e":"TextLayout+Helpers.swift","identifier":"AT-2-1-layout.swift","syntax":"swift"},"AT-1-1-app.swift":{"content":["import AdaEngine","","@main","struct AnimatedTextApp: App {","    var body: some AppScene {","        WindowGroup {","            ContentView()","        }","        .windowMode(.windowed)","        .windowTitle(\"Animated Text\")","    }","}"],"fileType":"swift","type":"file","highlights":[],"fileName":"AnimatedTextApp.swift","identifier":"AT-1-1-app.swift","syntax":"swift"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Type-of-events":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Type-of-events","kind":"section","url":"\/tutorials\/adaengine\/eventlisteners#Type-of-events","abstract":[{"text":"In this tutorial you will learn about the event listeners system in Ada.","type":"text"},{"text":" ","type":"text"},{"text":"How can you catch events and process them","type":"text"}],"type":"section","role":"pseudoSymbol","title":"Type of events"},"doc://AdaEngine/tutorials/AdaEngine/PlayerAndText":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText","kind":"project","url":"\/tutorials\/adaengine\/playerandtext","abstract":[{"text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene.","type":"text"}],"estimatedTime":"5min","type":"topic","role":"project","title":"Player and Text in Ada"},"AT-2-3-renderer.swift":{"content":["import AdaEngine","","struct AnimatedSineWaveRenderer: TextRenderer {","    var timeOffset: Double","","    var animatableData: Double {","        get { timeOffset }","        set { timeOffset = newValue }","    }","","    init(timeOffset: Double) {","        self.timeOffset = timeOffset","    }","","    func draw(layout: Text.Layout, in context: inout UIGraphicsContext) {","        let glyphs = layout.flattenedRuns","        let safeCount = max(glyphs.count, 1)","        let width = layout.first?.typographicBounds.rect.width ?? 1","        let height = layout.first?.typographicBounds.rect.height ?? 1","","        for (index, glyph) in glyphs.enumerated() {","            let offset = sineOffset(","                index: index,","                amplitude: Double(height) * 0.5,","                wavelength: Double(width),","                phase: timeOffset,","                total: safeCount","            )","","            var copy = context","            copy.translateBy(x: 0, y: Float(offset))","            copy.draw(glyph)","        }","    }","","    private func sineOffset(","        index: Int,","        amplitude: Double,","        wavelength: Double,","        phase: Double,","        total: Int","    ) -> Double {","        let x = Double(index)","        let position = (x \/ Double(total)) * wavelength","        let radians = ((position + phase) \/ wavelength) * 2 * .pi","        return Math.sin(radians) * amplitude","    }","}"],"fileType":"swift","type":"file","highlights":[{"line":14},{"line":15},{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23},{"line":24},{"line":25},{"line":26},{"line":27},{"line":28},{"line":29},{"line":30},{"line":31},{"line":32},{"line":33},{"line":34},{"line":35},{"line":36},{"line":37},{"line":38},{"line":39},{"line":40},{"line":41},{"line":42},{"line":43},{"line":44},{"line":45},{"line":46},{"line":47}],"fileName":"AnimatedSineWaveRenderer.swift","identifier":"AT-2-3-renderer.swift","syntax":"swift"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics#Debug-overlays":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Debug-overlays","kind":"section","url":"\/tutorials\/adaengine\/uibasics#Debug-overlays","abstract":[{"text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state.","type":"text"}],"type":"section","role":"pseudoSymbol","title":"Debug overlays"},"doc://AdaEngine/tutorials/AdaEngine":{"identifier