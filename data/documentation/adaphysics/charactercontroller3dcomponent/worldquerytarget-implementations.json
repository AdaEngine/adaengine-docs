{"kind":"article","topicSections":[{"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/AdaPhysics\/documentation\/AdaPhysics\/CharacterController3DComponent\/access-3irvt","doc:\/\/AdaPhysics\/documentation\/AdaPhysics\/CharacterController3DComponent\/access-6jenl"],"generated":true}],"metadata":{"modules":[{"name":"AdaPhysics"}],"role":"collectionGroup","title":"WorldQueryTarget Implementations","roleHeading":"API Collection"},"variants":[{"paths":["\/documentation\/adaphysics\/charactercontroller3dcomponent\/worldquerytarget-implementations"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/AdaPhysics\/documentation\/AdaPhysics\/CharacterController3DComponent\/WorldQueryTarget-Implementations","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/AdaPhysics\/documentation\/AdaPhysics","doc:\/\/AdaPhysics\/documentation\/AdaPhysics\/CharacterController3DComponent"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://AdaPhysics/documentation/AdaPhysics/CharacterController3DComponent/access-6jenl":{"abstract":[],"identifier":"doc:\/\/AdaPhysics\/documentation\/AdaPhysics\/CharacterController3DComponent\/access-6jenl","role":"symbol","type":"topic","title":"access","url":"\/documentation\/adaphysics\/charactercontroller3dcomponent\/access-6jenl","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"access","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6AdaECS15SystemAccessSetV","kind":"typeIdentifier","text":"SystemAccessSet"}]},"doc://AdaPhysics/documentation/AdaPhysics/CharacterController3DComponent":{"abstract":[{"type":"text","text":"An upright capsule mover. Its entity’s position is the bottom of the capsule in world units."},{"type":"text","text":" "},{"type":"text","text":"Use on a root entity without "},{"code":"PhysicsBody3DComponent","type":"codeVoice"},{"type":"text","text":"; visual scale does not resize the capsule."},{"type":"text","text":" "},{"type":"text","text":"The controller collides with physics bodies, ignores sensors, and does not push dynamic bodies"},{"type":"text","text":" "},{"type":"text","text":"or register a body that other character controllers can collide with."},{"type":"text","text":" "},{"type":"text","text":"Supported walking automatically steps over solid ledges up to 5% of the resolved height,"},{"type":"text","text":" "},{"type":"text","text":"provided the full capsule can sweep up, forward, and down to a walkable landing."}],"kind":"symbol","navigatorTitle":[{"text":"CharacterController3DComponent","kind":"identifier"}],"title":"CharacterController3DComponent","url":"\/documentation\/adaphysics\/charactercontroller3dcomponent","identifier":"doc:\/\/AdaPhysics\/documentation\/AdaPhysics\/CharacterController3DComponent","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CharacterController3DComponent","kind":"identifier"}],"type":"topic"},"doc://AdaPhysics/documentation/AdaPhysics":{"identifier":"doc:\/\/AdaPhysics\/documentation\/AdaPhysics","kind":"symbol","title":"AdaPhysics","type":"topic","abstract":[],"role":"collection","url":"\/documentation\/adaphysics"},"doc://AdaPhysics/documentation/AdaPhysics/CharacterController3DComponent/access-3irvt":{"title":"access","kind":"symbol","abstract":[],"url":"\/documentation\/adaphysics\/charactercontroller3dcomponent\/access-3irvt","type":"topic","identifier":"doc:\/\/AdaPhysics\/documentation\/AdaPhysics\/CharacterController3DComponent\/access-3irvt","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"access","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"SystemAccessSet","preciseIdentifier":"s:6AdaECS15SystemAccessSetV"}],"role":"symbol"}}}