ent()","                    Transform(scale: .init(0.5))","                    Sprite(tintColor: .red)","                }","","                appWorld.addSystem(GamepadInputSystem.self)","            }","            .windowMode(.windowed)","            .windowTitle(\"Gamepad Input\")","    }","}"],"identifier":"GP-1-3-app.swift","highlights":[{"line":24},{"line":25}],"syntax":"swift","type":"file","fileType":"swift"},"GP-2-5-system.swift":{"highlights":[{"line":36},{"line":37},{"line":38},{"line":39}],"type":"file","identifier":"GP-2-5-system.swift","fileName":"GamepadInputSystem.swift","fileType":"swift","syntax":"swift","content":["import AdaEngine","","@PlainSystem","struct GamepadInputSystem {","","    @FilterQuery<Ref<Transform>, With<PlayerComponent>>","    private var playerQuery","","    @Res<Input>","    private var input","","    @Res<DeltaTime>","    private var deltaTime","","    init(world _: World) {}","","    func update(context _: UpdateContext) {","        let gamepads = input.getConnectedGamepads()","","        if gamepads.isEmpty {","            return","        }","","        for gamepad in gamepads {","            let leftStickX = gamepad.getAxisValue(.leftStickX)","            let leftStickY = gamepad.getAxisValue(.leftStickY)","            let deadzone: Float = 0.1","","            if abs(leftStickX) > deadzone || abs(leftStickY) > deadzone {","                playerQuery.forEach { transform in","                    let speed: Float = 2.0","                    transform.position.x += leftStickX * Float(deltaTime.deltaTime) * speed","                    transform.position.y -= leftStickY * Float(deltaTime.deltaTime) * speed","                }","            }","","            if gamepad.isGamepadButtonPressed(.x) {","                gamepad.rumble(lowFrequency: 0.5, highFrequency: 0.75, duration: 0.5)","            }","        }","    }","}"]},"GP-2-1-system.swift":{"fileName":"GamepadInputSystem.swift","content":["import AdaEngine","","@Plai