{"primaryContentSections":[{"kind":"content","content":[{"text":"Declare a system","anchor":"Declare-a-system","type":"heading","level":2},{"inlineContent":[{"text":"Apply ","type":"text"},{"code":"@system","type":"codeVoice"},{"text":" to a class and implement ","type":"text"},{"code":"update(context)","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"ada","code":["@system(scheduler: \"update\", id: \"game.movement\")","class MovementSystem {","    func update(context) {","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The scheduler defaults to "},{"type":"codeVoice","code":"update"},{"type":"text","text":". System identifiers must be unique within a"},{"type":"text","text":" "},{"type":"text","text":"script module."}],"type":"paragraph"},{"inlineContent":[{"text":"For one-time world setup, use ","type":"text"},{"code":"@system(scheduler: \"startup\")","type":"codeVoice"},{"text":". Its","type":"text"},{"text":" ","type":"text"},{"code":"update(context)","type":"codeVoice"},{"text":" runs on the default scheduler runner’s first update, before","type":"text"},{"text":" ","type":"text"},{"text":"the regular frame stages. A script class constructor does not receive a world","type":"text"},{"text":" ","type":"text"},{"text":"context. See ","type":"text"},{"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","type":"reference","isActive":true},{"text":" for all annotation arguments.","type":"text"}],"type":"paragraph"},{"text":"Order systems","anchor":"Order-systems","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Use repeatable "},{"type":"codeVoice","code":"@after"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@before"},{"type":"text","text":" annotations when component and resource"},{"type":"text","text":" "},{"type":"text","text":"access alone does not express the required execution order:"}],"type":"paragraph"},{"syntax":"ada","code":["@after(id: \"game.input\")","@before(id: \"game.physics\")","@system(scheduler: \"update\", id: \"game.movement\")","class MovementSystem {","    func update(context) {","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Dependency IDs resolve within the same AdaScript module. Both systems must use"},{"type":"text","text":" "},{"type":"text","text":"the same scheduler. AdaScript rejects unknown IDs, self-dependencies, and"},{"type":"text","text":" "},{"type":"text","text":"dependency cycles while loading the module."}],"type":"paragraph"},{"text":"Declare a query","anchor":"Declare-a-query","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Apply "},{"type":"codeVoice","code":"@query"},{"type":"text","text":" to a stored system property:"}],"type":"paragraph"},{"syntax":"ada","code":["@query(","    Health,","    Movement,","    with: Movable,","    without: Frozen",")","var entities;"],"type":"codeListing"},{"inlineContent":[{"text":"Positional components are fetched and available on each row. Four more clauses","type":"text"},{"text":" ","type":"text"},{"text":"take one component or a list:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Clause","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Meaning","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"optional: Target","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Fetched like a positional component, but rows may lack it. ","type":"text"},{"code":"entity.target","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":" when absent.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"with: Movable","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The entity must have it; it is not fetched."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"without: Frozen"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The entity must not have it.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"changed: Health"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Rows where any listed component changed since the system last ran.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"added: Marker","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Rows where any listed component was added since the system last ran."}],"type":"paragraph"}]]],"type":"table"},{"syntax":"ada","type":"codeListing","code":["@query(Health, Movement, optional: Target, with: Movable, without: Frozen, changed: Health)","var entities;","","for (var entity in entities) {","    if (entity.target != null) { entity.health.current -= entity.target.damage; }","}"]},{"inlineContent":[{"type":"codeVoice","code":"changed"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"added"},{"text":" need the component to exist in the archetype; the change tick","type":"text"},{"text":" ","type":"text"},{"text":"of a component is updated by every successful field write. A boolean ","type":"text"},{"type":"codeVoice","code":"where:"},{"type":"text","text":" clause"},{"type":"text","text":" "},{"type":"text","text":"and any other label are rejected with a message naming the supported clauses."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Row properties are the lower-camel-case component names, or an explicit alias"},{"type":"text","text":" "},{"type":"text","text":"written with "},{"type":"codeVoice","code":"as"},{"type":"text","text":". A component may be named by its qualified path:"}]},{"type":"codeListing","syntax":"ada","code":["@query(Game.Health as hp, Physics.Movement as motion)","var entities;","","for (var entity in entities) {","    var position = entity.motion.position;","    entity.hp.current -= 1.0;","}"]},{"type":"paragraph","inlineContent":[{"text":"Two fetched components with the same short name (","type":"text"},{"code":"Game.Health","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Physics.Health","type":"codeVoice"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"are an error until one is given an alias, and no component may be aliased ","type":"text"},{"code":"id","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"entity.id"},{"type":"text","text":" exposes the native entity identifier."}]},{"type":"heading","level":2,"text":"Iterator behavior","anchor":"Iterator-behavior"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ada Script queries are native iterators. AdaECS resolves matching archetypes,"},{"type":"text","text":" "},{"type":"text","text":"binds component columns when entering a chunk, and advances their pointers by"},{"type":"text","text":" "},{"type":"text","text":"row stride. The bridge does not create an entity proxy for every result and"},{"type":"text","text":" "},{"type":"text","text":"does not perform a world component lookup for every field access."}]},{"type":"paragraph","inlineContent":[{"text":"A query row and its component views are borrowed. Do not retain them after the","type":"text"},{"text":" ","type":"text"},{"text":"loop or system update returns. Structural changes must use deferred commands.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inactive entities are skipped. Empty queries execute zero loop iterations."}]},{"text":"Component fields","type":"heading","anchor":"Component-fields","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"@Component","type":"codeVoice"},{"type":"text","text":" Swift macro generates the runtime field accessors used by Ada"},{"type":"text","text":" "},{"type":"text","text":"Script. Register native components before the script plugin is set up."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Supported field values include booleans, integers, finite floating-point"},{"type":"text","text":" "},{"type":"text","text":"values, strings, vectors, quaternions, colors, and reflected enums. A rejected"},{"type":"text","text":" "},{"type":"text","text":"write leaves the component unchanged and appends a development diagnostic."}]},{"text":"Access planning","type":"heading","anchor":"Access-planning","level":2},{"type":"paragraph","inlineContent":[{"text":"The compiler reads how a system uses its rows and requests exactly that access","type":"text"},{"text":" ","type":"text"},{"text":"from the scheduler:","type":"text"}]},{"syntax":"ada","code":["var current = entity.health.current;   \/\/ read Health","entity.health.current = current - 1;   \/\/ write Health","entity.health.current -= 1;            \/\/ read and write Health"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"A component that is only read can be shared with other readers; a write reserves","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"it exclusively. "},{"code":"changed:","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"added:","type":"codeVoice"},{"text":" read a component’s ticks, so they request","type":"text"},{"text":" ","type":"text"},{"text":"read access even for a component that is not fetched. Filter-only components","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"with"},{"text":", ","type":"text"},{"type":"codeVoice","code":"without"},{"text":") request none.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Analysis follows "},{"type":"codeVoice","code":"for (var row in query)"},{"type":"text","text":" loops. If a row, a component view, or the"},{"type":"text","text":" "},{"type":"text","text":"query itself escapes into code the compiler cannot follow (passed to a function,"},{"type":"text","text":" "},{"type":"text","text":"stored, called with an unknown method), the system must declare what it touches:"}]},{"type":"codeListing","syntax":"ada","code":["@system(id: \"game.inspect\")","@access(read: [Health], write: [Transform])","class InspectSystem {","    @query(Health, Transform)","    var entities;","","    func update(context) {","        for (var entity in entities) { inspect(entity); }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Without "},{"type":"codeVoice","code":"@access"},{"type":"text","text":" this fails to compile, naming the query and component. A"},{"type":"text","text":" "},{"type":"text","text":"declaration may be broader than the code but not narrower: declaring a component"},{"type":"text","text":" "},{"type":"text","text":"read-only while the script writes it is an error. The same "},{"type":"codeVoice","code":"@access"},{"type":"text","text":" declaration"},{"type":"text","text":" "},{"type":"text","text":"governs the dynamic "},{"type":"codeVoice","code":"context.world.read\/write"},{"type":"text","text":" calls. A precompiled module has no"},{"type":"text","text":" "},{"type":"text","text":"script text to analyse and keeps write access to every fetched component."}]},{"type":"heading","text":"Multiple queries","level":2,"anchor":"Multiple-queries"},{"type":"paragraph","inlineContent":[{"text":"One system may declare multiple independent iterators:","type":"text"}]},{"type":"codeListing","syntax":"ada","code":["@system(scheduler: \"update\")","class TargetingSystem {","    @query(Player, Transform)","    var players;","","    @query(Enemy, Target, without: Dead)","    var enemies;","","    func update(context) {","        for (var enemy in enemies) {","            for (var player in players) {","                enemy.target.entity = player.id;","                break;","            }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Queries are refreshed by the scheduler before each system execution."}]},{"type":"heading","text":"Project input actions","level":2,"anchor":"Project-input-actions"},{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"inlineContent":[{"text":"Project Settings → Input Bindings","type":"text"}],"type":"strong"},{"text":", add an action such as ","type":"text"},{"code":"Jump","type":"codeVoice"},{"text":", then add","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"keyboard, mouse, gamepad or touch bindings. Click "},{"type":"strong","inlineContent":[{"text":"Save Project Settings","type":"text"}]},{"type":"text","text":"."},{"text":" ","type":"text"},{"text":"Actions are stored in ","type":"text"},{"code":".ada\/project.json","type":"codeVoice"},{"text":" and loaded by both Play Mode and the","type":"text"},{"text":" ","type":"text"},{"text":"AdaScript project runtime. Multiple bindings act as alternatives: releasing one","type":"text"},{"text":" ","type":"text"},{"text":"input does not release the action while another binding is held.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Systems and scriptable components declare input as a read-only resource dependency","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"@res var input: Input;","type":"codeVoice"},{"text":". Only declarations that request Input receive it.","type":"text"},{"text":" ","type":"text"},{"text":"Use ","type":"text"},{"code":"@res(optional: true) var input: Input;","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"input.available()","type":"codeVoice"},{"text":" when the","type":"text"},{"text":" ","type":"text"},{"text":"resource may be absent; a missing required resource produces a diagnostic.","type":"text"}]},{"code":["@res var input: Input;","","func update(context) {","    if (input.isActionJustPressed(\"Jump\")) {","        \/\/ Start a jump once per press.","    }","    var movement = input.getActionStrength(\"MoveRight\");","}"],"type":"codeListing","syntax":"adascript"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"isActionPressed(name)"},{"text":" remains true while an input is held.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"isActionJustPressed(name)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"isActionJustReleased(name)","type":"codeVoice"},{"type":"text","text":" describe transitions"},{"type":"text","text":" "},{"type":"text","text":"during the current frame. Both can be true for a tap completed within one frame."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"getActionStrength(name)","type":"codeVoice"},{"text":" returns 0…1. Gamepad axes use a direction and the","type":"text"},{"text":" ","type":"text"},{"text":"action’s dead zone; buttons and touch return either zero or one.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Gamepad bindings match any connected controller. ","type":"text"},{"code":"Any Finger Held","type":"codeVoice"},{"text":" stays active","type":"text"},{"text":" ","type":"text"},{"text":"until every contact ends or is cancelled. Touch lifecycle events, mouse motion,","type":"text"},{"text":" ","type":"text"},{"text":"and wheel bindings produce frame pulses.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Input snapshots are scoped to a callback; query input again on the next update."},{"type":"text","text":" "},{"type":"text","text":"Unknown action names return false or zero. Names are case-sensitive."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift systems use the same methods on their "},{"type":"codeVoice","code":"Input"},{"type":"text","text":" resource. "},{"type":"codeVoice","code":"InputPlugin()"},{"type":"text","text":" "},{"type":"text","text":"loads the "},{"type":"codeVoice","code":"inputActions"},{"type":"text","text":" section from "},{"type":"codeVoice","code":".ada\/project.json"},{"type":"text","text":" in the current working"},{"type":"text","text":" "},{"type":"text","text":"directory, including games launched from the editor. Packaged Swift applications"},{"type":"text","text":" "},{"type":"text","text":"can decode "},{"type":"codeVoice","code":"[InputAction]"},{"text":" from an included resource and pass it to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"InputPlugin(actions:)"},{"text":", or call ","type":"text"},{"type":"codeVoice","code":"try input.setInputActions(actions)"},{"text":" on an existing","type":"text"},{"text":" ","type":"text"},{"text":"resource. Explicit ","type":"text"},{"type":"codeVoice","code":"InputPlugin(actions: [])"},{"text":" disables automatic project loading.","type":"text"}]},{"type":"heading","anchor":"Input-keyboard-bindings","text":"Input keyboard bindings","level":3},{"type":"paragraph","inlineContent":[{"text":"To bind Space to jumping, open ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Project Settings → Input Bindings"}]},{"text":", select","type":"text"},{"text":" ","type":"text"},{"text":"or add the ","type":"text"},{"type":"codeVoice","code":"Jump"},{"text":" action, and add a keyboard binding for Space. Save the project","type":"text"},{"text":" ","type":"text"},{"text":"settings, then start Play and press Space. The script checks ","type":"text"},{"type":"codeVoice","code":"Jump"},{"type":"text","text":" through"},{"type":"text","text":" "},{"text":"the Input resource, so you can change the bound key without editing the script.","type":"text"}]}]}],"metadata":{"roleHeading":"Article","role":"article","title":"Ada Script ECS","modules":[{"name":"Ada Script"}]},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Declare annotation-driven systems and iterate native AdaECS component columns.","type":"text"}],"variants":[{"paths":["\/documentation\/adascripting\/adascriptecs"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS"},"seeAlsoSections":[{"identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptDiagnosticsAndPerformance","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTesting"],"generated":true,"title":"ECS Integration","anchor":"ECS-Integration"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/AdaScripting\/documentation\/AdaScripting"]]},"references":{"doc://AdaScripting/documentation/AdaScripting/AdaScriptDiagnosticsAndPerformance":{"title":"Ada Script Diagnostics and Performance","abstract":[{"type":"text","text":"Understand annotation, setup, and runtime failures and keep ECS work on the"},{"type":"text","text":" "},{"type":"text","text":"native chunk path."}],"url":"\/documentation\/adascripting\/adascriptdiagnosticsandperformance","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptDiagnosticsAndPerformance","kind":"article","role":"article","type":"topic"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptTesting":{"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTesting","type":"topic","role":"collectionGroup","kind":"article","title":"Testing Ada Script","abstract":[{"text":"Write tests next to your gameplay code, run them with ","type":"text"},{"code":"swift test","type":"codeVoice"},{"text":" or a command, and keep them out of shipped builds.","type":"text"}],"url":"\/documentation\/adascripting\/adascripttesting"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptAnnotations":{"title":"Ada Script Annotation Reference","abstract":[{"text":"Choose an annotation by the declaration it describes. Annotation arguments","type":"text"},{"text":" ","type":"text"},{"text":"are literals, identifiers, or lists of those values, not runtime expressions.","type":"text"},{"type":"text","text":" "},{"text":"The same spelling can have different roles: ","type":"text"},{"code":"@component","type":"codeVoice"},{"text":" declares a struct,","type":"text"},{"text":" ","type":"text"},{"text":"while ","type":"text"},{"code":"@component(required: true)","type":"codeVoice"},{"text":" binds an existing component to a scriptable","type":"text"},{"text":" ","type":"text"},{"text":"instance.","type":"text"}],"url":"\/documentation\/adascripting\/adascriptannotations","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","kind":"article","role":"article","type":"topic"},"doc://AdaScripting/documentation/AdaScripting":{"type":"topic","role":"collection","kind":"symbol","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting","title":"Ada Script","url":"\/documentation\/adascripting","abstract":[{"text":"Write gameplay systems in Ada Script while keeping entity filtering and access planning in AdaEngine’s native ECS.","type":"text"}]}}}