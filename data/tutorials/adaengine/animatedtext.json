arn the basics of Ada and start developing your own games!","type":"text"}],"url":"\/tutorials\/adaengine","type":"topic"},"doc://AdaEngine/tutorials/AdaEngine/Create-your-first-2D-game-project.":{"url":"\/tutorials\/adaengine\/create-your-first-2d-game-project.","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project.","kind":"article","abstract":[],"title":"Create your first 2D game project.","type":"topic","role":"article"},"doc://AdaEngine/tutorials/AdaEngine/PlayerAndText#Add-Text-component":{"url":"\/tutorials\/adaengine\/playerandtext#Add-Text-component","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Text-component","kind":"section","abstract":[{"text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene.","type":"text"}],"title":"Add Text component","type":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics#Layout-with-stacks":{"url":"\/tutorials\/adaengine\/uibasics#Layout-with-stacks","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Layout-with-stacks","title":"Layout with stacks","abstract":[{"text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state.","type":"text"}],"kind":"section","type":"section","role":"pseudoSymbol"},"AT-3-1-view.swift":{"content":["import AdaEngine","","struct ContentView: View {","    @State private var timeOffset: Double = 0","","    var body: some View {","        Text(\"Sine Wave\")","            .textRendered(AnimatedSineWaveRenderer(timeOffset: timeOffset))","    }","}"],"fileName":"ContentView.swift","syntax":"swift","highlights":[],"type":"file","fileType":"swift","identifier":"AT-3-1-view.swift"},"doc://AdaEngine/tutorials/AdaEngine/PlayerAndText#Add-Player-component":{"url":"\/tutorials\/adaengine\/playerandtext#Add-Player-component","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Player-component","abstract":[{"text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene.","type":"text"}],"kind":"section","title":"Add Player component","type":"section","role":"pseudoSymbol"},"AT-1-1-app.swift":{"content":["import AdaEngine","","@main","struct AnimatedTextApp: App {","    var body: some AppScene {","        WindowGroup {","            ContentView()","        }","        .windowMode(.windowed)","        .windowTitle(\"Animated Text\")","    }","}"],"fileName":"AnimatedTextApp.swift","syntax":"swift","highlights":[],"type":"file","fileType":"swift","identifier":"AT-1-1-app.swift"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Read-buttons":{"url":"\/tutorials\/adaengine\/gamepadinput#Read-buttons","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Read-buttons","title":"Read buttons","abstract":[{"text":"Build a small scene that spawns a player entity and moves it with a gamepad.","type":"text"}],"kind":"section","type":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Create-a-main-camera":{"url":"\/tutorials\/adaengine\/createfirst2dscene#Create-a-main-camera","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-a-main-camera","abstract":[{"text":"In this tutorial, you will learn how to create your first 2D scene using Ada.","type":"text"}],"kind":"section","title":"Create a main camera.","type":"section","role":"pseudoSymbol"},"AT-2-3-renderer.swift":{"content":["import AdaEngine","","struct AnimatedSineWaveRenderer: TextRenderer {","    var timeOffset: Double","","    var animatableData: Double {","        get { timeOffset }","        set { timeOffset = newValue }","    }","","    init(timeOffset: Double) {","        self.timeOffset = timeOffset","    }","","    func draw(layout: Text.Layout, in context: inout UIGraphicsContext) {","        let glyphs = layout.flattenedRuns","        let safeCount = max(glyphs.count, 1)","        let width = layout.first?.typographicBounds.rect.width ?? 1","        let height = layout.first?.typographicBounds.rect.height ?? 1","","        for (index, glyph) in glyphs.enumerated() {","            let offset = sineOffset(","                index: index,","                amplitude: Double(height) * 0.5,","                wavelength: Double(width),","                phase: timeOffset,","                total: safeCount","            )","","            var copy = context","            copy.translateBy(x: 0, y: Float(offset))","            copy.draw(glyph)","        }","    }","","    private func sineOffset(","        index: Int,","        amplitude: Double,","        wavelength: Double,","        phase: Double,","        total: Int","    ) -> Double {","        let x = Double(index)","        let position = (x \/ Double(total)) * wavelength","        let radians = ((position + phase) \/ wavelength) * 2 * .pi","        return Math.sin(radians) * amplitude","    }","}"],"fileName":"AnimatedSineWaveRenderer.swift","syntax":"swift","highlights":[{"line":14},{"line":15},{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23},{"line":24},{"line":25},{"line":26},{"line":27},{"line":28},{"line":29},{"line":30},{"line":31},{"line":32},{"line":33},{"line":34},{"line":35},{"line":36},{"line":37},{"line":38},{"line":39},{"line":40},{"line":41},{"line":42},{"line":43},{"line":44},{"line":45},{"line":46},{"line":47}],"type":"file","fileType":"swift","identifier":"AT-2-3-renderer.swift"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics":{"estimatedTime":"15min","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics","role":"project","kind":"project","title":"UI Basics","abstract":[{"text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state.","type":"text"}],"url":"\/tutorials\/adaengine\/uibasics","type":"topic"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Move-and-rumble":{"url":"\/tutorials\/adaengine\/gamepadinput#Move-and-rumble","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Move-and-rumble","title":"Move and rumble","kind":"section","abstract":[{"text":"Build a small scene that spawns a player entity and moves it with a gamepad.","type":"text"}],"type":"section","role":"pseudoSymbol"},"AT-3-3-view.swift":{"content":["import AdaEngine","","struct ContentView: View {","    @State private var timeOffset: Double = 0","    @State private var animationTask: Task<Void, Never>?","","    var body: some View {","        Text(\"Sine Wave\")","            .textRendered(AnimatedSineWaveRenderer(timeOffset: timeOffset))","            .onAppear {","                startAnimation()","            }","            .onDisappear {","                animationTask?.cancel()","                animationTask = nil","            }","    }","","    private func startAnimation() {","        animationTask?.cancel()","        animationTask = Task { @MainActor in","            while !Task.isCancelled {","                timeOffset += 0.12","                try? await Task.sleep(nanoseconds: 16_000_000)","            }","        }","    }","}"],"fileName":"ContentView.swift","syntax":"swift","highlights":[{"line":13},{"line":14},{"line":15},{"line":16}],"type":"file","fileType":"swift","identifier":"AT-3-3-view.swift"},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText":{"estimatedTime":"20min","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText","role":"project","kind":"project","title":"Animated Text Renderer","abstract":[{"text":"Create a custom ","type":"text"},{"code":"TextRenderer","type":"codeVoice"},{"text":" that draws text along a sine wave and animate it by updating renderer state.","type":"text"}],"url":"\/tutorials\/adaengine\/animatedtext","type":"topic"},"doc://AdaEngine/tutorials/AdaEngine/UI