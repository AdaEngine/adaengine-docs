ntity: Event {","        public let entity: Entity","    }","","    \/\/\/ Raised before an entity is removed from the scene.","    public struct WillRemoveEntity: Event {","        public let entity: Entity","    }","","    \/\/\/ An event triggered once per frame interval that you can use to execute custom logic for each frame.","    public struct Update: Event {","","        \/\/\/ The updated scene.","        public let scene: Scene","","        \/\/\/ The elapsed time since the last update.","        public let deltaTime: TimeInterval","    }","}","","\/\/\/ Events associated with collisions.","public enum CollisionEvents {","","    \/\/\/ An event raised when two objects collide.","    public struct Began: Event {","","        \/\/\/ The first entity involved in the collision.","        public let entityA: Entity","","        \/\/\/ The second entity involved in the collision.","        public let entityB: Entity","","        \/\/\/ The estimated strength of the impact.","        public let impulse: Float","    }","","    \/\/\/ An event raised when two objects, previously in contact, separate.","    public struct Ended: Event {","","        \/\/\/ The first entity involved in the collision.","        public let entityA: Entity","","        \/\/\/ The second entity involved in the collision.","        public let entityB: Entity","    }","}"],"fileType":"swift","identifier":"EL-2-4-events.swift","type":"file","fileName":"Events.swift","syntax":"swift"},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText":{"type":"topic","abstract":[{"type":"text","text":"Create a custom "},{"type":"codeVoice","code":"TextRenderer"},{"type":"text","text":" that draws text along a sine wave and animate it by updating renderer state."}],"kind":"project","title":"Animated Text Renderer","role":"project","estimatedTime":"20min","url":"\/tutorials\/adaengine\/animatedtext","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Set-up-the-world":{"type":"section","url":"\/tutorials\/adaengine\/gamepadinput#Set-up-the-world","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Set-up-the-world","kind":"section","title":"Set up the world","abstract":[{"type":"text","text":"Build a small scene that spawns a player entity and moves it with a gamepad."}],"role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput":{"type":"topic","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput","url":"\/tutorials\/adaengine\/gamepadinput","estimatedTime":"20min","kind":"project","title":"Gamepad Input","abstract":[{"type":"text","text":"Build a small scene that spawns a player entity and moves it with a gamepad."}],"role":"project"},"doc://AdaEngine/tutorials/AdaEngine/CreateProject":{"type":"topic","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject","url":"\/tutorials\/adaengine\/createproject","estimatedTime":"5min","title":"Create your first game project","kind":"project","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first Ada project."}],"role":"project"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners":{"abstract":[{"text":"In this tutorial you will learn about the event listeners system in Ada.","type":"text"},{"text":" ","type":"text"},{"text":"How can you catch events and process them","type":"text"}],"type":"topic","kind":"project","title":"Event Listeners in Ada","role":"project","estimatedTime":"5min","url":"\/tutorials\/adaengine\/eventlisteners","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners"},"EL-2-1-scene.swift":{"highlights":[],"content":["import AdaEngine","","struct EventListenerPlugin: Plugin {","    func setup(in _: borrowing AppWorlds) {","","    }","}"],"fileType":"swift","syntax":"swift","type":"file","fileName":"EventListenerPlugin.swift","identifier":"EL-2-1-scene.swift"},"EL-2-2-scene.swift":{"fileName":"EventListenerPlugin.swift","content":["impor