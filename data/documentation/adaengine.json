{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdaEngine\/documentation\/AdaEngine"},"sections":[],"kind":"symbol","primaryContentSections":[{"content":[{"text":"Additional Resources","anchor":"Additional-Resources","type":"heading","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"https:\/\/github.com\/adaengine\/adaengine","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/github.com\/adaengine\/adaengine\/discussions","type":"reference","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/www.adaengine.org\/"}]}]}],"type":"unorderedList"},{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Ada is a modern, open-source game engine written in Swift, designed for building 2D and 3D games with simplicity and performance in mind. Its architecture leverages the Entity Component System (ECS) paradigm, enabling developers to create games and interactive experiences using a modular and scalable approach.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Ada provides a suite of built-in features, including:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"High-level rendering system supporting 2D and 3D graphics"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Physics, animation, input handling, audio, and UI systems"}]}]},{"content":[{"inlineContent":[{"text":"Asset management pipeline and streamlined workflows","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Cross-platform support across Apple platforms and Linux","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Hot-reload capabilities for assets and scripts"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Modern Swift API with async\/await, property wrappers, and result builders"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"With Ada, both beginners and experienced Swift developers can build games rapidly, focusing on gameplay instead of low-level boilerplate. Extensive documentation and tutorials make it easy to get started, from setting up your first scene to advanced gameplay mechanics.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Ada is actively developed, and contributions from the community are welcome.","type":"text"},{"text":" ","type":"text"},{"text":"For more details and guides, check out the tutorials below.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/adaengine"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"anchor":"Tutorials","title":"Tutorials","identifiers":["doc:\/\/AdaEngine\/documentation\/AdaEngine"]},{"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/AdaEngine\/documentation\/AdaEngine\/Building","doc:\/\/AdaEngine\/documentation\/AdaEngine\/Contributing","doc:\/\/AdaEngine\/documentation\/AdaEngine\/AdaUIIdentity","doc:\/\/AdaEngine\/documentation\/AdaEngine\/ImageDecoders","doc:\/\/AdaEngine\/documentation\/AdaEngine\/VisionOSWindowed"]},{"anchor":"Articles","title":"Articles","identifiers":["doc:\/\/AdaEngine\/documentation\/AdaEngine\/HowToBuildEngine","doc:\/\/AdaEngine\/documentation\/AdaEngine\/SPMDebug","doc:\/\/AdaEngine\/documentation\/AdaEngine\/MakeTutorials","doc:\/\/AdaEngine\/documentation\/AdaEngine\/VisionOSImmersive"],"generated":true},{"anchor":"Classes","title":"Classes","identifiers":["doc:\/\/AdaEngine\/documentation\/AdaEngine\/AdaUIDebug3DResource","doc:\/\/AdaEngine\/documentation\/AdaEngine\/AdaUIDebug3DVisibility","doc:\/\/AdaEngine\/documentation\/AdaEngine\/FPSCounter"],"generated":true},{"anchor":"Structures","title":"Structures","identifiers":["doc:\/\/AdaEngine\/documentat