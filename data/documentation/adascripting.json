cripting\/documentation\/AdaScripting\/AdaScriptObjectBinding"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptObjectSchema":{"type":"topic","abstract":[],"title":"AdaScriptObjectSchema","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptObjectSchema","kind":"identifier"}],"url":"\/documentation\/adascripting\/adascriptobjectschema","navigatorTitle":[{"text":"AdaScriptObjectSchema","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptObjectSchema","role":"symbol"},"doc://AdaScripting/documentation/AdaScripting/GettingStartedWithAdaScript":{"title":"Getting Started with Ada Script","abstract":[{"type":"text","text":"Add an "},{"code":".ada","type":"codeVoice"},{"type":"text","text":" file to an AdaEngine executable and run its systems without manually loading each script."}],"role":"article","type":"topic","url":"\/documentation\/adascripting\/gettingstartedwithadascript","kind":"article","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript"},"doc://AdaScripting/documentation/AdaScripting/NativeAOT":{"title":"Native AdaScript (experimental)","abstract":[{"type":"text","text":"Compile supported AdaScript into native code with Gravity, then install metadata"},{"type":"text","text":" "},{"type":"text","text":"and callbacks through "},{"code":"AdaScriptNativePlugin","type":"codeVoice"},{"type":"text","text":". Gravity owns C11 generation, the"},{"type":"text","text":" "},{"type":"text","text":"C ABI and native memory. AdaEngine owns world capabilities and the ECS adapters."},{"type":"text","text":" "},{"type":"text","text":"Native execution does not use Gravity bytecode or fall back to the VM."}],"role":"article","type":"topic","url":"\/documentation\/adascripting\/nativeaot","kind":"article","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/NativeAOT"},"doc://AdaScripting/documentation/AdaScripting/AdaScript