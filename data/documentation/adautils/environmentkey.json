{"variants":[{"paths":["\/documentation\/adautils\/environmentkey"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"A key for accessing values in the environment.","type":"text"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AdaUtils\/documentation\/AdaUtils"]]},"identifier":{"url":"doc:\/\/AdaUtils\/documentation\/AdaUtils\/EnvironmentKey","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"EnvironmentKey"}],"platforms":["macOS"]}]},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"You can create custom environment values by extending the ","type":"text"},{"identifier":"doc:\/\/AdaUtils\/documentation\/AdaUtils\/EnvironmentValues","type":"reference","isActive":true},{"text":" structure with new properties.","type":"text"},{"text":" ","type":"text"},{"text":"First declare a new environment key type and specify a value for the required defaultValue property:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["private struct MyEnvironmentKey: EnvironmentKey {","    static let defaultValue: String = \"Default value\"","}"]},{"type":"paragraph","inlineContent":[{"text":"Then use the key to define a new environment value property:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["extension EnvironmentValues {","    var myCustomValue: String {","        get { self[MyEnvironmentKey.self] }","        set { self[MyEnvironmentKey.self] = newValue }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Clients of your environment value never use the key directly. Instead, they use the key path of your","type":"text"},{"text":" ","type":"text"},{"text":"custom environment value property. To set the environment value for a view and all its subviews,","type":"text"},{"text":" ","type":"text"},{"text":"add the ","type":"text"},{"type":"codeVoice","code":"View\/environment(_:_:)"},{"text":" view modifier to that view:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["MyView()","   .environment(\\.myCustomValue, \"Another string\")"]},{"type":"paragraph","inlineContent":[{"text":"To read the value from inside MyView or one of its descendants, use the ","type":"text"},{"type":"codeVoice","code":"Environment"},{"text":" property wrapper:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct MyView: View {","    @Environment(\\.myCustomValue) var customValue: String","","    var body: some View {","        Text(customValue) \/\/ Displays \"Another string\".","    }","}"]}],"kind":"content"}],"metadata":{"title":"EnvironmentKey","externalID":"s:8AdaUtils14EnvironmentKeyP","modules":[{"name":"AdaUtils"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"EnvironmentKey"}],"role":"symbol","roleHeading":"Protocol","symbolKind":"protocol","navigatorTitle":[{"kind":"identifier","text":"EnvironmentKey"}]},"topicSections":[{"anchor":"Associated-Types","generated":true,"identifiers":["doc:\/\/AdaUtils\/documentation\/AdaUtils\/EnvironmentKey\/Value"],"title":"Associated Types"},{"anchor":"Type-Properties","generated":true,"identifiers":["doc:\/\/AdaUtils\/documentation\/AdaUtils\/EnvironmentKey\/defaultValue"],"title":"Type Properties"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"references":{"doc://AdaUtils/documentation/AdaUtils":{"abstract":[],"identifier":"doc:\/\/AdaUtils\/documentation\/AdaUtils","title":"AdaUtils","kind":"symbol","type":"topic","url":"\/documentation\/adautils","role":"collection"},"doc://AdaUtils/documentation/AdaUtils/EnvironmentKey/defaultValue":{"title":"defaultValue","required":true,"type":"topic","identifier":"doc:\/\/AdaUtils\/documentation\/AdaUtils\/EnvironmentKey\/defaultValue","kind":"symbol","url":"\/documentation\/ada