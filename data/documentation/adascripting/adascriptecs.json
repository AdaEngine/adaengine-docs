{"kind":"article","sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"modules":[{"name":"Ada Script"}],"roleHeading":"Article","role":"article","title":"Ada Script ECS"},"identifier":{"url":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS","interfaceLanguage":"swift"},"abstract":[{"text":"Declare annotation-driven systems and iterate native AdaECS component columns.","type":"text"}],"primaryContentSections":[{"content":[{"text":"Declare a system","anchor":"Declare-a-system","type":"heading","level":2},{"inlineContent":[{"text":"Apply ","type":"text"},{"code":"@system","type":"codeVoice"},{"text":" to a class and implement ","type":"text"},{"code":"update(context)","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"ada","type":"codeListing","code":["@system(scheduler: \"update\", id: \"game.movement\")","class MovementSystem {","    func update(context) {","    }","}"]},{"inlineContent":[{"text":"The scheduler defaults to ","type":"text"},{"code":"update","type":"codeVoice"},{"text":". System identifiers must be unique within a","type":"text"},{"text":" ","type":"text"},{"text":"script module.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For one-time world setup, use ","type":"text"},{"code":"@system(scheduler: \"startup\")","type":"codeVoice"},{"text":". Its","type":"text"},{"text":" ","type":"text"},{"code":"update(context)","type":"codeVoice"},{"text":" runs on the default scheduler runner’s first update, before","type":"text"},{"text":" ","type":"text"},{"text":"the regular frame stages. A script class constructor does not receive a world","type":"text"},{"text":" ","type":"text"},{"text":"context. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","type":"reference"},{"text":" for all annotation arguments.","type":"text"}],"type":"paragraph"},{"text":"Order systems","anchor":"Order-systems","type":"heading","level":2},{"inlineContent":[{"text":"Use repeatable ","type":"text"},{"code":"@after","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@before","type":"codeVoice"},{"text":" annotations when component and resource","type":"text"},{"text":" ","type":"text"},{"text":"access alone does not express the required execution order:","type":"text"}],"type":"paragraph"},{"syntax":"ada","type":"codeListing","code":["@after(id: \"game.input\")","@before(id: \"game.physics\")","@system(scheduler: \"update\", id: \"game.movement\")","class MovementSystem {","    func update(context) {","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Dependency IDs resolve within the same AdaScript module. Both systems must use","type":"text"},{"text":" ","type":"text"},{"text":"the same scheduler. AdaScript rejects unknown IDs, self-dependencies, and","type":"text"},{"text":" ","type":"text"},{"text":"dependency cycles while loading the module.","type":"text"}]},{"level":2,"type":"heading","anchor":"Declare-a-query","text":"Declare a query"},{"inlineContent":[{"type":"text","text":"Apply "},{"type":"codeVoice","code":"@query"},{"type":"text","text":" to a stored system property:"}],"type":"paragraph"},{"syntax":"ada","code":["@query(","    Health,","    Movement,","    with: Movable,","    without: Frozen",")","var entities;"],"type":"codeListing"},{"inlineContent":[{"text":"Positional components are fetched and available on each row. Four more clauses","type":"text"},{"type":"text","text":" "},{"text":"take one component or a list:","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Clause","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Meaning","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"optional: Target"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Fetched like a positional component, but rows may lack it. ","type":"text"},{"type":"codeVoice","code":"entity.target"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"null"},{"text":" when absent.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"with: Movable"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The entity must have it; it is not fetched.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"without: Frozen"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The entity must not have it.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"changed: Health"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Rows where any listed component changed since the system last ran.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"added: Marker"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Rows where any listed component was added since the system last ran.","type":"text"}],"type":"paragraph"}]]]},{"syntax":"ada","type":"codeListing","code":["@query(Health, Movement, optional: Target, with: Movable, without: Frozen, changed: Health)","var entities;","","for (var entity in entities) {","    if (entity.target != null) { entity.health.current -= entity.target.damage; }","}"]},{"type":"paragraph","inlineContent":[{"code":"changed","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"added"},{"text":" need the component to exist in the archetype; the change tick","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"of a component is updated by every successful field write. A boolean "},{"type":"codeVoice","code":"where:"},{"type":"text","text":" clause"},{"type":"text","text":" "},{"type":"text","text":"and any other label are rejected with a message naming the supported clauses."}]},{"type":"paragraph","inlineContent":[{"text":"Row properties are the lower-camel-case component names, or an explicit alias","type":"text"},{"text":" ","type":"text"},{"text":"written with ","type":"text"},{"type":"codeVoice","code":"as"},{"text":". A component may be named by its qualified path:","type":"text"}]},{"syntax":"ada","type":"codeListing","code":["@query(Game.Health as hp, Physics.Movement as motion)","var entities;","","for (var entity in entities) {","    var position = entity.motion.position;","    entity.hp.current -= 1.0;","}"]},{"inlineContent":[{"type":"text","text":"Two fetched components with the same short name ("},{"type":"codeVoice","code":"Game.Health"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Physics.Health"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"are an error until one is given an alias, and no component may be aliased "},{"type":"codeVoice","code":"id"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"entity.id"},{"type":"text","text":" exposes the native entity identifier."}],"type":"paragraph"},{"text":"Iterator behavior","anchor":"Iterator-behavior","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Ada Script queries are native iterators. AdaECS resolves matching archetypes,","type":"text"},{"text":" ","type":"text"},{"text":"binds component columns when entering a chunk, and advances their pointers by","type":"text"},{"text":" ","type":"text"},{"text":"row stride. The bridge does not create an entity proxy for every result and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"does not perform a world component lookup for every field access."}]},{"type":"paragraph","inlineContent":[{"text":"A query row and its component views are borrowed. Do not retain them after the","type":"text"},{"text":" ","type":"text"},{"text":"loop or system update returns. Structural changes must use deferred commands.","type":"text"}]},{"inlineContent":[{"text":"Inactive entities are skipped. Empty queries execute zero loop iterations.","type":"text"}],"type":"paragraph"},{"text":"Component fields","anchor":"Component-fields","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"@Component"},{"type":"text","text":" Swift macro generates the runtime field accessors used by Ada"},{"type":"text","text":" "},{"type":"text","text":"Script. Register native components before the script plugin is set up."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Supported field values include booleans, integers, finite floating-point","type":"text"},{"text":" ","type":"text"},{"text":"values, strings, vectors, quaternions, colors, and reflected enums. A rejected","type":"text"},{"text":" ","type":"text"},{"text":"write leaves the component unchanged and appends a development diagnostic.","type":"text"}]},{"text":"Access planning","anchor":"Access-planning","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The compiler reads how a system uses its rows and requests exactly that access"},{"type":"text","text":" "},{"type":"text","text":"from the scheduler:"}],"type":"paragraph"},{"syntax":"ada","type":"codeListing","code":["var current = entity.health.current;   \/\/ read Health","entity.health.current = current - 1;   \/\/ write Health","entity.health.current -= 1;            \/\/ read and write Health"]},{"inlineContent":[{"type":"text","text":"A component that is only read can be shared with other readers; a write reserves"},{"type":"text","text":" "},{"type":"text","text":"it exclusively. "},{"type":"codeVoice","code":"changed:"},{"type":"text","text":" and "},{"type":"codeVoice","code":"added:"},{"type":"text","text":" read a component’s ticks, so they request"},{"type":"text","text":" "},{"type":"text","text":"read access even for a component that is not fetched. Filter-only components"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"with"},{"text":", ","type":"text"},{"code":"without","type":"codeVoice"},{"text":") request none.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Analysis follows ","type":"text"},{"type":"codeVoice","code":"for (var row in query)"},{"type":"text","text":" loops. If a row, a component view, or the"},{"text":" ","type":"text"},{"type":"text","text":"query itself escapes into code the compiler cannot follow (passed to a function,"},{"type":"text","text":" "},{"type":"text","text":"stored, called with an unknown method), the system must declare what it touches:"}],"type":"paragraph"},{"syntax":"ada","type":"codeListing","code":["@system(id: \"game.inspect\")","@access(read: [Health], write: [Transform])","class InspectSystem {","    @query(Health, Transform)","    var entities;","","    func update(context) {","        for (var entity in entities) { inspect(entity); }","    }","}"]},{"inlineContent":[{"text":"Without ","type":"text"},{"code":"@access","type":"codeVoice"},{"text":" this fails to compile, naming the query and component. A","type":"text"},{"text":" ","type":"text"},{"text":"declaration may be broader than the code but not narrower: declaring a component","type":"text"},{"text":" ","type":"text"},{"text":"read-only while the script writes it is an error. The same ","type":"text"},{"code":"@access","type":"codeVoice"},{"text":" declaration","type":"text"},{"text":" ","type":"text"},{"text":"governs the dynamic ","type":"text"},{"code":"context.world.read\/write","type":"codeVoice"},{"text":" calls. A precompiled module has no","type":"text"},{"text":" ","type":"text"},{"text":"script text to analyse and keeps write access to every fetched component.","type":"text"}],"type":"paragraph"},{"text":"Multiple queries","anchor":"Multiple-queries","type":"heading","level":2},{"inlineContent":[{"text":"One system may declare multiple independent iterators:","type":"text"}],"type":"paragraph"},{"syntax":"ada","type":"codeListing","code":["@system(scheduler: \"update\")","class TargetingSystem {","    @query(Player, Transform)","    var players;","","    @query(Enemy, Target, without: Dead)","    var enemies;","","    func update(context) {","        for (var enemy in enemies) {","            for (var player in players) {","                enemy.target.entity = player.id;","                break;","            }","        }","    }","}"]},{"inlineContent":[{"text":"Queries are refreshed by the scheduler before each system execution.","type":"text"}],"type":"paragraph"},{"text":"Project input actions","anchor":"Project-input-actions","type":"heading","level":2},{"inlineContent":[{"text":"In ","type":"text"},{"inlineContent":[{"type":"text","text":"Project Settings → Input Bindings"}],"type":"strong"},{"text":", add an action such as ","type":"text"},{"code":"Jump","type":"codeVoice"},{"text":", then add","type":"text"},{"text":" ","type":"text"},{"text":"keyboard, mouse, gamepad or touch bindings. Click ","type":"text"},{"inlineContent":[{"type":"text","text":"Save Project Settings"}],"type":"strong"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Actions are stored in ","type":"text"},{"code":".ada\/project.json","type":"codeVoice"},{"text":" and loaded by both Play Mode and the","type":"text"},{"text":" ","type":"text"},{"text":"AdaScript project runtime. Multiple bindings act as alternatives: releasing one","type":"text"},{"text":" ","type":"text"},{"text":"input does not release the action while another binding is held.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Systems and scriptable components declare input as a read-only resource dependency","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"@res var input: Input;","type":"codeVoice"},{"text":". Only declarations that request Input receive it.","type":"text"},{"text":" ","type":"text"},{"text":"Use ","type":"text"},{"code":"@res(optional: true) var input: Input;","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"input.available()","type":"codeVoice"},{"text":" when the","type":"text"},{"text":" ","type":"text"},{"text":"resource may be absent; a missing required resource produces a diagnostic.","type":"text"}],"type":"paragraph"},{"syntax":"adascript","type":"codeListing","code":["@res var input: Input;","","func update(context) {","    if (input.isActionJustPressed(\"Jump\")) {","        \/\/ Start a jump once per press.","    }","    var movement = input.getActionStrength(\"MoveRight\");","}"]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isActionPressed(name)"},{"type":"text","text":" remains true while an input is held."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isActionJustPressed(name)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"isActionJustReleased(name)"},{"type":"text","text":" describe transitions"},{"type":"text","text":" "},{"type":"text","text":"during the current frame. Both can be true for a tap completed within one frame."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"getActionStrength(name)"},{"type":"text","text":" returns 0…1. Gamepad axes use a direction and the"},{"type":"text","text":" "},{"type":"text","text":"action’s dead zone; buttons and touch return either zero or one."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Gamepad bindings match any connected controller. "},{"type":"codeVoice","code":"Any Finger Held"},{"type":"text","text":" stays active"},{"type":"text","text":" "},{"type":"text","text":"until every contact ends or is cancelled. Touch lifecycle events, mouse motion,"},{"type":"text","text":" "},{"type":"text","text":"and wheel bindings produce frame pulses."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Input snapshots are scoped to a callback; query input again on the next update.","type":"text"},{"text":" ","type":"text"},{"text":"Unknown action names return false or zero. Names are case-sensitive.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Swift systems use the same methods on their ","type":"text"},{"code":"Input","type":"codeVoice"},{"text":" resource. ","type":"text"},{"code":"InputPlugin()","type":"codeVoice"},{"text":" ","type":"text"},{"text":"loads the ","type":"text"},{"code":"inputActions","type":"codeVoice"},{"text":" section from ","type":"text"},{"code":".ada\/project.json","type":"codeVoice"},{"text":" in the current working","type":"text"},{"text":" ","type":"text"},{"text":"directory, including games launched from the editor. Packaged Swift applications","type":"text"},{"text":" ","type":"text"},{"text":"can decode ","type":"text"},{"code":"[InputAction]","type":"codeVoice"},{"text":" from an included resource and pass it to","type":"text"},{"text":" ","type":"text"},{"code":"InputPlugin(actions:)","type":"codeVoice"},{"text":", or call ","type":"text"},{"code":"try input.setInputActions(actions)","type":"codeVoice"},{"text":" on an existing","type":"text"},{"text":" ","type":"text"},{"text":"resource. Explicit ","type":"text"},{"code":"InputPlugin(actions: [])","type":"codeVoice"},{"text":" disables automatic project loading.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adascripting\/adascriptecs"]}],"seeAlsoSections":[{"generated":true,"anchor":"ECS-Integration","title":"ECS Integration","identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptDiagnosticsAndPerformance","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTesting"]}],"hierarchy":{"paths":[["doc:\/\/AdaScripting\/documentation\/AdaScripting"]]},"references":{"doc://AdaScripting/documentation/AdaScripting":{"type":"topic","abstract":[{"type":"text","text":"Write gameplay systems in Ada Script while keeping entity filtering and access planning in AdaEngine’s native ECS."}],"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting","kind":"symbol","url":"\/documentation\/adascripting","role":"collection","title":"Ada Script"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptTesting":{"kind":"article","abstract":[{"text":"Write tests next to your gameplay code, run them with ","type":"text"},{"code":"swift test","type":"codeVoice"},{"text":" or a command, and keep them out of shipped builds.","type":"text"}],"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTesting","type":"topic","url":"\/documentation\/adascripting\/adascripttesting","title":"Testing Ada Script","role":"collectionGroup"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptDiagnosticsAndPerformance":{"kind":"article","abstract":[{"type":"text","text":"Understand annotation, setup, and runtime failures and keep ECS work on the"},{"text":" ","type":"text"},{"type":"text","text":"native chunk path."}],"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptDiagnosticsAndPerformance","type":"topic","url":"\/documentation\/adascripting\/adascriptdiagnosticsandperformance","title":"Ada Script Diagnostics and Performance","role":"article"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptAnnotations":{"kind":"article","abstract":[{"text":"Choose an annotation by the declaration it describes. Annotation arguments","type":"text"},{"text":" ","type":"text"},{"text":"are literals, identifiers, or lists of those values, not runtime expressions.","type":"text"},{"text":" ","type":"text"},{"text":"The same spelling can have different roles: ","type":"text"},{"code":"@component","type":"codeVoice"},{"text":" declares a struct,","type":"text"},{"text":" ","type":"text"},{"text":"while ","type":"text"},{"code":"@component(required: true)","type":"codeVoice"},{"text":" binds an existing component to a scriptable","type":"text"},{"text":" ","type":"text"},{"text":"instance.","type":"text"}],"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","type":"topic","url":"\/documentation\/adascripting\/adascriptannotations","title":"Ada Script Annotation Reference","role":"article"}}}