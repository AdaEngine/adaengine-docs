erial.color = .blue","","\/\/ Pass new value into material using string literals","\/\/ In this case we should think about correct name of uniform member.","customMaterial.setValue(Color.blue, for: \"u_Color\")"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"topicSections":[{"generated":true,"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial\/init(_:)","doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial\/init(from:)","doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial\/init(wrappedValue:)"]},{"generated":true,"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial\/material","doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial\/projectedValue","doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial\/wrappedValue"]},{"generated":true,"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial\/collectDefines(for:keys:)","doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial\/configureRenderPipeline(for:keys:shaderModule:)","doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial\/makeShaderModule(defines:)","doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial\/update()"]},{"generated":true,"title":"Subscripts","anchor":"Subscripts","identifiers":["doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial\/subscript(dynamicMember:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial"},"hierarchy":{"paths":[["doc:\/\/AdaRender\/documentation\/AdaRender"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"CustomMaterial"}],"modules":[{"name":"AdaRender"}],"roleHeading":"Class","symbolKind":"class","navigatorTitle":