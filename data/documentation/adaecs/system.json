              \/\/ if space button pressed","                transform.position.y += 5","            }","        }","    }","}",""],"syntax":"swift","type":"codeListing"}]}],"kind":"symbol","references":{"doc://AdaECS/documentation/AdaECS/System/dependencies":{"title":"dependencies","kind":"symbol","role":"symbol","required":true,"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dependencies","kind":"identifier"},{"text":": [","kind":"text"},{"text":"SystemDependency","preciseIdentifier":"s:6AdaECS16SystemDependencyO","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"defaultImplementations":1,"abstract":[{"text":"An array of dependencies for this system.","type":"text"}],"type":"topic","identifier":"doc:\/\/AdaECS\/documentation\/AdaECS\/System\/dependencies","url":"\/documentation\/adaecs\/system\/dependencies"},"doc://AdaECS/documentation/AdaECS/System/init(world:)":{"type":"topic","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"world"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"World","preciseIdentifier":"s:6AdaECS5WorldC"},{"kind":"text","text":")"}],"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Creates a new system."}],"url":"\/documentation\/adaecs\/system\/init(world:)","title":"init(world:)","identifier":"doc:\/\/AdaECS\/documentation\/AdaECS\/System\/init(world:)","required":true},"doc://AdaECS/documentation/AdaECS/DefaultSchedulerRunner":{"type":"topic","abstract":[{"type":"text","text":"A system that runs the default scheduler."}],"url":"\/documentation\/adaecs\/defaultschedulerrunner","kind":"symbol","identifier":"doc:\/\/AdaECS\/documentation\/AdaECS\/DefaultSchedulerRunner","navigatorTitle":[{"text":"DefaultSchedulerRunner","kind":"identifier"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","tex