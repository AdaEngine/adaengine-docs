alls statically linked AOT module metadata and native callbacks into the"},{"type":"text","text":" "},{"type":"text","text":"existing ECS scheduler. Compilation and foreign-runtime ownership stay in Gravity."}],"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptNativePlugin","kind":"identifier"}],"navigatorTitle":[{"text":"AdaScriptNativePlugin","kind":"identifier"}],"type":"topic","url":"\/documentation\/adascripting\/adascriptnativeplugin","kind":"symbol","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptNativePlugin"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptViewScanner":{"title":"AdaScriptViewScanner","abstract":[{"type":"text","text":"Finds "},{"code":"@view","type":"codeVoice"},{"type":"text","text":" declarations without executing their source."}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptViewScanner","kind":"identifier"}],"navigatorTitle":[{"text":"AdaScriptViewScanner","kind":"identifier"}],"type":"topic","url":"\/documentation\/adascripting\/adascriptviewscanner","kind":"symbol","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptViewScanner"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptViewEnvironment":{"navigatorTitle":[{"text":"AdaScriptViewEnvironment","kind":"identifier"}],"role":"symbol","kind":"symbol","abstract":[],"title":"AdaScriptViewEnvironment","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptViewEnvironment","kind":"identifier"}],"url":"\/documentation\/adascripting\/adascriptviewenvironment","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptViewEnvironment"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptObjectReloadCandidate":{"title":"AdaScriptObjectReloadCandidate","abstract":[{"type":"text","text":"A validated VM generation for scriptable objects, activate