{"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine","paths":[["doc:\/\/AdaEngine\/tutorials\/AdaEngine","doc:\/\/AdaEngine\/tutorials\/AdaEngine\/$volume","doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project."]],"modules":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project.","projects":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject","sections":[{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject#Create-project-using-Xcode"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene","sections":[{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Intro"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-an-app"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-a-main-camera"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#First-sprite"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Make-it-move"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Player-component","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Text-component","kind":"task"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Base-of-Event-Subscriber-pattern","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Subscribe-to-scene-events","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Type-of-events","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Additional-for-physics","kind":"task"}]}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UI-and-Input","projects":[{"sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Create-the-app-shell","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Layout-with-stacks","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Add-a-button-and-state","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Debug-overlays","kind":"task"}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics"},{"sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-the-view","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Prepare-layout-helpers","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-a-custom-TextRenderer","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Apply-and-animate","kind":"task"}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText"},{"sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Set-up-the-world","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Create-the-input-system","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Read-buttons","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Move-and-rumble","kind":"task"}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput"}]}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/adaengine\/createfirst2dscene"]}],"kind":"project","sections":[{"title":"Create your first 2D scene","content":[{"type":"paragraph","inlineContent":[{"text":"In this tutorial, you will learn how to create your first 2D scene using Ada.","type":"text"}]}],"kind":"hero","chapter":"Create your first 2D game project.","estimatedTimeInMinutes":20,"xcodeRequirement":"Xcode 26.2 or later"},{"kind":"tasks","tasks":[{"contentSection":[{"content":[{"inlineContent":[{"type":"text","text":"For the first 2D scene, we will try to repeat this example. We’ll look at adding a scene and a camera."},{"text":" ","type":"text"},{"type":"text","text":"In addition, we’ll learn how to add sprites and movement systems."}],"type":"paragraph"}],"media":"CF2G-3-5.mov","kind":"contentAndMedia","mediaPosition":"trailing"}],"stepsSection":[],"anchor":"Intro","title":"Intro"},{"contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"First, we need to create base files to launch our application."}]}]}],"title":"Create an app","stepsSection":[{"content":[{"inlineContent":[{"text":"In the previous tutorial, we’ve created an app and an empty window scene.","type":"text"}],"type":"paragraph"}],"runtimePreview":null,"caption":[],"type":"step","code":"CF2G-1-1-app.swift","media":null},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Let’s create the game logic. To do this, let’s create a file named "},{"code":"FirstScene.swift","type":"codeVoice"},{"type":"text","text":" and import AdaEngine."},{"type":"text","text":" "},{"type":"text","text":"After that, create a struct named "},{"code":"FirstScene","type":"codeVoice"},{"type":"text","text":" that conforms to "},{"code":"Plugin","type":"codeVoice"},{"type":"text","text":" and add a method named "},{"code":"setup(in app: AppWorlds)","type":"codeVoice"},{"text":" where we will set up entities in our game world.","type":"text"}]}],"runtimePreview":null,"caption":[],"type":"step","code":"CF2G-1-2-scene.swift","media":null},{"media":null,"content":[{"inlineContent":[{"type":"text","text":"Now add the "},{"type":"codeVoice","code":"FirstScene"},{"type":"text","text":" plugin to the app using the "},{"type":"codeVoice","code":"addPlugins"},{"type":"text","text":" method."}],"type":"paragraph"}],"code":"CF2G-1-4-app.swift","type":"step","runtimePreview":null,"caption":[]}],"anchor":"Create-an-app"},{"title":"Create a main camera.","anchor":"Create-a-main-camera","contentSection":[{"mediaPosition":"trailing","content":[{"inlineContent":[{"type":"text","text":"Ada uses the Entity Component System paradigm where all game objects are called "},{"type":"codeVoice","code":"Entity"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Entities are objects that store user or engine data like position, scale, mesh instance, audio, etc. This data is called components, and they should conform to the "},{"type":"codeVoice","code":"Component"},{"type":"text","text":" protocol."},{"type":"text","text":" "},{"type":"text","text":"By default, "},{"type":"codeVoice","code":"Entity"},{"type":"text","text":" is an empty object without any components."}],"type":"paragraph"}],"kind":"contentAndMedia"},{"content":[{"type":"paragraph","inlineContent":[{"code":"Camera","type":"codeVoice"},{"type":"text","text":" is a component that determines where all entities will be rendered. Ada supports rendering to a texture or to the "},{"code":"Window","type":"codeVoice"},{"type":"text","text":". We recommend using engine component bundles like "},{"code":"Camera2D","type":"codeVoice"},{"type":"text","text":" or "},{"code":"Camera3D","type":"codeVoice"},{"type":"text","text":", because the engine provides additional components for rendering and audio capabilities."}]}],"kind":"fullWidth"}],"stepsSection":[{"runtimePreview":null,"media":null,"content":[{"inlineContent":[{"text":"Let’s create our 2D camera. Spawn an entity with the ","type":"text"},{"type":"codeVoice","code":"Camera2D"},{"text":" bundle.","type":"text"}],"type":"paragraph"}],"code":"CF2G-2-1-camera.swift","type":"step","caption":[]},{"runtimePreview":"CF2G-2-1.png","media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Now let’s fill the camera background with a sky blue color."}]}],"code":"CF2G-2-2-camera.swift","type":"step","caption":[]}]},{"stepsSection":[{"caption":[],"media":"CF2G-3-1.png","code":null,"runtimePreview":null,"type":"step","content":[{"inlineContent":[{"text":"First, we should create an assets folder where we will store our game assets, like sprite sheets, sounds, shaders, etc. Let’s create a folder named ","type":"text"},{"type":"codeVoice","code":"Assets"},{"type":"text","text":" and add any sprite sheets you want. We will use this sprite sheet:"}],"type":"paragraph"}]},{"caption":[{"inlineContent":[{"type":"text","text":"You can download this texture by right-clicking on the image and saving it to the downloads folder."}],"type":"paragraph"}],"media":"CF2G-3-2.png","type":"step","code":null,"runtimePreview":null,"content":[{"inlineContent":[{"type":"text","text":"In the end, we should have this file structure in our project. Ada doesn’t use xcassets."}],"type":"paragraph"}]},{"caption":[],"media":null,"type":"step","code":"CF2G-3-1-sprite.swift","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Spawn a player entity in the game world. The player entity will store our sprite component and other player data in the future."}]}]},{"caption":[],"media":null,"type":"step","code":"CF2G-3-2-sprite.swift","runtimePreview":null,"content":[{"inlineContent":[{"text":"Let’s create an image from a file using a special resource manager object. ","type":"text"},{"code":"AssetsManager","type":"codeVoice"},{"text":" manages and caches game and engine resources. In our case, we should load an image from a file named ","type":"text"},{"code":"characters_packed.png","type":"codeVoice"},{"type":"text","text":" and use "},{"type":"codeVoice","code":"Bundle.main"},{"type":"text","text":" as a search path."}],"type":"paragraph"}]},{"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"To split the sprite sheet image into sprites, we can use the ","type":"text"},{"code":"TextureAtlas","type":"codeVoice"},{"text":" object. This object takes an image, sprite size, and margin between sprites if needed. In our case, we have a margin between sprites of 4px horizontally and 1px vertically, and a sprite size of 20px width and 23px height.","type":"text"}]}],"caption":[],"code":"CF2G-3-3-sprite.swift","runtimePreview":null,"media":null},{"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Now we can add our sprite to the player entity using the ","type":"text"},{"code":"Sprite","type":"codeVoice"},{"text":" component. This component is efficient for rendering because it uses a special batching system and requires fewer drawing calls.","type":"text"}]}],"caption":[{"type":"paragraph","inlineContent":[{"text":"Add a new sprite component to the entity in the ","type":"text"},{"code":"spawn","type":"codeVoice"},{"text":" method. As you can see, we use subscripts in our ","type":"text"},{"code":"TextureAtlas","type":"codeVoice"},{"text":" instance where 7 is the column number in our sprite sheet and 1 is the row number.","type":"text"}]}],"code":"CF2G-3-4-sprite.swift","runtimePreview":"CF2G-3-3.png","media":null},{"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"And finally, let’s add a special "},{"type":"codeVoice","code":"Transform"},{"type":"text","text":" component that describes the position of our entity on the screen."}]}],"caption":[],"code":"CF2G-3-5-sprite.swift","runtimePreview":"CF2G-3-4.png","media":null}],"anchor":"First-sprite","contentSection":[{"content":[{"inlineContent":[{"text":"Now we can create our first custom sprite.","type":"text"}],"type":"paragraph"}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"title":"First sprite"},{"stepsSection":[{"type":"step","code":"CF2G-4-1-player.swift","runtimePreview":null,"media":null,"caption":[],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"First, we should create a special tag component named "},{"type":"codeVoice","code":"PlayerComponent"},{"text":". We will use this component in the near future; it indicates that this entity is a player.","type":"text"}]}]},{"type":"step","code":"CF2G-4-2-player.swift","runtimePreview":null,"media":null,"caption":[],"content":[{"inlineContent":[{"type":"text","text":"Create a new function named "},{"type":"codeVoice","code":"PlayerMovement"},{"type":"text","text":" and annotate this function with the "},{"type":"codeVoice","code":"System"},{"type":"text","text":" macro. This system will listen to user inputs and move our player component on the screen."}],"type":"paragraph"}]},{"code":"CF2G-4-3-player.swift","media":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Add the new system to our game scene. The ","type":"text"},{"code":"System","type":"codeVoice"},{"text":" macro will create a new system with the same name as the function with the suffix ","type":"text"},{"code":"System","type":"codeVoice"},{"text":". Our system will be initialized once on app launch.","type":"text"}]}],"caption":[],"runtimePreview":null,"type":"step"},{"code":"CF2G-4-4-player.swift","media":null,"content":[{"inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"PlayerMovementSystem"},{"type":"text","text":", add a new function parameter named "},{"type":"codeVoice","code":"playerTransform"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"FilterQuery<Ref<Transform>, With<PlayerComponent>>"},{"type":"text","text":" type."},{"type":"text","text":" "},{"type":"text","text":"This object will query the world and return components that conform to your predicate. In our case, we require one mutable component "},{"type":"codeVoice","code":"Transform"},{"type":"text","text":" and a filter that indicates we need entities with the "},{"type":"codeVoice","code":"PlayerComponent"},{"type":"text","text":"."}],"type":"paragraph"}],"caption":[],"runtimePreview":null,"type":"step"},{"code":"CF2G-4-5-player.swift","media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a new function parameter named "},{"type":"codeVoice","code":"speed"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"Local<Float>"},{"type":"text","text":" type. This is a special type that stores a value available only within the system."}]}],"caption":[],"runtimePreview":null,"type":"step"},{"inlineContent":[{"type":"text","text":"Now we can update our player position. Ada can handle keyboard inputs for us. We should listen to keyboard inputs, and if a key is pressed, we should change the player transform."}],"type":"paragraph"},{"code":"CF2G-4-6-player.swift","runtimePreview":null,"caption":[{"inlineContent":[{"type":"text","text":"Using the special "},{"type":"codeVoice","code":"Input"},{"type":"text","text":" object, we can check if a key is pressed."},{"type":"text","text":" "},{"type":"text","text":"Add an "},{"type":"codeVoice","code":"if"},{"type":"text","text":" condition where we will listen to the "},{"type":"codeVoice","code":"w"},{"type":"text","text":" key. If the key is pressed, add the speed multiplied by delta time. We do this for a smooth transition between frames."}],"type":"paragraph"}],"media":null,"content":[{"inlineContent":[{"type":"text","text":"Let’s add a new function parameter named "},{"type":"codeVoice","code":"deltaTime"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"Res<DeltaTime>"},{"type":"text","text":" type and "},{"type":"codeVoice","code":"input"},{"type":"text","text":" with "},{"type":"codeVoice","code":"Res<Input>"},{"type":"text","text":". These are queries to resources in the world."}],"type":"paragraph"}],"type":"step"},{"code":"CF2G-4-7-player.swift","runtimePreview":"CF2G-3-5.mov","caption":[{"type":"paragraph","inlineContent":[{"text":"Run the app and try to move your player.","type":"text"}]}],"media":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Finally, add the same logic for other keys — ","type":"text"},{"code":"a","type":"codeVoice"},{"text":", ","type":"text"},{"code":"s","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"d","type":"codeVoice"},{"text":".","type":"text"}]}],"type":"step"}],"contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"inlineContent":[{"type":"text","text":"We did a lot of work, but our scene looks very simple. We should add more life to our player entity. All game logic is described in special objects named "},{"type":"codeVoice","code":"System"},{"type":"text","text":". A system is a unit that executes each game loop and manipulates entities and their data. We will use one to add life to our player."}],"type":"paragraph"}]}],"anchor":"Make-it-move","title":"Make it move"}]},{"abstract":[{"text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene.","type":"text"}],"action":{"isActive":true,"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText","overridingTitle":"Get started","type":"reference","overridingTitleInlineContent":[{"text":"Get started","type":"text"}]},"kind":"callToAction","title":"Player and Text in Ada","featuredEyebrow":"Tutorial"}],"metadata":{"categoryPathComponent":"AdaEngine","role":"project","title":"Create your first 2D scene","category":"Ada"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene"},"references":{"CF2G-1-2-scene.swift":{"fileName":"FirstScene.swift","identifier":"CF2G-1-2-scene.swift","syntax":"swift","content":["import AdaEngine","","struct FirstScene: Plugin {","    func setup(in _: AppWorlds) {","","    }","}"],"highlights":[],"type":"file","fileType":"swift"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Read-buttons":{"abstract":[{"text":"Build a small scene that spawns a player entity and moves it with a gamepad.","type":"text"}],"role":"pseudoSymbol","kind":"section","url":"\/tutorials\/adaengine\/gamepadinput#Read-buttons","type":"section","title":"Read buttons","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Read-buttons"},"CF2G-4-1-player.swift":{"fileName":"FirstScene.swift","syntax":"swift","identifier":"CF2G-4-1-player.swift","content":["import AdaEngine","","struct FirstScene: Plugin {","    func setup(in app: AppWorlds) {","        let camera = Camera()","        camera.backgroundColor = Color(45 \/ 255, 171 \/ 255, 255 \/ 255, 1)","        app.spawn(bundle: Camera2D(camera: camera))","","        let spriteSheetImage = try! AssetsManager.loadSync(Image.self, at: \"@res:\/\/characters_packed.png\").asset!","        let spriteSheet = TextureAtlas(from: spriteSheetImage, size: [20, 23], margin: [4, 1])","","        app.spawn(\"Player\") {","            Sprite(","                texture: spriteSheet[7, 1],","                size: Size(width: 24, height: 24)","            )","            Transform()","            PlayerComponent()","        }","    }","}","","@Component","struct PlayerComponent {}"],"highlights":[],"type":"file","fileType":"swift"},"CF2G-2-2-camera.swift":{"syntax":"swift","fileName":"FirstScene.swift","content":["import AdaEngine","","struct FirstScene: Plugin {","    func setup(in app: AppWorlds) {","        let camera = Camera()","        camera.backgroundColor = Color(45 \/ 255, 171 \/ 255, 255 \/ 255, 1)","        app.spawn(bundle: Camera2D(camera: camera))","    }","}"],"type":"file","fileType":"swift","highlights":[{"line":5},{"line":6},{"line":7}],"identifier":"CF2G-2-2-camera.swift"},"Xcode 26.2 or later":{"type":"xcodeRequirement","identifier":"Xcode 26.2 or later","title":"Xcode 26.2 or later","url":"https:\/\/developer.apple.com\/download\/"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Subscribe-to-scene-events":{"role":"pseudoSymbol","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Subscribe-to-scene-events","url":"\/tutorials\/adaengine\/eventlisteners#Subscribe-to-scene-events","kind":"section","abstract":[{"type":"text","text":"In this tutorial you will learn about the event listeners system in Ada."},{"type":"text","text":" "},{"type":"text","text":"How can you catch events and process them"}],"type":"section","title":"Subscribe to scene events"},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Create-a-custom-TextRenderer":{"abstract":[{"text":"Create a custom ","type":"text"},{"code":"TextRenderer","type":"codeVoice"},{"text":" that draws text along a sine wave and animate it by updating renderer state.","type":"text"}],"role":"pseudoSymbol","kind":"section","url":"\/tutorials\/adaengine\/animatedtext#Create-a-custom-TextRenderer","type":"section","title":"Create a custom TextRenderer","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-a-custom-TextRenderer"},"CF2G-3-2.png":{"type":"image","identifier":"CF2G-3-2.png","alt":"Our sprite sheet","variants":[{"url":"\/images\/AdaEngine\/CF2G-3-2.png","traits":["1x","light"]}]},"doc://AdaEngine/tutorials/AdaEngine/UIBasics":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics","url":"\/tutorials\/adaengine\/uibasics","role":"project","type":"topic","title":"UI Basics","kind":"project","estimatedTime":"15min","abstract":[{"type":"text","text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state."}]},"CF2G-4-7-player.swift":{"fileName":"FirstScene.swift","syntax":"swift","content":["import AdaEngine","","struct FirstScene: Plugin {","    func setup(in _: AppWorlds) {","        \/** Collapsed code *\/","    }","}","","@Component","struct PlayerComponent {}","","@System","func PlayerMovement(","    _ playerTransform: FIlterQuery<Ref<Transform>, With<PlayerComponent>>,","    _ speed: Local<Float> = 3.0,","    _ deltaTime: Res<DeltaTime>,","    _ input: Res<Input>",") {","    playerTransform.forEach { transform in","        if input.wrappedValue.isKeyPressed(.w) {","            transform.position.y += speed.wrappedValue * deltaTime.wrappedValue.deltaTime","        }","","        if input.wrappedValue.isKeyPressed(.s) {","            transform.position.y -= speed.wrappedValue * deltaTime.wrappedValue.deltaTime","        }","","        if input.wrappedValue.isKeyPressed(.a) {","            transform.position.x -= speed.wrappedValue * deltaTime.wrappedValue.deltaTime","        }","","        if input.wrappedValue.isKeyPressed(.d) {","            transform.position.x += speed.wrappedValue * deltaTime.wrappedValue.deltaTime","        }","    }","}"],"identifier":"CF2G-4-7-player.swift","highlights":[{"line":23},{"line":24},{"line":25},{"line":26},{"line":27},{"line":28},{"line":29},{"line":30},{"line":31},{"line":32},{"line":33},{"line":34}],"type":"file","fileType":"swift"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners","abstract":[{"text":"In this tutorial you will learn about the event listeners system in Ada.","type":"text"},{"text":" ","type":"text"},{"text":"How can you catch events and process them","type":"text"}],"role":"project","kind":"project","title":"Event Listeners in Ada","type":"topic","url":"\/tutorials\/adaengine\/eventlisteners","estimatedTime":"5min"},"doc://AdaEngine/tutorials/AdaEngine":{"abstract":[{"type":"text","text":"Learn the basics of Ada and start developing your own games!"}],"role":"overview","kind":"overview","url":"\/tutorials\/adaengine","type":"topic","title":"Meet Ada","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine"},"CF2G-3-1.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/AdaEngine\/CF2G-3-1.png"}],"type":"image","alt":"Our sprite sheet","identifier":"CF2G-3-1.png"},"CF2G-3-4-sprite.swift":{"syntax":"swift","fileName":"FirstScene.swift","content":["import AdaEngine","","struct FirstScene: Plugin {","    func setup(in app: AppWorlds) {","        let camera = Camera()","        camer