{"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AdaRender\/documentation\/AdaRender","doc:\/\/AdaRender\/documentation\/AdaRender\/BlendOperation"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/AdaRender\/documentation\/AdaRender\/BlendOperation\/subtract","interfaceLanguage":"swift"},"metadata":{"externalID":"s:9AdaRender14BlendOperationO8subtractyA2CmF","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"subtract","kind":"identifier"}],"roleHeading":"Case","symbolKind":"case","modules":[{"name":"AdaRender"}],"role":"symbol","title":"BlendOperation.subtract"},"abstract":[{"type":"text","text":"Subtract a portion of the destination pixel values from a portion of the source."}],"variants":[{"paths":["\/documentation\/adarender\/blendoperation\/subtract"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"subtract"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"RGB = Source.rgb * SBF - Dest.rgb * DBF","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A = Source.a * SBF - Dest.a * DBF"}]}]}],"references":{"doc://AdaRender/documentation/AdaRender/BlendOperation/subtract":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"subtract","kind":"identifier"}],"type":"topic","url":"\/documentation\/adarender\/blendoperation\/subtract","kind":"symbol","identifier":"doc:\/\/AdaRender\/documentation\/AdaRender\/BlendOperation\/subtract","title":"BlendOperation.subtract","role":"symbol","abstract":[{"text":"Subtract a portion of the destination pixel values from a portion of the source.","type":"text"}]},"doc://AdaRender/documentation/AdaRender/Ble