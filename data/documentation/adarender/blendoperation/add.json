kind":"text","text":" "},{"kind":"identifier","text":"add"}],"role":"symbol"},"doc://AdaRender/documentation/AdaRender/BlendOperation":{"url":"\/documentation\/adarender\/blendoperation","abstract":[{"type":"text","text":"For every pixel, "},{"type":"reference","identifier":"doc:\/\/AdaRender\/documentation\/AdaRender\/BlendOperation","isActive":true},{"type":"text","text":" determines how to combine and weight the source fragment values with the destination values."},{"type":"text","text":" "},{"type":"text","text":"Some blend operations multiply the source values by a source blend factor (SBF),"},{"type":"text","text":" "},{"type":"text","text":"multiply the destination values by a destination blend factor (DBF), and then combine the results using addition or subtraction."},{"type":"text","text":" "},{"type":"text","text":"Other blend operations use either a minimum or maximum function to determine the result."}],"kind":"symbol","type":"topic","role":"symbol","title":"BlendOperation","identifier":"doc:\/\/AdaRender\/documentation\/AdaRender\/BlendOperation","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BlendOperation","kind":"identifier"}],"navigatorTitle":[{"text":"BlendOperation","kind":"identifier"}]}}}