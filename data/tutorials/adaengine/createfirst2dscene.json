{"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/AdaEngine\/tutorials\/AdaEngine","doc:\/\/AdaEngine\/tutorials\/AdaEngine\/$volume","doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project."]],"modules":[{"projects":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject#Create-project-using-Xcode","kind":"task"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Intro","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-an-app","kind":"task"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-a-main-camera"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#First-sprite"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Make-it-move"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Player-component","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Text-component","kind":"task"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners","sections":[{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Base-of-Event-Subscriber-pattern"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Subscribe-to-scene-events"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Type-of-events"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Additional-for-physics"}]}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project."},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UI-and-Input","projects":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics","sections":[{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Create-the-app-shell"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Layout-with-stacks"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Add-a-button-and-state"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Debug-overlays"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-the-view","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Prepare-layout-helpers","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-a-custom-TextRenderer","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Apply-and-animate","kind":"task"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput","sections":[{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Set-up-the-world"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Create-the-input-system"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Read-buttons"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Move-and-rumble"}]}]}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine"},"kind":"project","sections":[{"chapter":"Create your first 2D game project.","estimatedTimeInMinutes":20,"xcodeRequirement":"Xcode 26.2 or later","content":[{"inlineContent":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}],"type":"paragraph"}],"title":"Create your first 2D scene","kind":"hero"},{"tasks":[{"title":"Intro","contentSection":[{"media":"CF2G-3-5.mov","mediaPosition":"trailing","content":[{"inlineContent":[{"text":"For the first 2D scene, we will try to repeat this example. We’ll look at adding a scene and a camera.","type":"text"},{"text":" ","type":"text"},{"text":"In addition, we’ll learn how to add sprites and movement systems.","type":"text"}],"type":"paragraph"}],"kind":"contentAndMedia"}],"anchor":"Intro","stepsSection":[]},{"title":"Create an app","contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"First, we need to create base files to launch our application."}]}]}],"anchor":"Create-an-app","stepsSection":[{"media":null,"type":"step","runtimePreview":null,"code":"CF2G-1-1-app.swift","content":[{"inlineContent":[{"text":"In the previous tutorial, we’ve created an app and an empty window scene.","type":"text"}],"type":"paragraph"}],"caption":[]},{"media":null,"type":"step","runtimePreview":null,"code":"CF2G-1-2-scene.swift","content":[{"type":"paragraph","inlineContent":[{"text":"Let’s create the game logic. To do this, let’s create a file named ","type":"text"},{"code":"FirstScene.swift","type":"codeVoice"},{"text":" and import AdaEngine.","type":"text"},{"text":" ","type":"text"},{"text":"After that, create a struct named ","type":"text"},{"code":"FirstScene","type":"codeVoice"},{"text":" that conforms to ","type":"text"},{"code":"Plugin","type":"codeVoice"},{"text":" and add a method named ","type":"text"},{"code":"setup(in app: AppWorlds)","type":"codeVoice"},{"type":"text","text":" where we will set up entities in our game world."}]}],"caption":[]},{"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Now add the ","type":"text"},{"type":"codeVoice","code":"FirstScene"},{"text":" plugin to the app using the ","type":"text"},{"type":"codeVoice","code":"addPlugins"},{"text":" method.","type":"text"}]}],"caption":[],"media":null,"code":"CF2G-1-4-app.swift","runtimePreview":null}]},{"title":"Create a main camera.","stepsSection":[{"code":"CF2G-2-1-camera.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Let’s create our 2D camera. Spawn an entity with the "},{"type":"codeVoice","code":"Camera2D"},{"text":" bundle.","type":"text"}]}],"caption":[],"type":"step","runtimePreview":null,"media":null},{"caption":[],"media":null,"code":"CF2G-2-2-camera.swift","type":"step","content":[{"inlineContent":[{"text":"Now let’s fill the camera background with a sky blue color.","type":"text"}],"type":"paragraph"}],"runtimePreview":"CF2G-2-1.png"}],"contentSection":[{"content":[{"inlineContent":[{"type":"text","text":"Ada uses the Entity Component System paradigm where all game objects are called "},{"code":"Entity","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Entities are objects that store user or engine data like position, scale, mesh instance, audio, etc. This data is called components, and they should conform to the "},{"code":"Component","type":"codeVoice"},{"type":"text","text":" protocol."},{"type":"text","text":" "},{"type":"text","text":"By default, "},{"code":"Entity","type":"codeVoice"},{"type":"text","text":" is an empty object without any components."}],"type":"paragraph"}],"kind":"contentAndMedia","mediaPosition":"trailing"},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Camera"},{"type":"text","text":" is a component that determines where all entities will be rendered. Ada supports rendering to a texture or to the "},{"type":"codeVoice","code":"Window"},{"type":"text","text":". We recommend using engine component bundles like "},{"type":"codeVoice","code":"Camera2D"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Camera3D"},{"type":"text","text":", because the engine provides additional components for rendering and audio capabilities."}],"type":"paragraph"}],"kind":"fullWidth"}],"anchor":"Create-a-main-camera"},{"anchor":"First-sprite","title":"First sprite","contentSection":[{"mediaPosition":"trailing","content":[{"inlineContent":[{"type":"text","text":"Now we can create our first custom sprite."}],"type":"paragraph"}],"kind":"contentAndMedia"}],"stepsSection":[{"code":null,"caption":[],"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"First, we should create an assets folder where we will store our game assets, like sprite sheets, sounds, shaders, etc. Let’s create a folder named "},{"code":"Assets","type":"codeVoice"},{"type":"text","text":" and add any sprite sheets you want. We will use this sprite sheet:"}]}],"runtimePreview":null,"media":"CF2G-3-1.png"},{"code":null,"caption":[{"inlineContent":[{"type":"text","text":"You can download this texture by right-clicking on the image and saving it to the downloads folder."}],"type":"paragraph"}],"type":"step","content":[{"inlineContent":[{"type":"text","text":"In the end, we should have this file structure in our project. Ada doesn’t use xcassets."}],"type":"paragraph"}],"runtimePreview":null,"media":"CF2G-3-2.png"},{"code":"CF2G-3-1-sprite.swift","caption":[],"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Spawn a player entity in the game world. The player entity will store our sprite component and other player data in the future.","type":"text"}]}],"runtimePreview":null,"media":null},{"code":"CF2G-3-2-sprite.swift","caption":[],"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Let’s create an image from a file using a special resource manager object. ","type":"text"},{"code":"AssetsManager","type":"codeVoice"},{"text":" manages and caches game and engine resources. In our case, we should load an image from a file named ","type":"text"},{"code":"characters_packed.png","type":"codeVoice"},{"text":" and use ","type":"text"},{"code":"Bundle.main","type":"codeVoice"},{"text":" as a search path.","type":"text"}]}],"runtimePreview":null,"media":null},{"code":"CF2G-3-3-sprite.swift","caption":[],"type":"step","content":[{"inlineContent":[{"text":"To split the sprite sheet image into sprites, we can use the ","type":"text"},{"type":"codeVoice","code":"TextureAtlas"},{"type":"text","text":" object. This object takes an image, sprite size, and margin between sprites if needed. In our case, we have a margin between sprites of 4px horizontally and 1px vertically, and a sprite size of 20px width and 23px height."}],"type":"paragraph"}],"runtimePreview":null,"media":null},{"code":"CF2G-3-4-sprite.swift","caption":[{"type":"paragraph","inlineContent":[{"text":"Add a new sprite component to the entity in the ","type":"text"},{"type":"codeVoice","code":"spawn"},{"text":" method. As you can see, we use subscripts in our ","type":"text"},{"type":"codeVoice","code":"TextureAtlas"},{"text":" instance where 7 is the column number in our sprite sheet and 1 is the row number.","type":"text"}]}],"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Now we can add our sprite to the player entity using the ","type":"text"},{"type":"codeVoice","code":"Sprite"},{"text":" component. This component is efficient for rendering because it uses a special batching system and requires fewer drawing calls.","type":"text"}]}],"runtimePreview":"CF2G-3-3.png","media":null},{"type":"step","media":null,"caption":[],"runtimePreview":"CF2G-3-4.png","code":"CF2G-3-5-sprite.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"And finally, let’s add a special "},{"type":"codeVoice","code":"Transform"},{"type":"text","text":" component that describes the position of our entity on the screen."}]}]}]},{"title":"Make it move","contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"text":"We did a lot of work, but our scene looks very simple. We should add more life to our player entity. All game logic is described in special objects named ","type":"text"},{"type":"codeVoice","code":"System"},{"text":". A system is a unit that executes each game loop and manipulates entities and their data. We will use one to add life to our player.","type":"text"}]}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"anchor":"Make-it-move","stepsSection":[{"content":[{"inlineContent":[{"text":"First, we should create a special tag component named ","type":"text"},{"type":"codeVoice","code":"PlayerComponent"},{"text":". We will use this component in the near future; it indicates that this entity is a player.","type":"text"}],"type":"paragraph"}],"type":"step","media":null,"code":"CF2G-4-1-player.swift","caption":[],"runtimePreview":null},{"content":[{"type":"paragraph","inlineContent":[{"text":"Create a new function named ","type":"text"},{"code":"PlayerMovement","type":"codeVoice"},{"text":" and annotate this function with the ","type":"text"},{"code":"System","type":"codeVoice"},{"text":" macro. This system will listen to user inputs and move our player component on the screen.","type":"text"}]}],"type":"step","media":null,"code":"CF2G-4-2-player.swift","caption":[],"runtimePreview":null},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the new system to our game scene. The ","type":"text"},{"type":"codeVoice","code":"System"},{"type":"text","text":" macro will create a new system with the same name as the function with the suffix "},{"type":"codeVoice","code":"System"},{"type":"text","text":". Our system will be initialized once on app launch."}]}],"type":"step","media":null,"code":"CF2G-4-3-player.swift","caption":[],"runtimePreview":null},{"caption":[],"content":[{"inlineContent":[{"text":"In ","type":"text"},{"code":"PlayerMovementSystem","type":"codeVoice"},{"text":", add a new function parameter named ","type":"text"},{"code":"playerTransform","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"FilterQuery<Ref<Transform>, With<PlayerComponent>>","type":"codeVoice"},{"text":" type.","type":"text"},{"text":" ","type":"text"},{"text":"This object will query the world and return components that conform to your predicate. In our case, we require one mutable component ","type":"text"},{"code":"Transform","type":"codeVoice"},{"text":" and a filter that indicates we need entities with the ","type":"text"},{"code":"PlayerComponent","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"code":"CF2G-4-4-player.swift","runtimePreview":null,"media":null,"type":"step"},{"caption":[],"content":[{"inlineContent":[{"text":"Add a new function parameter named ","type":"text"},{"code":"speed","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"Local<Float>","type":"codeVoice"},{"text":" type. This is a special type that stores a value available only within the system.","type":"text"}],"type":"paragraph"}],"code":"CF2G-4-5-player.swift","runtimePreview":null,"media":null,"type":"step"},{"inlineContent":[{"type":"text","text":"Now we can update our player position. Ada can handle keyboard inputs for us. We should listen to keyboard inputs, and if a key is pressed, we should change the player transform."}],"type":"paragraph"},{"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Using the special "},{"code":"Input","type":"codeVoice"},{"type":"text","text":" object, we can check if a key is pressed."},{"type":"text","text":" "},{"type":"text","text":"Add an "},{"code":"if","type":"codeVoice"},{"type":"text","text":" condition where we will listen to the "},{"code":"w","type":"codeVoice"},{"type":"text","text":" key. If the key is pressed, add the speed multiplied by delta time. We do this for a smooth transition between frames."}]}],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Let’s add a new function parameter named "},{"type":"codeVoice","code":"deltaTime"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"Res<DeltaTime>"},{"text":" type and ","type":"text"},{"type":"codeVoice","code":"input"},{"type":"text","text":" with "},{"code":"Res<Input>","type":"codeVoice"},{"type":"text","text":". These are queries to resources in the world."}]}],"code":"CF2G-4-6-player.swift","runtimePreview":null,"media":null,"type":"step"},{"runtimePreview":"CF2G-3-5.mov","type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Finally, add the same logic for other keys — ","type":"text"},{"code":"a","type":"codeVoice"},{"text":", ","type":"text"},{"code":"s","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"d","type":"codeVoice"},{"text":".","type":"text"}]}],"media":null,"code":"CF2G-4-7-player.swift","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Run the app and try to move your player."}]}]}]}],"kind":"tasks"},{"abstract":[{"type":"text","text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene."}],"kind":"callToAction","action":{"type":"reference","isActive":true,"overridingTitle":"Get started","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText","overridingTitleInlineContent":[{"type":"text","text":"Get started"}]},"title":"Player and Text in Ada","featuredEyebrow":"Tutorial"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/adaengine\/createfirst2dscene"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene"},"metadata":{"role":"project","category":"Ada","categoryPathComponent":"AdaEngine","title":"Create your first 2D scene"},"references":{"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Create-the-input-system":{"title":"Create the input system","kind":"section","type":"section","role":"pseudoSymbol","abstract":[{"text":"Build a small scene that spawns a player entity and moves it with a gamepad.","type":"text"}],"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Create-the-input-system","url":"\/tutorials\/adaengine\/gamepadinput#Create-the-input-system"},"doc://AdaEngine/tutorials/AdaEngi