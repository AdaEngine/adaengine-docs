{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/adaengine\/adaengine"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"https:\/\/github.com\/adaengine\/adaengine\/discussions","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"https:\/\/www.adaengine.org\/","isActive":true}]}]}]},{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Ada is a modern, open-source game engine written in Swift, designed for building 2D and 3D games with simplicity and performance in mind. Its architecture leverages the Entity Component System (ECS) paradigm, enabling developers to create games and interactive experiences using a modular and scalable approach.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ada provides a suite of built-in features, including:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"High-level rendering system supporting 2D and 3D graphics"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Physics, animation, input handling, audio, and UI systems","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Asset management pipeline and streamlined workflows","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Cross-platform support across Apple platforms and Linux","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Hot-reload capabilities for assets and scripts"}]}]},{"content":[{"inlineContent":[{"text":"Modern Swift API with async\/await, property wrappers, and result builders","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"With Ada, both beginners and experienced Swift developers can build games rapidly, focusing on gameplay instead of