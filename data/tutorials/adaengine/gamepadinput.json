ayout-helpers"},"GP-2-3-system.swift":{"syntax":"swift","content":["import AdaEngine","","@PlainSystem","struct GamepadInputSystem {","","    @FilterQuery<Ref<Transform>, With<PlayerComponent>>","    private var playerQuery","","    @Res<Input>","    private var input","","    @Res<DeltaTime>","    private var deltaTime","","    init(world: World) { }","","    func update(context: UpdateContext) {","        let gamepads = input.getConnectedGamepads()","","        if gamepads.isEmpty {","            return","        }","","        for gamepad in gamepads {","            if gamepad.isGamepadButtonPressed(.a) {","                print(\"Gamepad \\(gamepad.gamepadId): Button A pressed\")","            }","","            if gamepad.isGamepadButtonPressed(.b) {","                print(\"Gamepad \\(gamepad.gamepadId): Button B pressed\")","            }","        }","    }","}"],"identifier":"GP-2-3-system.swift","type":"file","fileName":"GamepadInputSystem.swift","fileType":"swift","highlights":[{"line":25},{"line":26},{"line":27},{"line":28},{"line":29},{"line":30},{"line":31}]},"doc://AdaEngine/tutorials/AdaEngine/CreateProject#Create-project-using-Xcode":{"role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject#Create-project-using-Xcode","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first AdaEngine project."}],"title":"Create project using Xcode","type":"section","url":"\/tutorials\/adaengine\/createproject#Create-project-using-Xcode"},"doc://AdaEngine/tutorials/AdaEngine/PlayerAndText#Add-Player-component":{"role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Player-component","abstract":[{"type":"text","text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene."}],"title":"Add Player component","type":"section","url":"\/tutorials\/adaengine\/playerandtext#Add-Player-component"},"GP-2-2-system.swift":{"syntax":"swift","content":["import AdaEngine","","@PlainSystem","struct GamepadInputSystem {","","    @FilterQuery<Ref<Transform>, With<PlayerComponent>>","    private var playerQuery","","    @Res<Input>","    private var input","","    @Res<DeltaTime>","    private var deltaTime","","    init(world: World) { }","","    func update(context: UpdateContext) {","        let gamepads = input.getConnectedGamepads()","","        if gamepads.isEmpty {","            return","        }","","        for gamepad in gamepads {","            \/\/ Handle per-gamepad input","        }","    }","}"],"identifier":"GP-2-2-system.swift","type":"file","fileName":"GamepadInputSystem.swift","fileType":"swift","highlights":[]},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Read-buttons":{"role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Read-buttons","abstract":[{"type":"text","text":"Build a small scene that spawns a player entity and moves it with a gamepad."}],"title":"Read buttons","type":"section","url":"\/tutorials\/adaengine\/gamepadinput#Read-buttons"},"GP-1-3-app.swift":{"syntax":"swift","content":["import AdaEngine","","@Component","struct PlayerComponent {}","","@main","struct GamepadInputApp: App {","    var body: some AppScene {","        DefaultAppWindow()","            .transformAppWorlds { appWorld in","                appWorld.spawn(","                    \"Camera\",","                    bundle: Camera2D(","                        camera: Camera(),","                        transform: Transform(position: [0, 0, 0])","                    )","                )","","                appWorld.spawn(\"Player\") {","                    PlayerComponent()","                    Transform(scale: .init(0.5))","                    Sprite(tintColor: .red)","                }","","                appWorld.addSystem(GamepadInputSystem.self)","            }","            .windowMode(.windowed)","            .windowTitle(\"Gamepad Input\")","    }","}"],"identifier":"GP-1-3-app.swift","type":"file","fileName":"GamepadInputApp.swift","fileType":"swift","highlights":[{"line":24},{"line":25}]},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Make-it-move":{"role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Make-it-move","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using AdaEngine."}],"title":"Make it move","type":"section","url":"\/tutorials\/adaengine\/createfirst2dscene#Make-it-move"},"doc://AdaEngine/tutorials/AdaEngine/PlayerAndText":{"estimatedTime":"5min","role":"project","kind":"project","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText","abstract":[{"type":"text","text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene."}],"title":"Player and Text in Ada Engine","type":"topic","url":"\/tutorials\/adaengine\/playerandtext"},"doc://AdaEngine/tutorials/AdaEngine/PlayerAndText#Add-Text-component":{"role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Text-component","abstract":[{"type":"text","text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene."}],"title":"Add Text component","type":"section","url":"\/tutorials\/adaengine\/playerandtext#Add-Text-component"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Base-of-Event-Subscriber-pattern":{"role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Base-of-Event-Subscriber-pattern","abstract":[{"type":"text","text":"In this tutorial you will learn about the event listeners system in Ada Engine."},{"type":"text","text":" "},{"type":"text","text":"How can you catch events and process them"}],"title":"Base of Event-Subscriber pattern","type":"section","url":"\/tutorials\/adaengine\/eventlisteners#Base-of-Event-Subscriber-pattern"},"GP-2-4-system.swift":{"syntax":"swift","content":["import AdaEngine","","@PlainSystem","struct GamepadInputSystem {","","    @FilterQuery<Ref<Transform>, With<PlayerComponent>>","    private var playerQuery","","    @Res<Input>","    private var input","","    @Res<DeltaTime>","    private var deltaTime","","    init(world: World) { }","","    func update(context: UpdateContext) {","        let gamepads = input.getConnectedGamepads()","","        if gamepads.isEmpty {","            return","        }","","        for gamepad in gamepads {","            let leftStickX = gamepad.getAxisValue(.leftStickX)","            let leftStickY = gamepad.getAxisValue(.leftStickY)","            let deadzone: Float = 0.1","","            if abs(leftStickX) > deadzone || abs(leftStickY) > deadzone {","                playerQuery.forEach { transform in","                    let speed: Float = 2.0","                    transform.position.x += leftStickX * Float(deltaTime.deltaTime) * speed","                    transform.position.y -= leftStickY * Float(deltaTime.deltaTime) * speed","                }","            }","        }","    }","}"],"identifier":"GP-2-4-system.swift","type":"file","fileName":"GamepadInputSystem.swift","fileType":"swift","highlights":[]},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Create-a-custom-TextRenderer":{"role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-a-custom-TextRenderer","abstract":[{"type":"text","text":"Create a custom "},{"code":"TextRenderer","type":"codeVoice"},{"type":"text","text":" that draws text along a sine wave and animate it by updating renderer state."}],"title":"Create a custom TextRenderer","type":"section","url":"\/tutorials\/adaengine\/animatedtext#Create-a-c