kind":"section","abstract":[{"text":"In this tutorial, you will learn how to create your first 2D scene using Ada.","type":"text"}],"title":"Create an app","type":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine","role":"overview","kind":"overview","title":"Meet Ada","abstract":[{"text":"Learn the basics of Ada and start developing your own games!","type":"text"}],"url":"\/tutorials\/adaengine","type":"topic"},"doc://AdaEngine/tutorials/AdaEngine/Create-your-first-2D-game-project.":{"url":"\/tutorials\/adaengine\/create-your-first-2d-game-project.","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project.","kind":"article","abstract":[],"title":"Create your first 2D game project.","type":"topic","role":"article"},"doc://AdaEngine/tutorials/AdaEngine/PlayerAndText#Add-Text-component":{"url":"\/tutorials\/adaengine\/playerandtext#Add-Text-component","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Text-component","kind":"section","abstract":[{"text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene.","type":"text"}],"title":"Add Text component","type":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics#Layout-with-stacks":{"url":"\/tutorials\/adaengine\/uibasics#Layout-with-stacks","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Layout-with-stacks","title":"Layout with stacks","abstract":[{"text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state.","type":"text"}],"kind":"section","type":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/PlayerAndText#Add-Player-component":{"url":"\/tutorials\/adaengine\/playerandtext#Add-Player-component","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Player-component","abstract":[{"text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene.","type":"text"}],"kind":"section","title":"Add Player component","type":"section","role":"pseudoSymbol"},"EL-2-4-events.swift":{"type":"file","content":["\/\/\/ Events the scene triggers.","public enum SceneEvents {","","    \/\/\/ An event triggered once when scene is ready to use and will starts update soon.","    public struct OnReady: Event {","        public let scene: Scene","    }","","    \/\/\/ Raised after an entity is added to the scene.","    public struct DidAddEntity: Event {","        public let entity: Entity","    }","","    \/\/\/ Raised before an entity is removed from the scene.","    public struct WillRemoveEntity: Event {","        public let entity: Entity","    }","","    \/\/\/ An event triggered once per frame interval that you can use to execute custom logic for each frame.","    public struct Update: Event {","","        \/\/\/ The updated scene.","        public let scene: Scene","","        \/\/\/ The elapsed time since the last update.","        public let deltaTime: TimeInterval","    }","}","","\/\/\/ Events associated with collisions.","public enum CollisionEvents {","","    \/\/\/ An event raised when two objects collide.","    public struct Began: Event {","","        \/\/\/ The first entity involved in the collision.","        public let entityA: Entity","","        \/\/\/ The second entity involved in the collision.","        public let entityB: Entity","","        \/\/\/ The estimated strength of the impact.","        public let impulse: Float","    }","","    \/\/\/ An event raised when two objects, previously in contact, separate.","    public struct Ended: Event {","","        \/\/\/ The first entity involved in the collision.","        public let entityA: Entity","","        \/\/\/ The second entity involved in the collision.","        public let entityB: Entity","    }","}"],"syntax":"swift","identifier":"EL-2-4-events.swift","fileType":"swift","highlights":[],"fileName":"Events.swift"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Read-buttons":{"url":"\/tutorials\/adaengine\/gamepadinput#Read-buttons","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Read-buttons","title":"Read buttons","abstract":[{"text":"Build a small scene that spawns a player entity and moves it with a gamepad.","type":"text"}],"kind":"section","type":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Create-a-main-camera":{"url":"\/tutorials\/adaengine\/createfirst2dscene#Create-a-main-camera","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-a-main-camera","abstract":[{"text":"In this tutorial, you will learn how to create your first 2D scene using Ada.","type":"text"}],"kind":"section","title":"Create a main camera.","type":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics":{"estimatedTime":"15min","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics","role":"project","kind":"project","title":"UI Basics","abstract":[{"text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state.","type":"text"}],"url":"\/tutorials\/adaengine\/uibasics","type":"topic"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Move-and-rumble":{"url":"\/tutorials\/adaengine\/gamepadinput#Move-and-rumble","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Move-and-rumble","title":"Move and rumble","kind":"section","abstract":[{"text":"Build a small scene that spawns a player entity and moves it with a gamepad.","type":"text"}],"type":"section","role":"pseudoSymbol"},"EL-1.jpg":{"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/AdaEngine\/EL-1.jpg"}],"alt":"Observer pattern scheme","identifier":"EL-1.jpg"},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText":{"estimatedTime":"20min","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText","role":"project","kind":"project","title":"Animated Text Renderer","abstract":[{"text":"Create a custom ","type":"text"},{"code":"TextRenderer","type":"codeVoice"},{"text":" that draws text along a sine wave and animate it by updating renderer state.","type":"text"}],"url":"\/tutorials\/adaengine\/animatedtext","type":"topic"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics#Debug-overlays":{"url":"\/tutorials\/adaengine\/uibasics#Debug-overlays","abstract":[{"text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state.","type":"text"}],"kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Debug-overlays","type":"section","role":"pseudoSymbol","title":"Debug overlays"},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Apply-and-animate":{"url":"\/tutorials\/adaengine\/animatedtext#Apply-and-animate","abstract":[{"text":"Create a custom ","type":"text"},{"type":"codeVoice","code":"TextRenderer"},{"text":" that draws text along a sine wave and animate it by updating renderer state.","type":"text"}],"kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Apply-and-animate","type":"section","role":"pseudoSymbol","title":"Apply and animate"},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Create-a-custom-TextRenderer":{"url":"\/tutorials\/adaengine\/animatedtext#Create-a-custom-TextRenderer","abstract":[{"text":"Create a custom ","type":"text"},{"type":"codeVoice","code":"TextRenderer"},{"text":" that draws text along a sine wave and animate it by updating renderer state.","type":"text"}],"kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-a-custom-TextRenderer","type":"section","role":"pseudoSymbol","title":"Create a custom TextRenderer"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Base-of-Event-Subscriber-pattern":{"url":"\/tutorials\/adaengine\/eventlisteners#Base-of-Event-Subscriber-pattern","abstract":[{"text":"In this tutorial you will learn about the event listeners system in Ada.","type":"text"},{"text":" ","type":"text"},{"text":"How can you catch events and process them","type":"text"}],"kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Base-of-Event-Subscriber-pattern","type":"section","role":"pseudoSymbol","title":"Base of Event-Subscriber pattern"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#First-sprite":{"url":"\/tutorials\/adaengine\/createfirst2dscene#First-sprite","abstract":[{"text":"In this tutorial, you will learn how to create your first 2D scene using Ada.","type":"text"}],"kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#First-sprite","type":"section","role":"pseudoSymbol","title":"First sprite"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics#Create-the-app-shell":{"url":"\/tutorials\/adaengine\/uibasics#Create-the-app-shell","abstract":[{"text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state.","type":"text"}],"kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Create-the-app-shell","type":"section","role":"pseudoSymbol","title":"Create the app shell"},"doc://AdaEngine/tutorials/AdaEngine/UI-and-Input":{"url":"\/tutorials\/adaengine\/ui-and-input","abstract":[],"kind":"article","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UI-and-Input","type":"topic","role":"article","title":"UI and Input"},"EL-2-3-scene.swift":{"type":"file","content":["import AdaEngine","","@MainActor","struct EventListenerPlugin: Plugin {","    @Local var disposeBag: Set<AnyCancellable> = []","","    func setup(in app: borrowing AppWorlds) {","        app.main","            .subscribe(to: SceneEvents.OnReady.self) { _ in","                \/\/ Handle event here!","            }","            .store(in: &self.disposeBag)","    }","}"],"syntax":"swift","fileType":"swift","identifier":"EL-2-3-scene.swift","highlights":[],"fileName":"EventListenerPlugin.swift"},"EL-2-5-physics.swift":{"type":"file","content":["import AdaEngine","","@MainActor","struct EventListenerPlugin: Plugin {","    @Local var disposeBag: Set<AnyCancellable> = []","","    func setup(in app: borrowing AppWorlds) {","        app.main","            .subscribe(to: SceneEvents.OnReady.self) { event in","                Task { @MainActor in","                    event.scene.world.physicsWorld2D?.gravity = .zero","                }","            }","            .store(in: &self.disposeBag)","    }","}"],"syntax":"swift","fileType":"swift","identifier":"EL-2-5-physics.swift","highlights":[],"fileName":"PhysicsHandler.swift"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene":{"estimatedTime":"20min","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene","role":"project","kind":"project","title":"Create your first 2D scene","abstract":[{"text":"In this tutorial, you will learn how to create your first 2D scene using Ada.","type":"text"}],"url":"\/tutorials\/adaengine\/createfirst2dscene","type":"topic"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Create-the-input-system":{"url":"\/tutorials\/adaengine\/gamepadinput#Create-the-input-system","abstract":[{"text":"Build a small scene that spawns a player entity and moves it with a gamepad.","type":"text"}],"kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Create-the-input-system","type":"section","role":"pseudoSymbol","title":"Create the input system"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Set-up-the-world":{"url":"\/tutorials\/adaengine\/gamepadinput#Set-up-the-world","abstract":[{"text":"Build a small scene that spawns a player entity and moves it with a gamepad.","type":"text"}],"kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Set-up-the-world","type":"section","role":"pseudoSymbol","title":"Set up the world"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput","url":"\/tutorials\/adaengine\/gamepadinput","abstract":[{"type":"text","text":"Build a small scene that spawns a player entity and moves it with a gamepad."}],"type":"topic","title":"Gamepad Input","role":"project","estimatedTime":"20min","kind":"project"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Intro":{"url":"\/tutorials\/adaengine\/createfirst2dscene#Intro","abstract":[{"text":"In this tutorial, you will learn how to create your first 2D scene using Ada.","type":"text"}],"kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Intro","type":"section","role":"pseudoSymbol","title":"Intro"},"EL-2-2-scene.swift":{"type":"file","content":["import AdaEngine","","@MainActor","struct EventListenerPlugin: Plugin {","    @Local var disposeBag: Set<AnyCancellable> = []","","    func setup(in _: borrowing AppWorlds) {","","    }","}"],"fileType":"swift","identifier":"EL-2-2-scene.swift","syntax":"swift","highlights":[{"line":3},{"line":5},{"line":6}],"fileName":"EventListenerPlugin.swift"}}}