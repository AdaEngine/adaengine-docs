/AdaEngine\/EventListeners#Type-of-events","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Additional-for-physics","kind":"task"}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners"}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project."},{"projects":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Create-the-app-shell","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Layout-with-stacks","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Add-a-button-and-state","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Debug-overlays","kind":"task"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-the-view","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Prepare-layout-helpers","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-a-custom-TextRenderer","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Apply-and-animate","kind":"task"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput","sections":[{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Set-up-the-world"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Create-the-input-system"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Read-buttons"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Move-and-rumble"}]}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UI-and-Input"}]},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[{"content":[{"inlineContent":[{"text":"In this tutorial, you will learn how to create your first 2D scene using Ada.","type":"text"}],"type":"paragraph"}],"title":"Create your first 2D scene","estimatedTimeInMinutes":20,"chapter":"Create your first 2D game project.","xcodeRequirement":"Xcode 26.2 or later","kind":"hero"},{"tasks":[{"stepsSection":[],"contentSection":[{"media":"CF2G-3-5.mov","kind":"contentAndMedia","mediaPosition":"trailing","content":[{"inlineContent":[{"type":"text","text":"For the first 2D scene, we will try to repeat this example. We’ll look at adding a scene and a camera."},{"type":"text","text":" "},{"type":"text","text":"In addition, we’ll learn how to add sprites and movement systems."}],"type":"paragraph"}]}],"title":"Intro","anchor":"Intro"},{"stepsSection":[{"code":"CF2G-1-1-app.swift","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"In the previous tutorial, we’ve created an app and an empty window scene.","type":"text"}]}],"type":"step","caption":[],"media":null},{"code":"CF2G-1-2-scene.swift","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Let’s create the game logic. To do this, let’s create a file named "},{"type":"codeVoice","code":"FirstScene.swift"},{"type":"text","text":" and import AdaEngine."},{"type":"text","text":" "},{"type":"text","text":"After that, create a struct named "},{"type":"codeVoice","code":"FirstScene"},{"type":"text","text":" that conforms to "},{"type":"codeVoice","code":"Plugin"},{"type":"text","text":" and add a method named "},{"type":"codeVoice","code":"setup(in app: AppWorlds)"},{"type":"text","text":" where we will set up entities in our game world."}]}],"type":"step","caption":[],"media":null},{"code":"CF2G-1-4-app.swift","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Now add the "},{"code":"FirstScene","type":"codeVoice"},{"type":"text","text":" plugin to the app using the "},{"code":"addPlugins","type":"codeVoice"},{"type":"text","text":" method."}]}],"type":"step","caption":[],"media":null}],"contentSection":[{"mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"First, we need to create base files to launch our application."}]}],"kind":"contentAndMedia"}],"title":"Create an app","anchor":"Create-an-app"},{"stepsSection":[{"runtimePreview":null,"caption":[],"content":[{"inlineContent":[{"text":"Let’s create our 2D camera. Spawn an entity with the ","type":"text"},{"type":"codeVoice","code":"Camera2D"},{"type":"text","text":" bundle."}],"type":"paragraph"}],"type":"step","media":null,"code":"CF2G-2-1-camera.swift"},{"runtimePreview":"CF2G-2-1.png","caption":[],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Now let’s fill the camera background with a sky blue color."}]}],"type":"step","media":null,"code":"CF2G-2-2-camera.swift"}],"anchor":"Create-a-main-camera","contentSection":[{"mediaPosition":"trailing","content":[{"inlineContent":[{"text":"Ada uses the Entity Component System paradigm where all game objects are called ","type":"text"},{"code":"Entity","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Entities are objects that store user or engine data like position, scale, mesh instance, audio, etc. This data is called components, and they should conform to the ","type":"text"},{"code":"Component","type":"codeVoice"},{"text":" protocol.","type":"text"},{"text":" ","type":"text"},{"text":"By default, ","type":"text"},{"code":"Entity","type":"codeVoice"},{"text":" is an empty object without any components.","type":"text"}],"type":"paragraph"}],"kind":"contentAndMedia"},{"content":[{"type":"paragraph","inlineContent":[{"code":"Camera","type":"codeVoice"},{"text":" is a component that determines where all entities will be rendered. Ada supports rendering to a texture or to the ","type":"text"},{"code":"Window","type":"codeVoice"},{"text":". We recommend using engine component bundles like ","type":"text"},{"code":"Camera2D","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"Camera3D","type":"codeVoice"},{"text":", because the engine provides additional components for rendering and audio capabilities.","type":"text"}]}],"kind":"fullWidth"}],"title":"Create a main camera."},{"stepsSection":[{"content":[{"inlineContent":[{"text":"First, we should create an assets folder where we will store our game assets, like sprite sheets, sounds, shaders, etc. Let’s create a folder named ","type":"text"},{"code":"Assets","type":"codeVoice"},{"text":" and add any sprite sheets you want. We will use this sprite sheet:","type":"text"}],"type":"paragraph"}],"code":null,"type":"step","runtimePreview":null,"media":"CF2G-3-1.png","caption":[]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In the end, we should have this file structure in our project. Ada doesn’t use xcassets.","type":"text"}]}],"code":null,"type":"step","runtimePreview":null,"media":"CF2G-3-2.png","caption":[{"type":"paragraph","inlineContent":[{"text":"You can download this texture by right-clicking on the image and saving it to the downloads folder.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Spawn a player entity in the game world. The player entity will store our sprite component and other player data in the future."}]}],"code":"CF2G-3-1-sprite.swift","type":"step","runtimePreview":null,"media":null,"caption":[]},{"content":[{"inlineContent":[{"text":"Let’s create an image from a file using a special resource manager object. ","type":"text"},{"code":"AssetsManager","type":"codeVoice"},{"text":" manages and caches game and engine resources. In our case, we should load an image from a file named ","type":"text"},{"code":"characters_packed.png","type":"codeVoice"},{"text":" and use ","type":"text"},{"code":"Bundle.main","type":"codeVoice"},{"text":" as a search path.","type":"text"}],"type":"paragraph"}],"code":"CF2G-3-2-sprite.swift","type":"step","runtimePreview":null,"media":null,"caption":[]},{"content":[{"type":"paragraph","inlineContent":[{"text":"To split the sprite sheet image into sprites, we can use the ","type":"text"},{"code":"TextureAtlas","type":"codeVoice"},{"text":" object. This object takes an image, sprite size, and margin between sprites if needed. In our case, we have a margin between sprites of 4px horizontally and 1px vertically, and a sprite size of 20px width and 23px height.","type":"text"}]}],"code":"CF2G-3-3-sprite.swift","type":"step","runtimePreview":null,"media":null,"caption":[]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Now we can add our sprite to the player entity using the ","type":"text"},{"type":"codeVoice","code":"Sprite"},{"type":"text","text":" component. This component is efficient for rendering because it uses a special batching system and requires fewer drawing calls."}]}],"code":"CF2G-3-4-sprite.swift","type":"step","runtimePreview":"CF2G-3-3.png","media":null,"caption":[{"type":"paragraph","inlineContent":[{"text":"Add a new sprite component to the entity in the ","type":"text"},{"type":"codeVoice","code":"spawn"},{"text":" method. As you can see, we use subscripts in our ","type":"text"},{"type":"codeVoice","code":"TextureAtlas"},{"text":" instance where 7 is the column number in our sprite sheet and 1 is the row number.","type":"text"}]}]},{"runtimePreview":"CF2G-3-4.png","content":[{"inlineContent":[{"text":"And finally, let’s add a special ","type":"text"},{"code":"Transform","type":"codeVoice"},{"text":" component that describes the position of our entity on the screen.","type":"text"}],"type":"paragraph"}],"code":"CF2G-3-5-sprite.swift","type":"step","media":null,"caption":[]}],"anchor":"First-sprite","title":"First sprite","contentSection":[{"content":[{"inlineContent":[{"text":"Now we can create our first custom sprite.","type":"text"}],"type":"paragraph"}],"kind":"contentAndMedia","mediaPosition":"trailing"}]},{"stepsSection":[{"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"First, we should create a special tag component named ","type":"text"},{"type":"codeVoice","code":"PlayerComponent"},{"text":". We will use this component in the near future; it indicates that this entity is a player.","type":"text"}]}],"caption":[],"runtimePreview":null,"code":"CF2G-4-1-player.swift","media":null},{"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a new function named "},{"type":"codeVoice","code":"PlayerMovement"},{"type":"text","text":" and annotate this function with the "},{"type":"codeVoice","code":"System"},{"type":"text","text":" macro. This system will listen to user inputs and move our player component on the screen."}]}],"caption":[],"runtimePreview":null,"code":"CF2G-4-2-player.swift","media":null},{"type":"step","content":[{"inlineContent":[{"type":"text","text":"Add the new system to our game scene. The "},{"type":"codeVoice","code":"System"},{"text":" macro will create a new system with the same name as the function with the suffix ","type":"text"},{"type":"codeVoice","code":"System"},{"type":"text","text":". Our system will be initialized once on app launch."}],"type":"paragraph"}],"caption":[],"runtimePreview":null,"code":"CF2G-4-3-player.swift","media":null},{"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"code":"PlayerMovementSystem","type":"codeVoice"},{"text":", add a new function parameter named ","type":"text"},{"code":"playerTransform","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"FilterQuery<Ref<Transform>, With<PlayerComponent>>","type":"codeVoice"},{"text":" type.","type":"text"},{"text":" ","type":"text"},{"text":"This object will query the world and return components that conform to your predicate. In our case, we require one mutable component ","type":"text"},{"code":"Transform","type":"codeVoice"},{"text":" and a filter that indicates we need entities with the ","type":"text"},{"code":"PlayerComponent","type":"codeVoice"},{"text":".","type":"text"}]}],"media":null,"runtimePreview":null,"caption":[],"code":"CF2G-4-4-player.swift"},{"type":"step","content":[{"inlineContent":[{"type":"text","text":"Add a new function parameter named "},{"code":"speed","type":"codeVoice"},{"type":"text","text":" with the "},{"code":"Local<Float>","type":"codeVoice"},{"type":"text","text":" type. This is a special type that stores a value available only within the system."}],"type":"paragraph"}],"media":null,"runtimePreview":null,"caption":[],"code":"CF2G-4-5-player.swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Now we can update our player position. Ada can handle keyboard inputs for us. We should listen to keyboard inputs, and if a key is pressed, we should change the player transform."}]},{"type":"step","content":[{"inlineContent":[{"text":"Let’s add a new function parameter named ","type":"text"},{"code":"deltaTime","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"Res<DeltaTime>","type":"codeVoice"},{"text":" type and ","type":"text"},{"code":"input","type":"codeVoice"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"Res<Input>"},{"text":". These are queries to resources in the world.","type":"text"}],"type":"paragraph"}],"media":null,"runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"text":"Using the special ","type":"text"},{"code":"Input","type":"codeVoice"},{"text":" object, we can check if a key is pressed.","type":"text"},{"text":" ","type":"text"},{"text":"Add an ","type":"text"},{"code":"if","type":"codeVoice"},{"text":" condition where we will listen to the ","type":"text"},{"code":"w","type":"codeVoice"},{"text":" key. If the key is pressed, add the speed multiplied by delta time. We do this for a smooth transition between frames.","type":"text"}]}],"code":"CF2G-4-6-player.swift"},{"type":"step","media":null,"content":[{"inlineContent":[{"type":"text","text":"Finally, add the same logic for other keys — "},{"type":"codeVoice","code":"a"},{"type":"text","text":", "},{"type":"codeVoice","code":"s"},{"type":"text","text":", and "},{"type":"codeVoice","code":"d"},{"type":"text","text":"."}],"type":"paragraph"}],"code":"CF2G-4-7-player.swift","runtimePreview":"CF2G-3-5.mov","caption":[{"inlineContent":[{"text":"Run the app and try to move your player.","type":"text"}],"type":"paragraph"}]}],"anchor":"Make-it-move","contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"text":"We did a lot of work, but our scene looks very simple. We should add more life to our player entity. All game logic is described in special objects named ","type":"text"},{"code":"System","type":"codeVoice"},{"text":". A system is a unit that executes each game loop and manipulates entities and their data. We will use one to add life to our player.","type":"text"}]}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"title":"Make it move"}],"kind":"tasks"},{"kind":"callToAction","action":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText","isActive":true,"overridingTitle":"Get started","overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"type":"reference"},"title":"Player and Text in Ada","featuredEyebrow":"Tutorial","abstract":[{"text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene.","type":"text"}]}],"kind":"project","references":{"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Create-a-custom-TextRenderer":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-a-custom-TextRenderer","url":"\/tutorials\/adaengine\/animatedtext#Create-a-custom-TextRenderer","title":"Create a custom TextRenderer","kind":"section","abstract":[{"text":"Create a custom ","type":"text"},{"code":"TextRenderer","type":"codeVoice"},{"text":" that draws text along a sine wave and animate it by updating renderer state.","type":"text"}],"role":"pseudoSymbol"},"CF2G-3-3.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/AdaEngine\/CF2G-3-3.png"}],"type":"image","alt":"Our sprite sheet","identifier":"CF2G-3-3.png"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Make-it-move":{"type":"section","url":"\/tutorials\/adaengine\/createfirst2dscene#Make-it-move","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Make-it-move","title":"Make it move","kind":"section","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}],"role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/Create-your-first-2D-game-project.":{"type":"topic","abstract":[],"kind":"article","title":"Create your first 2D game project.","role":"article","url":"\/tutorials\/adaengine\/create-your-first-2d-game-project.","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project."},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Create-an-app":{"kind":"section","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}],"type":"section","url":"\/tutorials\/adaengine\/createfirst2dscene#Create-an-app","role":"pseudoSymbol","title":"Create an app","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-an-app"},"CF2G-3-2-sprite.swift":{"fileName":"FirstScene.swift","fileType":"swift","content":["import AdaEngine","","struct FirstScene: Plugin {","    func setup(in app: AppWorlds) {","        let camera = Camera()","        camera.backgroundColor = Color(45 \/ 255, 171 \/ 255, 255 \/ 255, 1)","        app.spawn(bundle: Camera2D(camera: camera))","","        let spriteSheetImage = try! AssetsManager.loadSync(Image.self, at: \"@res:\/\/characters_packed.png\").asset!","","        app.spawn(\"Player\")","    }","}"],"identifier":"CF2G-3-2-sprite.swift","highlights":[{"line":9},{"line":10}],"syntax":"swift","type":"file"},"CF2G-2-1-camera.swift":{"syntax":"swift","highlights":[],"fileType":"swift","fileName":"FirstScene.swift","content":["import AdaEngine","","struct FirstScene: Plugin {","    func setup(in app: AppWorlds) {","        app.spawn(bundle: Camera2D())","    }","}"],"type":"file","identifier":"CF2G-2-1-camera.swift"},"CF2G-4-4-player.swift":{"fileName":"FirstScene.swift","content":["import AdaEngine","","struct FirstScene: Plugin {","    func setup(in app: AppWorlds) {","        let camera = Camera()","        camera.backgroundColor = Color(45 \/ 255, 171 \/ 255, 255 \/ 255, 1)","        app.spawn(bundle: Camera2D(camera: camera))","","        let spriteSheetImage = try! AssetsManager.loadSync(Image.self, at: \"@res:\/\/characters_packed.png\").asset!","        let spriteSheet = TextureAtlas(from: spriteSheetImage, size: [20, 23], margin: [4, 1])","","        app.spawn(\"Player\") {","            Sprite(","                texture: spriteSheet[7, 1],","                size: Size(width: 24, height: 24)","            )","            Transform()","            PlayerComponent()","        }","","        app.addSystem(PlayerMovementSystem.self)","    }","}","","@Component","struct PlayerComponent {}","","@System","func PlayerMovement(","    _: FIlterQuery<Ref<Transform>, With<PlayerComponent>>",") {","","}"],"identifier":"CF2G-4-4-player.swift","fileType":"swift","highlights":[{"line":29},{"line":30},{"line":31}],"syntax":"swift","type":"file"},"doc://AdaEngine/tutorials/AdaEngine/PlayerAndText#Add-Player-component":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Player-component","url":"\/tutorials\/adaengine\/playerandtext#Add-Player-component","kind":"section","title":"Add Player component","abstract":[{"text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene.","type":"text"}],"role":"pseudoSymbol"},"doc