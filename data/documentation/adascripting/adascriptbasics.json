{"hierarchy":{"paths":[["doc:\/\/AdaScripting\/documentation\/AdaScripting"]]},"metadata":{"roleHeading":"Article","role":"article","title":"Ada Script Basics","modules":[{"name":"Ada Script"}]},"seeAlsoSections":[{"identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLibraries"],"generated":true,"title":"Essentials","anchor":"Essentials"}],"primaryContentSections":[{"content":[{"text":"A first look","level":2,"anchor":"A-first-look","type":"heading"},{"code":["\/\/ A class keeps state between calls.","class Counter {","    var value = 0;","","    func increment() {","        value += 1;","        return value;","    }","}","","var counter = Counter();","var first = counter.increment(); \/\/ 1"],"syntax":"ada","type":"codeListing"},{"inlineContent":[{"code":"\/\/","type":"codeVoice"},{"type":"text","text":" starts a line comment; "},{"code":"\/* ... *\/","type":"codeVoice"},{"type":"text","text":" surrounds a block comment. Braces"},{"type":"text","text":" "},{"type":"text","text":"delimit blocks. Semicolons can separate statements and are used throughout"},{"type":"text","text":" "},{"type":"text","text":"AdaEngine’s examples. Names are case-sensitive: "},{"code":"Counter","type":"codeVoice"},{"type":"text","text":" and "},{"code":"counter","type":"codeVoice"},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"text","text":"different names."}],"type":"paragraph"},{"text":"Values and basic types","level":2,"anchor":"Values-and-basic-types","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ada Script is dynamically typed. A "},{"type":"codeVoice","code":"var"},{"type":"text","text":" holds a value, and later assignments"},{"type":"text","text":" "},{"type":"text","text":"can replace it. Type annotations such as "},{"type":"codeVoice","code":"var score: Int"},{"type":"text","text":" describe an API and"},{"type":"text","text":" "},{"type":"text","text":"support tooling. They are enforced only when strict type checking is enabled"},{"type":"text","text":" "},{"type":"text","text":"for the project or source file; dynamic mode remains the default."}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Example","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"What it represents","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"Bool"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"true"},{"type":"text","text":", "},{"code":"false","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A condition.","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Int"}]}],[{"inlineContent":[{"code":"42","type":"codeVoice"},{"text":", ","type":"text"},{"code":"-3","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"An integer.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Float"}],"type":"paragraph"}],[{"inlineContent":[{"code":"3.5","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A fractional number.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"String","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"\"player\"","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Text.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Null","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"null"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"No value."}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"List","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"[10, 20, 30]"}]}],[{"type":"paragraph","inlineContent":[{"text":"An indexed sequence, starting at index ","type":"text"},{"code":"0","type":"codeVoice"},{"text":".","type":"text"}]}]],[[{"inlineContent":[{"code":"Map","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"[\"hp\": 100, \"mp\": 20]","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Values looked up by key. Use ","type":"text"},{"code":"[:]","type":"codeVoice"},{"text":" for an empty map.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Range"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"0..<3"},{"text":", ","type":"text"},{"type":"codeVoice","code":"1...3"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"An exclusive or inclusive integer range.","type":"text"}]}]]],"header":"row","type":"table"},{"type":"codeListing","code":["var name = \"Ada\";","var lives: Int = 3;","var inventory = [\"key\", \"torch\"];","var healthByPlayer = [\"ada\": 100, \"lee\": 80];","","inventory[0] = \"map\";","healthByPlayer[\"ada\"] -= 10;","","const startingLives = 3;"],"syntax":"ada"},{"type":"paragraph","inlineContent":[{"code":"const","type":"codeVoice"},{"type":"text","text":" declares a value you do not reassign. A list has a "},{"code":"count","type":"codeVoice"},{"type":"text","text":" property;"},{"type":"text","text":" "},{"type":"text","text":"maps have "},{"type":"codeVoice","code":"keys()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"hasKey(key)"},{"type":"text","text":". A range "},{"type":"codeVoice","code":"0..<3"},{"type":"text","text":" visits "},{"type":"codeVoice","code":"0"},{"type":"text","text":", "},{"type":"codeVoice","code":"1"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"2"},{"type":"text","text":"; "},{"type":"codeVoice","code":"1...3"},{"type":"text","text":" also includes "},{"type":"codeVoice","code":"3"},{"type":"text","text":". Engine types such as "},{"type":"codeVoice","code":"Vector3"},{"type":"text","text":", "},{"type":"codeVoice","code":"Transform"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"Sprite"},{"type":"text","text":" come from registered AdaEngine APIs rather than the basic language"},{"type":"text","text":" "},{"type":"text","text":"types. Values passed to Swift or stored in ECS fields have narrower supported"},{"type":"text","text":" "},{"type":"text","text":"types than arbitrary script values; see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage"},{"type":"text","text":"."}]},{"type":"heading","level":2,"anchor":"Functions","text":"Functions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declare a function with "},{"code":"func","type":"codeVoice"},{"type":"text","text":", pass arguments in parentheses, and use"},{"type":"text","text":" "},{"type":"codeVoice","code":"return"},{"type":"text","text":" to send a value back. A function without an explicit "},{"type":"codeVoice","code":"return"},{"type":"text","text":" "},{"type":"text","text":"returns "},{"type":"codeVoice","code":"null"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"ada","code":["func doubled(value) { return value * 2; }","var next = doubled(5); \/\/ 10"]},{"type":"paragraph","inlineContent":[{"text":"Parameters can have defaults and type annotations:","type":"text"}]},{"type":"codeListing","syntax":"ada","code":["func addPoints(score: Int, bonus = 10) {","    return score + bonus;","}","","var updated = addPoints(5); \/\/ 15"]},{"inlineContent":[{"type":"text","text":"Annotations on parameters describe types for tooling; runtime calls still"},{"type":"text","text":" "},{"type":"text","text":"need values of the form the function expects. A helper function is ordinary"},{"type":"text","text":" "},{"type":"text","text":"code. An ECS callback such as "},{"type":"codeVoice","code":"update(context)"},{"type":"text","text":" runs only because its class is"},{"type":"text","text":" "},{"type":"text","text":"registered as a system."}],"type":"paragraph"},{"inlineContent":[{"text":"AdaScript provides ","type":"text"},{"code":"print(...)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"put(...)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"input(removeTrailingNewline = true)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"nanotime()","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"exit(code = 0)","type":"codeVoice"},{"text":" as free functions. They forward to the","type":"text"},{"text":" ","type":"text"},{"text":"corresponding ","type":"text"},{"code":"System","type":"codeVoice"},{"text":" methods. ","type":"text"},{"code":"assert(condition, message = \"Assertion failed\")","type":"codeVoice"},{"text":" ","type":"text"},{"text":"stops the current script with a diagnostic when its condition is false.","type":"text"},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"code":"System","type":"codeVoice"},{"text":" spellings remain available for existing scripts. Avoid ","type":"text"},{"code":"input","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"exit","type":"codeVoice"},{"text":" in game callbacks because they block for console input or terminate","type":"text"},{"text":" ","type":"text"},{"text":"the host process.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"AdaScript also supports "},{"type":"codeVoice","code":"Math.clamp"},{"type":"text","text":", "},{"type":"codeVoice","code":"Math.saturate"},{"type":"text","text":", "},{"type":"codeVoice","code":"Math.addVector"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"Math.subtractVector"},{"type":"text","text":", "},{"type":"codeVoice","code":"Math.scaleVector"},{"type":"text","text":", "},{"type":"codeVoice","code":"Math.dot"},{"type":"text","text":", "},{"type":"codeVoice","code":"Math.cross"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"Math.length"},{"type":"text","text":", "},{"type":"codeVoice","code":"Math.normalize"},{"type":"text","text":", "},{"type":"codeVoice","code":"Math.distance"},{"type":"text","text":", "},{"type":"codeVoice","code":"Math.lerpVector"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"Math.clampVector"},{"type":"text","text":". Vectors are lists of numbers;"},{"type":"text","text":" "},{"type":"codeVoice","code":"cross"},{"type":"text","text":" requires three components. Matrices are nonempty lists of equal-length"},{"type":"text","text":" "},{"type":"text","text":"rows. "},{"type":"codeVoice","code":"Math.identityMatrix(size)"},{"type":"text","text":", "},{"type":"codeVoice","code":"transposeMatrix(matrix)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"multiplyMatrix(left, right)"},{"type":"text","text":", and "},{"type":"codeVoice","code":"transformVector(matrix, vector)"},{"type":"text","text":" use row-major"},{"type":"text","text":" "},{"type":"text","text":"order and treat vectors as columns:"}],"type":"paragraph"},{"type":"codeListing","code":["var safeHealth = Math.clamp(120, 0, 100); \/\/ 100","var point = [3.0, 4.0, 1.0];","var translation = [[1.0, 0.0, 2.0], [0.0, 1.0, 5.0], [0.0, 0.0, 1.0]];","var moved = Math.transformVector(translation, point); \/\/ [5.0, 9.0, 1.0]"],"syntax":"ada"},{"type":"heading","anchor":"Structs-and-classes","level":2,"text":"Structs and classes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"struct"},{"type":"text","text":" for a small value that should be copied on assignment. Use"},{"type":"text","text":" "},{"type":"codeVoice","code":"class"},{"type":"text","text":" when several names should refer to the same mutable instance."}]},{"type":"codeListing","code":["struct Point {","    var x = 0;","    var y = 0;","}","","class Player {","    var health = 100;","}","","var point = Point();","var otherPoint = point;","otherPoint.x = 5; \/\/ point.x stays 0","","var player = Player();","var teammate = player;","teammate.health = 80; \/\/ player.health is now 80"],"syntax":"ada"},{"type":"paragraph","inlineContent":[{"text":"Classes can inherit from one parent class with ","type":"text"},{"type":"codeVoice","code":"class Child : Parent"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Both kinds of declaration can contain stored properties and methods. A plain","type":"text"},{"text":" ","type":"text"},{"text":"script ","type":"text"},{"type":"codeVoice","code":"struct"},{"text":" is not automatically an ECS component or resource: use","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@component"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"@resource"},{"text":" and the supported exported field schema for that.","type":"text"},{"text":" ","type":"text"},{"text":"See ","type":"text"},{"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS","type":"reference","isActive":true},{"text":".","type":"text"}]},{"type":"heading","anchor":"Static-members","level":2,"text":"Static members"},{"type":"paragraph","inlineContent":[{"text":"An instance member belongs to one object. A ","type":"text"},{"code":"static","type":"codeVoice"},{"type":"text","text":" member belongs to the"},{"type":"text","text":" "},{"type":"text","text":"declaration itself and is accessed through its type name:"}]},{"syntax":"ada","type":"codeListing","code":["class Difficulty {","    static var multiplier = 2;","","    static func apply(baseScore) {","        return baseScore * multiplier;","    }","}","","var points = Difficulty.apply(10); \/\/ 20"]},{"type":"paragraph","inlineContent":[{"text":"Use static state sparingly for gameplay. ECS components hold per-entity state,","type":"text"},{"text":" ","type":"text"},{"text":"and resources hold shared world state with an explicit lifecycle.","type":"text"}]},{"type":"heading","level":2,"text":"Initialization and cleanup","anchor":"Initialization-and-cleanup"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"func init(...)"},{"text":" is called when a class or struct instance is created.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"func deinit()"},{"text":" runs when a class instance is reclaimed; its timing depends on","type":"text"},{"text":" ","type":"text"},{"text":"the script runtime, so it is not a reliable place for a gameplay event.","type":"text"}]},{"syntax":"ada","type":"codeListing","code":["class TimerLabel {","    var title;","","    func init(name) {","        title = name;","    }","","    func deinit() {","        System.print(\"TimerLabel released\");","    }","}","","var label = TimerLabel(\"Countdown\");"]},{"type":"paragraph","inlineContent":[{"text":"Neither method receives an ECS ","type":"text"},{"code":"context","type":"codeVoice"},{"text":". To initialize a world once, create","type":"text"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"code":"@system(scheduler: \"startup\")","type":"codeVoice"},{"text":" class with ","type":"text"},{"code":"update(context)","type":"codeVoice"},{"text":". To react to","type":"text"},{"text":" ","type":"text"},{"text":"per-entity attachment or detachment, use a ","type":"text"},{"code":"@scriptable","type":"codeVoice"},{"text":" class’s","type":"text"},{"text":" ","type":"text"},{"code":"ready(context)","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"destroy(context)","type":"codeVoice"},{"type":"text","text":". There is currently no function-level"},{"type":"text","text":" "},{"type":"codeVoice","code":"@init"},{"type":"text","text":" annotation. See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations"},{"type":"text","text":" for these lifetimes."}]},{"text":"Stored and computed properties","anchor":"Stored-and-computed-properties","level":2,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"var"},{"type":"text","text":" inside a type is a stored property. A computed property runs "},{"type":"codeVoice","code":"get"},{"type":"text","text":" when"},{"type":"text","text":" "},{"type":"text","text":"read and "},{"type":"codeVoice","code":"set"},{"type":"text","text":" when assigned. Inside "},{"type":"codeVoice","code":"set"},{"type":"text","text":", "},{"type":"codeVoice","code":"value"},{"type":"text","text":" is the new value unless"},{"type":"text","text":" "},{"type":"text","text":"you give the setter parameter another name."}],"type":"paragraph"},{"code":["class HealthBar {","    private var storedHealth = 100;","","    var health {","        get { return storedHealth; }","        set (newHealth) {","            if (newHealth < 0) {","                storedHealth = 0;","            } else if (newHealth > 100) {","                storedHealth = 100;","            } else {","                storedHealth = newHealth;","            }","        }","    };","}","","var bar = HealthBar();","bar.health = 120;","var visibleHealth = bar.health; \/\/ 100"],"syntax":"ada","type":"codeListing"},{"inlineContent":[{"text":"A property with only ","type":"text"},{"code":"get","type":"codeVoice"},{"text":" is read-only. These accessors are ordinary script","type":"text"},{"text":" ","type":"text"},{"text":"behavior. They do not by themselves export an Inspector property or define an","type":"text"},{"text":" ","type":"text"},{"text":"ECS field; ","type":"text"},{"code":"@export","type":"codeVoice"},{"text":" on a supported stored field does that. See","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Conditions and loops","anchor":"Conditions-and-loops"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"if"},{"type":"text","text":", "},{"type":"codeVoice","code":"else if"},{"type":"text","text":", and "},{"type":"codeVoice","code":"else"},{"type":"text","text":" to choose a branch. "},{"type":"codeVoice","code":"&&"},{"type":"text","text":", "},{"type":"codeVoice","code":"||"},{"type":"text","text":", and "},{"type":"codeVoice","code":"!"},{"type":"text","text":" combine"},{"type":"text","text":" "},{"type":"text","text":"Boolean conditions."}]},{"syntax":"ada","type":"codeListing","code":["func healthMessage(health) {","    if (health <= 0) {","        return \"defeated\";","    } else if (health < 25) {","        return \"critical\";","    } else {","        return \"ready\";","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"for (var item in collection)"},{"type":"text","text":" for a list, range, or ECS query. "},{"type":"codeVoice","code":"while"},{"type":"text","text":" "},{"type":"text","text":"checks before each iteration; "},{"type":"codeVoice","code":"repeat ... while"},{"type":"text","text":" checks after one iteration."},{"type":"text","text":" "},{"type":"codeVoice","code":"break"},{"type":"text","text":" ends a loop, and "},{"type":"codeVoice","code":"continue"},{"type":"text","text":" skips to its next iteration."}]},{"syntax":"ada","type":"codeListing","code":["var total = 0;","for (var number in 1...3) {","    total += number; \/\/ 1 + 2 + 3","}","","var attempts = 0;","while (attempts < 3) {","    attempts += 1;","}","","repeat {","    attempts -= 1;","} while (attempts > 0);"]},{"type":"paragraph","inlineContent":[{"code":"switch (value)","type":"codeVoice"},{"text":" selects ","type":"text"},{"code":"case","type":"codeVoice"},{"type":"text","text":" branches and an optional "},{"code":"default","type":"codeVoice"},{"type":"text","text":". Add"},{"type":"text","text":" "},{"code":"break","type":"codeVoice"},{"type":"text","text":" to stop at the end of a case when no "},{"code":"return","type":"codeVoice"},{"type":"text","text":" exits it; execution can"},{"type":"text","text":" "},{"type":"text","text":"otherwise continue into the next case."}]},{"type":"codeListing","syntax":"ada","code":["func teamName(team) {","    switch (team) {","        case 1:","            return \"blue\";","        case 2:","            return \"red\";","        default:","            return \"unknown\";","    }","}"]},{"type":"heading","level":2,"anchor":"Async-functions-and-await","text":"Async functions and `await`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"code":"async func","type":"codeVoice"},{"type":"text","text":" may suspend at "},{"code":"await","type":"codeVoice"},{"type":"text","text":". Awaiting an operation pauses that"},{"type":"text","text":" "},{"type":"text","text":"script task while the game keeps updating. A synchronous callback starts an"},{"type":"text","text":" "},{"type":"text","text":"async function with "},{"code":"Tasks.start(...)","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"ada","code":["async func announceLater() {","    await Time.sleep(1.0);","    System.print(\"One game-time second passed\");","}","","@system","class AnnouncementSystem {","    var started = false;","","    func update(context) {","        if (!started) {","            started = true;","            Tasks.start(announceLater());","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"update(context)"},{"type":"text","text":" and scriptable callbacks remain"},{"type":"text","text":" "},{"type":"text","text":"synchronous. Do not keep "},{"type":"codeVoice","code":"context"},{"type":"text","text":", query rows, resource views, or commands"},{"type":"text","text":" "},{"type":"text","text":"across "},{"type":"codeVoice","code":"await"},{"type":"text","text":": those values expire when the callback returns. Pass detached"},{"type":"text","text":" "},{"type":"text","text":"values into the task. "},{"code":"Time.sleep","type":"codeVoice"},{"type":"text","text":" uses game time; "},{"code":"Time.sleepRealTime","type":"codeVoice"},{"type":"text","text":" uses a"},{"type":"text","text":" "},{"type":"text","text":"monotonic clock. Read "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage"},{"type":"text","text":" for asset operations, save"},{"type":"text","text":" "},{"type":"text","text":"results, cancellation, and task lifetimes."}]},{"text":"Scene navigation","level":2,"type":"heading","anchor":"Scene-navigation"},{"inlineContent":[{"text":"With ","type":"text"},{"type":"codeVoice","code":"ScenePlugin"},{"text":" installed, an AdaScript system or scriptable callback can","type":"text"},{"text":" ","type":"text"},{"text":"request a level change through its scoped world context:","type":"text"}],"type":"paragraph"},{"syntax":"ada","type":"codeListing","code":["context.world.changeScene(\"@res:\/\/Scenes\/Level02.ascn\");","context.world.reloadScene(); \/\/ Restart after game over."]},{"inlineContent":[{"type":"text","text":"Both calls return "},{"type":"codeVoice","code":"Bool"},{"type":"text","text":" to indicate whether the request was accepted. Scene"},{"type":"text","text":" "},{"type":"text","text":"loading happens asynchronously, and the prepared scene replaces the old one"},{"type":"text","text":" "},{"type":"text","text":"after an update pass. The current scene remains active if loading fails."},{"type":"text","text":" "},{"type":"codeVoice","code":"reloadScene()"},{"type":"text","text":" loads a fresh copy of the active scene, recreating its entities"},{"type":"text","text":" "},{"type":"text","text":"and scene resources. Entities spawned through AdaScript world commands are"},{"type":"text","text":" "},{"type":"text","text":"tracked as part of that scene and removed on reload. Application resources"},{"type":"text","text":" "},{"type":"text","text":"and entities created outside the scene remain available across transitions."},{"type":"text","text":" "},{"type":"text","text":"AdaScript tasks for the outgoing world are canceled and "},{"type":"codeVoice","code":"@system"},{"type":"text","text":" instances"},{"type":"text","text":" "},{"type":"text","text":"are recreated; module globals remain part of the application session."},{"type":"text","text":" "},{"type":"text","text":"World contexts expire when their callback returns, so do not retain one in an"},{"type":"text","text":" "},{"type":"text","text":"async task."}],"type":"paragraph"},{"text":"Annotations","type":"heading","level":2,"anchor":"Annotations"},{"inlineContent":[{"text":"Annotations begin with ","type":"text"},{"type":"codeVoice","code":"@"},{"text":" and attach metadata to a declaration. They are","type":"text"},{"text":" ","type":"text"},{"text":"AdaEngine features, not ordinary function calls:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"ada","code":["@component(id: \"game.health\")","struct Health {","    @export var current = 100;","}","","@system(scheduler: \"startup\")","class CreatePlayer {","    func update(context) {","        context.world.spawn([Health(current: 100)]);","    }","}"]},{"inlineContent":[{"code":"@component","type":"codeVoice"},{"type":"text","text":" tells AdaEngine to register data; "},{"code":"@export","type":"codeVoice"},{"type":"text","text":" gives a supported"},{"type":"text","text":" "},{"type":"text","text":"field a default. "},{"code":"@system","type":"codeVoice"},{"type":"text","text":" registers an ECS callback. Other annotations define"},{"type":"text","text":" "},{"type":"text","text":"queries, resources, scriptable behavior, editor tools, and multiplayer"},{"type":"text","text":" "},{"type":"text","text":"messages. Arguments are constants or symbolic identifiers used during module"},{"type":"text","text":" "},{"type":"text","text":"discovery. See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations"},{"text":" for their valid targets, arguments,","type":"text"},{"text":" ","type":"text"},{"text":"defaults, and limitations.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/adascripting\/adascriptbasics"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"url":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptBasics","interfaceLanguage":"swift"},"abstract":[{"text":"Learn the syntax of Ada Script before connecting a script to a scene or ECS","type":"text"},{"text":" ","type":"text"},{"text":"world. Ada Script files use the ","type":"text"},{"code":".ada","type":"codeVoice"},{"text":" extension. The examples on this page are","type":"text"},{"text":" ","type":"text"},{"text":"small pieces you can combine in one file; a game does not need a ","type":"text"},{"code":"main()","type":"codeVoice"},{"text":" ","type":"text"},{"text":"function. Start with ","type":"text"},{"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript","type":"reference","isActive":true},{"text":" to run a complete system.","type":"text"}],"kind":"article","references":{"doc://AdaScripting/documentation/AdaScripting/GettingStartedWithAdaScript":{"kind":"article","url":"\/documentation\/adascripting\/gettingstartedwithadascript","type":"topic","abstract":[{"text":"Add an ","type":"text"},{"code":".ada","type":"codeVoice"},{"text":" file to an AdaEngine executable and run its systems without manually loading each script.","type":"text"}],"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript","title":"Getting Started with Ada Script","role":"article"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptLanguage":{"url":"\/documentation\/adascripting\/adascriptlanguage","kind":"article","title":"Ada Script Language","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage","type":"topic","abstract":[{"type":"text","text":"Use Ada Script syntax with AdaEngine declaration annotations. New to the"},{"type":"text","text":" "},{"type":"text","text":"language? Start with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptBasics"},{"type":"text","text":" for values, functions, types,"},{"type":"text","text":" "},{"type":"text","text":"properties, control flow, asynchronous work, and annotations."}],"role":"article"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptLibraries":{"title":"AdaScript Libraries","type":"topic","kind":"article","abstract":[{"text":"Share reusable AdaScript functions, systems, and scriptable objects through a GitHub repository.","type":"text"},{"text":" ","type":"text"},{"text":"AdaEditor installs the library and its transitive dependencies into the project. Run, Play Mode,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Preview, and "},{"code":"AdaScriptBuildPlugin","type":"codeVoice"},{"type":"text","text":" load the same installed sources without network access."}],"url":"\/documentation\/adascripting\/adascriptlibraries","role":"article","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLibraries"},"doc://AdaScripting/documentation/AdaScripting":{"url":"\/documentation\/adascripting","kind":"symbol","title":"Ada Script","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting","type":"topic","abstract":[{"type":"text","text":"Write gameplay systems in Ada Script while keeping entity filtering and access planning in AdaEngine’s native ECS."}],"role":"collection"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptECS":{"url":"\/documentation\/adascripting\/adascriptecs","kind":"article","title":"Ada Script ECS","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS","type":"topic","abstract":[{"text":"Declare annotation-driven systems and iterate native AdaECS component columns.","type":"text"}],"role":"article"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptBasics":{"kind":"article","url":"\/documentation\/adascripting\/adascriptbasics","title":"Ada Script Basics","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptBasics","type":"topic","abstract":[{"type":"text","text":"Learn the syntax of Ada Script before connecting a script to a scene or ECS"},{"type":"text","text":" "},{"type":"text","text":"world. Ada Script files use the "},{"type":"codeVoice","code":".ada"},{"type":"text","text":" extension. The examples on this page are"},{"type":"text","text":" "},{"type":"text","text":"small pieces you can combine in one file; a game does not need a "},{"type":"codeVoice","code":"main()"},{"type":"text","text":" "},{"type":"text","text":"function. Start with "},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript","isActive":true},{"text":" to run a complete system.","type":"text"}],"role":"article"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptAnnotations":{"type":"topic","url":"\/documentation\/adascripting\/adascriptannotations","title":"Ada Script Annotation Reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","abstract":[{"type":"text","text":"Choose an annotation by the declaration it describes. Annotation arguments"},{"type":"text","text":" "},{"type":"text","text":"are literals, identifiers, or lists of those values, not runtime expressions."},{"type":"text","text":" "},{"type":"text","text":"The same spelling can have different roles: "},{"code":"@component","type":"codeVoice"},{"type":"text","text":" declares a struct,"},{"type":"text","text":" "},{"type":"text","text":"while "},{"code":"@component(required: true)","type":"codeVoice"},{"type":"text","text":" binds an existing component to a scriptable"},{"type":"text","text":" "},{"type":"text","text":"instance."}],"kind":"article","role":"article"}}}