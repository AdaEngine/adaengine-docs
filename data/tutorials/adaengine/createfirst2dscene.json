{"hierarchy":{"paths":[["doc:\/\/AdaEngine\/tutorials\/AdaEngine","doc:\/\/AdaEngine\/tutorials\/AdaEngine\/$volume","doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project."]],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine","modules":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project.","projects":[{"sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject#Create-project-using-Xcode","kind":"task"}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject"},{"sections":[{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Intro"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-an-app","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-a-main-camera","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#First-sprite","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Make-it-move","kind":"task"}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText","sections":[{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Player-component"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Text-component"}]},{"sections":[{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Base-of-Event-Subscriber-pattern"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Subscribe-to-scene-events"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Type-of-events"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Additional-for-physics"}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UI-and-Input","projects":[{"sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Create-the-app-shell","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Layout-with-stacks","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Add-a-button-and-state","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Debug-overlays","kind":"task"}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-the-view","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Prepare-layout-helpers","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-a-custom-TextRenderer","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Apply-and-animate","kind":"task"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput","sections":[{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Set-up-the-world"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Create-the-input-system"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Read-buttons"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Move-and-rumble","kind":"task"}]}]}]},"identifier":{"url":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene","interfaceLanguage":"swift"},"variants":[{"paths":["\/tutorials\/adaengine\/createfirst2dscene"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"category":"Ada","role":"project","title":"Create your first 2D scene","categoryPathComponent":"AdaEngine"},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[{"kind":"hero","chapter":"Create your first 2D game project.","xcodeRequirement":"Xcode 26.2 or later","content":[{"inlineContent":[{"text":"In this tutorial, you will learn how to create your first 2D scene using Ada.","type":"text"}],"type":"paragraph"}],"title":"Create your first 2D scene","estimatedTimeInMinutes":20},{"kind":"tasks","tasks":[{"contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"inlineContent":[{"text":"For the first 2D scene, we will try to repeat this example. We’ll look at adding a scene and a camera.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"In addition, we’ll learn how to add sprites and movement systems."}],"type":"paragraph"}],"media":"CF2G-3-5.mov"}],"title":"Intro","stepsSection":[],"anchor":"Intro"},{"contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"text":"First, we need to create base files to launch our application.","type":"text"}]}]}],"title":"Create an app","stepsSection":[{"type":"step","media":null,"runtimePreview":null,"caption":[],"code":"CF2G-1-1-app.swift","content":[{"inlineContent":[{"text":"In the previous tutorial, we’ve created an app and an empty window scene.","type":"text"}],"type":"paragraph"}]},{"type":"step","media":null,"runtimePreview":null,"caption":[],"code":"CF2G-1-2-scene.swift","content":[{"inlineContent":[{"type":"text","text":"Let’s create the game logic. To do this, let’s create a file named "},{"type":"codeVoice","code":"FirstScene.swift"},{"type":"text","text":" and import AdaEngine."},{"type":"text","text":" "},{"type":"text","text":"After that, create a struct named "},{"type":"codeVoice","code":"FirstScene"},{"type":"text","text":" that conforms to "},{"type":"codeVoice","code":"Plugin"},{"type":"text","text":" and add a method named "},{"type":"codeVoice","code":"setup(in app: AppWorlds)"},{"type":"text","text":" where we will set up entities in our game world."}],"type":"paragraph"}]},{"type":"step","media":null,"runtimePreview":null,"caption":[],"code":"CF2G-1-4-app.swift","content":[{"inlineContent":[{"text":"Now add the ","type":"text"},{"type":"codeVoice","code":"FirstScene"},{"text":" plugin to the app using the ","type":"text"},{"type":"codeVoice","code":"addPlugins"},{"text":" method.","type":"text"}],"type":"paragraph"}]}],"anchor":"Create-an-app"},{"contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ada uses the Entity Component System paradigm where all game objects are called "},{"code":"Entity","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Entities are objects that store user or engine data like position, scale, mesh instance, audio, etc. This data is called components, and they should conform to the "},{"type":"codeVoice","code":"Component"},{"type":"text","text":" protocol."},{"type":"text","text":" "},{"type":"text","text":"By default, "},{"code":"Entity","type":"codeVoice"},{"text":" is an empty object without any components.","type":"text"}]}]},{"kind":"fullWidth","content":[{"type":"paragraph","inlineContent":[{"code":"Camera","type":"codeVoice"},{"type":"text","text":" is a component that determines where all entities will be rendered. Ada supports rendering to a texture or to the "},{"code":"Window","type":"codeVoice"},{"type":"text","text":". We recommend using engine component bundles like "},{"code":"Camera2D","type":"codeVoice"},{"type":"text","text":" or "},{"code":"Camera3D","type":"codeVoice"},{"type":"text","text":", because the engine provides additional components for rendering and audio capabilities."}]}]}],"title":"Create a main camera.","stepsSection":[{"runtimePreview":null,"code":"CF2G-2-1-camera.swift","caption":[],"type":"step","content":[{"inlineContent":[{"type":"text","text":"Let’s create our 2D camera. Spawn an entity with the "},{"type":"codeVoice","code":"Camera2D"},{"type":"text","text":" bundle."}],"type":"paragraph"}],"media":null},{"runtimePreview":"CF2G-2-1.png","code":"CF2G-2-2-camera.swift","caption":[],"type":"step","content":[{"inlineContent":[{"type":"text","text":"Now let’s fill the camera background with a sky blue color."}],"type":"paragraph"}],"media":null}],"anchor":"Create-a-main-camera"},{"stepsSection":[{"code":null,"content":[{"type":"paragraph","inlineContent":[{"text":"First, we should create an assets folder where we will store our game assets, like sprite sheets, sounds, shaders, etc. Let’s create a folder named ","type":"text"},{"type":"codeVoice","code":"Assets"},{"text":" and add any sprite sheets you want. We will use this sprite sheet:","type":"text"}]}],"caption":[],"media":"CF2G-3-1.png","type":"step","runtimePreview":null},{"code":null,"content":[{"type":"paragraph","inlineContent":[{"text":"In the end, we should have this file structure in our project. Ada doesn’t use xcassets.","type":"text"}]}],"caption":[{"type":"paragraph","inlineContent":[{"text":"You can download this texture by right-clicking on the image and saving it to the downloads folder.","type":"text"}]}],"media":"CF2G-3-2.png","type":"step","runtimePreview":null},{"code":"CF2G-3-1-sprite.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Spawn a player entity in the game world. The player entity will store our sprite component and other player data in the future."}]}],"caption":[],"media":null,"type":"step","runtimePreview":null},{"runtimePreview":null,"caption":[],"media":null,"code":"CF2G-3-2-sprite.swift","type":"step","content":[{"inlineContent":[{"type":"text","text":"Let’s create an image from a file using a special resource manager object. "},{"type":"codeVoice","code":"AssetsManager"},{"type":"text","text":" manages and caches game and engine resources. In our case, we should load an image from a file named "},{"type":"codeVoice","code":"characters_packed.png"},{"type":"text","text":" and use "},{"type":"codeVoice","code":"Bundle.main"},{"type":"text","text":" as a search path."}],"type":"paragraph"}]},{"runtimePreview":null,"caption":[],"media":null,"code":"CF2G-3-3-sprite.swift","type":"step","content":[{"inlineContent":[{"text":"To split the sprite sheet image into sprites, we can use the ","type":"text"},{"code":"TextureAtlas","type":"codeVoice"},{"text":" object. This object takes an image, sprite size, and margin between sprites if needed. In our case, we have a margin between sprites of 4px horizontally and 1px vertically, and a sprite size of 20px width and 23px height.","type":"text"}],"type":"paragraph"}]},{"runtimePreview":"CF2G-3-3.png","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a new sprite component to the entity in the "},{"code":"spawn","type":"codeVoice"},{"type":"text","text":" method. As you can see, we use subscripts in our "},{"code":"TextureAtlas","type":"codeVoice"},{"type":"text","text":" instance where 7 is the column number in our sprite sheet and 1 is the row number."}]}],"media":null,"code":"CF2G-3-4-sprite.swift","type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Now we can add our sprite to the player entity using the "},{"code":"Sprite","type":"codeVoice"},{"type":"text","text":" component. This component is efficient for rendering because it uses a special batching system and requires fewer drawing calls."}]}]},{"runtimePreview":"CF2G-3-4.png","caption":[],"media":null,"code":"CF2G-3-5-sprite.swift","type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"And finally, let’s add a special "},{"type":"codeVoice","code":"Transform"},{"type":"text","text":" component that describes the position of our entity on the screen."}]}]}],"anchor":"First-sprite","title":"First sprite","contentSection":[{"mediaPosition":"trailing","content":[{"inlineContent":[{"text":"Now we can create our first custom sprite.","type":"text"}],"type":"paragraph"}],"kind":"contentAndMedia"}]},{"anchor":"Make-it-move","stepsSection":[{"caption":[],"type":"step","media":null,"code":"CF2G-4-1-player.swift","content":[{"inlineContent":[{"text":"First, we should create a special tag component named ","type":"text"},{"type":"codeVoice","code":"PlayerComponent"},{"text":". We will use this component in the near future; it indicates that this entity is a player.","type":"text"}],"type":"paragraph"}],"runtimePreview":null},{"caption":[],"type":"step","media":null,"code":"CF2G-4-2-player.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a new function named "},{"code":"PlayerMovement","type":"codeVoice"},{"type":"text","text":" and annotate this function with the "},{"code":"System","type":"codeVoice"},{"type":"text","text":" macro. This system will listen to user inputs and move our player component on the screen."}]}],"runtimePreview":null},{"caption":[],"type":"step","media":null,"code":"CF2G-4-3-player.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the new system to our game scene. The "},{"type":"codeVoice","code":"System"},{"type":"text","text":" macro will create a new system with the same name as the function with the suffix "},{"type":"codeVoice","code":"System"},{"type":"text","text":". Our system will be initialized once on app launch."}]}],"runtimePreview":null},{"caption":[],"type":"step","media":null,"code":"CF2G-4-4-player.swift","content":[{"inlineContent":[{"text":"In ","type":"text"},{"code":"PlayerMovementSystem","type":"codeVoice"},{"text":", add a new function parameter named ","type":"text"},{"code":"playerTransform","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"FilterQuery<Ref<Transform>, With<PlayerComponent>>","type":"codeVoice"},{"text":" type.","type":"text"},{"text":" ","type":"text"},{"text":"This object will query the world and return components that conform to your predicate. In our case, we require one mutable component ","type":"text"},{"code":"Transform","type":"codeVoice"},{"text":" and a filter that indicates we need entities with the ","type":"text"},{"code":"PlayerComponent","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"runtimePreview":null},{"caption":[],"type":"step","media":null,"code":"CF2G-4-5-player.swift","content":[{"inlineContent":[{"type":"text","text":"Add a new function parameter named "},{"type":"codeVoice","code":"speed"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"Local<Float>"},{"type":"text","text":" type. This is a special type that stores a value available only within the system."}],"type":"paragraph"}],"runtimePreview":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"Now we can update our player position. Ada can handle keyboard inputs for us. We should listen to keyboard inputs, and if a key is pressed, we should change the player transform."}]},{"content":[{"inlineContent":[{"text":"Let’s add a new function parameter named ","type":"text"},{"code":"deltaTime","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"Res<DeltaTime>","type":"codeVoice"},{"text":" type and ","type":"text"},{"code":"input","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"Res<Input>","type":"codeVoice"},{"text":". These are queries to resources in the world.","type":"text"}],"type":"paragraph"}],"type":"step","caption":[{"inlineContent":[{"type":"text","text":"Using the special "},{"code":"Input","type":"codeVoice"},{"type":"text","text":" object, we can check if a key is pressed."},{"type":"text","text":" "},{"type":"text","text":"Add an "},{"code":"if","type":"codeVoice"},{"type":"text","text":" condition where we will listen to the "},{"code":"w","type":"codeVoice"},{"type":"text","text":" key. If the key is pressed, add the speed multiplied by delta time. We do this for a smooth transition between frames."}],"type":"paragraph"}],"runtimePreview":null,"media":null,"code":"CF2G-4-6-player.swift"},{"content":[{"inlineContent":[{"text":"Finally, add the same logic for other keys — ","type":"text"},{"code":"a","type":"codeVoice"},{"text":", ","type":"text"},{"code":"s","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"d","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"step","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Run the app and try to move your player."}]}],"runtimePreview":"CF2G-3-5.mov","media":null,"code":"CF2G-4-7-player.swift"}],"contentSection":[{"kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"We did a lot of work, but our scene looks very simple. We should add more life to our player entity. All game logic is described in special objects named ","type":"text"},{"code":"System","type":"codeVoice"},{"text":". A system is a unit that executes each game loop and manipulates entities and their data. We will use one to add life to our player.","type":"text"}]}],"mediaPosition":"trailing"}],"title":"Make it move"}]},{"abstract":[{"type":"text","text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene."}],"kind":"callToAction","title":"Player and Text in Ada","action":{"isActive":true,"overridingTitle":"Get started","overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"type":"reference","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText"},"featuredEyebrow":"Tutorial"}],"kind":"project","references":{"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Create-a-main-camera":{"role":"pseudoSymbol","title":"Create a main camera.","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-a-main-camera","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}],"type":"section","url":"\/tutorials\/adaengine\/createfirst2dscene#Create-a-main-camera"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Base-of-Event-Subscriber-pattern":{"role":"pseudoSymbol","kind":"section","title":"Base of Event-Subscriber pattern","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Base-of-Event-Subscriber-pattern","abstract":[{"type":"text","text":"In this tutorial you will learn about the event listeners system in Ada."},{"type":"text","text":" "},{"type":"text","text":"How can you catch events and process them"}],"type":"section","url":"\/tutorials\/adaengine\/eventlisteners#Base-of-Event-Subscriber-pattern"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Additional-for-physics":{"role":"pseudoSymbol","kind":"section","title":"Additional for physics","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Additional-for-physics","abstract":[{"text":"In this tutorial you will learn about the event listeners system in Ada.","type":"text"},{"text":" ","type":"text"},{"text":"How can you catch events and process them","type":"text"}],"type":"section","url":"\/tutorials\/adaengine\/eventlisteners#Additional-for-physics"},"CF2G-3-2-sprite.swift":{"fileType":"swift","fileName":"FirstScene.swift","identifier":"CF2G-3-2-sprite.swift","content":["import AdaEngine","","struct FirstScene: Plugin {","    func setup(in app: AppWorlds) {","        let camera = Camera()","        camera.backgroundColor = Color(45 \/ 255, 171 \/ 255, 255 \/ 255, 1)","        app.spawn(bundle: Camera2D(camera: camera))","","        let spriteSheetImage = try! AssetsManager.loadSync(Image.self, at: \"@res:\/\/characters_packed.png\").asset!","","        app.spawn(\"Player\")","    }","}"],"highlights":[{"line":9},{"line":10}],"type":"file","syntax":"swift"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Create-an-app":{"role":"pseudoSymbol","kind":"section","title":"Create an app","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-an-app","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}],"type":"section","url":"\/tutorials\/adaengine\/createfirst2dscene#Create-an-app"},"doc://AdaEngine/tutorials/AdaEngine/CreateProject#Create-project-using-Xcode":{"role":"pseudoSymbol","title":"Create project using Xcode","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject#Create-project-using-Xcode","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first Ada project."}],"url":"\/tutorials\/adaengine\/createproject#Create-project-using-Xcode","type":"section"},"CF2G-2-1-camera.swift":{"highlights":[],"type":"file","identifier":"CF2G-2-1-camera.swift","fileName":"FirstScene.swift","fileType":"swift","syntax":"swift","content":["import AdaEngine","","struct FirstScene: Plugin {","    func setup(in app: AppWorlds) {","        app.spawn(bundle: Camera2D())","    }","}"]},"doc://AdaEngine/tutorials/AdaEngine":{"type":"topic","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine","title":"Meet Ada","url":"\/tutorials\/adaengine","abstract":[{"type":"text","text":"Learn the basics of Ada and start developing your own games!"}],"kind":"overview","role":"overview"},"doc://AdaEngine/tutorials/AdaEngine/PlayerAndText":{"role":"project","kind":"project","title":"Player and Text in Ada","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText","estimatedTime":"5min","abstract":[{"type":"text","text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene."}],"type":"topic","url":"\/tutorials\/adaengine\/playerandtext"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics#Debug-overlays":{"role":"pseudoSymbol","kind":"section","title":"Debug overlays","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Debug-overlays","abstract":[{"text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state.","type":"text"}],"type":"section","url":"\/tutorials\/adaengine\/uibasics#Debug-overlays"},"CF2G-3-4-sprite.swift":{"fileType":"swift","fileName":"FirstScene.swift","identifier":"CF2G-3-4-sprite.swift","content":["import AdaEngine","","struct FirstScene: Plugin {","    func setup(in app: AppWorlds) {","        let camera = Camera()","        camera.backgroundColor = Color(45 \/ 255, 171 \/ 255, 255 \/ 255, 1)","        app.spawn(bundle: Camera2D(camera: camera))","","        let spriteSheetImage = try! AssetsManager.loadSync(Image.self, at: \"@res:\/\/characters_packed.png\").asset!","        let spriteSheet = TextureAtlas(from: spriteSheetImage, size: [20, 23], margin: [4, 1])","","        app.spawn(\"Player\") {","            Sprite(","                texture: spriteSheet[7, 1],","                size: Size(width: 24, height: 24)","            )","        }","    }","}"],"highlights":[{"line":12},{"line":13},{"line":14},{"line":15},{"line":16},{"line":17}],"type":"file","syntax":"swift"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene":{"role":"project","title":"Create your first 2D scene","kind":"project","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene","estimatedTime":"20min","abstract":[{"text":"In this tutorial, you will learn how to create your first 2D scene using Ada.","type":"text"}],"url":"\/tutorials\/adaengine\/createfirst2dscene","type":"topic"},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Create-a-custom-TextRenderer":{"url":"\/tutorials\/adaengine\/animatedtext#Create-a-custom-TextRenderer","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-a-custom-TextRenderer","abstract":[{"text":"Create a custom ","type":"text"},{"code":"TextRenderer","type":"codeVoice"},{"text":" that draws text along a sine wave and animate it by updating renderer state.","type":"text"}],"role":"pseudoSymbol","type":"section","kind":"section","title":"Create a custom TextRenderer"},"doc://AdaEngine/tutorials/AdaEngine/Anima