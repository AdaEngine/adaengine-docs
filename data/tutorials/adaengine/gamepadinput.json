\/AdaEngine\/EventListeners#Additional-for-physics","abstract":[{"text":"In this tutorial you will learn about the event listeners system in Ada.","type":"text"},{"text":" ","type":"text"},{"text":"How can you catch events and process them","type":"text"}],"role":"pseudoSymbol","kind":"section","title":"Additional for physics","type":"section","url":"\/tutorials\/adaengine\/eventlisteners#Additional-for-physics"},"doc://AdaEngine/tutorials/AdaEngine/PlayerAndText#Add-Text-component":{"url":"\/tutorials\/adaengine\/playerandtext#Add-Text-component","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Text-component","role":"pseudoSymbol","kind":"section","title":"Add Text component","type":"section","abstract":[{"type":"text","text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene."}]},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Create-the-view":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-the-view","abstract":[{"type":"text","text":"Create a custom "},{"type":"codeVoice","code":"TextRenderer"},{"type":"text","text":" that draws text along a sine wave and animate it by updating renderer state."}],"role":"pseudoSymbol","kind":"section","title":"Create the view","type":"section","url":"\/tutorials\/adaengine\/animatedtext#Create-the-view"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics#Add-a-button-and-state":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Add-a-button-and-state","abstract":[{"type":"text","text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state."}],"role":"pseudoSymbol","kind":"section","title":"Add a button and state","type":"section","url":"\/tutorials\/adaengine\/uibasics#Add-a-button-and-state"},"GP-2-2-system.swift":{"syntax":"swift","fileName":"GamepadInputSystem.swift","content":["import AdaEngine","","@PlainSystem","struct GamepadInputSystem {","","    @FilterQuery<Ref<Transform>, With<PlayerComponent>>","    private var playerQuery","","    @Res<Input>","    private var input","","    @Res<DeltaTime>","    private var deltaTime","","    init(world _: World) {}","","    func update(context _: UpdateContext) {","        let gamepads = input.getConnectedGamepads()","","        if gamepads.isEmpty {","            return","        }","","        for gamepad in gamepads {","            \/\/ Handle per-gamepad input","        }","    }","}"],"type":"file","fileType":"swift","highlights":[],"identifier":"GP-2-2-system.swift"},"doc://AdaEngine/tutorials/AdaEngine/PlayerAndText#Add-Player-component":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Player-component","abstract":[{"type":"text","text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene."}],"role":"pseudoSymbol","kind":"section","title":"Add Player component","type":"section","url":"\/tutorials\/adaengine\/playerandtext#Add-Player-component"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Base-of-Event-Subscriber-pattern":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Base-of-Event-Subscriber-pattern","abstract":[{"type":"text","text":"In this tutorial you will learn about the event listeners system in Ada."},{"type":"text","text":" "},{"type":"text","text":"How can you catch events and process them"}],"role":"pseudoSymbol","kind":"section","title":"Base of Event-Subscriber pattern","type":"section","url":"\/tutorials\/adaengine\/eventlisteners#Base-of-Event-Subscriber-pattern"},"GP-2-3-system.swift":{"syntax":"swift","fileName":"GamepadInputSystem.swift","content":["import AdaEngine","","@PlainSystem","struct GamepadInputSystem {","","    @FilterQuery<Ref<Transform>, With<PlayerComponent>>","    private var playerQuery","","    @Res<Input>","    private var input","","    @Res<DeltaTime>","    private var deltaTime","","    init(world _: World) {}","","    func update(context _: UpdateContext) {","        let gamepads = input.getConnectedGamepads()","","        if gamepads.isEmpty {","            return","        }","","        for gamepad in gamepads {","            if gamepad.isGamepadButtonPressed(.a) {","                print(\"Gamepad \\(gamepad.gamepadId): Button A pressed\")","            }","","            if gamepad.isGamepadButtonPressed(.b) {","                print(\"Gamepad \\(gamepad.gamepadId): Button B pressed\")","            }","        }","    }","}"],"type":"file","fileType":"swift","highlights":[{"line":25},{"line":26},{"line":27},{"line":28},{"line":29},{"line":30},{"line":31}],"identifier":"GP-2-3-system.swift"},"GP-2-5-system.swift":{"fileName":"GamepadInputSystem.swift","content":["import AdaEngine","","@PlainSystem","struct GamepadInputSystem {","","    @FilterQuery<Ref<Transform>, With<PlayerComponent>>","    private var playerQuery","","    @Res<Input>","    private var input","","    @Res<DeltaTime>","    private var deltaTime","","    init(world _: World) {}","","    func update(context _: UpdateContext) {","        let gamepads = input.getConnectedGamepads()","","        if gamepads.isEmpty {","            return","        }","","        for gamepad in gamepads {","            let leftStickX = gamepad.getAxisValue(.leftStickX)","            let leftStickY = gamepad.getAxisValue(.leftStickY)","            let deadzone: Float = 0.1","","            if abs(leftStickX) > deadzone || abs(leftStickY) > deadzone {","                playerQuery.forEach { transform in","                    let speed: Float = 2.0","                    transform.position.x += leftStickX * Float(deltaTime.deltaTime) * speed","                    transform.position.y -= leftStickY * Float(deltaTime.deltaTime) * speed","                }","            }","","            if gamepad.isGamepadButtonPressed(.x) {","                gamepad.rumble(lowFrequency: 0.5, highFrequency: 0.75, duration: 0.5)","            }","        }","    }","}"],"identifier":"GP-2-5-system.swift","syntax":"swift","type":"file","fileType":"swift","highlights":[{"line":36},{"line":37},{"line":38},{"line":39}]},"Xcode 26.3 or later":{"title":"Xcode 26.3 or later","type":"xcodeRequirement","identifier":"Xcode 26.3 or later","url":"https:\/\/developer.apple.com\/download\/"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Read-buttons":{"abstract":[{"text":"Build a small scene that spawns a player entity and moves it with a gamepad.","type":"text"}],"role":"pseudoSymbol","kind":"section","url":"\/tutorials\/adaengine\/gamepadinput#Read-buttons","type":"section","title":"Read buttons","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Read-buttons"},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Prepare-layout-helpers":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Prepare-layout-helpers","abstract":[{"type":"text","text":"Create a custom "},{"type":"codeVoice","code":"TextRenderer"},{"type":"text","text":" that draws text along a sine wave and animate it by updating renderer state."}],"role":"pseudoSymbol","kind":"section","title":"Prepare layout helpers","type":"section","url":"\/tutorials\/adaengine\/animatedtext#Prepare-layout-helpers"},"doc://AdaEngine/tutorials/AdaEngine/Create-your-first-2D-game-project.":{"abstract":[],"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project.","role":"article","type":"topic","title":"Create your first 2D game project.","kind":"article","url":"\/tutorials\/adaengine\/create-your-first-2d-game-project."},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene":{"abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}],"url":"\/tutorials\/adaengine\/createfirst2dscene","role":"project","type":"topic","title":"Create your first 2D scene","kind":"project","est