,"abstract":[{"text":"An upright capsule mover. Its entity’s position is the bottom of the capsule in world units.","type":"text"},{"text":" ","type":"text"},{"text":"Use on a root entity without ","type":"text"},{"code":"PhysicsBody3DComponent","type":"codeVoice"},{"text":"; visual scale does not resize the capsule.","type":"text"},{"text":" ","type":"text"},{"text":"The controller collides with physics bodies, ignores sensors, and does not push dynamic bodies","type":"text"},{"text":" ","type":"text"},{"text":"or register a body that other character controllers can collide with.","type":"text"},{"text":" ","type":"text"},{"text":"Supported walking automatically steps over solid ledges up to 5% of the resolved height,","type":"text"},{"text":" ","type":"text"},{"text":"provided the full capsule can sweep up, forward, and down to a walkable landing.","type":"text"}],"kind":"symbol","role":"symbol","url":"\/documentation\/adaphysics\/charactercontroller3dcomponent","navigatorTitle":[{"text":"CharacterController3DComponent","kind":"identifier"}]},"doc://AdaPhysics/documentation/AdaPhysics":{"role":"collection","url":"\/documentation\/adaphysics","title":"AdaPhysics","identifier":"doc:\/\/AdaPhysics\/documentation\/AdaPhysics","kind":"symbol","abstract":[],"type":"topic"},"doc://AdaPhysics/documentation/AdaPhysics/CharacterController3DComponent/init(from:)":{"role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Decoder","preciseIdentifier":"s:s7DecoderP","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"url":"\/documentation\/adaphysics\/charactercontroller3dcomponent\/init(from:)","title":"init(from:)","kind":"symbol","identifier":"doc:\/\/AdaPhysics\/documentation\/AdaPhysics\/CharacterController3DComponent\/init(from:)","abstract":[],"type":"topic"}}}