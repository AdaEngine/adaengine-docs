{"variants":[{"paths":["\/documentation\/adascripting\/adascripttesting"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTesting"},"kind":"article","metadata":{"title":"Testing Ada Script","roleHeading":"API Collection","modules":[{"name":"Ada Script"}],"role":"collectionGroup"},"hierarchy":{"paths":[["doc:\/\/AdaScripting\/documentation\/AdaScripting"]]},"seeAlsoSections":[{"generated":true,"title":"ECS Integration","identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptDiagnosticsAndPerformance"],"anchor":"ECS-Integration"}],"abstract":[{"type":"text","text":"Write tests next to your gameplay code, run them with "},{"type":"codeVoice","code":"swift test"},{"type":"text","text":" or a command, and keep them out of shipped builds."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"text":"A function annotated with ","type":"text"},{"code":"@test","type":"codeVoice"},{"text":" is a test. It takes no parameters and may sit in any ","type":"text"},{"code":".ada","type":"codeVoice"},{"text":" file, where it can see that file’s ","type":"text"},{"code":"private","type":"codeVoice"},{"text":" declarations, or under a ","type":"text"},{"type":"codeVoice","code":"Tests\/"},{"text":" directory, where it sees public declarations only.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"ada","code":["@system(id: \"gravity\")","class GravitySystem {","    @query(Body)","    var bodies;","","    func update(context) { \/* … *\/ }","}","","private func clampSpeed(speed) { return Math.max(speed, -50.0); }","","@test(\"speed is capped\")","func speedIsCapped() {","    expectEqual(clampSpeed(-100.0), -50.0);","}"]},{"anchor":"Assertions","type":"heading","level":3,"text":"Assertions"},{"inlineContent":[{"code":"expect(condition)","type":"codeVoice"},{"type":"text","text":", "},{"code":"expectEqual(actual, expected)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"expectNear(actual, expected, tolerance)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"expectNil(value)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"fail(message)","type":"codeVoice"},{"text":" record a failure and let the test continue. ","type":"text"},{"code":"require(condition)","type":"codeVoice"},{"text":" records a failure and ends the test. Each failure is reported as ","type":"text"},{"type":"codeVoice","code":"path:line:column: message"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"TestWorld","text":"TestWorld","type":"heading","level":3},{"inlineContent":[{"type":"codeVoice","code":"TestWorld()"},{"text":" creates an isolated world with the module’s components and systems. Time moves only when the test says so.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Run synchronous ","type":"text"},{"type":"codeVoice","code":"TestWorld"},{"text":" steps on the host. Browser players cannot block their","type":"text"},{"text":" ","type":"text"},{"text":"single thread while awaiting the scheduler; they report a diagnostic if asked to","type":"text"},{"text":" ","type":"text"},{"text":"step a test world. Gameplay systems continue through the normal async frame loop.","type":"text"}],"type":"paragraph"},{"syntax":"ada","type":"codeListing","code":["@test(\"a body falls\")","func falls() {","    var world = TestWorld();","    var body = world.spawn([Body(y: 10.0, speed: 0.0)]);","    world.run(30);","    expect(world.read(body, \"Body\", \"y\") < 10.0);","}"]},{"items":[{"content":[{"inlineContent":[{"code":"spawn(components)","type":"codeVoice"},{"type":"text","text":", "},{"code":"insert(entity, component)","type":"codeVoice"},{"type":"text","text":", "},{"code":"remove(entity, name)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"despawn(entity)","type":"codeVoice"},{"type":"text","text":" change entities at once."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"has(entity, name)","type":"codeVoice"},{"type":"text","text":", "},{"code":"read(entity, name, field)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"count(name)","type":"codeVoice"},{"type":"text","text":" inspect them."}]}]},{"content":[{"inlineContent":[{"code":"run(ticks)","type":"codeVoice"},{"text":" installs every system and runs fixed 1\/60 s ticks. ","type":"text"},{"code":"runSystem(System, ticks)","type":"codeVoice"},{"text":" installs only that system. ","type":"text"},{"code":"advance(seconds)","type":"codeVoice"},{"text":" runs one step of an exact length.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Each test gets its own world. Module-level ","type":"text"},{"code":"var","type":"codeVoice"},{"text":" values that are numbers, booleans, strings or null are restored after each test; lists and maps are not.","type":"text"}],"type":"paragraph"},{"level":3,"text":"The Tests directory","anchor":"The-Tests-directory","type":"heading"},{"inlineContent":[{"text":"Files under ","type":"text"},{"code":"Tests\/","type":"codeVoice"},{"text":" are compiled only when tests run, and gameplay code cannot import from them.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Running tests","anchor":"Running-tests","type":"heading"},{"inlineContent":[{"type":"text","text":"Load a project with tests and run it from Swift:"}],"type":"paragraph"},{"code":["let plugin = try AdaScriptPlugin(sources: sources, name: \"Game\", includeTests: true)","let results = plugin.runTests()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"or point "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestProject"},{"type":"text","text":" at a directory, which picks up every "},{"type":"codeVoice","code":".ada"},{"type":"text","text":" file, and render the outcome with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestReport"},{"type":"text","text":" as text, JUnit or JSON. The "},{"type":"codeVoice","code":"AdaScriptTest"},{"type":"text","text":" command does the same from a terminal and exits non-zero on failure:"}],"type":"paragraph"},{"code":["swift run AdaScriptTest Path\/To\/Project --format junit"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"Production modules never contain tests. Loading without ","type":"text"},{"type":"codeVoice","code":"includeTests"},{"text":" removes every ","type":"text"},{"code":"@test","type":"codeVoice"},{"text":" function and the ","type":"text"},{"code":"Tests\/","type":"codeVoice"},{"text":" directory, and reports any gameplay code that refers to a test-only name such as ","type":"text"},{"code":"expect","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"TestWorld","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"topicSections":[{"title":"Running tests","identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestProject","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestReport","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestCase","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestResult"],"anchor":"Running-tests"}],"references":{"doc://AdaScripting/documentation/AdaScripting/AdaScriptTestResult":{"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"AdaScriptTestResult"}],"abstract":[{"type":"text","text":"The outcome of running one "},{"code":"@test","type":"codeVoice"},{"type":"text","text":" function."}],"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestResult","title":"AdaScriptTestResult","url":"\/documentation\/adascripting\/adascripttestresult","navigatorTitle":[{"kind":"identifier","text":"AdaScriptTestResult"}],"role":"symbol"},"doc://AdaScripting/documentation/AdaScripting":{"url":"\/documentation\/adascripting","title":"Ada Script","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting","kind":"symbol","abstract":[{"text":"Write gameplay systems in Ada Script while keeping entity filtering and access planning in AdaEngine’s native ECS.","type":"text"}],"type":"topic","role":"collection"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptTestProject":{"type":"topic","url":"\/documentation\/adascripting\/adascripttestproject","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestProject","navigatorTitle":[{"text":"AdaScriptTestProject","kind":"identifier"}],"title":"AdaScriptTestProject","abstract":[{"text":"Runs the ","type":"text"},{"code":"@test","type":"codeVoice"},{"text":" functions of an Ada Script project on disk (ADR-0024).","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptTestProject","kind":"identifier"}]},"doc://AdaScripting/documentation/AdaScripting/AdaScriptECS":{"abstract":[{"type":"text","text":"Declare annotation-driven systems and iterate native AdaECS component columns."}],"title":"Ada Script ECS","type":"topic","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS","kind":"article","url":"\/documentation\/adascripting\/adascriptecs","role":"article"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptTestReport":{"title":"AdaScriptTestReport","type":"topic","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptTestReport","kind":"identifier"}],"url":"\/documentation\/adascripting\/adascripttestreport","navigatorTitle":[{"text":"AdaScriptTestReport","kind":"identifier"}],"abstract":[{"type":"text","text":"Text, JUnit and JSON renderings of test results, for terminals and CI."}],"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestReport","kind":"symbol"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptDiagnosticsAndPerformance":{"title":"Ada Script Diagnostics and Performance","type":"topic","role":"article","url":"\/documentation\/adascripting\/adascriptdiagnosticsandperformance","abstract":[{"type":"text","text":"Understand annotation, setup, and runtime failures and keep ECS work on the"},{"type":"text","text":" "},{"type":"text","text":"native chunk path."}],"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptDiagnosticsAndPerformance","kind":"article"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptTestCase":{"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptTestCase","kind":"identifier"}],"abstract":[{"text":"One ","type":"text"},{"code":"@test","type":"codeVoice"},{"text":" function discovered in an Ada Script module (ADR-0024).","type":"text"}],"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestCase","title":"AdaScriptTestCase","url":"\/documentation\/adascripting\/adascripttestcase","navigatorTitle":[{"text":"AdaScriptTestCase","kind":"identifier"}],"role":"symbol"}}}