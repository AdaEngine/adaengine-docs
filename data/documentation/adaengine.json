]},{"content":[{"inlineContent":[{"type":"text","text":"Cross-platform support across Apple platforms and Linux"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Hot-reload capabilities for assets and scripts"}]}]},{"content":[{"inlineContent":[{"text":"Modern Swift API with async\/await, property wrappers, and result builders","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"With Ada, both beginners and experienced Swift developers can build games rapidly, focusing on gameplay instead of low-level boilerplate. Extensive documentation and tutorials make it easy to get started, from setting up your first scene to advanced gameplay mechanics."}]},{"type":"paragraph","inlineContent":[{"text":"Ada is actively developed, and contributions from the community are welcome.","type":"text"},{"text":" ","type":"text"},{"text":"For more details and guides, check out the tutorials below.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"anchor":"Tutorials","title":"Tutorials","identifiers":["doc:\/\/AdaEngine\/documentation\/AdaEngine"]},{"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/AdaEngine\/documentation\/AdaEngine\/Building","doc:\/\/AdaEngine\/documentation\/AdaEngine\/Contributing","doc:\/\/AdaEngine\/documentation\/AdaEngine\/AdaUIIdentity","doc:\/\/AdaEngine\/documentation\/AdaEngine\/VisionOSWindowed"]},{"anchor":"Articles","title":"Articles","identifiers":["doc:\/\/AdaEngine\/documentation\/AdaEngine\/HowToBuildEngine","doc:\/\/AdaEngine\/documentation\/AdaEngine\/SPMDebug","doc:\/\/AdaEngine\/documentation\/AdaEngine\/MakeTutorials"],"generated":true},{"anchor":"Classes","title":"Classes","identifiers":["doc:\/\/AdaEngine\/documentation\/AdaEngine\/AdaUIDebug3DResource","doc:\/\/AdaEngine\/documentation\/AdaEngine\/AdaUIDebug3DVisibility","doc:\/\/AdaEngine\/documentation\/AdaEngine\/FPSCounter"],"genera