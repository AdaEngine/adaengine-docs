{"identifier":{"url":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Use Ada Script syntax with AdaEngine declaration annotations."}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adascripting\/adascriptlanguage"]}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"Ada Script"}],"title":"Ada Script Language"},"seeAlsoSections":[{"anchor":"Essentials","title":"Essentials","generated":true,"identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/AdaScripting\/documentation\/AdaScripting"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Source files","level":2,"anchor":"Source-files"},{"inlineContent":[{"text":"Ada Script uses ","type":"text"},{"code":".ada","type":"codeVoice"},{"text":" files. A file contains classes,","type":"text"},{"text":" ","type":"text"},{"text":"functions, variables, and control flow. Ada Script modules do not declare a","type":"text"},{"text":" ","type":"text"},{"code":"main()","type":"codeVoice"},{"text":" function and do not assemble plugin manifests.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"ada","code":["@system(scheduler: \"update\")","class CounterSystem {","    @query(Counter)","    var counters;","","    func update(context) {","        for (var entity in counters) {","            entity.counter.value += 1;","        }","    }","}"]},{"type":"heading","text":"Imports","level":2,"anchor":"Imports"},{"inlineContent":[{"text":"Files with discovery annotations such as ","type":"text"},{"code":"@system","type":"codeVoice"},{"text":" are module roots. Import a","type":"text"},{"text":" ","type":"text"},{"text":"helper declaration explicitly from another target-relative source file:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"ada","code":["import {","    clampSpeed,","    MovementSettings","} from \"..\/Shared\/Movement\";"]},{"inlineContent":[{"text":"Relative imports are resolved from the importing file. The ","type":"text"},{"code":".ada","type":"codeVoice"},{"text":" extension is","type":"text"},{"text":" ","type":"text"},{"text":"optional. Absolute paths and imports which escape the Swift target source map","type":"text"},{"text":" ","type":"text"},{"text":"are rejected. A reachable source is compiled once, and an import cycle reports","type":"text"},{"text":" ","type":"text"},{"text":"the complete cycle.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The current implementation supports selected relative imports. Namespace","type":"text"},{"text":" ","type":"text"},{"text":"imports, public\/private visibility enforcement, and the ","type":"text"},{"code":"AdaEngine","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"AdaUI","type":"codeVoice"},{"text":" ","type":"text"},{"text":"virtual-module declarations remain part of the next module-language slice.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Annotations","level":2,"anchor":"Annotations"},{"inlineContent":[{"text":"Ada Script declaration annotations have three forms:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"ada","code":["@name","@name(value)","@name(key: value, other: [a, b])"]},{"inlineContent":[{"text":"Arguments are compile-time constants or symbolic identifiers. They do not run","type":"text"},{"text":" ","type":"text"},{"text":"user code during module discovery.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The initial AdaEngine annotations are:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"@system","type":"codeVoice"},{"text":" for ECS systems;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"@query","type":"codeVoice"},{"text":" for native ECS iterators;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"@access","type":"codeVoice"},{"text":" for explicit scheduler access;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"@component","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@resource","type":"codeVoice"},{"text":" for generated data declarations;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"@scriptable","type":"codeVoice"},{"text":" for attached script objects;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"@view","type":"codeVoice"},{"text":" for declarative AdaUI views;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"@previewable","type":"codeVoice"},{"text":" for AdaUI views exposed in AdaEditor Preview;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"@state","type":"codeVoice"},{"text":" for state owned by an Ada Script view;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"@environment","type":"codeVoice"},{"text":" for read-only AdaUI environment values;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"@export","type":"codeVoice"},{"text":" for persistent and inspectable fields.","type":"text"}]}]}]},{"type":"heading","text":"Script-defined data","level":2,"anchor":"Script-defined-data"},{"inlineContent":[{"text":"The build plugin generates native backing types for scalar component and","type":"text"},{"text":" ","type":"text"},{"text":"resource schemas:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"ada","code":["@component(id: \"game.health\")","struct Health {","    @export var current = 100.0;","    @export var maximum = 120;","}","","@resource(id: \"game.balance\", autoInsert: true)","struct GameBalance {","    @export var acceleration = 9.8;","}"]},{"inlineContent":[{"text":"The first schema slice supports ","type":"text"},{"code":"Bool","type":"codeVoice"},{"text":", signed ","type":"text"},{"code":"Int64","type":"codeVoice"},{"text":", finite ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" defaults. Generated Swift symbol names are private implementation","type":"text"},{"text":" ","type":"text"},{"text":"details. Runtime lookup accepts both the Ada Script declaration name (","type":"text"},{"code":"Health","type":"codeVoice"},{"text":") and","type":"text"},{"text":" ","type":"text"},{"text":"the stable ID (","type":"text"},{"code":"game.health","type":"codeVoice"},{"text":"). ","type":"text"},{"code":"autoInsert: true","type":"codeVoice"},{"text":" inserts the generated resource","type":"text"},{"text":" ","type":"text"},{"text":"before systems are installed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Bind a resource directly on a system with ","type":"text"},{"code":"@res","type":"codeVoice"},{"text":". The binding uses a native ECS","type":"text"},{"text":" ","type":"text"},{"text":"resource pointer during ","type":"text"},{"code":"update(context)","type":"codeVoice"},{"text":"; field writes update the resource","type":"text"},{"text":" ","type":"text"},{"text":"change tick:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"ada","code":["@system(id: \"physics.system\")","class PhysicsSystem {","    @res","    var balance: GameBalance;","","    func update(context) {","        balance.acceleration += 0.1;","    }","}"]},{"inlineContent":[{"text":"A missing required resource is reported through plugin diagnostics. Optional","type":"text"},{"text":" ","type":"text"},{"text":"resources can be guarded with ","type":"text"},{"code":"available()","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"ada","code":["@res(optional: true)","var debugSettings: DebugSettings;","","if (debugSettings.available()) {","    debugSettings.enabled = true;","}"]},{"inlineContent":[{"text":"Resource access is currently conservative: each ","type":"text"},{"code":"@res","type":"codeVoice"},{"text":" requests scheduler write","type":"text"},{"text":" ","type":"text"},{"text":"access. Static read\/write inference and explicit access overrides are planned.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"World commands","level":2,"anchor":"World-commands"},{"inlineContent":[{"text":"Systems receive a capability-scoped world facade. Structural changes are","type":"text"},{"text":" ","type":"text"},{"text":"queued through ","type":"text"},{"code":"context.world.commands","type":"codeVoice"},{"text":" and applied only after the current","type":"text"},{"text":" ","type":"text"},{"text":"system parameters finish, so an active query iterator cannot be invalidated:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"ada","code":["@system(id: \"cleanup.system\")","class CleanupSystem {","    @query(Expired)","    var expired;","","    func update(context) {","        for (var entity in expired) {","            context.world.commands.despawn(entity.id);","        }","    }","}"]},{"inlineContent":[{"text":"The initial command API creates registered component defaults by Ada Script name","type":"text"},{"text":" ","type":"text"},{"text":"or stable ID:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"ada","code":["var entity = context.world.commands.spawn([\"game.health\"]);","context.world.commands.insert(entity, \"game.poison\");","context.world.commands.remove(entity, \"game.poison\");","context.world.commands.despawn(entity);"]},{"inlineContent":[{"text":"Direct command use is inferred per system and declares deferred-world access to","type":"text"},{"text":" ","type":"text"},{"text":"the scheduler. Command facades expire when ","type":"text"},{"code":"update(context)","type":"codeVoice"},{"text":" returns; using a","type":"text"},{"text":" ","type":"text"},{"text":"retained or undeclared facade reports a plugin diagnostic and performs no","type":"text"},{"text":" ","type":"text"},{"text":"mutation. Component constructor arguments, explicit dynamic ","type":"text"},{"code":"@access","type":"codeVoice"},{"text":", events,","type":"text"},{"text":" ","type":"text"},{"text":"assets, UI commands, and exclusive immediate world access are planned.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Script-defined data requires ","type":"text"},{"code":"AdaScriptBuildPlugin","type":"codeVoice"},{"text":"; manual runtime-only source","type":"text"},{"text":" ","type":"text"},{"text":"loading cannot introduce a new native Swift layout.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Swift and Editor tooling can attach the generated default without naming its","type":"text"},{"text":" ","type":"text"},{"text":"private backing type:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["world.insertDefaultComponent(named: \"game.health\", into: entity.id)"]},{"inlineContent":[{"text":"Generated-component dynamic mutation\/removal and scene coding, vectors, colors,","type":"text"},{"text":" ","type":"text"},{"text":"enums, entity references, and asset references are not part of that data-schema","type":"text"},{"text":" ","type":"text"},{"text":"slice yet.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Scriptable-objects","text":"Scriptable objects","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"@scriptable"},{"text":" for low-cardinality behavior attached to one entity. Systems","type":"text"},{"text":" ","type":"text"},{"text":"remain the scalable path for processing large entity sets.","type":"text"}]},{"code":["@scriptable(","    id: \"game.player-controller\",","    version: 2,","    aliases: [\"PlayerController\"]",")","class PlayerController {","    @export var speed = 8.0;","    @component(required: true) var transform: Transform;","    @res(optional: true) var settings: PlayerSettings;","","    func ready(context) {}","","    func update(context) {","        transform.position += speed * context.deltaTime;","    }","","    func fixedUpdate(context) {}","    func event(events, context) {}","    func destroy(context) {}","}"],"type":"codeListing","syntax":"ada"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The build plugin registers stable IDs, versions, aliases, exported scalar"},{"type":"text","text":" "},{"text":"defaults, and transient component\/resource bindings. Required components are","type":"text"},{"type":"text","text":" "},{"text":"checked before ","type":"text"},{"type":"codeVoice","code":"ready"},{"type":"text","text":". Optional resources expose "},{"type":"codeVoice","code":"available()"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ScriptableComponents"},{"text":" encodes a polymorphic envelope containing only ","type":"text"},{"code":"type","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"version","type":"codeVoice"},{"text":", and detached ","type":"text"},{"code":"payload","type":"codeVoice"},{"text":". Entity bindings, resources, VM instances,","type":"text"},{"text":" ","type":"text"},{"text":"world contexts, and lifecycle state are never serialized. Decoding does not run","type":"text"},{"text":" ","type":"text"},{"text":"gameplay; attachment runs ","type":"text"},{"code":"ready","type":"codeVoice"},{"text":" once and detachment runs ","type":"text"},{"code":"destroy","type":"codeVoice"},{"text":" once.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Scriptable contexts expose the same expiring deferred commands facade as","type":"text"},{"text":" ","type":"text"},{"text":"systems. Retaining it after a callback produces a diagnostic. Scriptable","type":"text"},{"text":" ","type":"text"},{"text":"objects intentionally have no immediate-mode GUI callback; declarative UI","type":"text"},{"text":" ","type":"text"},{"text":"belongs to AdaUI script views.","type":"text"}]},{"level":2,"anchor":"AdaUI-views","text":"AdaUI views","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"@view","type":"codeVoice"},{"text":" on a class whose ","type":"text"},{"code":"body()","type":"codeVoice"},{"text":" contains declarative AdaUI expressions.","type":"text"},{"text":" ","type":"text"},{"text":"Add ","type":"text"},{"code":"@previewable","type":"codeVoice"},{"text":" when that view should appear in AdaEditor Preview. See","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptViews","type":"reference","isActive":true},{"text":" for the supported view constructors, modifiers, and","type":"text"},{"text":" ","type":"text"},{"text":"preview workflow.","type":"text"}]},{"level":2,"anchor":"System-context","text":"System context","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"update(context)","type":"codeVoice"},{"text":" receives a scoped system context. ","type":"text"},{"code":"context.deltaTime","type":"codeVoice"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"current scheduler delta. Context and query values must not be retained after","type":"text"},{"text":" ","type":"text"},{"text":"the callback.","type":"text"}]},{"level":2,"anchor":"State","text":"State","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Fields on a system instance persist between scheduler updates:","type":"text"}]},{"code":["@system(scheduler: \"update\")","class LifetimeSystem {","    var elapsed = 0.0;","","    func update(context) {","        elapsed += context.deltaTime;","    }","}"],"type":"codeListing","syntax":"ada"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use local variables for per-call calculations. Store ECS gameplay state in"},{"type":"text","text":" "},{"type":"text","text":"components and shared singleton state in resources rather than global mutable"},{"type":"text","text":" "},{"type":"text","text":"variables."}]},{"level":2,"anchor":"Values-crossing-the-bridge","text":"Values crossing the bridge","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Ada Script bridge values are detached booleans, integers, finite floating-point","type":"text"},{"text":" ","type":"text"},{"text":"numbers, strings, lists, and null. ECS component views are borrowed native","type":"text"},{"text":" ","type":"text"},{"text":"capabilities rather than detached values.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Unsupported values and invalid numeric conversions are rejected without","type":"text"},{"text":" ","type":"text"},{"text":"partially mutating a component.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"System ","type":"text"},{"type":"codeVoice","code":"update(context)"},{"text":" callbacks are command-style. Their return values are","type":"text"},{"type":"text","text":" "},{"type":"text","text":"ignored; observable behavior belongs in components, resources, events, or"},{"text":" ","type":"text"},{"text":"diagnostics.","type":"text"}]}]}],"references":{"doc://AdaScripting/documentation/AdaScripting/AdaScriptViews":{"role":"article","type":"topic","kind":"article","url":"\/documentation\/adascripting\/adascriptviews","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptViews","title":"AdaUI Views in Ada Script","abstract":[{"type":"text","text":"Declare native AdaUI view trees in "},{"type":"codeVoice","code":".ada"},{"type":"text","text":" files and preview them directly in AdaEditor."}]},"doc://AdaScripting/documentation/AdaScripting/GettingStartedWithAdaScript":{"role":"article","type":"topic","kind":"article","url":"\/documentation\/adascripting\/gettingstartedwithadascript","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript","title":"Getting Started with Ada Script","abstract":[{"type":"text","text":"Add an "},{"type":"codeVoice","code":".ada"},{"type":"text","text":" file to an AdaEngine executable and run its systems without manually loading each script."}]},"doc://AdaScripting/documentation/AdaScripting":{"role":"collection","type":"topic","kind":"symbol","url":"\/documentation\/adascripting","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting","title":"Ada Script","abstract":[{"type":"text","text":"Write gameplay systems in Ada Script while keeping entity filtering and access planning in AdaEngine’s native ECS."}]}}}