PlayerAndText#Add-Text-component","title":"Add Text component","abstract":[{"type":"text","text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene."}],"kind":"section","role":"pseudoSymbol"},"PAT-2-2-makeScore.swift":{"type":"file","highlights":[],"identifier":"PAT-2-2-makeScore.swift","content":["import AdaEngine","","func makeScore(in app: borrowing AppWorlds) throws {","    var container = TextAttributeContainer()","    container.foregroundColor = .white","    let attributedText = AttributedText(\"Score: 0\", attributes: container)","","    app.main.spawn(\"Score\") {","        TextComponent(text: attributedText)","        Transform(position: [0, -500, 0])","    }","","    app.insertResource(GameState())","}"],"fileName":"MakeScore.swift","syntax":"swift","fileType":"swift"},"PAT-1-4-makePlayer.swift":{"syntax":"swift","fileName":"MakePlayer.swift","type":"file","fileType":"swift","content":["import AdaEngine","","func makePlayer(in world: World) {","    world.spawn {","        PlayerComponent()","        Transform(position: [0, -300, 0])","    }","}"],"identifier":"PAT-1-4-makePlayer.swift","highlights":[{"line":3},{"line":6}]},"doc://AdaEngine/tutorials/AdaEngine/UIBasics#Create-the-app-shell":{"url":"\/tutorials\/adaengine\/uibasics#Create-the-app-shell","type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Create-the-app-shell","title":"Create the app shell","abstract":[{"text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state.","type":"text"}],"kind":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Make-it-move":{"abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}],"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Make-it-move","title":"Make it move","role":"pseudoSymbol","kind":"section","url":"\/tutorials\/adaengine\/createfirst2dscene#Make-it-move","type":"section"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Create-the-input-system":{"url":"\/tutorials\/adaengine\/gamepadinput#Create-the-input-system","type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Create-the-input-system","title":"Create the input system","abstract":[{"type":"text","text":"Build a small scene that spawns a player entity and moves it with a gamepad."}],"kind":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput":{"abstract":[{"type":"text","text":"Build a small scene that spawns a player entity and moves it with a gamepad."}],"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput","title":"Gamepad Input","role":"project","kind":"project","url":"\/tutorials\/adaengine\/gamepadinput","estimatedTime":"20min","type":"topic"},"doc://AdaEngine/tutorials/AdaEngine/CreateProject#Create-project-using-Xcode":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject#Create-project-using-Xcode","abstract":[{"text":"In this tutorial, you will learn how to create your first Ada project.","type":"text"}],"title":"Create project using Xcode","role":"pseudoSymbol","kind":"section","url":"\/tutorials\/adaengine\/createproject#Create-project-using-Xcode","type":"section"},"PAT-1-6-makeScene.swift":{"identifier":"PAT-1-6-makeScene.swift","fileType":"swift","fileName":"PlayerAndTextPlugin.swift","type":"file","highlights":[],"content":["import AdaEngine","","struct PlayerAndTextPlugin: Plugin {","    let characterAtlas: TextureAtlas","","    func setup(in app: borrowing AppWorlds) {","        self.makePlayer(in: app.main)","    }","","    private func makePlayer(in world: World) {","        world.spawn {","            PlayerComponent()","            Transform(position: [0, -300, 0])","            Sprite(texture: characterAtlas[7, 1], size: Size(width: 24, height: 24))","        }","    }","}"],"syntax":"swift"},"doc://AdaEngine/tutorials/AdaEngine/CreateProject":{"abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first Ada project."}],"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject","title":"Create your first game project","role":"project","kind":"project","url":"\/tutorials\/adaengine\/createproject","estimatedTime":"5min","type":"topic"},"doc://AdaEngine/tutorials/AdaEngine/PlayerAndText":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText","abstract":[{"text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene.","type":"text"}],"title":"Player and Text in Ada","role":"project","kind":"project","url":"\/tutorials\/adaengine\/playerandtext","estimatedTime":"5min","type":"topic"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Create-an-app":{"url":"\/tutorials\/adaengine\/createfirst2dscene#Create-an-app","type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-an-app","title":"Create an app","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}],"kind":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Intro":{"url":"\/tutorials\/adaengine\/createfirst2dscene#Intro","type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Intro","title":"Intro","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}],"kind":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics":{"abstract":[{"type":"text","text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state."}],"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics","title":"UI Basi