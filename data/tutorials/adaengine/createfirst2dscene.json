{"sections":[{"estimatedTimeInMinutes":20,"xcodeRequirement":"Xcode 26.2 or later","title":"Create your first 2D scene","content":[{"type":"paragraph","inlineContent":[{"text":"In this tutorial, you will learn how to create your first 2D scene using Ada.","type":"text"}]}],"chapter":"Create your first 2D game project.","kind":"hero"},{"tasks":[{"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"text":"For the first 2D scene, we will try to repeat this example. We’ll look at adding a scene and a camera.","type":"text"},{"text":" ","type":"text"},{"text":"In addition, we’ll learn how to add sprites and movement systems.","type":"text"}]}],"media":"CF2G-3-5.mov","kind":"contentAndMedia","mediaPosition":"trailing"}],"title":"Intro","stepsSection":[],"anchor":"Intro"},{"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"text":"First, we need to create base files to launch our application.","type":"text"}]}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"title":"Create an app","stepsSection":[{"content":[{"type":"paragraph","inlineContent":[{"text":"In the previous tutorial, we’ve created an app and an empty window scene.","type":"text"}]}],"media":null,"runtimePreview":null,"caption":[],"type":"step","code":"CF2G-1-1-app.swift"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Let’s create the game logic. To do this, let’s create a file named ","type":"text"},{"type":"codeVoice","code":"FirstScene.swift"},{"text":" and import AdaEngine.","type":"text"},{"text":" ","type":"text"},{"text":"After that, create a struct named ","type":"text"},{"type":"codeVoice","code":"FirstScene"},{"text":" that conforms to ","type":"text"},{"type":"codeVoice","code":"Plugin"},{"text":" and add a method named ","type":"text"},{"type":"codeVoice","code":"setup(in app: AppWorlds)"},{"text":" where we will set up entities in our game world.","type":"text"}]}],"media":null,"runtimePreview":null,"caption":[],"type":"step","code":"CF2G-1-2-scene.swift"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Now add the ","type":"text"},{"type":"codeVoice","code":"FirstScene"},{"text":" plugin to the app using the ","type":"text"},{"type":"codeVoice","code":"addPlugins"},{"text":" method.","type":"text"}]}],"media":null,"runtimePreview":null,"caption":[],"type":"step","code":"CF2G-1-4-app.swift"}],"anchor":"Create-an-app"},{"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Ada uses the Entity Component System paradigm where all game objects are called ","type":"text"},{"type":"codeVoice","code":"Entity"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Entities are objects that store user or engine data like position, scale, mesh instance, audio, etc. This data is called components, and they should conform to the ","type":"text"},{"type":"codeVoice","code":"Component"},{"text":" protocol.","type":"text"},{"text":" ","type":"text"},{"text":"By default, ","type":"text"},{"type":"codeVoice","code":"Entity"},{"text":" is an empty object without any components.","type":"text"}]}],"kind":"contentAndMedia","mediaPosition":"trailing"},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Camera"},{"text":" is a component that determines where all entities will be rendered. Ada supports rendering to a texture or to the ","type":"text"},{"type":"codeVoice","code":"Window"},{"text":". We recommend using engine component bundles like ","type":"text"},{"type":"codeVoice","code":"Camera2D"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"Camera3D"},{"text":", because the engine provides additional components for rendering and audio capabilities.","type":"text"}]}],"kind":"fullWidth"}],"title":"Create a main camera.","stepsSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Let’s create our 2D camera. Spawn an entity with the "},{"type":"codeVoice","code":"Camera2D"},{"type":"text","text":" bundle."}]}],"media":null,"runtimePreview":null,"caption":[],"type":"step","code":"CF2G-2-1-camera.swift"},{"caption":[],"media":null,"type":"step","code":"CF2G-2-2-camera.swift","content":[{"inlineContent":[{"text":"Now let’s fill the camera background with a sky blue color.","type":"text"}],"type":"paragraph"}],"runtimePreview":"CF2G-2-1.png"}],"anchor":"Create-a-main-camera"},{"stepsSection":[{"caption":[],"media":"CF2G-3-1.png","type":"step","code":null,"content":[{"inlineContent":[{"text":"First, we should create an assets folder where we will store our game assets, like sprite sheets, sounds, shaders, etc. Let’s create a folder named ","type":"text"},{"type":"codeVoice","code":"Assets"},{"type":"text","text":" and add any sprite sheets you want. We will use this sprite sheet:"}],"type":"paragraph"}],"runtimePreview":null},{"caption":[{"type":"paragraph","inlineContent":[{"text":"You can download this texture by right-clicking on the image and saving it to the downloads folder.","type":"text"}]}],"media":"CF2G-3-2.png","type":"step","code":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In the end, we should have this file structure in our project. Ada doesn’t use xcassets."}]}],"runtimePreview":null},{"media":null,"code":"CF2G-3-1-sprite.swift","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Spawn a player entity in the game world. The player entity will store our sprite component and other player data in the future.","type":"text"}]}],"type":"step","caption":[]},{"code":"CF2G-3-2-sprite.swift","content":[{"type":"paragraph","inlineContent":[{"text":"Let’s create an image from a file using a special resource manager object. ","type":"text"},{"type":"codeVoice","code":"AssetsManager"},{"text":" manages and caches game and engine resources. In our case, we should load an image from a file named ","type":"text"},{"code":"characters_packed.png","type":"codeVoice"},{"text":" and use ","type":"text"},{"code":"Bundle.main","type":"codeVoice"},{"text":" as a search path.","type":"text"}]}],"runtimePreview":null,"type":"step","caption":[],"media":null},{"runtimePreview":null,"code":"CF2G-3-3-sprite.swift","type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"To split the sprite sheet image into sprites, we can use the ","type":"text"},{"type":"codeVoice","code":"TextureAtlas"},{"text":" object. This object takes an image, sprite size, and margin between sprites if needed. In our case, we have a margin between sprites of 4px horizontally and 1px vertically, and a sprite size of 20px width and 23px height.","type":"text"}]}],"caption":[],"media":null},{"media":null,"code":"CF2G-3-4-sprite.swift","content":[{"inlineContent":[{"type":"text","text":"Now we can add our sprite to the player entity using the "},{"code":"Sprite","type":"codeVoice"},{"text":" component. This component is efficient for rendering because it uses a special batching system and requires fewer drawing calls.","type":"text"}],"type":"paragraph"}],"type":"step","caption":[{"inlineContent":[{"type":"text","text":"Add a new sprite component to the entity in the "},{"code":"spawn","type":"codeVoice"},{"type":"text","text":" method. As you can see, we use subscripts in our "},{"code":"TextureAtlas","type":"codeVoice"},{"text":" instance where 7 is the column number in our sprite sheet and 1 is the row number.","type":"text"}],"type":"paragraph"}],"runtimePreview":"CF2G-3-3.png"},{"media":null,"code":"CF2G-3-5-sprite.swift","content":[{"inlineContent":[{"text":"And finally, let’s add a special ","type":"text"},{"type":"codeVoice","code":"Transform"},{"text":" component that describes the position of our entity on the screen.","type":"text"}],"type":"paragraph"}],"type":"step","caption":[],"runtimePreview":"CF2G-3-4.png"}],"title":"First sprite","contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"Now we can create our first custom sprite.","type":"text"}]}]}],"anchor":"First-sprite"},{"stepsSection":[{"media":null,"code":"CF2G-4-1-player.swift","content":[{"inlineContent":[{"text":"First, we should create a special tag component named ","type":"text"},{"type":"codeVoice","code":"PlayerComponent"},{"text":". We will use this component in the near future; it indicates that this entity is a player.","type":"text"}],"type":"paragraph"}],"type":"step","caption":[],"runtimePreview":null},{"media":null,"code":"CF2G-4-2-player.swift","content":[{"inlineContent":[{"text":"Create a new function named ","type":"text"},{"type":"codeVoice","code":"PlayerMovement"},{"text":" and annotate this function with the ","type":"text"},{"type":"codeVoice","code":"System"},{"text":" macro. This system will listen to user inputs and move our player component on the screen.","type":"text"}],"type":"paragraph"}],"type":"step","caption":[],"runtimePreview":null},{"media":null,"code":"CF2G-4-3-player.swift","content":[{"inlineContent":[{"text":"Add the new system to our game scene. The ","type":"text"},{"type":"codeVoice","code":"System"},{"text":" macro will create a new system with the same name as the function with the suffix ","type":"text"},{"type":"codeVoice","code":"System"},{"text":". Our system will be initialized once on app launch.","type":"text"}],"type":"paragraph"}],"type":"step","caption":[],"runtimePreview":null},{"media":null,"code":"CF2G-4-4-player.swift","content":[{"inlineContent":[{"text":"In ","type":"text"},{"type":"codeVoice","code":"PlayerMovementSystem"},{"text":", add a new function parameter named ","type":"text"},{"type":"codeVoice","code":"playerTransform"},{"text":" with the ","type":"text"},{"type":"codeVoice","code":"FilterQuery<Ref<Transform>, With<PlayerComponent>>"},{"text":" type.","type":"text"},{"text":" ","type":"text"},{"text":"This object will query the world and return components that conform to your predicate. In our case, we require one mutable component ","type":"text"},{"type":"codeVoice","code":"Transform"},{"text":" and a filter that indicates we need entities with the ","type":"text"},{"type":"codeVoice","code":"PlayerComponent"},{"text":".","type":"text"}],"type":"paragraph"}],"type":"step","caption":[],"runtimePreview":null},{"media":null,"code":"CF2G-4-5-player.swift","content":[{"inlineContent":[{"text":"Add a new function parameter named ","type":"text"},{"type":"codeVoice","code":"speed"},{"text":" with the ","type":"text"},{"type":"codeVoice","code":"Local<Float>"},{"text":" type. This is a special type that stores a value available only within the system.","type":"text"}],"type":"paragraph"}],"type":"step","caption":[],"runtimePreview":null},{"type":"paragraph","inlineContent":[{"text":"Now we can update our player position. Ada can handle keyboard inputs for us. We should listen to keyboard inputs, and if a key is pressed, we should change the player transform.","type":"text"}]},{"media":null,"code":"CF2G-4-6-player.swift","content":[{"inlineContent":[{"text":"Let’s add a new function parameter named ","type":"text"},{"type":"codeVoice","code":"deltaTime"},{"text":" with the ","type":"text"},{"type":"codeVoice","code":"Res<DeltaTime>"},{"text":" type and ","type":"text"},{"type":"codeVoice","code":"input"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"Res<Input>"},{"text":". These are queries to resources in the world.","type":"text"}],"type":"paragraph"}],"type":"step","caption":[{"inlineContent":[{"text":"Using the special ","type":"text"},{"type":"codeVoice","code":"Input"},{"text":" object, we can check if a key is pressed.","type":"text"},{"text":" ","type":"text"},{"text":"Add an ","type":"text"},{"type":"codeVoice","code":"if"},{"text":" condition where we will listen to the ","type":"text"},{"type":"codeVoice","code":"w"},{"text":" key. If the key is pressed, add the speed multiplied by delta time. We do this for a smooth transition between frames.","type":"text"}],"type":"paragraph"}],"runtimePreview":null},{"media":null,"code":"CF2G-4-7-player.swift","content":[{"inlineContent":[{"text":"Finally, add the same logic for other keys — ","type":"text"},{"type":"codeVoice","code":"a"},{"text":", ","type":"text"},{"type":"codeVoice","code":"s"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"d"},{"text":".","type":"text"}],"type":"paragraph"}],"type":"step","caption":[{"inlineContent":[{"text":"Run the app and try to move your player.","type":"text"}],"type":"paragraph"}],"runtimePreview":"CF2G-3-5.mov"}],"title":"Make it move","contentSection":[{"mediaPosition":"trailing","content":[{"inlineContent":[{"text":"We did a lot of work, but our scene looks very simple. We should add more life to our player entity. All game logic is described in special objects named ","type":"text"},{"type":"codeVoice","code":"System"},{"text":". A system is a unit that executes each game loop and manipulates entities and their data. We will use one to add life to our player.","type":"text"}],"type":"paragraph"}],"kind":"contentAndMedia"}],"anchor":"Make-it-move"}],"kind":"tasks"},{"featuredEyebrow":"Tutorial","action":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText","overridingTitle":"Get started","type":"reference","overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"isActive":true},"title":"Player and Text in Ada","abstract":[{"type":"text","text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene."}],"kind":"callToAction"}],"hierarchy":{"modules":[{"projects":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject","sections":[{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject#Create-project-using-Xcode"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene","sections":[{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Intro"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-an-app"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-a-main-camera"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#First-sprite"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Make-it-move"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText","sections":[{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Player-component"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Text-component"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners","sections":[{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Base-of-Event-Subscriber-pattern"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Subscribe-to-scene-events"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Type-of-events"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Additional-for-physics"}]}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project."},{"projects":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics","sections":[{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Create-the-app-shell"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Layout-with-stacks"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Add-a-button-and-state"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Debug-overlays"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText","sections":[{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-the-view"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Prepare-layout-helpers"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-a-custom-TextRenderer"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Apply-and-animate"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput","sections":[{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Set-up-the-world"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Create-the-input-system"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Read-buttons"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Move-and-rumble"}]}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UI-and-Input"}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine","paths":[["doc:\/\/AdaEngine\/tutorials\/AdaEngine","doc:\/\/AdaEngine\/tutorials\/AdaEngine\/$volume","doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project."]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"role":"project","category":"Ada","title":"Create your first 2D scene","categoryPathComponent":"AdaEngine"},"kind":"project","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/adaengine\/createfirst2dscene"]}],"identifier":{"url":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene","interfaceLanguage":"swift"},"references":{"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Create-a-custom-TextRenderer":{"title":"Create a custom TextRenderer","role":"pseudoSymbol","type":"section","url":"\/tutorials\/adaengine\/animatedtext#Create-a-custom-TextRenderer","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-a-custom-TextRenderer","abstract":[{"text":"Create a custom ","type":"text"},{"code":"TextRenderer","type":"codeVoice"},{"type":"text","text":" that draws text along a sine wave and animate it by updating renderer state."}]},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Create-the-view":{"title":"Create the view","role":"pseudoSymbol","type":"section","url":"\/tutorials\/adaengine\/animatedtext#Create-the-view","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-the-view","abstract":[{"text":"Create a custom ","type":"text"},{"code":"TextRenderer","type":"codeVoice"},{"text":" that draws text along a sine wave and animate it by updating renderer state.","type":"text"}]},"CF2G-2-1-camera.swift":{"content":["import AdaEngine","","struct FirstScene: Plugin {","    func setup(in app: AppWorlds) {","        app.spawn(bundle: Camera2D())","    }","}"],"fileType":"swift","type":"file","highlights":[],"fileName":"FirstScene.swift","identifier":"CF2G-2-1-camera.swift","syntax":"swift"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners":{"type":"topic","url":"\/tutorials\/adaengine\/eventlisteners","kind":"project","title":"Event Listeners in Ada","abstract":[{"text":"In this tutorial you will learn about the event listeners system in Ada.","type":"text"},{"text":" ","type":"text"},{"text":"How can you catch events and process them","type":"text"}],"role":"project","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners","estimatedTime":"5min"},"doc://AdaEngine/tutorials/AdaEngine/UI-and-Input":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UI-and-Input","kind":"article","url":"\/tutorials\/adaengine\/ui-and-input","abstract":[],"type":"topic","role":"article","title":"UI and Input"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput":{"type":"topic","url":"\/tutorials\/adaengine\/gamepadinput","kind":"project","title":"Gamepad Input","abstract":[{"type":"text","text":"Build a small scene that spawns a player entity and moves it with a gamepad."}],"role":"project","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput","estimatedTime":"20min"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Create-an-app":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-an-app","kind":"section","url":"\/tutorials\/adaengine\/createfirst2dscene#Create-an-app","abstract":[{"text":"In this tutorial, you will learn how to create your first 2D scene using Ada.","type":"text"}],"type":"section","role":"pseudoSymbol","title":"Create an app"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Subscribe-to-scene-events":{"title":"Subscribe to scene events","role":"pseudoSymbol","type":"section","url":"\/tutorials\/adaengine\/eventlisteners#Subscribe-to-scene-events","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Subscribe-to-scene-events","abstract":[{"text":"In this tutorial you will learn about the event listeners system in Ada.","type":"text"},{"type":"text","text":" "},{"text":"How can you catch events and process them","type":"text"}]},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText","kind":"project","url":"\/tutorials\/adaengine\/animatedtext","abstract":[{"text":"Create a custom ","type":"text"},{"code":"TextRenderer","type":"codeVoice"},{"text":" that draws text along a sine wave and animate it by updating renderer state.","type":"text"}],"estimatedTime":"20min","type":"topic","role":"project","title":"Animated Text Renderer"},"CF2G-1-2-scene.swift":{"type":"file","fileName":"FirstScene.swift","identifier":"CF2G-1-2-scene.swift","content":["import AdaEngine","","struct FirstScene: Plugin {","    func setup(in _: AppWorlds) {","","    }","}"],"highlights":[],"syntax":"swift","fileType":"swift"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics#Add-a-button-and-state":{"title":"Add a button and state","role":"pseudoSymbol","type":"section","url":"\/tutorials\/adaengine\/uibasics#Add-a-button-and-state","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Add-a-button-and-state","abstract":[{"text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state.","type":"text"}]},"doc://AdaEngine/tutorials/AdaEngine/UIBasics":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics","kind":"project","url":"\/tutorials\/adaengine\/uibasics","abstract":[{"text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state.","type":"text"}],"estimatedTime":"15min","type":"topic","role":"project","title":"UI Basics"},"doc://AdaEngine/tutorials/AdaEngine":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine","kind":"overview","url":"\/tutorials\/adaengine","abstract":[{"text":"Learn the basics of Ada and start developing your own games!","type":"text"}],"type":"topic","role":"overview","title":"Meet Ada"},"CF2G-4-3-player.swift":{"type":"file","fileName":"FirstScene.swift","identifier":"CF2G-4-3-player.swift","content":["import AdaEngine","","struct FirstScene: Plugin {","    func setup(in app: AppWorlds) {","        let camera = Camera()","        camera.backgroundColor = Color(45 \/ 255, 171 \/ 255, 255 \/ 255, 1)","        app.spawn(bundle: Camera2D(camera: camera))","","        let spriteSheetImage = try! AssetsManager.loadSync(Image.self, at: \"@res:\/\/characters_packed.png\").asset!","        let spriteSheet = TextureAtlas(from: spriteSheetImage, size: [20, 23], margin: [4, 1])","","        app.spawn(\"Player\") {","            Sprite(","                texture: spriteSheet[7, 1],","                size: Size(width: 24, height: 24)","            )","            Transform()","            PlayerComponent()","        }","","        app.addSystem(PlayerMovementSystem.self)","    }","}","","@Component","struct PlayerComponent {}","","@System","func PlayerMovement() {","","}"],"highlights":[{"line":20},{"line":21}],"syntax":"swift","fileType":"swift"},"Xcode 26.2 or later":{"url":"https:\/\/devel