{"seeAlsoSections":[{"identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTesting"],"title":"ECS Integration","anchor":"ECS-Integration","generated":true}],"hierarchy":{"paths":[["doc:\/\/AdaScripting\/documentation\/AdaScripting"]]},"abstract":[{"type":"text","text":"Understand annotation, setup, and runtime failures and keep ECS work on the"},{"type":"text","text":" "},{"type":"text","text":"native chunk path."}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Compilation diagnostics","anchor":"Compilation-diagnostics"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin","type":"reference"},{"text":" compiles the source and reads declaration metadata","type":"text"},{"text":" ","type":"text"},{"text":"without executing a ","type":"text"},{"code":"main()","type":"codeVoice"},{"type":"text","text":" manifest. Initialization throws"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptError\/compilation(_:)"},{"type":"text","text":" for syntax or semantic errors and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptError\/invalidManifest(_:)"},{"type":"text","text":" for invalid AdaEngine annotations."}]},{"inlineContent":[{"type":"text","text":"Examples include "},{"type":"codeVoice","code":"@system"},{"type":"text","text":" on a non-class declaration, duplicate system"},{"type":"text","text":" "},{"type":"text","text":"identifiers, "},{"code":"@query","type":"codeVoice"},{"type":"text","text":" outside a system class, a query with no fetched"},{"type":"text","text":" "},{"type":"text","text":"components, and a system class that cannot be initialized."}],"type":"paragraph"},{"anchor":"Setup-diagnostics","type":"heading","level":2,"text":"Setup diagnostics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Native component identifiers are resolved during plugin setup so earlier"},{"type":"text","text":" "},{"type":"text","text":"plugins can register game components. Unknown or ambiguous component names skip"},{"type":"text","text":" "},{"type":"text","text":"the affected system and append a diagnostic."}]},{"anchor":"Runtime-diagnostics","type":"heading","level":2,"text":"Runtime diagnostics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Runtime diagnostics include unknown component aliases, unknown fields,"},{"type":"text","text":" "},{"type":"text","text":"unsupported values, invalid numeric conversions, and query capabilities used"},{"type":"text","text":" "},{"type":"text","text":"outside their callback lifetime."}]},{"type":"paragraph","inlineContent":[{"text":"Inspect ","type":"text"},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin\/diagnostics","isActive":true},{"text":" after setup and during development.","type":"text"},{"text":" ","type":"text"},{"text":"System ","type":"text"},{"code":"update(context)","type":"codeVoice"},{"text":" callbacks are command-style; their return values are","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"ignored. Tests should assert observable ECS state and diagnostics."}]},{"anchor":"Performance-model","text":"Performance model","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Ada Script query execution traverses native archetypes and chunks. Component"},{"type":"text","text":" "},{"type":"text","text":"columns are bound once per chunk, and field access advances a typed pointer by"},{"type":"text","text":" "},{"type":"text","text":"row stride. A successful write mutates the component in place and updates its"},{"type":"text","text":" "},{"type":"text","text":"change tick."}],"type":"paragraph"},{"inlineContent":[{"text":"The hot path avoids arrays of matched entity identifiers, one Swift bridge","type":"text"},{"text":" ","type":"text"},{"text":"object per entity, repeated entity-location lookups, existential component","type":"text"},{"text":" ","type":"text"},{"text":"copies, and whole-component reinsertion.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The current embedded C runtime is globally shared and non-reentrant, so runtime entry remains"},{"type":"text","text":" "},{"type":"text","text":"serialized. Scalability comes from native filtering, column iteration, cached"},{"type":"text","text":" "},{"type":"text","text":"metadata, and narrow bridge calls rather than multiple concurrent VMs."}],"type":"paragraph"},{"inlineContent":[{"text":"Benchmark scripting changes with multiple archetypes and chunks and compare","type":"text"},{"text":" ","type":"text"},{"text":"them with a typed Swift query. Validate semantics before drawing performance","type":"text"},{"text":" ","type":"text"},{"text":"conclusions.","type":"text"}],"type":"paragraph"}]}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adascripting\/adascriptdiagnosticsandperformance"]}],"identifier":{"url":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptDiagnosticsAndPerformance","interfaceLanguage":"swift"},"metadata":{"title":"Ada Script Diagnostics and Performance","role":"article","roleHeading":"Article","modules":[{"name":"Ada Script"}]},"kind":"article","references":{"doc://AdaScripting/documentation/AdaScripting/AdaScriptPlugin/diagnostics":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"diagnostics","kind":"identifier"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"]","kind":"text"}],"role":"symbol","abstract":[],"url":"\/documentation\/adascripting\/ada