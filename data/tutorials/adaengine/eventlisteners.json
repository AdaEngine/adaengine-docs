,"text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state."}],"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Create-the-app-shell","url":"\/tutorials\/adaengine\/uibasics#Create-the-app-shell"},"EL-2-4-events.swift":{"highlights":[],"type":"file","identifier":"EL-2-4-events.swift","syntax":"swift","fileName":"Events.swift","content":["\/\/\/ Events the scene triggers.","public enum SceneEvents {","","    \/\/\/ An event triggered once when scene is ready to use and will starts update soon.","    public struct OnReady: Event {","        public let scene: Scene","    }","","    \/\/\/ Raised after an entity is added to the scene.","    public struct DidAddEntity: Event {","        public let entity: Entity","    }","","    \/\/\/ Raised before an entity is removed from the scene.","    public struct WillRemoveEntity: Event {","        public let entity: Entity","    }","","    \/\/\/ An event triggered once per frame interval that you can use to execute custom logic for each frame.","    public struct Update: Event {","","        \/\/\/ The updated scene.","        public let scene: Scene","","        \/\/\/ The elapsed time since the last update.","        public let deltaTime: TimeInterval","    }","}","","\/\/\/ Events associated with collisions.","public enum CollisionEvents {","","    \/\/\/ An event raised when two objects collide.","    public struct Began: Event {","","        \/\/\/ The first entity involved in the collision.","        public let entityA: Entity","","        \/\/\/ The second entity involved in the collision.","        public let entityB: Entity","","        \/\/\/ The estimated strength of the impact.","        public let impulse: Float","    }","","    \/\/\/ An event raised when two objects, previously in contact, separate.","    public struct Ended: Event {","","        \/\/\/ The first entity involved in the collision.","        public let entityA: Entity","","        \/\/\/ The second entity involved in the collision.","        public let entityB: Entity","    }","}"],"fileType":"swift"},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Prepare-layout-helpers":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Prepare-layout-helpers","abstract":[{"type":"text","text":"Create a custom "},{"type":"codeVoice","code":"TextRenderer"},{"type":"text","text":" that draws text along a sine wave and animate it by updating renderer state."}],"url":"\/tutorials\/adaengine\/animatedtext#Prepare-layout-helpers","title":"Prepare layout helpers","role":"pseudoSymbol","kind":"section"},"doc://AdaEngine/tutorials/AdaEngine/CreateProject":{"abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first Ada project."}],"url":"\/tutorials\/adaengine\/createproject","kind":"project","estimatedTime":"5min","title":"Create your first game project","type":"topic","role":"project","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Create-an-app":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-an-app","abstract":[{"text":"In this tutorial, you will learn how to create your first 2D scene using Ada.","type":"text"}],"url":"\/tutorials\/adaengine\/createfirst2dscene#Create-an-app","title":"Create an app","role":"pseudoSymbol","kind":"section"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#First-sprite":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#First-sprite","abstract":[{"text":"In this tutorial, you will learn how to create your first 2D scene using Ada.","type":"text"}],"url":"\/tutorials\/adaengine\/createfirst2dscene#First-sprite","title":"First sprite","role":"pseudoSymbol","kind":"section"},"doc://AdaEngine/tutorials/AdaEngine/Create-your-first-2D-game-project.":{"type":"topic","identifier