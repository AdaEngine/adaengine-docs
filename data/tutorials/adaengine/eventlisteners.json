Engine\/EventListeners#Additional-for-physics","kind":"section","url":"\/tutorials\/adaengine\/eventlisteners#Additional-for-physics","abstract":[{"text":"In this tutorial you will learn about the event listeners system in Ada.","type":"text"},{"text":" ","type":"text"},{"text":"How can you catch events and process them","type":"text"}],"type":"section","role":"pseudoSymbol","title":"Additional for physics"},"EL-2-3-scene.swift":{"fileName":"EventListenerPlugin.swift","fileType":"swift","syntax":"swift","identifier":"EL-2-3-scene.swift","content":["import AdaEngine","","@MainActor","struct EventListenerPlugin: Plugin {","    @Local var disposeBag: Set<AnyCancellable> = []","","    func setup(in app: borrowing AppWorlds) {","        app.main","            .subscribe(to: SceneEvents.OnReady.self) { _ in","                \/\/ Handle event here!","            }","            .store(in: &self.disposeBag)","    }","}"],"highlights":[],"type":"file"},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Apply-and-animate":{"type":"section","url":"\/tutorials\/adaengine\/animatedtext#Apply-and-animate","kind":"section","title":"Apply and animate","abstract":[{"type":"text","text":"Create a custom "},{"code":"TextRenderer","type":"codeVoice"},{"type":"text","text":" that draws text along a sine wave and animate it by updating renderer state."}],"role":"pseudoSymbol","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Apply-and-animate"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Base-of-Event-Subscriber-pattern":{"type":"section","url":"\/tutorials\/adaengine\/eventlisteners#Base-of-Event-Subscriber-pattern","kind":"section","abstract":[{"type":"text","text":"In this tutorial you will learn about the event listeners system in Ada."},{"type":"text","text":" "},{"type":"text","text":"How can you catch events and process them"}],"title":"Base of Event-Subscriber pattern","role":"pseudoSymbol","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Base-of-Event-Subscriber-pattern"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene":{"kind":"project","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene","url":"\/tutorials\/adaengine\/createfirst2dscene","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}],"estimatedTime":"20min","type":"topic","role":"project","title":"Create your first 2D scene"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners":{"type":"topic","url":"\/tutorials\/adaengine\/eventlisteners","kind":"project","title":"Event Listeners in Ada","abstract":[{"text":"In this tutorial you will learn about the event listeners system in Ada.","type":"text"},{"text":" ","type":"text"},{"text":"How can you catch events and process them","type":"text"}],"role":"project","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners","estimatedTime":"5min"},"doc://AdaEngine/tutorials/AdaEngine/Create-your-first-2D-game-project.":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project.","kind":"article","url":"\/tutorials\/adaengine\/create-your-first-2d-game-project.","abstract":[],"type":"topic","role":"article","title":"Create your first 2D game project."}}}