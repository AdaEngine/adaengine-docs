uralnoise","role":"article","kind":"article","type":"topic","title":"Procedural Noise","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/ProceduralNoise"},"doc://AdaEngine/documentation/AdaEngine/ImageDecoders":{"role":"article","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/ImageDecoders","url":"\/documentation\/adaengine\/imagedecoders","kind":"article","abstract":[{"text":"Load PNG, JPEG (","type":"text"},{"code":"jpg","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"jpeg","type":"codeVoice"},{"text":"), BMP and TGA images as CPU pixels using","type":"text"},{"text":" ","type":"text"},{"code":"Image","type":"codeVoice"},{"text":", or load a GPU texture through ","type":"text"},{"code":"Texture2D","type":"codeVoice"},{"text":":","type":"text"}],"type":"topic","title":"Loading images and adding formats"},"https://github.com/AdaEngine/AdaEngine/blob/main/CONTRIBUTING.md":{"url":"https:\/\/github.com\/AdaEngine\/AdaEngine\/blob\/main\/CONTRIBUTING.md","title":"CONTRIBUTING.md","titleInlineContent":[{"text":"CONTRIBUTING.md","type":"text"}],"type":"link","identifier":"https:\/\/github.com\/AdaEngine\/AdaEngine\/blob\/main\/CONTRIBUTING.md"},"doc://AdaEngine/documentation/AdaEngine/VisionOSWindowed":{"identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/VisionOSWindowed","url":"\/documentation\/adaengine\/visionoswindowed","role":"article","kind":"article","title":"visionOS Windowed Mode","type":"topic","abstract":[{"type":"text","text":"Run Ada apps in visionOS Shared Space using the existing "},{"type":"codeVoice","code":"WindowGroup"},{"type":"text","text":" scene model."}]},"doc://AdaEngine/documentation/AdaEngine/CharacterLocomotion3D":{"role":"article","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/CharacterLocomotion3D","url":"\/documentation\/adaengine\/characterlocomotion3d","kind":"article","abstract":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"CharacterLocomotion3DComponent"},{"type":"text","text