{"seeAlsoSections":[{"title":"Essentials","identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLibraries"],"generated":true,"anchor":"Essentials"}],"hierarchy":{"paths":[["doc:\/\/AdaScripting\/documentation\/AdaScripting"]]},"abstract":[{"text":"Learn the syntax of Ada Script before connecting a script to a scene or ECS","type":"text"},{"text":" ","type":"text"},{"text":"world. Ada Script files use the ","type":"text"},{"code":".ada","type":"codeVoice"},{"type":"text","text":" extension. The examples on this page are"},{"type":"text","text":" "},{"type":"text","text":"small pieces you can combine in one file; a game does not need a "},{"type":"codeVoice","code":"main()"},{"type":"text","text":" "},{"type":"text","text":"function. Start with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript"},{"type":"text","text":" to run a complete system."}],"kind":"article","primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"A first look","anchor":"A-first-look"},{"type":"codeListing","syntax":"ada","code":["\/\/ A class keeps state between calls.","class Counter {","    var value = 0;","","    func increment() {","        value += 1;","        return value;","    }","}","","var counter = Counter();","var first = counter.increment(); \/\/ 1"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\/\/"},{"type":"text","text":" starts a line comment; "},{"type":"codeVoice","code":"\/* ... *\/"},{"type":"text","text":" surrounds a block comment. Braces"},{"type":"text","text":" "},{"text":"delimit blocks. Semicolons can separate statements and are used throughout","type":"text"},{"text":" ","type":"text"},{"text":"AdaEngine’s examples. Names are case-sensitive: ","type":"text"},{"code":"Counter","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"counter","type":"codeVoice"},{"text":" are","type":"text"},{"text":" ","type":"text"},{"text":"different names.","type":"text"}]},{"type":"heading","level":2,"text":"Values and basic types","anchor":"Values-and-basic-types"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ada Script is dynamically typed. A "},{"type":"codeVoice","code":"var"},{"text":" holds a value, and later assignments","type":"text"},{"text":" ","type":"text"},{"text":"can replace it. Type annotations such as ","type":"text"},{"type":"codeVoice","code":"var score: Int"},{"text":" describe an API and","type":"text"},{"text":" ","type":"text"},{"text":"support tooling. They are enforced only when strict type checking is enabled","type":"text"},{"type":"text","text":" "},{"type":"text","text":"for the project or source file; dynamic mode remains the default."}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Example","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"What it represents","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Bool"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"true"},{"type":"text","text":", "},{"type":"codeVoice","code":"false"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A condition.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Int"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"42"},{"type":"text","text":", "},{"type":"codeVoice","code":"-3"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"An integer."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Float","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"3.5"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A fractional number.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"String"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"\"player\"","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Text.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Null","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"null","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"No value.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"List"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"[10, 20, 30]"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"An indexed sequence, starting at index "},{"type":"codeVoice","code":"0"},{"type":"text","text":"."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Map"}]}],[{"type":"paragraph","inlineContent":[{"code":"[\"hp\": 100, \"mp\": 20]","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Values looked up by key. Use ","type":"text"},{"code":"[:]","type":"codeVoice"},{"text":" for an empty map.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Range","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"0..<3","type":"codeVoice"},{"type":"text","text":", "},{"code":"1...3","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"An exclusive or inclusive integer range.","type":"text"}]}]]]},{"type":"codeListing","code":["var name = \"Ada\";","var lives: Int = 3;","var inventory = [\"key\", \"torch\"];","var healthByPlayer = [\"ada\": 100, \"lee\": 80];","","inventory[0] = \"map\";","healthByPlayer[\"ada\"] -= 10;","","const startingLives = 3;"],"syntax":"ada"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"const"},{"type":"text","text":" declares a value you do not reassign. A list has a "},{"type":"codeVoice","code":"count"},{"type":"text","text":" property;"},{"type":"text","text":" "},{"type":"text","text":"maps have "},{"type":"codeVoice","code":"keys()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"hasKey(key)"},{"type":"text","text":". A range "},{"type":"codeVoice","code":"0..<3"},{"type":"text","text":" visits "},{"type":"codeVoice","code":"0"},{"type":"text","text":", "},{"type":"codeVoice","code":"1"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"2"},{"type":"text","text":"; "},{"type":"codeVoice","code":"1...3"},{"type":"text","text":" also includes "},{"type":"codeVoice","code":"3"},{"type":"text","text":". Engine types such as "},{"type":"codeVoice","code":"Vector3"},{"type":"text","text":", "},{"type":"codeVoice","code":"Transform"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"Sprite"},{"type":"text","text":" come from registered AdaEngine APIs rather than the basic language"},{"type":"text","text":" "},{"type":"text","text":"types. Values passed to Swift or stored in ECS fields have narrower supported"},{"type":"text","text":" "},{"type":"text","text":"types than arbitrary script values; see "},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage","isActive":true},{"type":"text","text":"."}]},{"level":2,"text":"Functions","anchor":"Functions","type":"heading"},{"inlineContent":[{"text":"Declare a function with ","type":"text"},{"code":"func","type":"codeVoice"},{"text":", pass arguments in parentheses, and use","type":"text"},{"text":" ","type":"text"},{"code":"return","type":"codeVoice"},{"text":" to send a value back. A function without an explicit ","type":"text"},{"code":"return","type":"codeVoice"},{"text":" ","type":"text"},{"text":"returns ","type":"text"},{"code":"null","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"ada","type":"codeListing","code":["func doubled(value) { return value * 2; }","var next = doubled(5); \/\/ 10"]},{"inlineContent":[{"type":"text","text":"Parameters can have defaults and type annotations:"}],"type":"paragraph"},{"syntax":"ada","type":"codeListing","code":["func addPoints(score: Int, bonus = 10) {","    return score + bonus;","}","","var updated = addPoints(5); \/\/ 15"]},{"inlineContent":[{"type":"text","text":"Annotations on parameters describe types for tooling; runtime calls still"},{"type":"text","text":" "},{"type":"text","text":"need values of the form the function expects. A helper function is ordinary"},{"type":"text","text":" "},{"type":"text","text":"code. An ECS callback such as "},{"type":"codeVoice","code":"update(context)"},{"type":"text","text":" runs only because its class is"},{"type":"text","text":" "},{"type":"text","text":"registered as a system."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"AdaScript provides "},{"type":"codeVoice","code":"print(...)"},{"type":"text","text":", "},{"type":"codeVoice","code":"put(...)"},{"type":"text","text":", "},{"type":"codeVoice","code":"input(removeTrailingNewline = true)"},{"type":"text","text":","},{"text":" ","type":"text"},{"code":"nanotime()","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"exit(code = 0)","type":"codeVoice"},{"text":" as free functions. They forward to the","type":"text"},{"text":" ","type":"text"},{"text":"corresponding ","type":"text"},{"code":"System","type":"codeVoice"},{"text":" methods. ","type":"text"},{"code":"assert(condition, message = \"Assertion failed\")","type":"codeVoice"},{"text":" ","type":"text"},{"text":"stops the current script with a diagnostic when its condition is false.","type":"text"},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"code":"System","type":"codeVoice"},{"text":" spellings remain available for existing scripts. Avoid ","type":"text"},{"code":"input","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"exit","type":"codeVoice"},{"text":" in game callbacks because they block for console input or terminate","type":"text"},{"text":" ","type":"text"},{"text":"the host process.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"AdaScript also supports "},{"type":"codeVoice","code":"Math.clamp"},{"type":"text","text":", "},{"type":"codeVoice","code":"Math.saturate"},{"type":"text","text":", "},{"type":"codeVoice","code":"Math.addVector"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"Math.subtractVector"},{"type":"text","text":", "},{"type":"codeVoice","code":"Math.scaleVector"},{"type":"text","text":", "},{"code":"Math.dot","type":"codeVoice"},{"type":"text","text":", "},{"code":"Math.cross","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"Math.length","type":"codeVoice"},{"type":"text","text":", "},{"code":"Math.normalize","type":"codeVoice"},{"type":"text","text":", "},{"code":"Math.distance","type":"codeVoice"},{"type":"text","text":", "},{"code":"Math.lerpVector","type":"codeVoice"},{"type":"text","text":", and"},{"type":"text","text":" "},{"code":"Math.clampVector","type":"codeVoice"},{"type":"text","text":". Vectors are lists of numbers;"},{"type":"text","text":" "},{"code":"cross","type":"codeVoice"},{"type":"text","text":" requires three components. Matrices are nonempty lists of equal-length"},{"type":"text","text":" "},{"type":"text","text":"rows. "},{"code":"Math.identityMatrix(size)","type":"codeVoice"},{"type":"text","text":", "},{"code":"transposeMatrix(matrix)","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"multiplyMatrix(left, right)","type":"codeVoice"},{"type":"text","text":", and "},{"code":"transformVector(matrix, vector)","type":"codeVoice"},{"type":"text","text":" use row-major"},{"type":"text","text":" "},{"type":"text","text":"order and treat vectors as columns:"}],"type":"paragraph"},{"code":["var safeHealth = Math.clamp(120, 0, 100); \/\/ 100","var point = [3.0, 4.0, 1.0];","var translation = [[1.0, 0.0, 2.0], [0.0, 1.0, 5.0], [0.0, 0.0, 1.0]];","var moved = Math.transformVector(translation, point); \/\/ [5.0, 9.0, 1.0]"],"type":"codeListing","syntax":"ada"},{"level":2,"anchor":"Structs-and-classes","type":"heading","text":"Structs and classes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"struct"},{"text":" for a small value that should be copied on assignment. Use","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"class"},{"text":" when several names should refer to the same mutable instance.","type":"text"}]},{"syntax":"ada","code":["struct Point {","    var x = 0;","    var y = 0;","}","","class Player {","    var health = 100;","}","","var point = Point();","var otherPoint = point;","otherPoint.x = 5; \/\/ point.x stays 0","","var player = Player();","var teammate = player;","teammate.health = 80; \/\/ player.health is now 80"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Classes can inherit from one parent class with "},{"type":"codeVoice","code":"class Child : Parent"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Both kinds of declaration can contain stored properties and methods. A plain"},{"type":"text","text":" "},{"type":"text","text":"script "},{"type":"codeVoice","code":"struct"},{"type":"text","text":" is not automatically an ECS component or resource: use"},{"type":"text","text":" "},{"type":"codeVoice","code":"@component"},{"type":"text","text":" or "},{"type":"codeVoice","code":"@resource"},{"type":"text","text":" and the supported exported field schema for that."},{"type":"text","text":" "},{"type":"text","text":"See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"anchor":"Static-members","text":"Static members","type":"heading"},{"inlineContent":[{"text":"An instance member belongs to one object. A ","type":"text"},{"type":"codeVoice","code":"static"},{"text":" member belongs to the","type":"text"},{"text":" ","type":"text"},{"text":"declaration itself and is accessed through its type name:","type":"text"}],"type":"paragraph"},{"syntax":"ada","code":["class Difficulty {","    static var multiplier = 2;","","    static func apply(baseScore) {","        return baseScore * multiplier;","    }","}","","var points = Difficulty.apply(10); \/\/ 20"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use static state sparingly for gameplay. ECS components hold per-entity state,"},{"type":"text","text":" "},{"type":"text","text":"and resources hold shared world state with an explicit lifecycle."}],"type":"paragraph"},{"text":"Initialization and cleanup","type":"heading","anchor":"Initialization-and-cleanup","level":2},{"inlineContent":[{"type":"codeVoice","code":"func init(...)"},{"type":"text","text":" is called when a class or struct instance is created."},{"type":"text","text":" "},{"type":"codeVoice","code":"func deinit()"},{"type":"text","text":" runs when a class instance is reclaimed; its timing depends on"},{"type":"text","text":" "},{"type":"text","text":"the script runtime, so it is not a reliable place for a gameplay event."}],"type":"paragraph"},{"syntax":"ada","type":"codeListing","code":["class TimerLabel {","    var title;","","    func init(name) {","        title = name;","    }","","    func deinit() {","        System.print(\"TimerLabel released\");","    }","}","","var label = TimerLabel(\"Countdown\");"]},{"inlineContent":[{"text":"Neither method receives an ECS ","type":"text"},{"code":"context","type":"codeVoice"},{"text":". To initialize a world once, create","type":"text"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"code":"@system(scheduler: \"startup\")","type":"codeVoice"},{"text":" class with ","type":"text"},{"code":"update(context)","type":"codeVoice"},{"text":". To react to","type":"text"},{"text":" ","type":"text"},{"text":"per-entity attachment or detachment, use a ","type":"text"},{"code":"@scriptable","type":"codeVoice"},{"text":" class’s","type":"text"},{"text":" ","type":"text"},{"code":"ready(context)","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"destroy(context)","type":"codeVoice"},{"text":". There is currently no function-level","type":"text"},{"text":" ","type":"text"},{"code":"@init","type":"codeVoice"},{"text":" annotation. See ","type":"text"},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","isActive":true},{"text":" for these lifetimes.","type":"text"}],"type":"paragraph"},{"text":"Stored and computed properties","type":"heading","anchor":"Stored-and-computed-properties","level":2},{"inlineContent":[{"type":"codeVoice","code":"var"},{"type":"text","text":" inside a type is a stored property. A computed property runs "},{"type":"codeVoice","code":"get"},{"type":"text","text":" when"},{"text":" ","type":"text"},{"text":"read and ","type":"text"},{"code":"set","type":"codeVoice"},{"text":" when assigned. Inside ","type":"text"},{"type":"codeVoice","code":"set"},{"text":", ","type":"text"},{"type":"codeVoice","code":"value"},{"text":" is the new value unless","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"you give the setter parameter another name."}],"type":"paragraph"},{"code":["class HealthBar {","    private var storedHealth = 100;","","    var health {","        get { return storedHealth; }","        set (newHealth) {","            if (newHealth < 0) {","                storedHealth = 0;","            } else if (newHealth > 100) {","                storedHealth = 100;","            } else {","                storedHealth = newHealth;","            }","        }","    };","}","","var bar = HealthBar();","bar.health = 120;","var visibleHealth = bar.health; \/\/ 100"],"type":"codeListing","syntax":"ada"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A property with only "},{"code":"get","type":"codeVoice"},{"type":"text","text":" is read-only. These accessors are ordinary script"},{"type":"text","text":" "},{"type":"text","text":"behavior. They do not by themselves export an Inspector property or define an"},{"type":"text","text":" "},{"text":"ECS field; ","type":"text"},{"type":"codeVoice","code":"@export"},{"text":" on a supported stored field does that. See","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"heading","text":"Conditions and loops","anchor":"Conditions-and-loops","level":2},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"if"},{"text":", ","type":"text"},{"type":"codeVoice","code":"else if"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"else"},{"text":" to choose a branch. ","type":"text"},{"type":"codeVoice","code":"&&"},{"text":", ","type":"text"},{"type":"codeVoice","code":"||"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"!"},{"text":" combine","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Boolean conditions."}]},{"type":"codeListing","syntax":"ada","code":["func healthMessage(health) {","    if (health <= 0) {","        return \"defeated\";","    } else if (health < 25) {","        return \"critical\";","    } else {","        return \"ready\";","    }","}"]},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"for (var item in collection)"},{"type":"text","text":" for a list, range, or ECS query. "},{"code":"while","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"checks before each iteration; "},{"code":"repeat ... while","type":"codeVoice"},{"type":"text","text":" checks after one iteration."},{"type":"text","text":" "},{"type":"codeVoice","code":"break"},{"type":"text","text":" ends a loop, and "},{"type":"codeVoice","code":"continue"},{"text":" skips to its next iteration.","type":"text"}],"type":"paragraph"},{"syntax":"ada","type":"codeListing","code":["var total = 0;","for (var number in 1...3) {","    total += number; \/\/ 1 + 2 + 3","}","","var attempts = 0;","while (attempts < 3) {","    attempts += 1;","}","","repeat {","    attempts -= 1;","} while (attempts > 0);"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"switch (value)"},{"text":" selects ","type":"text"},{"type":"codeVoice","code":"case"},{"text":" branches and an optional ","type":"text"},{"type":"codeVoice","code":"default"},{"text":". Add","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"break"},{"text":" to stop at the end of a case when no ","type":"text"},{"type":"codeVoice","code":"return"},{"text":" exits it; execution can","type":"text"},{"text":" ","type":"text"},{"text":"otherwise continue into the next case.","type":"text"}]},{"syntax":"ada","type":"codeListing","code":["func teamName(team) {","    switch (team) {","        case 1:","            return \"blue\";","        case 2:","            return \"red\";","        default:","            return \"unknown\";","    }","}"]},{"anchor":"Async-functions-and-await","type":"heading","level":2,"text":"Async functions and `await`"},{"inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"async func"},{"text":" may suspend at ","type":"text"},{"type":"codeVoice","code":"await"},{"text":". Awaiting an operation pauses that","type":"text"},{"type":"text","text":" "},{"text":"script task while the game keeps updating. A synchronous callback starts an","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"async function with "},{"type":"codeVoice","code":"Tasks.start(...)"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"ada","code":["async func announceLater() {","    await Time.sleep(1.0);","    System.print(\"One game-time second passed\");","}","","@system","class AnnouncementSystem {","    var started = false;","","    func update(context) {","        if (!started) {","            started = true;","            Tasks.start(announceLater());","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"update(context)"},{"type":"text","text":" and scriptable callbacks remain"},{"text":" ","type":"text"},{"text":"synchronous. Do not keep ","type":"text"},{"code":"context","type":"codeVoice"},{"text":", query rows, resource views, or commands","type":"text"},{"text":" ","type":"text"},{"text":"across ","type":"text"},{"type":"codeVoice","code":"await"},{"type":"text","text":": those values expire when the callback returns. Pass detached"},{"text":" ","type":"text"},{"text":"values into the task. ","type":"text"},{"code":"Time.sleep","type":"codeVoice"},{"text":" uses game time; ","type":"text"},{"code":"Time.sleepRealTime","type":"codeVoice"},{"text":" uses a","type":"text"},{"text":" ","type":"text"},{"text":"monotonic clock. Read ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage"},{"text":" for asset operations, save","type":"text"},{"text":" ","type":"text"},{"text":"results, cancellation, and task lifetimes.","type":"text"}]},{"text":"Scene navigation","level":2,"anchor":"Scene-navigation","type":"heading"},{"inlineContent":[{"text":"With ","type":"text"},{"code":"ScenePlugin","type":"codeVoice"},{"text":" installed, an AdaScript system or scriptable callback can","type":"text"},{"text":" ","type":"text"},{"text":"request a level change through its scoped world context:","type":"text"}],"type":"paragraph"},{"syntax":"ada","code":["context.world.changeScene(\"@res:\/\/Scenes\/Level02.ascn\");","context.world.reloadScene(); \/\/ Restart after game over."],"type":"codeListing"},{"inlineContent":[{"text":"Both calls return ","type":"text"},{"code":"Bool","type":"codeVoice"},{"text":" to indicate whether the request was accepted. Scene","type":"text"},{"text":" ","type":"text"},{"text":"loading happens asynchronously, and the prepared scene replaces the old one","type":"text"},{"text":" ","type":"text"},{"text":"after an update pass. The current scene remains active if loading fails.","type":"text"},{"text":" ","type":"text"},{"code":"reloadScene()","type":"codeVoice"},{"text":" loads a fresh copy of the active scene, recreating its entities","type":"text"},{"text":" ","type":"text"},{"text":"and scene resources. Entities spawned through AdaScript world commands are","type":"text"},{"text":" ","type":"text"},{"text":"tracked as part of that scene and removed on reload. Application resources","type":"text"},{"text":" ","type":"text"},{"text":"and entities created outside the scene remain available across transitions.","type":"text"},{"text":" ","type":"text"},{"text":"AdaScript tasks for the outgoing world are canceled and ","type":"text"},{"code":"@system","type":"codeVoice"},{"text":" instances","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"are recreated; module globals remain part of the application session."},{"type":"text","text":" "},{"type":"text","text":"World contexts expire when their callback returns, so do not retain one in an"},{"type":"text","text":" "},{"type":"text","text":"async task."}],"type":"paragraph"},{"anchor":"Annotations","level":2,"type":"heading","text":"Annotations"},{"inlineContent":[{"text":"Annotations begin with ","type":"text"},{"type":"codeVoice","code":"@"},{"text":" and attach metadata to a declaration. They are","type":"text"},{"text":" ","type":"text"},{"text":"AdaEngine features, not ordinary function calls:","type":"text"}],"type":"paragraph"},{"code":["@component(id: \"game.health\")","struct Health {","    @export var current = 100;","}","","@system(scheduler: \"startup\")","class CreatePlayer {","    func update(context) {","        context.world.spawn([Health(current: 100)]);","    }","}"],"type":"codeListing","syntax":"ada"},{"inlineContent":[{"type":"codeVoice","code":"@component"},{"type":"text","text":" tells AdaEngine to register data; "},{"type":"codeVoice","code":"@export"},{"type":"text","text":" gives a supported"},{"type":"text","text":" "},{"type":"text","text":"field a default. "},{"type":"codeVoice","code":"@system"},{"type":"text","text":" registers an ECS callback. Other annotations define"},{"type":"text","text":" "},{"type":"text","text":"queries, resources, scriptable behavior, editor tools, and multiplayer"},{"type":"text","text":" "},{"type":"text","text":"messages. Arguments are constants or symbolic identifiers used during module"},{"type":"text","text":" "},{"type":"text","text":"discovery. See "},{"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","type":"reference","isActive":true},{"type":"text","text":" for their valid targets, arguments,"},{"type":"text","text":" "},{"type":"text","text":"defaults, and limitations."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adascripting\/adascriptbasics"]}],"identifier":{"url":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptBasics","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"metadata":{"title":"Ada Script Basics","roleHeading":"Article","role":"article","modules":[{"name":"Ada Script"}]},"references":{"doc://AdaScripting/documentation/AdaScripting/AdaScriptLanguage":{"title":"Ada Script Language","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage","url":"\/documentation\/adascripting\/adascriptlanguage","type":"topic","kind":"article","abstract":[{"type":"text","text":"Use Ada Script syntax with AdaEngine declaration annotations. New to the"},{"type":"text","text":" "},{"type":"text","text":"language? Start with "},{"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptBasics","type":"reference","isActive":true},{"type":"text","text":" for values, functions, types,"},{"type":"text","text":" "},{"type":"text","text":"properties, control flow, asynchronous work, and annotations."}],"role":"article"},"doc://AdaScripting/documentation/AdaScripting":{"type":"topic","kind":"symbol","url":"\/documentation\/adascripting","role":"collection","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting","title":"Ada Script","abstract":[{"type":"text","text":"Write gameplay systems in Ada Script while keeping entity filtering and access planning in AdaEngine’s native ECS."}]},"doc://AdaScripting/documentation/AdaScripting/AdaScriptLibraries":{"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLibraries","title":"AdaScript Libraries","role":"article","abstract":[{"type":"text","text":"Share reusable AdaScript functions, systems, and scriptable objects through a GitHub repository."},{"text":" ","type":"text"},{"type":"text","text":"AdaEditor installs the library and its transitive dependencies into the project. Run, Play Mode,"},{"type":"text","text":" "},{"text":"Preview, and ","type":"text"},{"type":"codeVoice","code":"AdaScriptBuildPlugin"},{"text":" load the same installed sources without network access.","type":"text"}],"url":"\/documentation\/adascripting\/adascriptlibraries","type":"topic","kind":"article"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptAnnotations":{"title":"Ada Script Annotation Reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","url":"\/documentation\/adascripting\/adascriptannotations","type":"topic","kind":"article","abstract":[{"type":"text","text":"Choose an annotation by the declaration it describes. Annotation arguments"},{"type":"text","text":" "},{"type":"text","text":"are literals, identifiers, or lists of those values, not runtime expressions."},{"type":"text","text":" "},{"text":"The same spelling can have different roles: ","type":"text"},{"code":"@component","type":"codeVoice"},{"text":" declares a struct,","type":"text"},{"text":" ","type":"text"},{"text":"while ","type":"text"},{"code":"@component(required: true)","type":"codeVoice"},{"text":" binds an existing component to a scriptable","type":"text"},{"type":"text","text":" "},{"text":"instance.","type":"text"}],"role":"article"},"doc://AdaScripting/documentation/AdaScripting/GettingStartedWithAdaScript":{"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript","kind":"article","role":"article","type":"topic","abstract":[{"text":"Add an ","type":"text"},{"type":"codeVoice","code":".ada"},{"type":"text","text":" file to an AdaEngine executable and run its systems without manually loading each script."}],"url":"\/documentation\/adascripting\/gettingstartedwithadascript","title":"Getting Started with Ada Script"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptBasics":{"title":"Ada Script Basics","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptBasics","url":"\/documentation\/adascripting\/adascriptbasics","type":"topic","kind":"article","abstract":[{"text":"Learn the syntax of Ada Script before connecting a script to a scene or ECS","type":"text"},{"text":" ","type":"text"},{"text":"world. Ada Script files use the ","type":"text"},{"type":"codeVoice","code":".ada"},{"text":" extension. The examples on this page are","type":"text"},{"text":" ","type":"text"},{"text":"small pieces you can combine in one file; a game does not need a ","type":"text"},{"code":"main()","type":"codeVoice"},{"text":" ","type":"text"},{"text":"function. Start with ","type":"text"},{"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript","isActive":true,"type":"reference"},{"text":" to run a complete system.","type":"text"}],"role":"article"},"doc://AdaScr