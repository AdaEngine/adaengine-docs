, you will learn how to create your first 2D scene using Ada.","type":"text"}],"url":"\/tutorials\/adaengine\/createfirst2dscene#Create-an-app","title":"Create an app","role":"pseudoSymbol","kind":"section"},"doc://AdaEngine/tutorials/AdaEngine/Create-your-first-2D-game-project.":{"type":"topic","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project.","abstract":[],"url":"\/tutorials\/adaengine\/create-your-first-2d-game-project.","title":"Create your first 2D game project.","role":"article","kind":"article"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics#Add-a-button-and-state":{"role":"pseudoSymbol","abstract":[{"type":"text","text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state."}],"type":"section","kind":"section","title":"Add a button and state","url":"\/tutorials\/adaengine\/uibasics#Add-a-button-and-state","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Add-a-button-and-state"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Subscribe-to-scene-events":{"kind":"section","abstract":[{"text":"In this tutorial you will learn about the event listeners system in Ada.","type":"text"},{"text":" ","type":"text"},{"text":"How can you catch events and process them","type":"text"}],"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Subscribe-to-scene-events","type":"section","url":"\/tutorials\/adaengine\/eventlisteners#Subscribe-to-scene-events","role":"pseudoSymbol","title":"Subscribe to scene events"},"GP-2-5-system.swift":{"highlights":[{"line":36},{"line":37},{"line":38},{"line":39}],"fileType":"swift","syntax":"swift","type":"file","identifier":"GP-2-5-system.swift","fileName":"GamepadInputSystem.swift","content":["import AdaEngine","","@PlainSystem","struct GamepadInputSystem {","","    @FilterQuery<Ref<Transform>, With<PlayerComponent>>","    private var playerQuery","","    @Res<Input>","    private var input","","    @Res<DeltaTime>","    private var deltaTime","","    init(world _: World) {}","","    func update(context _: UpdateContext) {","        let gamepads = input.getConnectedGamepads()","","        if gamepads.isEmpty {","            return","        }","","        for gamepad in gamepads {","            let leftStickX = gamepad.getAxisValue(.leftStickX)","            let leftStickY = gamepad.getAxisValue(.leftStickY)","            let deadzone: Float = 0.1","","            if abs(leftStickX) > deadzone || abs(leftStickY) > deadzone {","                playerQuery.forEach { transform in","                    let speed: Float = 2.0","                    transform.position.x += leftStickX * Float(deltaTime.deltaTime) * speed","                    transform.position.y -= leftStickY * Float(deltaTime.deltaTime) * speed","                }","            }","","            if gamepad.isGamepadButtonPressed(.x) {","                gamepad.rumble(lowFrequency: 0.5, highFrequency: 0.75, duration: 0.5)","            }","        }","    }","}"]},"Xcode 26.3 or later":{"url":"https:\/\/developer.apple.com\/download\/","identifier":"Xcode 26.3 or later","type":"xcodeRequirement","title":"Xcode 26.3 or later"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics":{"role":"project","estimatedTime":"15min","abstract":[{"type":"text","text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state."}],"type":"topic","url":"\/tutorials\/adaengine\/uibasics","title":"UI Basics","kind":"project","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics"},"GP-2-4-system.swift":{"content":["import AdaEngine","","@PlainSystem","struct GamepadInputSystem {","","    @FilterQuery<Ref<Transform>, With<PlayerComponent>>","    private var playerQuery","","    @Res<Input>","    private var input","","    @Res<DeltaTime>","    private var deltaTime","","    init(world _: World) {}","","    func update(context _: UpdateContext) {","        let gamepads = input.getConnectedGamepads()","","        if gamepads.isEmpty {","            return","        }","","        for gamepad in gamepads {","            let leftStickX = gamepad.getAxisValue(.leftStickX)","            let leftStickY = gamepad.getAxisValue(.leftStickY)","            let deadzone: Float = 0.1","","            if abs(leftStickX) > deadzone || abs(leftStickY) > deadzone {","                playerQuery.forEach { transform in","                    let speed: Float = 2.0","                    transform.position.x += leftStickX * Float(deltaTime.deltaTime) * speed","                    transform.position.y -= leftStickY * Float(deltaTime.deltaTime) * speed","                }","            }","        }","    }","}"],"identifier":"GP-2-4-system.swift","highlights":[],"type":"file","fileName":"GamepadInputSystem.swift","fileType":"swift","syntax":"swift"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Read-buttons":{"kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Read-buttons","url":"\/tutorials\/adaengine\/gamepadinput#Read-buttons","title":"Read buttons","type":"section","role":"pseudoSymbol","abstract":[{"text":"Build a small scene that spawns a player entity and moves it with a gamepad.","type":"text"}]},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene":{"role":"project","estimatedTime":"20min","abstract":[{"text":"In this tutorial, you will learn how to create your first 2D scene using Ada.","type":"text"}],"type":"topic","kind":"project","title":"Create your first 2D scene","url":"\/tutorials\/adaengine\/createfirst2dscene","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene"},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText":{"title":"Animated Text Renderer","kind":"project","type":"topic","role":"project","estimatedTime":"20min","abstract":[{"type":"text","text":"Create a custom "},{"type":"codeVoice","code":"TextRenderer"},{"text":" that draws text along a sine wave and a