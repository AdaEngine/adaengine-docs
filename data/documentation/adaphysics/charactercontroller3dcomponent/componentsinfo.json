:"An upright capsule mover. Its entity’s position is the bottom of the capsule in world units."},{"type":"text","text":" "},{"type":"text","text":"Use on a root entity without "},{"code":"PhysicsBody3DComponent","type":"codeVoice"},{"type":"text","text":"; visual scale does not resize the capsule."},{"type":"text","text":" "},{"type":"text","text":"The controller collides with physics bodies, ignores sensors, and does not push dynamic bodies"},{"type":"text","text":" "},{"type":"text","text":"or register a body that other character controllers can collide with."},{"type":"text","text":" "},{"type":"text","text":"Supported walking automatically steps over solid ledges up to 5% of the resolved height,"},{"type":"text","text":" "},{"type":"text","text":"provided the full capsule can sweep up, forward, and down to a walkable landing."}],"kind":"symbol","navigatorTitle":[{"text":"CharacterController3DComponent","kind":"identifier"}],"title":"CharacterController3DComponent","url":"\/documentation\/adaphysics\/charactercontroller3dcomponent","identifier":"doc:\/\/AdaPhysics\/documentation\/AdaPhysics\/CharacterController3DComponent","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CharacterController3DComponent","kind":"identifier"}],"type":"topic"},"doc://AdaECS/documentation/AdaECS/ComponentsInfo":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ComponentsInfo"}],"type":"topic","abstract":[],"navigatorTitle":[{"kind":"identifier","text":"ComponentsInfo"}],"title":"ComponentsInfo","identifier":"doc:\/\/AdaECS\/documentation\/AdaECS\/ComponentsInfo","url":"\/documentation\/adaecs\/componentsinfo","role":"symbol"},"doc://AdaPhysics/documentation/AdaPhysics/CharacterController3DComponent/componentsInfo":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"component