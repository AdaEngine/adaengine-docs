{"hierarchy":{"paths":[["doc:\/\/AdaScripting\/documentation\/AdaScripting"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adascripting\/adascriptecs"]}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Declare a system","anchor":"Declare-a-system","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apply "},{"type":"codeVoice","code":"@system"},{"type":"text","text":" to a class and implement "},{"type":"codeVoice","code":"update(context)"},{"text":":","type":"text"}]},{"code":["@system(scheduler: \"update\", id: \"game.movement\")","class MovementSystem {","    func update(context) {","    }","}"],"type":"codeListing","syntax":"ada"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The scheduler defaults to "},{"type":"codeVoice","code":"update"},{"type":"text","text":". System identifiers must be unique within a"},{"type":"text","text":" "},{"type":"text","text":"script module."}]},{"type":"paragraph","inlineContent":[{"text":"For one-time world setup, use ","type":"text"},{"code":"@system(scheduler: \"startup\")","type":"codeVoice"},{"type":"text","text":". Its"},{"type":"text","text":" "},{"type":"codeVoice","code":"update(context)"},{"type":"text","text":" runs on the default scheduler runner’s first update, before"},{"text":" ","type":"text"},{"type":"text","text":"the regular frame stages. A script class constructor does not receive a world"},{"text":" ","type":"text"},{"text":"context. See ","type":"text"},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","isActive":true},{"text":" for all annotation arguments.","type":"text"}]},{"text":"Order systems","level":2,"anchor":"Order-systems","type":"heading"},{"inlineContent":[{"type":"text","text":"Use repeatable "},{"code":"@after","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@before"},{"type":"text","text":" annotations when component and resource"},{"type":"text","text":" "},{"type":"text","text":"access alone does not express the required execution order:"}],"type":"paragraph"},{"code":["@after(id: \"game.input\")","@before(id: \"game.physics\")","@system(scheduler: \"update\", id: \"game.movement\")","class MovementSystem {","    func update(context) {","    }","}"],"type":"codeListing","syntax":"ada"},{"inlineContent":[{"type":"text","text":"Dependency IDs resolve within the same AdaScript module. Both systems must use"},{"text":" ","type":"text"},{"type":"text","text":"the same scheduler. AdaScript rejects unknown IDs, self-dependencies, and"},{"type":"text","text":" "},{"text":"dependency cycles while loading the module.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Declare a query","type":"heading","anchor":"Declare-a-query"},{"inlineContent":[{"type":"text","text":"Apply "},{"type":"codeVoice","code":"@query"},{"type":"text","text":" to a stored system property:"}],"type":"paragraph"},{"code":["@query(","    Health,","    Movement,","    with: Movable,","    without: Frozen",")","var entities;"],"type":"codeListing","syntax":"ada"},{"inlineContent":[{"text":"Positional components are fetched and available on each row. Four more clauses","type":"text"},{"type":"text","text":" "},{"type":"text","text":"take one component or a list:"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"text":"Clause","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Meaning"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"optional: Target"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Fetched like a positional component, but rows may lack it. "},{"type":"codeVoice","code":"entity.target"},{"type":"text","text":" is "},{"type":"codeVoice","code":"null"},{"type":"text","text":" when absent."}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"with: Movable"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The entity must have it; it is not fetched."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"without: Frozen"}]}],[{"type":"paragraph","inlineContent":[{"text":"The entity must not have it.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"changed: Health"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Rows where any listed component changed since the system last ran."}]}]],[[{"type":"paragraph","inlineContent":[{"code":"added: Marker","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Rows where any listed component was added since the system last ran.","type":"text"}]}]]],"type":"table","header":"row"},{"syntax":"ada","code":["@query(Health, Movement, optional: Target, with: Movable, without: Frozen, changed: Health)","var entities;","","for (var entity in entities) {","    if (entity.target != null) { entity.health.current -= entity.target.damage; }","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"changed"},{"type":"text","text":" and "},{"type":"codeVoice","code":"added"},{"type":"text","text":" need the component to exist in the archetype; the change tick"},{"type":"text","text":" "},{"type":"text","text":"of a component is updated by every successful field write. A boolean "},{"type":"codeVoice","code":"where:"},{"type":"text","text":" clause"},{"type":"text","text":" "},{"type":"text","text":"and any other label are rejected with a message naming the supported clauses."}],"type":"paragraph"},{"inlineContent":[{"text":"Row properties are the lower-camel-case component names, or an explicit alias","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"written with "},{"type":"codeVoice","code":"as"},{"type":"text","text":". A component may be named by its qualified path:"}],"type":"paragraph"},{"syntax":"ada","code":["@query(Game.Health as hp, Physics.Movement as motion)","var entities;","","for (var entity in entities) {","    var position = entity.motion.position;","    entity.hp.current -= 1.0;","}"],"type":"codeListing"},{"inlineContent":[{"text":"Two fetched components with the same short name (","type":"text"},{"type":"codeVoice","code":"Game.Health"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Physics.Health"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"are an error until one is given an alias, and no component may be aliased "},{"type":"codeVoice","code":"id"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"code":"entity.id","type":"codeVoice"},{"text":" exposes the native entity identifier.","type":"text"}]},{"text":"Iterator behavior","type":"heading","anchor":"Iterator-behavior","level":2},{"type":"paragraph","inlineContent":[{"text":"Ada Script queries are native iterators. AdaECS resolves matching archetypes,","type":"text"},{"text":" ","type":"text"},{"text":"binds component columns when entering a chunk, and advances their pointers by","type":"text"},{"text":" ","type":"text"},{"text":"row stride. The bridge does not create an entity proxy for every result and","type":"text"},{"text":" ","type":"text"},{"text":"does not perform a world component lookup for every field access.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A query row and its component views are borrowed. Do not retain them after the","type":"text"},{"text":" ","type":"text"},{"text":"loop or system update returns. Structural changes must use deferred commands.","type":"text"}]},{"inlineContent":[{"text":"Inactive entities are skipped. Empty queries execute zero loop iterations.","type":"text"}],"type":"paragraph"},{"text":"Component fields","level":2,"anchor":"Component-fields","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"@Component","type":"codeVoice"},{"text":" Swift macro generates the runtime field accessors used by Ada","type":"text"},{"text":" ","type":"text"},{"text":"Script. Register native components before the script plugin is set up.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Supported field values include booleans, integers, finite floating-point"},{"type":"text","text":" "},{"type":"text","text":"values, strings, vectors, quaternions, colors, and reflected enums. A rejected"},{"type":"text","text":" "},{"type":"text","text":"write leaves the component unchanged and appends a development diagnostic."}],"type":"paragraph"},{"level":2,"text":"Access planning","anchor":"Access-planning","type":"heading"},{"inlineContent":[{"text":"The compiler reads how a system uses its rows and requests exactly that access","type":"text"},{"text":" ","type":"text"},{"text":"from the scheduler:","type":"text"}],"type":"paragraph"},{"code":["var current = entity.health.current;   \/\/ read Health","entity.health.current = current - 1;   \/\/ write Health","entity.health.current -= 1;            \/\/ read and write Health"],"syntax":"ada","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A component that is only read can be shared with other readers; a write reserves"},{"type":"text","text":" "},{"type":"text","text":"it exclusively. "},{"type":"codeVoice","code":"changed:"},{"type":"text","text":" and "},{"type":"codeVoice","code":"added:"},{"type":"text","text":" read a component’s ticks, so they request"},{"type":"text","text":" "},{"type":"text","text":"read access even for a component that is not fetched. Filter-only components"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"with"},{"type":"text","text":", "},{"type":"codeVoice","code":"without"},{"type":"text","text":") request none."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Analysis follows "},{"type":"codeVoice","code":"for (var row in query)"},{"type":"text","text":" loops. If a row, a component view, or the"},{"text":" ","type":"text"},{"text":"query itself escapes into code the compiler cannot follow (passed to a function,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"stored, called with an unknown method), the system must declare what it touches:"}],"type":"paragraph"},{"type":"codeListing","syntax":"ada","code":["@system(id: \"game.inspect\")","@access(read: [Health], write: [Transform])","class InspectSystem {","    @query(Health, Transform)","    var entities;","","    func update(context) {","        for (var entity in entities) { inspect(entity); }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Without ","type":"text"},{"code":"@access","type":"codeVoice"},{"text":" this fails to compile, naming the query and component. A","type":"text"},{"text":" ","type":"text"},{"text":"declaration may be broader than the code but not narrower: declaring a component","type":"text"},{"text":" ","type":"text"},{"text":"read-only while the script writes it is an error. The same ","type":"text"},{"code":"@access","type":"codeVoice"},{"text":" declaration","type":"text"},{"type":"text","text":" "},{"type":"text","text":"governs the dynamic "},{"type":"codeVoice","code":"context.world.read\/write"},{"type":"text","text":" calls. A precompiled module has no"},{"text":" ","type":"text"},{"text":"script text to analyse and keeps write access to every fetched component.","type":"text"}]},{"type":"heading","text":"Multiple queries","anchor":"Multiple-queries","level":2},{"type":"paragraph","inlineContent":[{"text":"One system may declare multiple independent iterators:","type":"text"}]},{"type":"codeListing","syntax":"ada","code":["@system(scheduler: \"update\")","class TargetingSystem {","    @query(Player, Transform)","    var players;","","    @query(Enemy, Target, without: Dead)","    var enemies;","","    func update(context) {","        for (var enemy in enemies) {","            for (var player in players) {","                enemy.target.entity = player.id;","                break;","            }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Queries are refreshed by the scheduler before each system execution.","type":"text"}]},{"type":"heading","text":"Project input actions","anchor":"Project-input-actions","level":2},{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"inlineContent":[{"text":"Project Settings → Input Bindings","type":"text"}],"type":"strong"},{"text":", add an action such as ","type":"text"},{"code":"Jump","type":"codeVoice"},{"text":", then add","type":"text"},{"text":" ","type":"text"},{"text":"keyboard, mouse, gamepad or touch bindings. Click ","type":"text"},{"inlineContent":[{"type":"text","text":"Save Project Settings"}],"type":"strong"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Actions are stored in ","type":"text"},{"code":".ada\/project.json","type":"codeVoice"},{"text":" and loaded by both Play Mode and the","type":"text"},{"text":" ","type":"text"},{"text":"AdaScript project runtime. Multiple bindings act as alternatives: releasing one","type":"text"},{"text":" ","type":"text"},{"text":"input does not release the action while another binding is held.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Systems and scriptable components declare input as a read-only resource dependency"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"@res var input: Input;"},{"type":"text","text":". Only declarations that request Input receive it."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"codeVoice","code":"@res(optional: true) var input: Input;"},{"type":"text","text":" and "},{"type":"codeVoice","code":"input.available()"},{"type":"text","text":" when the"},{"type":"text","text":" "},{"type":"text","text":"resource may be absent; a missing required resource produces a diagnostic."}],"type":"paragraph"},{"syntax":"adascript","type":"codeListing","code":["@res var input: Input;","","func update(context) {","    if (input.isActionJustPressed(\"Jump\")) {","        \/\/ Start a jump once per press.","    }","    var movement = input.getActionStrength(\"MoveRight\");","}"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"isActionPressed(name)"},{"type":"text","text":" remains true while an input is held."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"isActionJustPressed(name)","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"isActionJustReleased(name)"},{"text":" describe transitions","type":"text"},{"text":" ","type":"text"},{"text":"during the current frame. Both can be true for a tap completed within one frame.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"getActionStrength(name)"},{"type":"text","text":" returns 0…1. Gamepad axes use a direction and the"},{"type":"text","text":" "},{"type":"text","text":"action’s dead zone; buttons and touch return either zero or one."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Gamepad bindings match any connected controller. ","type":"text"},{"code":"Any Finger Held","type":"codeVoice"},{"text":" stays active","type":"text"},{"text":" ","type":"text"},{"text":"until every contact ends or is cancelled. Touch lifecycle events, mouse motion,","type":"text"},{"text":" ","type":"text"},{"text":"and wheel bindings produce frame pulses.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Input snapshots are scoped to a callback; query input again on the next update.","type":"text"},{"text":" ","type":"text"},{"text":"Unknown action names return false or zero. Names are case-sensitive.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Swift systems use the same methods on their "},{"type":"codeVoice","code":"Input"},{"text":" resource. ","type":"text"},{"code":"InputPlugin()","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"loads the "},{"code":"inputActions","type":"codeVoice"},{"type":"text","text":" section from "},{"code":".ada\/project.json","type":"codeVoice"},{"type":"text","text":" in the current working"},{"type":"text","text":" "},{"type":"text","text":"directory, including games launched from the editor. Packaged Swift applications"},{"text":" ","type":"text"},{"text":"can decode ","type":"text"},{"code":"[InputAction]","type":"codeVoice"},{"text":" from an included resource and pass it to","type":"text"},{"text":" ","type":"text"},{"code":"InputPlugin(actions:)","type":"codeVoice"},{"text":", or call ","type":"text"},{"code":"try input.setInputActions(actions)","type":"codeVoice"},{"text":" on an existing","type":"text"},{"text":" ","type":"text"},{"text":"resource. Explicit ","type":"text"},{"code":"InputPlugin(actions: [])","type":"codeVoice"},{"text":" disables automatic project loading.","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"title":"Ada Script ECS","modules":[{"name":"Ada Script"}],"roleHeading":"Article","role":"article"},"abstract":[{"type":"text","text":"Declare annotation-driven systems and iterate native AdaECS component columns."}],"seeAlsoSections":[{"title":"ECS Integration","identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptDiagnosticsAndPerformance","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTesting"],"anchor":"ECS-Integration","generated":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS"},"kind":"article","references":{"doc://AdaScripting/documentation/AdaScripting/AdaScriptDiagnosticsAndPerformance":{"title":"Ada Script Diagnostics and Performance","type":"topic","role":"article","url":"\/documentation\/adascripting\/adascriptdiagnosticsandperformance","abstract":[{"type":"text","text":"Understand annotation, setup, and runtime failures and keep ECS work on the"},{"type":"text","text":" "},{"type":"text","text":"native chunk path."}],"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptDiagnosticsAndPerformance","kind":"article"},"doc://AdaScripting/documentation/AdaScripting":{"url":"\/documentation\/adascripting","title":"Ada Script","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting","kind":"symbol","abstract":[{"text":"Write gameplay systems in Ada Script while keeping entity filtering and access planning in AdaEngine’s native ECS.","type":"text"}],"type":"topic","role":"collection"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptAnnotations":{"url":"\/documentation\/adascripting\/adascriptannotations","abstract":[{"type":"text","text":"Choose an annotation by the declaration it describes. Annotation arguments"},{"type":"text","text":" "},{"type":"text","text":"are literals, identifiers, or lists of those values, not runtime expressions."},{"type":"text","text":" "},{"type":"text","text":"The same spelling can have different roles: "},{"type":"codeVoice","code":"@component"},{"type":"text","text":" declares a struct,"},{"type":"text","text":" "},{"type":"text","text":"while "},{"type":"codeVoice","code":"@component(required: true)"},{"type":"text","text":" binds an existing component to a scriptable"},{"type":"text","text":" "},{"type":"text","text":"instance."}],"role":"article","type":"topic","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","title":"Ada Script Annotation Reference","kind":"article"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptTesting":{"type":"topic","kind":"article","abstract":[{"type":"text","text":"Write tests next to your gameplay code, run them with "},{"type":"codeVoice","code":"swift test"},{"type":"text","text":" or a command, and keep them out of shipped builds."}],"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTesting","title":"Testing Ada Script","url":"\/documentation\/adascripting\/adascripttesting","role":"collectionGroup"}}}