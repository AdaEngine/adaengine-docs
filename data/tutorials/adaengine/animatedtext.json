            line","        }","    }","","    var flattenedRuns: some RandomAccessCollection<Glyph> {","        runs.flatMap { $0 }","    }","}"],"identifier":"AT-2-1-layout.swift","highlights":[],"type":"file","fileType":"swift"},"AT-1-1-app.swift":{"syntax":"swift","fileName":"AnimatedTextApp.swift","content":["import AdaEngine","","@main","struct AnimatedTextApp: App {","    var body: some AppScene {","        WindowGroup {","            ContentView()","        }","        .windowMode(.windowed)","        .windowTitle(\"Animated Text\")","    }","}"],"highlights":[],"type":"file","fileType":"swift","identifier":"AT-1-1-app.swift"},"AT-3-2-view.swift":{"fileName":"ContentView.swift","syntax":"swift","content":["import AdaEngine","","struct ContentView: View {","    @State private var timeOffset: Double = 0","    @State private var animationTask: Task<Void, Never>?","","    var body: some View {","        Text(\"Sine Wave\")","            .textRendered(AnimatedSineWaveRenderer(timeOffset: timeOffset))","            .onAppear {","                startAnimation()","            }","    }","","    private func startAnimation() {","        animationTask?.cancel()","        animationTask = Task { @MainActor in","            while !Task.isCancelled {","                timeOffset += 0.12","                try? await Task.sleep(nanoseconds: 16_000_000)","            }","        }","    }","}"],"identifier":"AT-3-2-view.swift","highlights":[{"line":5},{"line":10},{"line":11},{"line":12},{"line":13},{"line":14},{"line":15},{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22}],"type":"file","fileType":"swift"}}}