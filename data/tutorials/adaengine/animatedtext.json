ome View {","        Text(\"Sine Wave\")","            .textRendered(AnimatedSineWaveRenderer(timeOffset: timeOffset))","            .onAppear {","                startAnimation()","            }","            .onDisappear {","                animationTask?.cancel()","                animationTask = nil","            }","    }","","    private func startAnimation() {","        animationTask?.cancel()","        animationTask = Task { @MainActor in","            while !Task.isCancelled {","                timeOffset += 0.12","                try? await Task.sleep(nanoseconds: 16_000_000)","            }","        }","    }","}"],"type":"file","fileName":"ContentView.swift","fileType":"swift","highlights":[{"line":13},{"line":14},{"line":15},{"line":16}]},"doc://AdaEngine/tutorials/AdaEngine/PlayerAndText#Add-Player-component":{"role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Player-component","abstract":[{"type":"text","text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene."}],"title":"Add Player component","type":"section","url":"\/tutorials\/adaengine\/playerandtext#Add-Player-component"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Read-buttons":{"role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Read-buttons","abstract":[{"type":"text","text":"Build a small scene that spawns a player entity and moves it with a gamepad."}],"title":"Read buttons","type":"section","url":"\/tutorials\/adaengine\/gamepadinput#Read-buttons"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Make-it-move":{"role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Make-it-move","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using AdaEngine."}],"title":"Make it