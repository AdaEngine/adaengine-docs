{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adaengine\/pipelinedrendering"]}],"seeAlsoSections":[{"generated":true,"title":"Guides","anchor":"Guides","identifiers":["doc:\/\/AdaEngine\/documentation\/AdaEngine\/Building","doc:\/\/AdaEngine\/documentation\/AdaEngine\/Contributing","doc:\/\/AdaEngine\/documentation\/AdaEngine\/AdaUIIdentity","doc:\/\/AdaEngine\/documentation\/AdaEngine\/ImageDecoders","doc:\/\/AdaEngine\/documentation\/AdaEngine\/AnimationAuthoring","doc:\/\/AdaEngine\/documentation\/AdaEngine\/AnimationIK","doc:\/\/AdaEngine\/documentation\/AdaEngine\/GameDiagnosticsOverlay","doc:\/\/AdaEngine\/documentation\/AdaEngine\/MovieMaker","doc:\/\/AdaEngine\/documentation\/AdaEngine\/Terrain","doc:\/\/AdaEngine\/documentation\/AdaEngine\/VisionOSWindowed","doc:\/\/AdaEngine\/documentation\/AdaEngine\/WESLShaders"]}],"hierarchy":{"paths":[["doc:\/\/AdaEngine\/documentation\/AdaEngine"]]},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/PipelinedRendering"},"kind":"article","metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"AdaEngine"}],"title":"Pipelined Rendering"},"abstract":[{"text":"Render a scene one frame behind its simulation to overlap rendering with the next frame’s work.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"By default a frame runs every world in sequence: the scene simulates, extracts its renderable state,"},{"type":"text","text":" "},{"type":"text","text":"renders, and only then can the window’s UI and the next frame start. With pipelined rendering, the"},{"type":"text","text":" "},{"type":"text","text":"scene’s render world draws frame N while the simulation and UI already prepare frame N+1. Extraction is"},{"type":"text","text":" "},{"type":"text","text":"the only point where the two meet: before extracting frame N+1, the engine waits for frame N to finish."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A frame then takes about as long as the slower of the two paths instead of their sum. The cost is one"},{"type":"text","text":" "},{"type":"text","text":"frame of input latency, about 7 ms on a 143 Hz display. Pipelining does not reduce GPU time: when the GPU"},{"type":"text","text":" "},{"type":"text","text":"is already the limit, the frame rate does not change."}],"type":"paragraph"},{"inlineContent":[{"text":"Enable it for a ","type":"text"},{"type":"codeVoice","code":"SceneView"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["SceneView(useSceneCameras: true, make: { app in","    app.addPlugin(RenderWorldPlugin())","    \/\/ ...","}, updateContent: { _, _ in })",".pipelinedRendering()"]},{"inlineContent":[{"type":"text","text":"Or for any render world you manage yourself:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["renderWorld.insertResource(RenderPipelining(isEnabled: true))"]},{"type":"paragraph","inlineContent":[{"text":"Set ","type":"text"},{"type":"codeVoice","code":"ADAENGINE_PIPELINED_RENDERING=0"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"=1"},{"text":" to override the setting of every world that declares it,","type":"text"},{"text":" ","type":"text"},{"text":"for example to compare both modes. WebAssembly builds always render serially.","type":"text"}]},{"type":"heading","level":2,"text":"Rules for scene code","anchor":"Rules-for-scene-code"},{"inlineContent":[{"text":"While a frame is in flight, the simulation and the renderer run at the same time. Two rules keep them","type":"text"},{"text":" ","type":"text"},{"text":"apart:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Render systems read the scene only during extraction.","type":"text"}],"type":"strong"},{"text":" Use ","type":"text"},{"code":"Extract","type":"codeVoice"},{"text":" parameters only in systems","type":"text"},{"text":" ","type":"text"},{"text":"registered on the ","type":"text"},{"code":".extract","type":"codeVoice"},{"text":" schedule, and copy what later schedules need into render-world resources.","type":"text"},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"code":"MainWorld","type":"codeVoice"},{"text":" reference is removed after extraction; debug builds assert when ","type":"text"},{"code":"Extract","type":"codeVoice"},{"text":" is read later.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Do not mutate assets in place while they are rendered."}],"type":"strong"},{"text":" The renderer draws a snapshot of each","type":"text"},{"text":" ","type":"text"},{"code":"PBRMaterial","type":"codeVoice"},{"text":" taken at extraction, so material edits are safe and appear one frame later. Other assets","type":"text"},{"text":" ","type":"text"},{"text":"such as meshes and textures should be replaced, not edited in place, while a frame may be rendering them.","type":"text"}]}]}]},{"inlineContent":[{"text":"Tooling entry points such as ","type":"text"},{"type":"codeVoice","code":"AppWorlds.withWorldAccess(_:)"},{"type":"text","text":" wait for the frame in flight before they run."},{"type":"text","text":" "},{"type":"text","text":"Render statistics resources are synchronized and can be read at any time."}],"type":"paragraph"},{"anchor":"Measuring","type":"heading","level":2,"text":"Measuring"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Run with "},{"type":"codeVoice","code":"ADAENGINE_STALL_PROBE=1"},{"type":"text","text":" to print slow operations, including "},{"type":"codeVoice","code":"App.Update.*"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Schedule.*"},{"type":"text","text":" "},{"type":"text","text":"spans for each world. With pipelining on, the scene’s update on the main thread shrinks to its simulation"},{"type":"text","text":" "},{"type":"text","text":"and extraction while its render world appears as a separate span. The Sponza technical example also"},{"type":"text","text":" "},{"type":"text","text":"prints per-second frame statistics with "},{"type":"codeVoice","code":"ADAENGINE_SPONZA_FRAME_LOG=1"},{"type":"text","text":"."}]}]}],"references":{"doc://AdaEngine/documentation/AdaEngine/AnimationIK":{"url":"\/documentation\/adaengine\/animationik","kind":"article","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/AnimationIK","role":"article","type":"topic","abstract":[{"text":"Constrain a skeletal chain after its clip, Animation Graph and visual LOD pose have been mixed.","type":"text"}],"title":"Animation IK and pose modifiers"},"doc://AdaEngine/documentation/AdaEngine/VisionOSWindowed":{"type":"topic","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/VisionOSWindowed","url":"\/documentation\/adaengine\/visionoswindowed","kind":"article","title":"visionOS Windowed Mode","abstract":[{"type":"text","text":"Run Ada apps in visionOS Shared Space using the existing "},{"type":"codeVoice","code":"WindowGroup"},{"type":"text","text":" scene model."}],"role":"article"},"doc://AdaEngine/documentation/AdaEngine/Terrain":{"type":"topic","url":"\/documentation\/adaengine\/terrain","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/Terrain","title":"Terrain","kind":"article","abstract":[{"type":"text","text":"Create editable ground with "},{"type":"codeVoice","code":"Terrain3D"},{"type":"text","text":". Its heights describe one square surface"},{"type":"text","text":" "},{"type":"text","text":"in the entity’s local X\/Z plane. "},{"type":"codeVoice","code":"Model3DPlugin"},{"type":"text","text":" generates the visible geometry;"},{"type":"text","text":" "},{"type":"codeVoice","code":"Physics3DPlugin"},{"type":"text","text":" adds matching static triangle collision."}],"role":"article"},"doc://AdaEngine/documentation/AdaEngine":{"role":"collection","title":"AdaEngine","url":"\/documentation\/adaengine","abstract":[{"text":"Bringing simple and powerful game engine for your awesome games.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine","type":"topic"},"doc://AdaEngine/documentation/AdaEngine/Building":{"type":"topic","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/Building","url":"\/documentation\/adaengine\/building","kind":"article","title":"Building Ada","abstract":[{"type":"text","text":"This guide covers two scenarios:"}],"role":"article"},"doc://AdaEngine/documentation/AdaEngine/GameDiagnosticsOverlay":{"title":"Game diagnostics overlay","kind":"article","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/GameDiagnosticsOverlay","role":"article","type":"topic","abstract":[{"type":"text","text":"See the game’s update rate while you play. The overlay shows "},{"type":"strong","inlineContent":[{"type":"text","text":"FPS"}]},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"Frame time","type":"text"}]},{"type":"text","text":" in the top-left corner of the game window. Mouse and keyboard"},{"type":"text","text":" "},{"type":"text","text":"input still reach the game under the overlay."}],"url":"\/documentation\/adaengine\/gamediagnosticsoverlay"},"doc://AdaEngine/documentation/AdaEngine/Contributing":{"url":"\/documentation\/adaengine\/contributing","kind":"article","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/Contributing","role":"article","type":"topic","abstract":[{"type":"text","text":"We welcome contributions of all kinds: bug fixes, features, documentation, and examples."}],"title":"Contributing to Ada"},"doc://AdaEngine/documentation/AdaEngine/AdaUIIdentity":{"abstract":[{"text":"AdaUI reconciles a new view tree against the mounted ","type":"text"},{"code":"ViewNode","type":"codeVoice"},{"text":" tree. A node is preserved only when the new node and old node describe the same identity and the new node can update the old node. Preserved nodes keep their ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":", focus state, in-flight animation controllers, layers, and other node-local runtime state. Recreated nodes start with fresh runtime state.","type":"text"}],"identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/AdaUIIdentity","type":"topic","role":"article","title":"AdaUI View Identity","url":"\/documentation\/adaengine\/adauiidentity","kind":"article"},"doc://AdaEngine/documentation/AdaEngine/MovieMaker":{"kind":"symbol","abstract":[{"type":"text","text":"Records a fresh game world at a fixed simulation rate, waiting for every GPU"},{"type":"text","text":" "},{"type":"text","text":"frame and disk write before advancing. Rendering speed never drops movie frames."},{"type":"text","text":" "},{"type":"text","text":"Configure the same gameplay plugins and cameras as your game in "},{"type":"codeVoice","code":"make"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Platform\/window plugins are unnecessary for this offscreen runtime."}],"type":"topic","url":"\/documentation\/adaengine\/moviemaker","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MovieMaker"}],"title":"MovieMaker","navigatorTitle":[{"kind":"identifier","text":"MovieMaker"}],"identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/MovieMaker"},"doc://AdaEngine/documentation/AdaEngine/ImageDecoders":{"url":"\/documentation\/adaengine\/imagedecoders","kind":"article","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/ImageDecoders","role":"article","type":"topic","abstract":[{"type":"text","text":"Load PNG, JPEG ("},{"type":"codeVoice","code":"jpg"},{"type":"text","text":" or "},{"type":"codeVoice","code":"jpeg"},{"type":"text","text":"), BMP and TGA images as CPU pixels using"},{"type":"text","text":" "},{"type":"codeVoice","code":"Image"},{"text":", or load a GPU texture through ","type":"text"},{"type":"codeVoice","code":"Texture2D"},{"text":":","type":"text"}],"title":"Loading images and adding formats"},"doc://AdaEngine/documentation/AdaEngine/WESLShaders":{"type":"topic","url":"\/documentation\/adaengine\/weslshaders","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/WESLShaders","title":"Compile modular WESL shaders","kind":"article","abstract":[{"text":"Link local shader modules and compile feature variants to WGSL with the AdaEngine host tool.","type":"text"}],"role":"article"},"doc://AdaEngine/documentation/AdaEngine/AnimationAuthoring":{"url":"\/documentation\/adaengine\/animationauthoring","kind":"article","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/AnimationAuthoring","role":"article","type":"topic","abstract":[{"type":"text","text":"Copy an imported animation or capture a rest\/current pose into a project-owned"},{"type":"text","text":" "},{"type":"codeVoice","code":".animlib"},{"type":"text","text":" resource. Source GLB\/glTF bytes remain unchanged. Swift code, Studio’s"},{"type":"text","text":" "},{"type":"text","text":"Animator, the editor agent and project Tools share the same data and edit commands."}],"title":"Authoring skeletal animation"}}}