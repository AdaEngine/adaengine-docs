{"sections":[],"kind":"symbol","hierarchy":{"paths":[[]]},"abstract":[{"text":"Bringing simple and powerful game engine for your awesome games.","type":"text"}],"primaryContentSections":[{"content":[{"text":"Additional Resources","type":"heading","level":2,"anchor":"Additional-Resources"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"https:\/\/github.com\/adaengine\/adaengine","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"https:\/\/github.com\/adaengine\/adaengine\/discussions","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"https:\/\/www.adaengine.org\/","isActive":true}]}]}]},{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"AdaEngine is a modern, open-source game engine written in Swift, designed for building 2D and 3D games with simplicity and performance in mind. Its architecture leverages the Entity Component System (ECS) paradigm, enabling developers to create games and interactive experiences using a modular and scalable approach.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"AdaEngine provides a suite of built-in features, including:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"High-level rendering system supporting 2D and 3D graphics"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Physics, animation, input handling, audio, and UI systems"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Asset management pipeline and streamlined workflows"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cross-platform support across Apple platforms and Linux"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Hot-reload capabilities for assets and scripts"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Modern Swift API with async\/await, property wrappers, and result builders"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"With AdaEngine, both beginners and experienced Swift developers can build games rapidly, focusing on gameplay instead of low-level boilerplate. Extensive documentation and tutorials make it easy to get started, from setting up your first scene to advanced gameplay mechanics.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"AdaEngine is actively developed, and contributions from the community are welcome.","type":"text"},{"text":" ","type":"text"},{"text":"For more details and guides, check out the tutorials below.","type":"text"}]}],"kind":"content"}],"metadata":{"symbolKind":"module","title":"AdaEngine","modules":[{"name":"AdaEngine"}],"roleHeading":"Framework","role":"collection","externalID":"AdaEngine"},"schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"identifiers":["doc:\/\/AdaEngine\/documentation\/AdaEngine"],"anchor":"Tutorials","title":"Tutorials"},{"identifiers":["doc:\/\/AdaEngine\/documentation\/AdaEngine\/Building","doc:\/\/AdaEngine\/documentation\/AdaEngine\/Contributing","doc:\/\/AdaEngine\/documentation\/AdaEngine\/AdaUIIdentity","doc:\/\/AdaEngine\/documentation\/AdaEngine\/VisionOSWindowed"],"anchor":"Guides","title":"Guides"},{"identifiers":["doc:\/\/AdaEngine\/documentation\/AdaEngine\/HowToBuildEngine","doc:\/\/AdaEngine\/documentation\/AdaEngine\/SPMDebug","doc:\/\/AdaEngine\/documentation\/AdaEngine\/MakeTutorials"],"generated":true,"anchor":"Articles","title":"Articles"},{"identifiers":["doc:\/\/AdaEngine\/documentation\/AdaEngine\/AdaUIDebug3DResource","doc:\/\/AdaEngine\/documentation\/AdaEngine\/AdaUIDebug3DVisibility","doc:\/\/AdaEngine\/documentation\/AdaEngine\/FPSCounter"],"generated":true,"anchor":"Classes","title":"Classes"},{"identifiers":["doc:\/\/AdaEngine\/document