{"hierarchy":{"paths":[["doc:\/\/AdaScripting\/documentation\/AdaScripting"]]},"identifier":{"url":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTesting","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"Ada Script"}],"roleHeading":"API Collection","role":"collectionGroup","title":"Testing Ada Script"},"abstract":[{"type":"text","text":"Write tests next to your gameplay code, run them with "},{"code":"swift test","type":"codeVoice"},{"type":"text","text":" or a command, and keep them out of shipped builds."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adascripting\/adascripttesting"]}],"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"topicSections":[{"anchor":"Running-tests","identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestProject","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestReport","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestCase","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestResult"],"title":"Running tests"}],"seeAlsoSections":[{"anchor":"ECS-Integration","identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptDiagnosticsAndPerformance"],"generated":true,"title":"ECS Integration"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"A function annotated with ","type":"text"},{"code":"@test","type":"codeVoice"},{"text":" is a test. It takes no parameters and may sit in any ","type":"text"},{"code":".ada","type":"codeVoice"},{"text":" file, where it can see that file’s ","type":"text"},{"code":"private","type":"codeVoice"},{"text":" declarations, or under a ","type":"text"},{"code":"Tests\/","type":"codeVoice"},{"text":" directory, where it sees public declarations only.","type":"text"}],"type":"paragraph"},{"syntax":"ada","code":["@system(id: \"gravity\")","class GravitySystem {","    @query(Body)","    var bodies;","","    func update(context) { \/* … *\/ }","}","","private func clampSpeed(speed) { return Math.max(speed, -50.0); }","","@test(\"speed is capped\")","func speedIsCapped() {","    expectEqual(clampSpeed(-100.0), -50.0);","}"],"type":"codeListing"},{"text":"Assertions","anchor":"Assertions","level":3,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"expect(condition)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"expectEqual(actual, expected)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"expectNear(actual, expected, tolerance)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"expectNil(value)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"fail(message)"},{"text":" record a failure and let the test continue. ","type":"text"},{"code":"require(condition)","type":"codeVoice"},{"text":" records a failure and ends the test. Each failure is reported as ","type":"text"},{"code":"path:line:column: message","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"TestWorld","anchor":"TestWorld"},{"type":"paragraph","inlineContent":[{"code":"TestWorld()","type":"codeVoice"},{"text":" creates an isolated world with the module’s components and systems. Time moves only when the test says so.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Run synchronous "},{"type":"codeVoice","code":"TestWorld"},{"type":"text","text":" steps on the host. Browser players cannot block their"},{"type":"text","text":" "},{"type":"text","text":"single thread while awaiting the scheduler; they report a diagnostic if asked to"},{"type":"text","text":" "},{"type":"text","text":"step a test world. Gameplay systems continue through the normal async frame loop."}]},{"type":"codeListing","syntax":"ada","code":["@test(\"a body falls\")","func falls() {","    var world = TestWorld();","    var body = world.spawn([Body(y: 10.0, speed: 0.0)]);","    world.run(30);","    expect(world.read(body, \"Body\", \"y\") < 10.0);","}"]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"spawn(components)"},{"type":"text","text":", "},{"type":"codeVoice","code":"insert(entity, component)"},{"type":"text","text":", "},{"type":"codeVoice","code":"remove(entity, name)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"despawn(entity)"},{"type":"text","text":" change entities at once."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"has(entity, name)"},{"type":"text","text":", "},{"type":"codeVoice","code":"read(entity, name, field)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"count(name)"},{"type":"text","text":" inspect them."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"run(ticks)"},{"type":"text","text":" installs every system and runs fixed 1\/60 s ticks. "},{"type":"codeVoice","code":"runSystem(System, ticks)"},{"type":"text","text":" installs only that system. "},{"type":"codeVoice","code":"advance(seconds)"},{"type":"text","text":" runs one step of an exact length."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Each test gets its own world. Module-level ","type":"text"},{"code":"var","type":"codeVoice"},{"text":" values that are numbers, booleans, strings or null are restored after each test; lists and maps are not.","type":"text"}]},{"level":3,"type":"heading","anchor":"The-Tests-directory","text":"The Tests directory"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Files under "},{"code":"Tests\/","type":"codeVoice"},{"type":"text","text":" are compiled only when tests run, and gameplay code cannot import from them."}]},{"level":3,"type":"heading","anchor":"Running-tests","text":"Running tests"},{"type":"paragraph","inlineContent":[{"text":"Load a project with tests and run it from Swift:","type":"text"}]},{"code":["let plugin = try AdaScriptPlugin(sources: sources, name: \"Game\", includeTests: true)","let results = plugin.runTests()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"or point ","type":"text"},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestProject","isActive":true},{"text":" at a directory, which picks up every ","type":"text"},{"type":"codeVoice","code":".ada"},{"text":" file, and render the outcome with ","type":"text"},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestReport","isActive":true},{"text":" as text, JUnit or JSON. The ","type":"text"},{"type":"codeVoice","code":"AdaScriptTest"},{"text":" command does the same from a terminal and exits non-zero on failure:","type":"text"}],"type":"paragraph"},{"code":["swift run AdaScriptTest Path\/To\/Project --format junit"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Production modules never contain tests. Loading without "},{"type":"codeVoice","code":"includeTests"},{"type":"text","text":" removes every "},{"type":"codeVoice","code":"@test"},{"type":"text","text":" function and the "},{"type":"codeVoice","code":"Tests\/"},{"type":"text","text":" directory, and reports any gameplay code that refers to a test-only name such as "},{"type":"codeVoice","code":"expect"},{"type":"text","text":" or "},{"type":"codeVoice","code":"TestWorld"},{"type":"text","text":"."}],"type":"paragraph"}]}],"references":{"doc://AdaScripting/documentation/AdaScripting/AdaScriptTestProject":{"navigatorTitle":[{"text":"AdaScriptTestProject","kind":"identifier"}],"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestProject","type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptTestProject","kind":"identifier"}],"title":"AdaScriptTestProject","url":"\/documentation\/adascripting\/adascripttestproject","abstract":[{"text":"Runs the ","type":"text"},{"code":"@test","type":"codeVoice"},{"text":" functions of an Ada Script project on disk (ADR-0024).","type":"text"}]},"doc://AdaScripting/documentation/AdaScripting/AdaScriptECS":{"type":"topic","abstract":[{"type":"text","text":"Declare annotation-driven systems and iterate native AdaECS component columns."}],"url":"\/documentation\/adascripting\/adascriptecs","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS","title":"Ada Script ECS","role":"article","kind":"article"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptTestReport":{"navigatorTitle":[{"text":"AdaScriptTestReport","kind":"identifier"}],"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestReport","type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptTestReport","kind":"identifier"}],"title":"AdaScriptTestReport","url":"\/documentation\/adascripting\/adascripttestreport","abstract":[{"text":"Text, JUnit and JSON renderings of test results, for terminals and CI.","type":"text"}]},"doc://AdaScripting/documentation/AdaScripting/AdaScriptDiagnosticsAndPerformance":{"title":"Ada Script Diagnostics and Performance","abstract":[{"type":"text","text":"Understand annotation, setup, and runtime failures and keep ECS work on the"},{"type":"text","text":" "},{"type":"text","text":"native chunk path."}],"url":"\/documentation\/adascripting\/adascriptdiagnosticsandperformance","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptDiagnosticsAndPerformance","kind":"article","role":"article","type":"topic"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptTestCase":{"navigatorTitle":[{"text":"AdaScriptTestCase","kind":"identifier"}],"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestCase","type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptTestCase","kind":"identifier"}],"title":"AdaScriptTestCase","abstract":[{"type":"text","text":"One "},{"type":"codeVoice","code":"@test"},{"type":"text","text":" function discovered in an Ada Script module (ADR-0024)."}],"url":"\/documentation\/adascripting\/adascripttestcase"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptTestResult":{"type":"topic","role":"symbol","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestResult","url":"\/documentation\/adascripting\/adascripttestresult","title":"AdaScriptTestResult","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"AdaScriptTestResult","kind":"identifier"}],"navigatorTitle":[{"text":"AdaScriptTestResult","kind":"identifier"}],"abstract":[{"text":"The outcome of running one ","type":"text"},{"code":"@test","type":"codeVoice"},{"text":" function.","type":"text"}]},"doc://AdaScripting/documentation/AdaScripting":{"type":"topic","role":"collection","kind":"symbol","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting","title":"Ada Script","url":"\/documentation\/adascripting","abstract":[{"text":"Write gameplay systems in Ada Script while keeping entity filtering and access planning in AdaEngine’s native ECS.","type":"text"}]}}}