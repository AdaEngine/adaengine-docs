{"kind":"article","sections":[],"metadata":{"modules":[{"name":"Ada Script"}],"roleHeading":"API Collection","role":"collectionGroup","title":"Testing Ada Script"},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTesting","interfaceLanguage":"swift"},"abstract":[{"text":"Write tests next to your gameplay code, run them with ","type":"text"},{"code":"swift test","type":"codeVoice"},{"text":" or a command, and keep them out of shipped builds.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A function annotated with "},{"type":"codeVoice","code":"@test"},{"type":"text","text":" is a test. It takes no parameters and may sit in any "},{"type":"codeVoice","code":".ada"},{"type":"text","text":" file, where it can see that file’s "},{"type":"codeVoice","code":"private"},{"type":"text","text":" declarations, or under a "},{"type":"codeVoice","code":"Tests\/"},{"type":"text","text":" directory, where it sees public declarations only."}],"type":"paragraph"},{"syntax":"ada","code":["@system(id: \"gravity\")","class GravitySystem {","    @query(Body)","    var bodies;","","    func update(context) { \/* … *\/ }","}","","private func clampSpeed(speed) { return Math.max(speed, -50.0); }","","@test(\"speed is capped\")","func speedIsCapped() {","    expectEqual(clampSpeed(-100.0), -50.0);","}"],"type":"codeListing"},{"anchor":"Assertions","level":3,"text":"Assertions","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"expect(condition)"},{"type":"text","text":", "},{"type":"codeVoice","code":"expectEqual(actual, expected)"},{"type":"text","text":", "},{"type":"codeVoice","code":"expectNear(actual, expected, tolerance)"},{"type":"text","text":", "},{"type":"codeVoice","code":"expectNil(value)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"fail(message)"},{"type":"text","text":" record a failure and let the test continue. "},{"type":"codeVoice","code":"require(condition)"},{"type":"text","text":" records a failure and ends the test. Each failure is reported as "},{"type":"codeVoice","code":"path:line:column: message"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"TestWorld","level":3,"text":"TestWorld","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"TestWorld()"},{"type":"text","text":" creates an isolated world with the module’s components and systems. Time moves only when the test says so."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Run synchronous "},{"type":"codeVoice","code":"TestWorld"},{"type":"text","text":" steps on the host. Browser players cannot block their"},{"type":"text","text":" "},{"type":"text","text":"single thread while awaiting the scheduler; they report a diagnostic if asked to"},{"type":"text","text":" "},{"type":"text","text":"step a test world. Gameplay systems continue through the normal async frame loop."}],"type":"paragraph"},{"syntax":"ada","code":["@test(\"a body falls\")","func falls() {","    var world = TestWorld();","    var body = world.spawn([Body(y: 10.0, speed: 0.0)]);","    world.run(30);","    expect(world.read(body, \"Body\", \"y\") < 10.0);","}"],"type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"spawn(components)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"insert(entity, component)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"remove(entity, name)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"despawn(entity)","type":"codeVoice"},{"text":" change entities at once.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"has(entity, name)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"read(entity, name, field)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"count(name)","type":"codeVoice"},{"text":" inspect them.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"run(ticks)","type":"codeVoice"},{"text":" installs every system and runs fixed 1\/60 s ticks. ","type":"text"},{"code":"runSystem(System, ticks)","type":"codeVoice"},{"text":" installs only that system. ","type":"text"},{"code":"advance(seconds)","type":"codeVoice"},{"text":" runs one step of an exact length.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Each test gets its own world. Module-level "},{"type":"codeVoice","code":"var"},{"type":"text","text":" values that are numbers, booleans, strings or null are restored after each test; lists and maps are not."}],"type":"paragraph"},{"anchor":"The-Tests-directory","level":3,"text":"The Tests directory","type":"heading"},{"inlineContent":[{"type":"text","text":"Files under "},{"type":"codeVoice","code":"Tests\/"},{"type":"text","text":" are compiled only when tests run, and gameplay code cannot import from them."}],"type":"paragraph"},{"anchor":"Running-tests","level":3,"text":"Running tests","type":"heading"},{"inlineContent":[{"type":"text","text":"Load a project with tests and run it from Swift:"}],"type":"paragraph"},{"syntax":"swift","code":["let plugin = try AdaScriptPlugin(sources: sources, name: \"Game\", includeTests: true)","let results = plugin.runTests()"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"or point "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestProject"},{"type":"text","text":" at a directory, which picks up every "},{"type":"codeVoice","code":".ada"},{"type":"text","text":" file, and render the outcome with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestReport"},{"type":"text","text":" as text, JUnit or JSON. The "},{"type":"codeVoice","code":"AdaScriptTest"},{"type":"text","text":" command does the same from a terminal and exits non-zero on failure:"}],"type":"paragraph"},{"syntax":null,"code":["swift run AdaScriptTest Path\/To\/Project --format junit"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Production modules never contain tests. Loading without "},{"type":"codeVoice","code":"includeTests"},{"type":"text","text":" removes every "},{"type":"codeVoice","code":"@test"},{"type":"text","text":" function and the "},{"type":"codeVoice","code":"Tests\/"},{"type":"text","text":" directory, and reports any gameplay code that refers to a test-only name such as "},{"type":"codeVoice","code":"expect"},{"type":"text","text":" or "},{"type":"codeVoice","code":"TestWorld"},{"type":"text","text":"."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adascripting\/adascripttesting"]}],"topicSections":[{"identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestProject","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestReport","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestCase","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestResult"],"title":"Running tests","anchor":"Running-tests"}],"seeAlsoSections":[{"identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptDiagnosticsAndPerformance"],"title":"ECS Integration","generated":true,"anchor":"ECS-Integration"}],"hierarchy":{"paths":[["doc:\/\/AdaScripting\/documentation\/AdaScripting"]]},"references":{"doc://AdaScripting/documentation/AdaScripting/AdaScriptTestResult":{"navigatorTitle":[{"text":"AdaScriptTestResult","kind":"identifier"}],"type":"topic","url":"\/documentation\/adascripting\/adascripttestresult","abstract":[{"type":"text","text":"The outcome of running one "},{"type":"codeVoice","code":"@test"},{"text":" function.","type":"text"}],"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestResult","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptTestResult","kind":"identifier"}],"title":"AdaScriptTestResult","role":"symbol","kind":"symbol"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptTestProject":{"navigatorTitle":[{"text":"AdaScriptTestProject","kind":"identifier"}],"type":"topic","url":"\/documentation\/adascripting\/adascripttestproject","abstract":[{"type":"text","text":"Runs the "},{"type":"codeVoice","code":"@test"},{"type":"text","text":" functions of an Ada Script project on disk (ADR-0024)."}],"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestProject","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptTestProject","kind":"identifier"}],"title":"AdaScriptTestProject","role":"symbol","kind":"symbol"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptECS":{"kind":"article","abstract":[{"type":"text","text":"Declare annotation-driven systems and iterate native AdaECS component columns."}],"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS","type":"topic","url":"\/documentation\/adascripting\/adascriptecs","title":"Ada Script ECS","role":"article"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptDiagnosticsAndPerformance":{"kind":"article","abstract":[{"type":"text","text":"Understand annotation, setup, and runtime failures and keep ECS work on the"},{"text":" ","type":"text"},{"type":"text","text":"native chunk path."}],"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptDiagnosticsAndPerformance","type":"topic","url":"\/documentation\/adascripting\/adascriptdiagnosticsandperformance","title":"Ada Script Diagnostics and Performance","role":"article"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptTestReport":{"navigatorTitle":[{"text":"AdaScriptTestReport","kind":"identifier"}],"type":"topic","url":"\/documentation\/adascripting\/adascripttestreport","abstract":[{"text":"Text, JUnit and JSON renderings of test results, for terminals and CI.","type":"text"}],"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestReport","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"AdaScriptTestReport"}],"title":"AdaScriptTestReport","role":"symbol","kind":"symbol"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptTestCase":{"navigatorTitle":[{"text":"AdaScriptTestCase","kind":"identifier"}],"type":"topic","url":"\/documentation\/adascripting\/adascripttestcase","abstract":[{"type":"text","text":"One "},{"type":"codeVoice","code":"@test"},{"type":"text","text":" function discovered in an Ada Script module (ADR-0024)."}],"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestCase","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptTestCase","kind":"identifier"}],"title":"AdaScriptTestCase","role":"symbol","kind":"symbol"},"doc://AdaScripting/documentation/AdaScripting":{"type":"topic","abstract":[{"type":"text","text":"Write gameplay systems in Ada Script while keeping entity filtering and access planning in AdaEngine’s native ECS."}],"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting","kind":"symbol","url":"\/documentation\/adascripting","role":"collection","title":"Ada Script"}}}