{"hierarchy":{"paths":[["doc:\/\/AdaEngine\/documentation\/AdaEngine"]]},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"AdaEngine"}],"role":"article","roleHeading":"Article","title":"Game diagnostics overlay"},"abstract":[{"type":"text","text":"See the game’s update rate while you play. The overlay shows "},{"type":"strong","inlineContent":[{"type":"text","text":"FPS"}]},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"Frame time","type":"text"}]},{"type":"text","text":" in the top-left corner of the game window. Mouse and keyboard"},{"type":"text","text":" "},{"type":"text","text":"input still reach the game under the overlay."}],"seeAlsoSections":[{"title":"Guides","generated":true,"identifiers":["doc:\/\/AdaEngine\/documentation\/AdaEngine\/Building","doc:\/\/AdaEngine\/documentation\/AdaEngine\/Contributing","doc:\/\/AdaEngine\/documentation\/AdaEngine\/AdaUIIdentity","doc:\/\/AdaEngine\/documentation\/AdaEngine\/ImageDecoders","doc:\/\/AdaEngine\/documentation\/AdaEngine\/AnimationAuthoring","doc:\/\/AdaEngine\/documentation\/AdaEngine\/AnimationIK","doc:\/\/AdaEngine\/documentation\/AdaEngine\/MovieMaker","doc:\/\/AdaEngine\/documentation\/AdaEngine\/PipelinedRendering","doc:\/\/AdaEngine\/documentation\/AdaEngine\/Terrain","doc:\/\/AdaEngine\/documentation\/AdaEngine\/VisionOSWindowed","doc:\/\/AdaEngine\/documentation\/AdaEngine\/WESLShaders"],"anchor":"Guides"}],"kind":"article","variants":[{"paths":["\/documentation\/adaengine\/gamediagnosticsoverlay"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"text":"Enable it in Ada Studio","type":"heading","level":2,"anchor":"Enable-it-in-Ada-Studio"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Open the build-target picker and choose ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Edit Build Targets…"}]},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select a target with a local desktop "},{"type":"strong","inlineContent":[{"text":"Run Destination","type":"text"}]},{"type":"text","text":", then turn on"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"Diagnostics overlay","type":"text"}]},{"type":"text","text":" and select "},{"type":"strong","inlineContent":[{"text":"Save Build Targets","type":"text"}]},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Run the selected target. The first readings appear after about one second."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"For example, duplicate the ","type":"text"},{"inlineContent":[{"type":"text","text":"Main"}],"type":"strong"},{"text":" target, call the copy ","type":"text"},{"inlineContent":[{"text":"Performance","type":"text"}],"type":"strong"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"enable the overlay only for that copy. Run ","type":"text"},{"inlineContent":[{"text":"Performance","type":"text"}],"type":"strong"},{"text":" to inspect frame","type":"text"},{"text":" ","type":"text"},{"text":"pacing, then select and run ","type":"text"},{"inlineContent":[{"text":"Main","type":"text"}],"type":"strong"},{"text":" to play without the readout.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The setting applies to local product runs on Windows, macOS, and Linux for"},{"type":"text","text":" "},{"text":"AdaScript games and compatible Swift apps. It works in both Debug and Release.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"It is off by default and applies on the next run. Scene-document Play, debugger"},{"type":"text","text":" "},{"text":"sessions, AdaPlayer, exports, and Movie Maker run independently of this setting.","type":"text"}]},{"type":"heading","level":2,"text":"Enable it from a shell","anchor":"Enable-it-from-a-shell"},{"type":"paragraph","inlineContent":[{"text":"For a Swift app using ","type":"text"},{"type":"codeVoice","code":"DefaultAppWindow"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"WindowGroup"},{"type":"text","text":", set the environment"},{"type":"text","text":" "},{"type":"text","text":"variable when you launch the product. The app must be built with an AdaEngine"},{"type":"text","text":" "},{"type":"text","text":"version that includes the overlay."}]},{"syntax":"bash","code":["ADAENGINE_DIAGNOSTICS_OVERLAY=1 swift run -c release"],"type":"codeListing"},{"type":"codeListing","syntax":"powershell","code":["$env:ADAENGINE_DIAGNOSTICS_OVERLAY = '1'","swift run -c release","Remove-Item Env:ADAENGINE_DIAGNOSTICS_OVERLAY"]},{"anchor":"Read-the-numbers","type":"heading","text":"Read the numbers","level":2},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"FPS","type":"text"}],"type":"strong"},{"text":" is the number of game update intervals per second. ","type":"text"},{"inlineContent":[{"type":"text","text":"Frame time"}],"type":"strong"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"average duration of those intervals in milliseconds. At a steady 60 FPS, it","type":"text"},{"type":"text","text":" "},{"type":"text","text":"reads about 16.7 ms. Both numbers include frame pacing and stalls between"},{"type":"text","text":" "},{"type":"text","text":"updates. They describe the game’s update loop. Use profiling tools to measure"},{"type":"text","text":" "},{"text":"GPU work or investigate individual slow systems.","type":"text"}]},{"inlineContent":[{"type":"text","text":"The overlay refreshes its text about once per second. It displays dashes while"},{"text":" ","type":"text"},{"text":"collecting the first sample window and after an explicit simulation pause.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/GameDiagnosticsOverlay","interf