pseudoSymbol","kind":"section","title":"Create the app shell","type":"section","url":"\/tutorials\/adaengine\/uibasics#Create-the-app-shell"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Type-of-events":{"abstract":[{"type":"text","text":"In this tutorial you will learn about the event listeners system in Ada."},{"type":"text","text":" "},{"type":"text","text":"How can you catch events and process them"}],"url":"\/tutorials\/adaengine\/eventlisteners#Type-of-events","role":"pseudoSymbol","type":"section","title":"Type of events","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Type-of-events"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Make-it-move":{"abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}],"url":"\/tutorials\/adaengine\/createfirst2dscene#Make-it-move","role":"pseudoSymbol","type":"section","title":"Make it move","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Make-it-move"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Set-up-the-world":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Set-up-the-world","abstract":[{"type":"text","text":"Build a small scene that spawns a player entity and moves it with a gamepad."}],"role":"pseudoSymbol","kind":"section","title":"Set up the world","type":"section","url":"\/tutorials\/adaengine\/gamepadinput#Set-up-the-world"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics","url":"\/tutorials\/adaengine\/uibasics","role":"project","type":"topic","title":"UI Basics","kind":"project","estimatedTime":"15min","abstract":[{"type":"text","text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state."}]},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Create-a-custom-TextRenderer":{"abstract":[{"text":"Create a custom ","type":"text"},{"code":"TextRenderer","type":"codeVoice"},{"text":" that draws text along a sine wave and animate it by updating renderer state.","type":"text"}],"role":"pseudoSymbol","kind":"section","url":"\/tutorials\/adaengine\/animatedtext#Create-a-custom-TextRenderer","type":"section","title":"Create a custom TextRenderer","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-a-custom-TextRenderer"},"AT-2-3-renderer.swift":{"fileName":"AnimatedSineWaveRenderer.swift","syntax":"swift","content":["import AdaEngine","","struct AnimatedSineWaveRenderer: TextRenderer {","    var timeOffset: Double","","    var animatableData: Double {","        get { timeOffset }","        set { timeOffset = newValue }","    }","","    init(timeOffset: Double) {","        self.timeOffset = timeOffset","    }","","    func draw(layout: Text.Layout, in context: inout UIGraphicsContext) {","        let glyphs = layout.flattenedRuns","        let safeCount = max(glyphs.count, 1)","        let width = layout.first?.typographicBounds.rect.width ?? 1","        let height = layout.first?.typographicBounds.rect.height ?? 1","","        for (index, glyph) in glyphs.enumerated() {","            let offset = sineOffset(","                index: index,","                amplitude: Double(height) * 0.5,","                wavelength: Double(width),","                phase: timeOffset,","                total: safeCount","            )","","            var copy = context","            copy.translateBy(x: 0, y: Float(offset))","            copy.draw(glyph)","        }","    }","","    private func sineOffset(","        index: Int,","        amplitude: Double,","        wavelength: Double,","        phase: Double,","        total: Int","    ) -> Double {","        let x = Double(index)","        let position = (x \/ Double(total)) * wavelength","        let radians = ((position + phase) \/ wavelength) * 2 * .pi","        return Math.sin(radians) * amplitude","    }","}"],