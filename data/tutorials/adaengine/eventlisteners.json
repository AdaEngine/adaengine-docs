put","type":"topic"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene":{"estimatedTime":"20min","url":"\/tutorials\/adaengine\/createfirst2dscene","type":"topic","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene","title":"Create your first 2D scene","abstract":[{"text":"In this tutorial, you will learn how to create your first 2D scene using Ada.","type":"text"}],"kind":"project","role":"project"},"EL-2-3-scene.swift":{"type":"file","highlights":[],"identifier":"EL-2-3-scene.swift","fileName":"EventListenerPlugin.swift","content":["import AdaEngine","","@MainActor","struct EventListenerPlugin: Plugin {","    @Local var disposeBag: Set<AnyCancellable> = []","","    func setup(in app: borrowing AppWorlds) {","        app.main","            .subscribe(to: SceneEvents.OnReady.self) { _ in","                \/\/ Handle event here!","            }","            .store(in: &self.disposeBag)","    }","}"],"syntax":"swift","fileType":"swift"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Subscribe-to-scene-events":{"url":"\/tutorials\/adaengine\/eventlisteners#Subscribe-to-scene-events","type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Subscribe-to-scene-events","title":"Subscribe to scene events","abstract":[{"type":"text","text":"In this tutorial you will learn about the event listeners system in Ada."},{"type":"text","text":" "},{"type":"text","text":"How can you catch events and process them"}],"kind":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics#Layout-with-stacks":{"url":"\/tutorials\/adaengine\/uibasics#Layout-with-stacks","type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Layout-with-stacks","title":"Layout with stacks","abstract":[{"type":"text","text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state."}],"kind":"section","role":"pseudoSymbol"},"doc://AdaEngine/t