ence":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Subscribe-to-scene-events","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Type-of-events","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Additional-for-physics","kind":"task"}]}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UI-and-Input","projects":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Create-the-app-shell","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Layout-with-stacks","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Add-a-button-and-state","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Debug-overlays","kind":"task"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-the-view","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Prepare-layout-helpers","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-a-custom-TextRenderer","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Apply-and-animate","kind":"task"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Set-up-the-world","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Create-the-input-system","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Read-buttons","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Move-and-rumble","kind":"task"}]}]}]},"kind":"project","sections":[{"xcodeRequirement":"Xcode 26.2 or later","kind":"hero","estimatedTimeInMinutes":5,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In this tutorial you will learn about the event listeners system in Ada."},{"type":"text","text":" "},{"type":"text","text":"How can you catch events and process them"}]}],"title":"Event Listeners in Ada","chapter":"Create your first 2D game project."},{"tasks":[{"anchor":"Base-of-Event-Subscriber-pattern","title":"Base of Event-Subscriber pattern","stepsSection":[],"contentSection":[{"media":"EL-1.jpg","content":[{"type":"paragraph","inlineContent":[{"text":"Event listeners in Ada are built on the Observer pattern.","type":"text"},{"text":" ","type":"text"},{"text":"Its main concept is based on the fact that there is a certain Subject that can send any events.","type":"text"},{"text":" ","type":"text"},{"text":"And there is an Observer that can receive and process this event.","type":"text"},{"text":" ","type":"text"},{"text":"In addition, Observer “subscribes” to events, as if you had subscribed to your favorite blog or magazine - as soon as an event occurs, Observer immediately knows about it.","type":"text"}]}],"kind":"contentAndMedia","mediaPosition":"trailing"}]},{"contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"inlineContent":[{"text":"Having understood how the Observer pattern works, let’s look at how to subscribe to scene events using the Plugin pattern.","type":"text"}],"type":"paragraph"}]}],"title":"Subscribe to scene events","stepsSection":[{"runtimePreview":null,"media":null,"caption":[],"type":"step","content":[{"inlineContent":[{"text":"Let’s say we have a plugin in which we would like to listen to some events.","type":"text"}],"type":"paragraph"}],"code":"EL-2-1-scene.swift"},{"runtimePreview":null,"code":"EL-2-2-scene.swift","content":[{"type":"paragraph","inlineContent":[{"text":"First of all, to control subscription\/unsubscription to events and for proper memory management, we must create a ","type":"text"},{"type":"codeVoice","code":"disposeBag"},{"text":" using the ","type":"text"},{"type":"codeVoice","code":"@Local"},{"text":" property wrapper.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"We also mark our plugin with "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" to ensure thread safety."}]}],"caption":[],"media":null,"type":"step"},{"runtimePreview":null,"code":"EL-2-3-scene.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"After that, in the "},{"type":"codeVoice","code":"setup(in:)"},{"text":" method you can call some code to subscribe to the event.","type":"text"},{"type":"text","text":" "},{"text":"The ","type":"text"},{"type":"codeVoice","code":"app.main.subscribe"},{"text":" method helps with this.","type":"text"},{"text":" ","type":"text"},{"text":"When an event is triggered, our listener subscribes to it and in the callback we can process our event.","type":"text"}]}],"caption":[],"media":null,"type":"step"}],"anchor":"Subscribe-to-scene-events"},{"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"text":"What events can we use? Let’s look at a couple of code examples in Ada.","type":"text"}]}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"title":"Type of events","stepsSection":[{"content":[{"inlineContent":[{"text":"In the previous section, we saw the ","type":"text"},{"type":"codeVoice","code":"SceneEvents.OnReady"},{"text":" event.","type":"text"},{"text":" ","type":"text"},{"text":"Ada has several available events that you can handle.","type":"text"},{"text":" ","type":"text"},{"text":"For example, you can find out what state your current game scene is in.","type":"text"},{"text":" ","type":"text"},{"text":"You can add your own additional logic when any built-in event occurs.","type":"text"}],"type":"paragraph"}],"media":null,"runtimePreview":null,"caption":[],"code":"EL-2-3-scene.swift","type":"step"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Here, as an example, are some built-in events that may be useful to you.","type":"text"},{"text":" ","type":"text"},{"text":"Familiar scene events and new collision events.","type":"text"}]}],"media":null,"runtimePreview":null,"caption":[],"code":"EL-2-4-events.swift","type":"step"}],"anchor":"Type-of-events"},{"contentSection":[{"content":[{"inlineContent":[{"text":"Additional information for handling physics in a game engine.","type":"text"},{"text":" ","type":"text"},{"text":"With the ","type":"text"},{"code":"physicsWorld2D","type":"codeVoice"},{"text":" component you can control the physics settings for any objects in our game.","type":"text"},{"text":" ","type":"text"},{"text":"For example, you can set the gravity to zero for the scene creation event.","type":"text"}],"type":"paragraph"}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"title":"Additional for physics","stepsSection":[{"content":[{"inlineContent":[{"text":"Let’s continue with the example we looked at earlier.","type":"text"},{"text":" ","type":"text"},{"text":"We can access our event and assign the necessary parameters to the properties of the physical component.","type":"text"},{"text":" ","type":"text"},{"text":"Note that we use ","type":"text"},{"code":"Task { @MainActor in ... }","type":"codeVoice"},{"text":" to ensure we’re on the main actor when modifying physics properties.","type":"text"}],"type":"paragraph"}],"media":null,"runtimePreview":null,"caption":[],"code":"EL-2-5-physics.swift","type":"step"}],"anchor":"Additional-for-physics"}],"kind":"tasks"},{"featuredEyebrow":"Tutorial","kind":"callToAction","action":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics","overridingTitle":"Get started","overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"type":"reference","isActive":true},"title":"UI Basics","abstract":[{"type":"text","text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state."}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://AdaEngine/tutorials/AdaEngine/AnimatedText":{"type":"topic","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText","role":"project","url":"\/tutorials\/adaengine\/animatedtext","kind":"project","title":"Animated Text Renderer","abstract":[{"type":"text","text":"Create a custom "},{"type":"codeVoice","code":"TextRenderer"},{"type":"text","text":" that draws text along a sine wave and animate it by updating renderer state."}],"estimatedTime":"20min"},"doc://AdaEngine/tutorials/AdaEngine/PlayerAndText#Add-Text-component":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Text-component","role":"pseudoSymbol","url":"\/tutorials\/adaengine\/playerandtext#Add-Text-component","kind":"section","title":"Add Text component","abstract":[{"type":"text","text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene."}]},"EL-2-4-events.swift":{"fileType":"swift","content":["\/\/\/ Events the scene triggers.","public enum SceneEvents {","","    \/\/\/ An event triggered once when scene is ready to use and will starts update soon.","    public struct OnReady: Event {","        public let scene: Scene","    }","","    \/\/\/ Raised after an entity is added to the scene.","    public struct DidAddEntity: Event {","        public let entity: Entity","    }","","    \/\/\/ Raised before an entity is removed from the scene.","    public struct WillRemoveEntity: Event {","        public let entity: Entity","    }","","    \/\/\/ An event triggered once per frame interval that you can use to execute custom logic for each frame.","    public struct Update: Event {","","        \/\/\/ The updated scene.","        public let scene: Scene","","        \/\/\/ The elapsed time since the last update.","        public let deltaTime: TimeInterval","    }","}","","\/\/\/ Events associated with collisions.","public enum CollisionEvents {","","    \/\/\/ An event raised when two objects collide.","    public struct Began: Event {","","        \/\/\/ The first entity involved in the collision.","        public let entityA: Entity","","        \/\/\/ The second entity involved in the collision.","        public let entityB: Entity","","        \/\/\/ The estimated strength of the impact.","        public let impulse: Float","    }","","    \/\/\/ An event raised when two objects, previously in contact, separate.","    public struct Ended: Event {","","        \/\/\/ The first entity involved in the collision.","        public let entityA: Entity","","        \/\/\/ The second entity involved in the collision.","        public let entityB: Entity","    }","}"],"fileName":"Events.swift","identifier":"EL-2-4-events.swift","type":"file","syntax":"swift","highlights":[]},"doc://AdaEngine/tutorials/AdaEngine/UIBasics":{"type":"topic","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics","role":"project","url":"\/tutorials\/adaengine\/uibasics","kind":"project","title":"UI Basics","abstract":[{"type":"text","text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state."}],"estimatedTime":"15min"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Move-and-rumble":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Move-and-rumble","type":"section","role":"pseudoSymbol","url":"\/tutorials\/adaengine\/gamepadinput#Move-and-rumble","kind":"section","title":"Move and rumble","abstract":[{"text":"Build a small scene that spawns a player entity and moves it with a gamepad.","type":"text"}]},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Make-it-move":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Make-it-move","role":"pseudoSymbol","url":"\/tutorials\/adaengine\/createfirst2dscene#Make-it-move","kind":"section","title":"Make it move","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}]},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Intro":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Intro","role":"pseudoSymbol","url":"\/tutorials\/adaengine\/createfirst2dscene#Intro","kind":"section","title":"Intro","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}]},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Type-of-events":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Type-of-events","role":"pseudoSymbol","url":"\/tutorials\/adaengine\/eventlisteners#Type-of-events","kind":"section","title":"Type of events","abstract":[{"type":"text","text":"In this tutorial you will learn about the event listeners system in Ada."},{"type":"text","text":" "},{"type":"text","text":"How can you catch events and process them"}]},"doc://AdaEngine/tutorials/AdaEngine/PlayerAndText#Add-Player-component":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Player-component","role":"pseudoSymbol","url":"\/tutorials\/adaengine\/playerandtext#Add-Player-component","kind":"section","title":"Add Player component","abstract":[{"type":"text","text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene."}]},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput":{"type":"topic","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput","role":"project","url":"\/tutorials\/adaengine\/gamepadinput","kind":"project","title":"Gamepad Input","abstract":[{"type":"text","text":"Build a small scene that spawns a player entity and moves it with a gamepad."}],"estimatedTime":"20min"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Create-a-main-camera":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutoria