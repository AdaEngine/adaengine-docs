{"metadata":{"modules":[{"name":"Ada Script"}],"roleHeading":"Article","role":"article","title":"Ada Script Diagnostics and Performance"},"sections":[],"hierarchy":{"paths":[["doc:\/\/AdaScripting\/documentation\/AdaScripting"]]},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptDiagnosticsAndPerformance"},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/adascripting\/adascriptdiagnosticsandperformance"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"anchor":"ECS-Integration","identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS"],"title":"ECS Integration","generated":true}],"abstract":[{"type":"text","text":"Understand annotation, setup, and runtime failures and keep ECS work on the"},{"type":"text","text":" "},{"type":"text","text":"native chunk path."}],"primaryContentSections":[{"content":[{"type":"heading","anchor":"Compilation-diagnostics","text":"Compilation diagnostics","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin"},{"type":"text","text":" compiles the source and reads declaration metadata"},{"type":"text","text":" "},{"type":"text","text":"without executing a "},{"type":"codeVoice","code":"main()"},{"type":"text","text":" manifest. Initialization throws"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptError\/compilation(_:)"},{"type":"text","text":" for syntax or semantic errors and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptError\/invalidManifest(_:)"},{"type":"text","text":" for invalid AdaEngine annotations."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Examples include "},{"type":"codeVoice","code":"@system"},{"type":"text","text":" on a non-class declaration, duplicate system"},{"type":"text","text":" "},{"type":"text","text":"identifiers, "},{"type":"codeVoice","code":"@query"},{"type":"text","text":" outside a system class, a query with no fetched"},{"type":"text","text":" "},{"type":"text","text":"components, and a system class that cannot be initialized."}]},{"type":"heading","anchor":"Setup-diagnostics","text":"Setup diagnostics","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Native component identifiers are resolved during plugin setup so earlier"},{"type":"text","text":" "},{"type":"text","text":"plugins can register game components. Unknown or ambiguous component names skip"},{"type":"text","text":" "},{"type":"text","text":"the affected system and append a diagnostic."}]},{"type":"heading","anchor":"Runtime-diagnostics","text":"Runtime diagnostics","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Runtime diagnostics include unknown component aliases, unknown fields,"},{"type":"text","text":" "},{"type":"text","text":"unsupported values, invalid numeric conversions, and query capabilities used"},{"type":"text","text":" "},{"type":"text","text":"outside their callback lifetime."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inspect "},{"isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin\/diagnostics","type":"reference"},{"text":" after setup and during development.","type":"text"},{"text":" ","type":"text"},{"text":"System ","type":"text"},{"code":"update(context)","type":"codeVoice"},{"text":" callbacks are command-style; their return values are","type":"text"},{"text":" ","type":"text"},{"text":"ignored. Tests should assert observable ECS state and diagnostics.","type":"text"}]},{"type":"heading","anchor":"Performance-model","level":2,"text":"Performance model"},{"type":"paragraph","inlineContent":[{"text":"Ada Script query execution traverses native archetypes and chunks. Component","type":"text"},{"text":" ","type":"text"},{"text":"columns are bound once per chunk, and field access advances a typed pointer by","type":"text"},{"text":" ","type":"text"},{"text":"row stride. A successful write mutates the component in place and updates its","type":"text"},{"text":" ","type":"text"},{"text":"change tick.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The hot path avoids arrays of matched entity identifiers, one Swift bridge","type":"text"},{"text":" ","type":"text"},{"text":"object per entity, repeated entity-location lookups, existential component","type":"text"},{"type":"text","text":" "},{"type":"text","text":"copies, and whole-component reinsertion."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The current embedded C runtime is globally shared and non-reentrant, so runtime entry remains"},{"type":"text","text":" "},{"text":"serialized. Scalability comes from native filtering, column iteration, cached","type":"text"},{"text":" ","type":"text"},{"text":"metadata, and narrow bridge calls rather than multiple concurrent VMs.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Benchmark scripting changes with multiple archetypes and chunks and compare","type":"text"},{"type":"text","text":" "},{"type":"text","text":"them with a typed Swift query. Validate semantics before drawing performance"},{"type":"text","text":" "},{"type":"text","text":"conclusions."}]}],"kind":"content"}],"references":{"doc://AdaScripting/documentation/AdaScripting/AdaScriptPlugin/diagnostics":{"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"diagnostics","kind":"identifier"},{"text":": [","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"text":"]","kind":"text"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin\/diagnostics"