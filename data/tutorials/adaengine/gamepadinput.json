    }","","        for gamepad in gamepads {","            let leftStickX = gamepad.getAxisValue(.leftStickX)","            let leftStickY = gamepad.getAxisValue(.leftStickY)","            let deadzone: Float = 0.1","","            if abs(leftStickX) > deadzone || abs(leftStickY) > deadzone {","                playerQuery.forEach { transform in","                    let speed: Float = 2.0","                    transform.position.x += leftStickX * Float(deltaTime.deltaTime) * speed","                    transform.position.y -= leftStickY * Float(deltaTime.deltaTime) * speed","                }","            }","","            if gamepad.isGamepadButtonPressed(.x) {","                gamepad.rumble(lowFrequency: 0.5, highFrequency: 0.75, duration: 0.5)","            }","        }","    }","}"],"identifier":"GP-2-5-system.swift","type":"file","fileName":"GamepadInputSystem.swift","fileType":"swift","highlights":[{"line":36},{"line":37},{"line":38},{"line":39}]},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Create-an-app":{"role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-an-app","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using AdaEngine."}],"title":"Create an app","type":"section","url":"\/tutorials\/adaengine\/createfirst2dscene#Create-an-app"},"doc://AdaEngine/tutorials/AdaEngine/CreateProject":{"estimatedTime":"5min","role":"project","kind":"project","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first AdaEngine project."}],"title":"Create your first game project","type":"topic","url":"\/tutorials\/adaengine\/createproject"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Type-of-events":{"role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Type-of-events","abstract":[{"type":"text","text":"In this tutorial you will learn about the event listeners system in Ada Engine."},{"type":"text","text":" "},{"type":"text","text":"How can you catch events and process them"}],"title":"Type of events","type":"section","url":"\/tutorials\/adaengine\/eventlisteners#Type-of-events"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Create-the-input-system":{"role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Create-the-input-system","abstract":[{"type":"text","text":"Build a small scene that spawns a player entity and moves it with a gamepad."}],"title":"Create the input system","type":"section","url":"\/tutorials\/adaengine\/gamepadinput#Create-the-input-system"}}}