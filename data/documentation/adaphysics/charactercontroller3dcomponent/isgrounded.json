"doc:\/\/AdaPhysics\/documentation\/AdaPhysics\/CharacterController3DComponent","abstract":[{"type":"text","text":"An upright capsule mover. Its entity’s position is the bottom of the capsule in world units."},{"type":"text","text":" "},{"type":"text","text":"Use on a root entity without "},{"type":"codeVoice","code":"PhysicsBody3DComponent"},{"type":"text","text":"; visual scale does not resize the capsule."},{"type":"text","text":" "},{"type":"text","text":"The controller collides with physics bodies, ignores sensors, and does not push dynamic bodies"},{"type":"text","text":" "},{"type":"text","text":"or register a body that other character controllers can collide with."},{"type":"text","text":" "},{"type":"text","text":"Supported walking automatically steps over solid ledges up to 5% of the resolved height,"},{"type":"text","text":" "},{"type":"text","text":"provided the full capsule can sweep up, forward, and down to a walkable landing."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CharacterController3DComponent"}],"type":"topic","url":"\/documentation\/adaphysics\/charactercontroller3dcomponent","title":"CharacterController3DComponent","navigatorTitle":[{"kind":"identifier","text":"CharacterController3DComponent"}]},"doc://AdaPhysics/documentation/AdaPhysics":{"title":"AdaPhysics","kind":"symbol","role":"collection","type":"topic","url":"\/documentation\/adaphysics","identifier":"doc:\/\/AdaPhysics\/documentation\/AdaPhysics","abstract":[]}}}