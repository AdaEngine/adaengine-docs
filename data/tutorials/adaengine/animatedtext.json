ts":[{"line":5},{"line":10},{"line":11},{"line":12},{"line":13},{"line":14},{"line":15},{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22}],"fileType":"swift","fileName":"ContentView.swift","identifier":"AT-3-2-view.swift","syntax":"swift","type":"file","content":["import AdaEngine","","struct ContentView: View {","    @State private var timeOffset: Double = 0","    @State private var animationTask: Task<Void, Never>?","","    var body: some View {","        Text(\"Sine Wave\")","            .textRendered(AnimatedSineWaveRenderer(timeOffset: timeOffset))","            .onAppear {","                startAnimation()","            }","    }","","    private func startAnimation() {","        animationTask?.cancel()","        animationTask = Task { @MainActor in","            while !Task.isCancelled {","                timeOffset += 0.12","                try? await Task.sleep(nanoseconds: 16_000_000)","            }","        }","    }","}"]},"doc://AdaEngine/tutorials/AdaEngine/CreateProject":{"abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first Ada project."}],"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject","title":"Create your first game project","role":"project","kind":"project","url":"\/tutorials\/adaengine\/createproject","estimatedTime":"5min","type":"topic"},"doc://AdaEngine/tutorials/AdaEngine/PlayerAndText":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText","abstract":[{"text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene.","type":"text"}],"title":"Player and Text in Ada","role":"project","kind":"project","url":"\/tutorials\/adaengine\/playerandtext","estimatedTime":"5min","type":"topic"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Create-an-app":{"url":"\/tutorials\/adaengine\/createfirst2dscene#Create-an-app","type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-an-app","title":"Create an app","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}],"kind":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Intro":{"url":"\/tutorials\/adaengine\/createfirst2dscene#Intro","type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Intro","title":"Intro","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}],"kind":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics":{"abstract":[{"type":"text","text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state."}],"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics","title":"UI Basics","role":"project","kind":"project","url":"\/tutorials\/adaengine\/uibasics","estimatedTime":"15min","type":"topic"},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Apply-and-animate":{"url":"\/tutorials\/adaengine\/animatedtext#Apply-and-animate","type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Apply-and-animate","title":"Apply and animate","abstract":[{"type":"text","text":"Create a custom "},{"type":"codeVoice","code":"TextRenderer"},{"type":"text","text":" that draws text along a sine wave and animate it by updating renderer state."}],"kind":"section","role":"pseudoSymbol"},"AT-1-2-view.swift":{"fileName":"ContentView.swift","fileType":"swift","syntax":"swift","identifier":"AT-1-2-view.swift","highlights":[],"content":["import AdaEngine","","struct ContentView: View {","    var body: some View {","        Text(\"Sine Wave\")","    }","}"],"type":"file"},"AT-2-2-renderer.swift":{"highlights":[],"fileType":"swift","fileName":"AnimatedSineWaveRenderer.swift","identifier":"AT-2-2-renderer.swift","syntax":"swift","content":["import AdaEngine","","struct AnimatedSineWaveRenderer: TextRenderer {","    var timeOffset: Double","","    var animatableData: Double {","        get { timeOffset }","        set { timeOffset = newValue }","    }","","    init(timeOffset: Double) {","        self.timeOffset = timeOffset","    }","}"],"type":"file"},"AT-2-3-renderer.swift":{"fileName":"AnimatedSineWaveRenderer.swift","fileType":"swift","syntax":"swift","identifier":"AT-2-3-renderer.swift","highlights":[{"line":14},{"line":15},{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23},{"line":24},{"line":25},{"line":26},{"line":27},{"line":28},{"line":29},{"line":30},{"line":31},{"line":32},{"line":33},{"line":34},{"line":35},{"line":36},{"line":37},{"line":38},{"line":39},{"line":40},{"line":41},{"line":42},{"line":43},{"line":44},{"line":45},{"line":46},{"line":47}],"content":["import AdaEngine","","struct AnimatedSineWaveRenderer: TextRenderer {","    var timeOffset: Double","","    var animatableData: Double {","        get { timeOffset }","        set { timeOffset = newValue }","    }","","    init(timeOffset: Double) {","        self.timeOffset = timeOffset","    }","","    func draw(layout: Text.Layout, in context: inout UIGraphicsContext) {","        let glyphs = layout.flattenedRuns","        let safeCount = max(glyphs.count, 1)","        let width = layout.first?.typographicBounds.rect.width ?? 1","        let height = layout.first?.typographicBounds.rect.height ?? 1","","        for (index, glyph) in glyphs.enumerated() {","            let offset = sineOffset(","                index: index,","                amplitude: Double(height) * 0.5,","                wavelength: Double(width),","                phase: timeOffset,","                total: safeCount","            )","","            var copy = context","            copy.translateBy(x: 0, y: Float(offset))","            copy.draw(glyph)","        }","    }","","    private func sineOffset(","        index: Int,","        amplitude: Double,","        wavelength: Double,","        phase: Double,","        total: Int","    ) -> Double {","        let x = Double(index)","        let position = (x \/ Double(total)) * wavelength","        let radians = ((position + phase) \/ wavelength) * 2 * .pi","        return Math.sin(radians) * amplitude","    }","}"],"type":"file"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Additional-for-physics":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Additional-for-physics","abstract":[{"type":"text","text":"In this tutorial you will learn about the event listeners system in Ada."},{"type":"text","text":" "},{"type":"text","text":"How can you catch events and process them"}],"title":"Additional for physics","role":"pseudoSymbol","kind":"section","url":"\/tutorials\/adaengine\/eventlisteners#Additional-for-physics","type":"section"},"doc://AdaEngine/tutorials/AdaEngine":{"url":"\/tutorials\/adaengine","type":"topic","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine","title":"Meet Ada","abstract":[{"text":"Learn the basics of Ada and start developing your own games!","type":"text"}],"kind":"overview","role":"overview"},"AT-3-3-view.swift":{"highlights":[{"line":13},{"line":14},{"line":15},{"line":16}],"fileType":"swift","fileName":"ContentView.swift","identifier":"AT-3-3-view.swift","syntax":"swift","type":"file","content":["import AdaEngine","","struct ContentView: View {","    @State private var timeOffset: Double = 0","    @State private var animationTask: Task<Void, Never>?","","    var body: some View {","        Text(\"Sine Wave\")","            .textRendered(AnimatedSineWaveRenderer(timeOffset: timeOffset))","            .onAppear {","                startAnimation()","            }","            .onDisappear {","                animationTask?.cancel()","                animationTask = nil","            }","    }","","    private func startAnimation() {","        animationTask?.cancel()","        animationTask = Task { @MainActor in","            while !Task.isCancelled {","                timeOffset += 0.12","                try? await Task.sleep(nanoseconds: 16_000_000)","            }","        }","    }","}"]},"doc://AdaEngine/tutorials/AdaEngine/UIBasics#Debug-overlays":{"abstract":[{"type":"text","text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state."}],"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Debug-overlays","title":"Debug overlays","role":"pseudoSymbol","kind":"section","url":"\/tutorials\/adaengine\/uibasics#Debug-overlays","type":"section"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Base-of-Event-Subscriber-pattern":{"url":"\/tutorials\/adaengine\/eventlisteners#Base-of-Event-Subscriber-pattern","type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Base-of-Event-Subscriber-pattern","title":"Base of Event-Subscriber pattern","abstract":[{"type":"text","text":"In this tutorial you will learn about the event listeners system in Ada."},{"type":"text","text":" "},{"type":"text","text":"How can you catch events and process them"}],"kind":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Read-buttons":{"abstract":[{"type":"text","text":"Build a small scene that spawns a player entity and moves it with a gamepad."}],"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Read-buttons","title":"Read buttons","role":"pseudoSymbol","kind":"section","url":"\/tutorials\/adaengine\/gamepadinput#Read-buttons","type":"section"}}}