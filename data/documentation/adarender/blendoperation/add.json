er","identifier":"doc:\/\/AdaRender\/documentation\/AdaRender","abstract":[]},"doc://AdaRender/documentation/AdaRender/BlendOperation":{"navigatorTitle":[{"text":"BlendOperation","kind":"identifier"}],"abstract":[{"text":"For every pixel, ","type":"text"},{"identifier":"doc:\/\/AdaRender\/documentation\/AdaRender\/BlendOperation","isActive":true,"type":"reference"},{"text":" determines how to combine and weight the source fragment values with the destination values.","type":"text"},{"text":" ","type":"text"},{"text":"Some blend operations multiply the source values by a source blend factor (SBF),","type":"text"},{"text":" ","type":"text"},{"text":"multiply the destination values by a destination blend factor (DBF), and then combine the results using addition or subtraction.","type":"text"},{"text":" ","type":"text"},{"text":"Other blend operations use either a minimum or maximum function to determine the result.","type":"text"}],"identifier":"doc:\/\/AdaRender\/documentation\/AdaRender\/BlendOperation","role":"symbol","title":"BlendOperation","kind":"symbol","url":"\/documentation\/adarender\/blendoperation","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BlendOperation","kind":"identifier"}],"type":"topic"}}}