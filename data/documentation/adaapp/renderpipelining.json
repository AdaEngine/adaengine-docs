{"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/adaapp\/renderpipelining"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"anchor":"Initializers","title":"Initializers","generated":true,"identifiers":["doc:\/\/AdaApp\/documentation\/AdaApp\/RenderPipelining\/init(isEnabled:)"]},{"anchor":"Instance-Properties","title":"Instance Properties","generated":true,"identifiers":["doc:\/\/AdaApp\/documentation\/AdaApp\/RenderPipelining\/isActive","doc:\/\/AdaApp\/documentation\/AdaApp\/RenderPipelining\/isEnabled"]},{"generated":true,"title":"Type Methods","identifiers":["doc:\/\/AdaApp\/documentation\/AdaApp\/RenderPipelining\/isActive(in:)"],"anchor":"Type-Methods"},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/AdaApp\/documentation\/AdaApp\/RenderPipelining\/Resource-Implementations"],"anchor":"Default-Implementations"}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/AdaECS\/documentation\/AdaECS\/Resource","doc:\/\/AdaApp\/s8SendableP","doc:\/\/AdaApp\/s16SendableMetatypeP"],"type":"conformsTo"}],"sections":[],"abstract":[{"text":"Opts a subworld, normally a render world, into pipelined updates.","type":"text"}],"identifier":{"url":"doc:\/\/AdaApp\/documentation\/AdaApp\/RenderPipelining","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"RenderPipelining"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A pipelined subworld runs one frame behind its parent. The parent extracts frame N into it,"},{"type":"text","text":" "},{"type":"text","text":"starts its update and continues with frame N+1 without waiting. Before the next extraction the"},{"type":"text","text":" "},{"type":"text","text":"parent waits for that update to finish, so extraction remains the only point where both worlds"},{"type":"text","text":" "},{"type":"text","text":"meet. Frame time approaches the longer of the two paths instead of their sum, at the cost of"},{"type":"text","text":" "},{"type":"text","text":"one frame of input latency."}],"type":"paragraph"},{"inlineContent":[{"text":"While a pipelined update is in flight, systems of the subworld must not read the parent world","type":"text"},{"text":" ","type":"text"},{"text":"(see ","type":"text"},{"code":"Extract","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"MainWorld","type":"codeVoice"},{"text":"), and parent systems must not mutate objects the subworld reads.","type":"text"},{"text":" ","type":"text"},{"text":"Set ","type":"text"},{"type":"codeVoice","code":"ADAENGINE_PIPELINED_RENDERING=0|1"},{"text":" to override the setting of every world that declares this","type":"text"},{"text":" ","type":"text"},{"text":"resource, for measurements.","type":"text"},{"text":" ","type":"text"},{"text":"Pipelining is unavailable on WebAssembly, where the setting is ignored.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/AdaApp\/documentation\/AdaApp"]]},"metadata":{"symbolKind":"struct","role":"symbol","modules":[{"name":"AdaApp"}],"navigatorTitle":[{"text":"RenderPipelining","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"RenderPipelining","kind":"identifier"}],"roleHeading":"Structure","externalID":"s:6AdaApp16RenderPipeliningV","title":"RenderPipelining"},"references":{"doc://AdaApp/documentation/AdaApp/RenderPipelining/isEnabled":{"identifier":"doc:\/\/AdaApp\/documentation\/AdaApp\/RenderPipelining\/isEnabled","title":"isEnabled","kind":"symbol","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isEnabled","kind":"identifier"},{"text":": ","kind":"text"}