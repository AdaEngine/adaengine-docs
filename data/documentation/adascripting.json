{"abstract":[{"type":"text","text":"Write gameplay systems in Ada Script while keeping entity filtering and access planning in AdaEngine’s native ECS."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"symbolKind":"module","externalID":"AdaScripting","role":"collection","modules":[{"name":"Ada Script"}],"roleHeading":"Framework","title":"Ada Script"},"hierarchy":{"paths":[[]]},"kind":"symbol","identifier":{"url":"doc:\/\/AdaScripting\/documentation\/AdaScripting","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage"],"title":"Essentials","anchor":"Essentials"},{"identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptDiagnosticsAndPerformance"],"title":"ECS Integration","anchor":"ECS-Integration"},{"identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptViews"],"title":"User Interfaces","anchor":"User-Interfaces"},{"identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptSource","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptError","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptView","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptViewRegistry"],"title":"Runtime API","anchor":"Runtime-API"},{"identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptObjectBinding","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptObjectSchema","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptViewEnvironment","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptViewMetadata"],"title":"Structures","generated":true,"anchor":"Structures"},{"identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptObjectRegistration","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptViewScanner"],"title":"Enumerations","generated":true,"anchor":"Enumerations"}],"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"Ada Script is AdaEngine’s scripting layer for gameplay and declarative AdaUI. Its source files use the "},{"type":"codeVoice","code":".ada"},{"type":"text","text":" extension. The current implementation uses an embedded language runtime, while the public API, diagnostics, and tooling consistently present Ada Script concepts."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Annotations are not only syntax. AdaEngine resolves every query into native archetypes and component columns and publishes its component access to the scheduler."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use Ada Script for gameplay rules that benefit from quick iteration. Keep rendering backends, custom data structures, and other low-level or performance-critical facilities in Swift."}],"type":"paragraph"},{"code":["@system(scheduler: \"update\")","class MovementSystem {","    @query(Transform, Movement)","    var movers;","","    func update(context) {","        for (var entity in movers) {","            var position = entity.transform.position;","            var velocity = entity.movement.velocity;","            position[0] += velocity[0] * context.deltaTime;","            position[1] += velocity[1] * context.deltaTime;","            entity.transform.position = position;","        }","    }","}"],"syntax":"ada","type":"codeListing"},{"inlineContent":[{"type":"text","text":"AdaEditor projects configure automatic script discovery by default. For an existing Swift package, follow "},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript","isActive":true},{"type":"text","text":" to enable the build plugin and register the generated script plugins."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/adascripting"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://AdaScripting/documentation/AdaScripting/AdaScriptViewEnvironment":{"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptViewEnvironment","navigatorTitle":[{"text":"AdaScriptViewEnvironment","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptViewEnvironment","kind":"identifier"}],"title":"AdaScriptViewEnvironment","kind":"symbol","type":"topic","abstract":[],"url":"\/documentation\/adascripting\/adascriptviewenvironment"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptView":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AdaScriptView"}],"title":"AdaScriptView","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A native AdaUI view whose declarative tree is supplied by Ada Script."}],"role":"symbol","url":"\/documentation\/adascripting\/adascriptview","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptView","navigatorTitle":[{"text":"AdaScriptView","kind":"identifier"}]},"doc://AdaScripting/documentation/AdaScripting/AdaScriptViewRegistry":{"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptViewRegistry","navigatorTitle":[{"text":"AdaScriptViewRegistry","kind":"identifier"}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptViewRegistry","kind":"identifier"}],"title":"AdaScriptViewRegistry","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Process-wide registry populated by generated Ada Script plugins."}],"url":"\/documentation\/adascripting\/adascriptviewregistry"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptViewMetadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptViewMetadata","kind":"identifier"}],"kind":"symbol","title":"AdaScriptViewMetadata","type":"topic","abstract":[{"type":"text","text":"Metadata for an AdaUI view declared with "},{"type":"codeVoice","code":"@view"},{"type":"text","text":" in Ada Script."}],"role":"symbol","url":"\/documentation\/adascripting\/adascriptviewmetadata","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptViewMetadata","navigatorTitle":[{"text":"AdaScriptViewMetadata","kind":"identifier"}]},"doc://AdaScripting/documentation/AdaScripting/AdaScriptViewScanner":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptViewScanner","kind":"identifier"}],"kind":"symbol","title":"AdaScriptViewScanner","type":"topic","abstract":[{"type":"text","text":"Finds "},{"type":"codeVoice","code":"@view"},{"type":"text","text":" declarations without executing their source."}],"role":"symbol","url":"\/documentation\/adascripting\/adascriptviewscanner","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptViewScanner","navigatorTitle":[{"text":"AdaScriptViewScanner","kind":"identifier"}]},"doc://AdaScripting/documentation/AdaScripting/AdaScriptObjectRegistration":{"fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"AdaScriptObjectRegistration"}],"navigatorTitle":[{"kind":"identifier","text":"AdaScriptObjectRegistration"}],"role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptObjectRegistration","url":"\/documentation\/adascripting\/adascriptobjectregistration","title":"AdaScriptObjectRegistration","abstract":[]},"doc://AdaScripting/documentation/AdaScripting/AdaScriptSource":{"fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptSource","kind":"identifier"}],"kind":"symbol","title":"AdaScriptSource","type":"topic","abstract":[{"typ