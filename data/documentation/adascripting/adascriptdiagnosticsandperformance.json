{"abstract":[{"type":"text","text":"Understand annotation, setup, and runtime failures and keep ECS work on the"},{"type":"text","text":" "},{"type":"text","text":"native chunk path."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS"],"generated":true,"anchor":"ECS-Integration","title":"ECS Integration"}],"metadata":{"roleHeading":"Article","title":"Ada Script Diagnostics and Performance","role":"article","modules":[{"name":"Ada Script"}]},"hierarchy":{"paths":[["doc:\/\/AdaScripting\/documentation\/AdaScripting"]]},"kind":"article","identifier":{"url":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptDiagnosticsAndPerformance","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adascripting\/adascriptdiagnosticsandperformance"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Compilation-diagnostics","level":2,"text":"Compilation diagnostics"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin","isActive":true},{"type":"text","text":" compiles the source and reads declaration metadata"},{"type":"text","text":" "},{"type":"text","text":"without executing a "},{"type":"codeVoice","code":"main()"},{"type":"text","text":" manifest. Initialization throws"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptError\/compilation(_:)","isActive":true},{"type":"text","text":" for syntax or semantic errors and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptError\/invalidManifest(_:)","isActive":true},{"type":"text","text":" for invalid AdaEngine annotations."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Examples include "},{"type":"codeVoice","code":"@system"},{"type":"text","text":" on a non-class declaration, duplicate system"},{"type":"text","text":" "},{"type":"text","text":"identifiers, "},{"type":"codeVoice","code":"@query"},{"type":"text","text":" outside a system class, a query with no fetched"},{"type":"text","text":" "},{"type":"text","text":"components, and a system class that cannot be initialized."}]},{"type":"heading","anchor":"Setup-diagnostics","level":2,"text":"Setup diagnostics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Native component identifiers are resolved during plugin setup so earlier"},{"type":"text","text":" "},{"type":"text","text":"plugins can register game components. Unknown or ambiguous component names skip"},{"type":"text","text":" "},{"type":"text","text":"the affected system and append a diagnostic."}]},{"type":"heading","anchor":"Runtime-diagnostics","level":2,"text":"Runtime diagnostics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Runtime diagnostics include unknown component aliases, unknown fields,"},{"type":"text","text":" "},{"type":"text","text":"unsupported values, invalid numeric conversions, and query capabilities used"},{"type":"text","text":" "},{"type":"text","text":"outside their callback lifetime."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inspect "},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin\/diagnostics","isActive":true},{"type":"text","text":" after setup and during development."},{"type":"text","text":" "},{"type":"text","text":"System "},{"type":"codeVoice","code":"update(context)"},{"type":"text","text":" callbacks are command-style; their return values are"},{"type":"text","text":" "},{"type":"text","text":"ignored. Tests should assert observable ECS state and diagnostics."}]},{"type":"heading","anchor":"Performance-model","level":2,"text":"Performance model"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ada Script query execution traverses native archetypes and chunks. Component"},{"type":"text","text":" "},{"type":"text","text":"columns are bound once per chunk, and field access advances a typed pointer by"},{"type":"text","text":" "},{"type":"text","text":"row stride. A successful write mutates the component in place and updates its"},{"type":"text","text":" "},{"type":"text","text":"change tick."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The hot path avoids arrays of matched entity identifiers, one Swift bridge"},{"type":"text","text":" "},{"type":"text","text":"object per entity, repeated entity-location lookups, existential component"},{"type":"text","text":" "},{"type":"text","text":"copies, and whole-component reinsertion."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The current embedded C runtime is globally shared and non-reentrant, so runtime entry remains"},{"type":"text","text":" "},{"type":"text","text":"serialized. Scalability comes from native filtering, column iteration, cached"},{"type":"text","text":" "},{"type":"text","text":"metadata, and narrow bridge calls rather than multiple concurrent VMs."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Benchmark scripting changes with multiple archetypes and chunks and compare"},{"type":"text","text":" "},{"type":"text","text":"them with a typed Swift query. Validate semantics before drawing performance"},{"type":"text","text":" "},{"type":"text","text":"conclusions."}]}]}],"sections":[],"references":{"doc://AdaScripting/documentation/AdaScripting/AdaScriptError/compilation(_:)":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"compilation","kind":"identifier"},{"text":"([","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/adascripting\/adascripterror\/compilation(_:)","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptError\/compilation(_:)","title":"AdaScriptError.compilation(_:)","abstract":[]},"doc://AdaScripting/documentation/AdaScripting/AdaScriptECS":{"role":"article","type":"topic","kind":"article","url":"\/documentation\/adascripting\/adascriptecs","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS","title":"Ada Script ECS","abstract":[{"type":"text","text":"Declare annotation-driven systems and iterate native AdaECS component columns."}]},"doc://AdaScripting/documentation/AdaScripting/AdaScriptError/invalidManifest(_:)":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"invalidManifest","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/adascripting\/adascripterror\/invalidmanifest(_:)","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptError\/invalidManifest(_:)","title":"AdaScriptError.invalidManifest(_:)","abstract":[]},"doc://AdaScripting/documentation/AdaScripting/AdaScriptPlugin":{"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin","navigatorTitle":[{"kind":"identifier","text":"AdaScriptPlugin"}],"role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"AdaScriptPlugin"}],"title":"AdaScriptPlugin","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Loads an annotation-driven Ada Script module."}],"url":"\/documentation\/adascripting\/adascriptplugin"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptPlugin/diagnostics":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"diagnostics","kind":"identifier"},{"text":": [","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/adascripting\/adascriptplugin\/diagnostics","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin\/diagnostics","title":"diagnostics","abstract":[]},"doc://AdaScripting/documentation/AdaScripting":{"role":"collection","type":"topic","kind":"symbol","url":"\/documentation\/adascripting","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting","title":"Ada Script","abstract":[{"type":"text","text":"Write gameplay systems in Ada Script while keeping entity filtering and access planning in AdaEngine’s native ECS."}]}}}