criptnativescenedocument","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AdaScriptNativeSceneDocument"}],"title":"AdaScriptNativeSceneDocument","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptNativeSceneDocument","abstract":[{"text":"Editor-exported scenes contain ordinary Codable component payloads. Native","type":"text"},{"text":" ","type":"text"},{"text":"component fields are decoded against the module’s world-local descriptors.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"AdaScriptNativeSceneDocument"}],"kind":"symbol","role":"symbol"}}}