{"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/AdaEngine\/documentation\/AdaEngine"]]},"primaryContentSections":[{"content":[{"level":2,"text":"Xcode Instruments: “Required kernel recording resources are in use by another document”","type":"heading","anchor":"Xcode-Instruments-Required-kernel-recording-resources-are-in-use-by-another-document"},{"inlineContent":[{"type":"text","text":"When profiling an SPM project (without an xcodeproj) in Instruments, you may see a message about kernel recording resources being in use, even when no other Instruments documents are open."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Cause:","type":"text"}]},{"type":"text","text":" The message is misleading. The real cause is that the binary does not have the "},{"type":"codeVoice","code":"get-task-allow"},{"type":"text","text":" entitlement. SPM does not distinguish between “release” and “profiling,” so profiling uses a release build without this entitlement."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Solution:","type":"text"}]},{"type":"text","text":" Re-sign the binary with the "},{"type":"codeVoice","code":"get-task-allow"},{"type":"text","text":" entitlement before launching Instruments."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Open your scheme (Cmd-Shift-,).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"type":"text","text":"Profile → Pre-actions"}]},{"text":", add a Pre-action.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Set the shell to "},{"code":"\/bin\/zsh","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Paste the re-sign script below (the ","type":"text"},{"code":"=(...)","type":"codeVoice"},{"text":" syntax is zsh process substitution):","type":"text"}]}]}],"type":"orderedList"},{"code":["# For Instruments, re-sign binary with get-task-allow entitlement","codesign -s - -v -f --entitlements =(echo -n '<?xml version=\"1.0\" encoding=\"UTF-8\"?>","<!DOCTYPE plist PUBLIC \"-\/\/Apple\/\/DTD PLIST 1.0\/\/EN\" \"https:\/\/www.apple.com\/DTDs\/PropertyList-1.0.dtd\">","<plist version=\"1.0\">","    <dict>","        <key>com.apple.security.get-task-allow<\/key>","        <true\/>","    <\/dict>","<\/plist>') ${TARGET_BUILD_DIR}\/${PRODUCT_NAME}"],"type":"codeListing","syntax":"zsh"},{"type":"paragraph","inlineContent":[{"type":"text","text":"See also: "},{"identifier":"https:\/\/cocoaphony.micro.blog\/2022\/10\/29\/solving-required-kernel.html","type":"reference","isActive":true},{"text":" (Rob Napier).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The script is stored in "},{"type":"codeVoice","code":".swiftpm\/xcode\/xcshareddata\/xcschemes\/<schemename>.xcscheme"},{"type":"text","text":". The pre-action runs only for Profile, so it does not affect normal builds."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Note:"}]},{"type":"text","text":" Pre-action scripts do not receive "},{"type":"codeVoice","code":"SRCROOT"},{"text":"; if the script fails, Xcode will not show details—check Console.app for logs.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/adaengine\/spmdebug"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"AdaEngine"}],"role":"article","title":"Known issues and how to debug SPM targets","roleHeading":"Article"},"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/SPMDebug","interfaceLanguage":"swift"},"references":{"doc://AdaEngine/documentation/AdaEngine":{"kind":"symbol","abstract":[{"text":"Bringing simple and powerful game engine for your awesome games.","type":"text"}],"type":"topic","url":"\/documentation\/adaengine","title":"AdaEngine","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine","role":"collection"},"https://cocoaphony.micro.blog/2022/10/29/solving-required-kernel.html":{"type":"link","titleInlineContent":[{"text":"Solving “Required kernel recording resources…” in Instruments","type":"text"}],"identifier":"https:\/\/cocoaphony.micro.blog\/2022\/10\/29\/solving-required-kernel.html","title":"Solving “Required kernel recording resources…” in Instruments","url":"https:\/\/cocoaphony.micro.blog\/2022\/10\/29\/solving-required-kernel.html"}}}