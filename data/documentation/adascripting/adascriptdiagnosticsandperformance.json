{"kind":"article","sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTesting"],"anchor":"ECS-Integration","title":"ECS Integration","generated":true}],"identifier":{"url":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptDiagnosticsAndPerformance","interfaceLanguage":"swift"},"abstract":[{"text":"Understand annotation, setup, and runtime failures and keep ECS work on the","type":"text"},{"type":"text","text":" "},{"text":"native chunk path.","type":"text"}],"variants":[{"paths":["\/documentation\/adascripting\/adascriptdiagnosticsandperformance"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Compilation diagnostics","level":2,"anchor":"Compilation-diagnostics"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin"},{"text":" compiles the source and reads declaration metadata","type":"text"},{"type":"text","text":" "},{"text":"without executing a ","type":"text"},{"code":"main()","type":"codeVoice"},{"type":"text","text":" manifest. Initialization throws"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptError\/compilation(_:)","isActive":true},{"text":" for syntax or semantic errors and","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptError\/invalidManifest(_:)","isActive":true},{"type":"text","text":" for invalid AdaEngine annotations."}]},{"type":"paragraph","inlineContent":[{"text":"Examples include ","type":"text"},{"type":"codeVoice","code":"@system"},{"text":" on a non-class declaration, duplicate system","type":"text"},{"text":" ","type":"text"},{"text":"identifiers, ","type":"text"},{"code":"@query","type":"codeVoice"},{"text":" outside a system class, a query with no fetched","type":"text"},{"text":" ","type":"text"},{"text":"components, and a system class that cannot be initialized.","type":"text"}]},{"type":"heading","text":"Setup diagnostics","anchor":"Setup-diagnostics","level":2},{"type":"paragraph","inlineContent":[{"text":"Native component identifiers are resolved during plugin setup so earlier","type":"text"},{"text":" ","type":"text"},{"text":"plugins can register game components. Unknown or ambiguous component names skip","type":"text"},{"text":" ","type":"text"},{"text":"the affected system and append a diagnostic.","type":"text"}]},{"type":"heading","text":"Runtime diagnostics","anchor":"Runtime-diagnostics","level":2},{"inlineContent":[{"text":"Runtime diagnostics include unknown component aliases, unknown fields,","type":"text"},{"text":" ","type":"text"},{"text":"unsupported values, invalid numeric conversions, and query capabilities used","type":"text"},{"text":" ","type":"text"},{"text":"outside their callback lifetime.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Inspect "},{"isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin\/diagnostics","type":"reference"},{"text":" after setup and during development.","type":"text"},{"text":" ","type":"text"},{"text":"System ","type":"text"},{"code":"update(context)","type":"codeVoice"},{"text":" callbacks are command-style; their return values are","type":"text"},{"text":" ","type":"text"},{"text":"ignored. Tests should assert observable ECS state and diagnostics.","type":"text"}],"type":"paragraph"},{"text":"Performance model","anchor":"Performance-model","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Ada Script query execution traverses native archetypes and chunks. Component"},{"type":"text","text":" "},{"type":"text","text":"columns are bound once per chunk, and field access advances a typed pointer by"},{"type":"text","text":" "},{"type":"text","text":"row stride. A successful write mutates the component in place and updates its"},{"type":"text","text":" "},{"type":"text","text":"change tick."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The hot path avoids arrays of matched entity identifiers, one Swift bridge"},{"type":"text","text":" "},{"type":"text","text":"object per entity, repeated entity-location lookups, existential component"},{"type":"text","text":" "},{"type":"text","text":"copies, and whole-component reinsertion."}],"type":"paragraph"},{"inlineContent":[{"text":"The current embedded C runtime is globally shared and non-reentrant, so runtime entry remains","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"serialized. Scalability comes from native filtering, column iteration, cached"},{"type":"text","text":" "},{"text":"metadata, and narrow bridge calls rather than multiple concurrent VMs.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Benchmark scripting changes with multiple archetypes and chunks and compare"},{"type":"text","text":" "},{"type":"text","text":"them with a typed Swift query. Validate semantics before drawing performance"},{"type":"text","text":" "},{"type":"text","text":"conclusions."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/AdaScripting\/documentation\/AdaScripting"]]},"metadata":{"title":"Ada Script Diagnostics and Performance","roleHeading":"Article","role":"article","modules":[{"name":"Ada Script"}]},"references":{"doc://AdaScripting/documentation/AdaScripting/AdaScriptError/invalidManifest(_:)":{"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptError\/invalidManifest(_:)","url":"\/documentation\/adascripting\/adascripterror\/invalidmanifest(_:)","title":"AdaScriptError.invalidManifest(_:)","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind