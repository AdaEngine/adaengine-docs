{"hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdaEngine\/documentation\/AdaEngine"},"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","primaryContentSections":[{"content":[{"level":2,"anchor":"Additional-Resources","text":"Additional Resources","type":"heading"},{"items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/adaengine\/adaengine"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/adaengine\/adaengine\/discussions"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/www.adaengine.org\/"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Ada is a modern, open-source game engine written in Swift, designed for building 2D and 3D games with simplicity and performance in mind. Its architecture leverages the Entity Component System (ECS) paradigm, enabling developers to create games and interactive experiences using a modular and scalable approach."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Ada provides a suite of built-in features, including:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"High-level rendering system supporting 2D and 3D graphics"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Physics, animation, input handling, audio, and UI systems"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Asset management pipeline and streamlined workflows"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Cross-platform support across Apple platforms and Linux"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Hot-reload capabilities for assets and scripts"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Modern Swift API with async\/await, property wrappers, and result builders"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"With Ada, both beginners and experienced Swift developers can build games rapidly, focusing on gameplay instead of low-level boilerplate. Extensive documentation and tutorials make it easy to get started, from setting up your first scene to advanced gameplay mechanics."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Ada is actively developed, and contributions from the community are welcome."},{"type":"text","text":" "},{"type":"text","text":"For more details and guides, check out the tutorials below."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"Bringing simple and powerful game engine for your awesome games.","type":"text"}],"metadata":{"modules":[{"name":"AdaEngine"}],"role":"collection","title":"AdaEngine","roleHeading":"Framework","externalID":"AdaEngine","symbolKind":"module"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adaengine"]}],"sections":[],"topicSections":[{"title":"Tutorials","identifiers":["doc:\/\/AdaEngine\/documentation\/AdaEngine"],"anchor":"Tutorials"},{"title":"Guides","identifiers":["doc:\/\/AdaEngine\/documentation\/AdaEngine\/Building","doc:\/\/AdaEngine\/documentation\/AdaEngine\/Contributing","doc:\/\/AdaEngine\/documentation\/AdaEngine\/AdaUIIdentity","doc:\/\/AdaEngine\/documentation\/AdaEngine\/ImageDecoders","doc:\/\/AdaEngine\/documentation\/AdaEngine\/VisionOSWindowed"],"anchor":"Guides"},{"title":"Articles","identifiers":["doc:\/\/AdaEngine\/documentation\/AdaEngine\/HowToBuildEngine","doc:\/\/AdaEngine\/documentation\/AdaEngine\/SPMDebug","doc:\/\/AdaEngine\/documentation\/AdaEngine\/MakeTutorials","doc:\/\/AdaEngine\/documentation\/AdaEngine\/VisionOSImmersive"],"anchor":"Articles","generated":true},{"title":"Classes","