{"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"anchor":"Declare-a-system","type":"heading","text":"Declare a system","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apply "},{"code":"@system","type":"codeVoice"},{"type":"text","text":" to a class and implement "},{"code":"update(context)","type":"codeVoice"},{"type":"text","text":":"}]},{"code":["@system(scheduler: \"update\", id: \"game.movement\")","class MovementSystem {","    func update(context) {","    }","}"],"type":"codeListing","syntax":"ada"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The scheduler defaults to "},{"code":"update","type":"codeVoice"},{"type":"text","text":". System identifiers must be unique within a"},{"type":"text","text":" "},{"type":"text","text":"script module."}]},{"inlineContent":[{"text":"For one-time world setup, use ","type":"text"},{"code":"@system(scheduler: \"startup\")","type":"codeVoice"},{"text":". Its","type":"text"},{"text":" ","type":"text"},{"code":"update(context)","type":"codeVoice"},{"text":" runs on the default scheduler runner’s first update, before","type":"text"},{"text":" ","type":"text"},{"text":"the regular frame stages. A script class constructor does not receive a world","type":"text"},{"text":" ","type":"text"},{"text":"context. See ","type":"text"},{"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","type":"reference","isActive":true},{"text":" for all annotation arguments.","type":"text"}],"type":"paragraph"},{"anchor":"Order-systems","type":"heading","level":2,"text":"Order systems"},{"inlineContent":[{"text":"Use repeatable ","type":"text"},{"code":"@after","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@before","type":"codeVoice"},{"text":" annotations when component and resource","type":"text"},{"text":" ","type":"text"},{"text":"access alone does not express the required execution order:","type":"text"}],"type":"paragraph"},{"syntax":"ada","code":["@after(id: \"game.input\")","@before(id: \"game.physics\")","@system(scheduler: \"update\", id: \"game.movement\")","class MovementSystem {","    func update(context) {","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dependency IDs resolve within the same AdaScript module. Both systems must use"},{"type":"text","text":" "},{"type":"text","text":"the same scheduler. AdaScript rejects unknown IDs, self-dependencies, and"},{"type":"text","text":" "},{"type":"text","text":"dependency cycles while loading the module."}]},{"anchor":"Declare-a-query","type":"heading","text":"Declare a query","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apply "},{"code":"@query","type":"codeVoice"},{"type":"text","text":" to a stored system property:"}]},{"code":["@query(","    Health,","    Movement,","    with: Movable,","    without: Frozen",")","var entities;"],"type":"codeListing","syntax":"ada"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Positional components are fetched and available on each row. Four more clauses"},{"type":"text","text":" "},{"type":"text","text":"take one component or a list:"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Clause","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Meaning","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"optional: Target","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Fetched like a positional component, but rows may lack it. ","type":"text"},{"code":"entity.target","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":" when absent.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"with: Movable","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The entity must have it; it is not fetched.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"without: Frozen","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The entity must not have it.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"changed: Health","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Rows where any listed component changed since the system last ran.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"added: Marker","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Rows where any listed component was added since the system last ran.","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"code":["@query(Health, Movement, optional: Target, with: Movable, without: Frozen, changed: Health)","var entities;","","for (var entity in entities) {","    if (entity.target != null) { entity.health.current -= entity.target.damage; }","}"],"type":"codeListing","syntax":"ada"},{"type":"paragraph","inlineContent":[{"code":"changed","type":"codeVoice"},{"type":"text","text":" and "},{"code":"added","type":"codeVoice"},{"type":"text","text":" need the component to exist in the archetype; the change tick"},{"type":"text","text":" "},{"type":"text","text":"of a component is updated by every successful field write. A boolean "},{"code":"where:","type":"codeVoice"},{"type":"text","text":" clause"},{"type":"text","text":" "},{"type":"text","text":"and any other label are rejected with a message naming the supported clauses."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Row properties are the lower-camel-case component names, or an explicit alias"},{"type":"text","text":" "},{"type":"text","text":"written with "},{"code":"as","type":"codeVoice"},{"text":". A component may be named by its qualified path:","type":"text"}]},{"code":["@query(Game.Health as hp, Physics.Movement as motion)","var entities;","","for (var entity in entities) {","    var position = entity.motion.position;","    entity.hp.current -= 1.0;","}"],"type":"codeListing","syntax":"ada"},{"type":"paragraph","inlineContent":[{"text":"Two fetched components with the same short name (","type":"text"},{"code":"Game.Health","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Physics.Health","type":"codeVoice"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"are an error until one is given an alias, and no component may be aliased ","type":"text"},{"code":"id","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"entity.id","type":"codeVoice"},{"text":" exposes the native entity identifier.","type":"text"}]},{"level":2,"text":"Iterator behavior","anchor":"Iterator-behavior","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Ada Script queries are native iterators. AdaECS resolves matching archetypes,","type":"text"},{"text":" ","type":"text"},{"text":"binds component columns when entering a chunk, and advances their pointers by","type":"text"},{"text":" ","type":"text"},{"text":"row stride. The bridge does not create an entity proxy for every result and","type":"text"},{"text":" ","type":"text"},{"text":"does not perform a world component lookup for every field access.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A query row and its component views are borrowed. Do not retain them after the"},{"text":" ","type":"text"},{"text":"loop or system update returns. Structural changes must use deferred commands.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Inactive entities are skipped. Empty queries execute zero loop iterations."}],"type":"paragraph"},{"text":"Component fields","type":"heading","anchor":"Component-fields","level":2},{"inlineContent":[{"type":"text","text":"The "},{"code":"@Component","type":"codeVoice"},{"text":" Swift macro generates the runtime field accessors used by Ada","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Script. Register native components before the script plugin is set up."}],"type":"paragraph"},{"inlineContent":[{"text":"Supported field values include booleans, integers, finite floating-point","type":"text"},{"text":" ","type":"text"},{"text":"values, strings, vectors, quaternions, colors, and reflected enums. A rejected","type":"text"},{"text":" ","type":"text"},{"text":"write leaves the component unchanged and appends a development diagnostic.","type":"text"}],"type":"paragraph"},{"anchor":"Access-planning","text":"Access planning","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The compiler reads how a system uses its rows and requests exactly that access"},{"type":"text","text":" "},{"type":"text","text":"from the scheduler:"}],"type":"paragraph"},{"syntax":"ada","code":["var current = entity.health.current;   \/\/ read Health","entity.health.current = current - 1;   \/\/ write Health","entity.health.current -= 1;            \/\/ read and write Health"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A component that is only read can be shared with other readers; a write reserves"},{"type":"text","text":" "},{"type":"text","text":"it exclusively. "},{"code":"changed:","type":"codeVoice"},{"type":"text","text":" and "},{"code":"added:","type":"codeVoice"},{"type":"text","text":" read a component’s ticks, so they request"},{"type":"text","text":" "},{"type":"text","text":"read access even for a component that is not fetched. Filter-only components"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"with","type":"codeVoice"},{"type":"text","text":", "},{"code":"without","type":"codeVoice"},{"type":"text","text":") request none."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Analysis follows ","type":"text"},{"code":"for (var row in query)","type":"codeVoice"},{"type":"text","text":" loops. If a row, a component view, or the"},{"type":"text","text":" "},{"type":"text","text":"query itself escapes into code the compiler cannot follow (passed to a function,"},{"text":" ","type":"text"},{"type":"text","text":"stored, called with an unknown method), the system must declare what it touches:"}]},{"code":["@system(id: \"game.inspect\")","@access(read: [Health], write: [Transform])","class InspectSystem {","    @query(Health, Transform)","    var entities;","","    func update(context) {","        for (var entity in entities) { inspect(entity); }","    }","}"],"type":"codeListing","syntax":"ada"},{"inlineContent":[{"text":"Without ","type":"text"},{"code":"@access","type":"codeVoice"},{"type":"text","text":" this fails to compile, naming the query and component. A"},{"type":"text","text":" "},{"type":"text","text":"declaration may be broader than the code but not narrower: declaring a component"},{"type":"text","text":" "},{"type":"text","text":"read-only while the script writes it is an error. The same "},{"type":"codeVoice","code":"@access"},{"type":"text","text":" declaration"},{"text":" ","type":"text"},{"text":"governs the dynamic ","type":"text"},{"code":"context.world.read\/write","type":"codeVoice"},{"text":" calls. A precompiled module has no","type":"text"},{"text":" ","type":"text"},{"text":"script text to analyse and keeps write access to every fetched component.","type":"text"}],"type":"paragraph"},{"anchor":"Multiple-queries","text":"Multiple queries","level":2,"type":"heading"},{"inlineContent":[{"text":"One system may declare multiple independent iterators:","type":"text"}],"type":"paragraph"},{"syntax":"ada","code":["@system(scheduler: \"update\")","class TargetingSystem {","    @query(Player, Transform)","    var players;","","    @query(Enemy, Target, without: Dead)","    var enemies;","","    func update(context) {","        for (var enemy in enemies) {","            for (var player in players) {","                enemy.target.entity = player.id;","                break;","            }","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Queries are refreshed by the scheduler before each system execution.","type":"text"}],"type":"paragraph"},{"anchor":"Project-input-actions","text":"Project input actions","level":2,"type":"heading"},{"inlineContent":[{"text":"In ","type":"text"},{"inlineContent":[{"type":"text","text":"Project Settings → Input Bindings"}],"type":"strong"},{"text":", add an action such as ","type":"text"},{"code":"Jump","type":"codeVoice"},{"text":", then add","type":"text"},{"text":" ","type":"text"},{"text":"keyboard, mouse, gamepad or touch bindings. Click ","type":"text"},{"inlineContent":[{"type":"text","text":"Save Project Settings"}],"type":"strong"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Actions are stored in ","type":"text"},{"code":".ada\/project.json","type":"codeVoice"},{"type":"text","text":" and loaded by both Play Mode and the"},{"text":" ","type":"text"},{"text":"AdaScript project runtime. Multiple bindings act as alternatives: releasing one","type":"text"},{"text":" ","type":"text"},{"text":"input does not release the action while another binding is held.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Systems and scriptable components declare input as a read-only resource dependency","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"@res var input: Input;","type":"codeVoice"},{"text":". Only declarations that request Input receive it.","type":"text"},{"text":" ","type":"text"},{"text":"Use ","type":"text"},{"code":"@res(optional: true) var input: Input;","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"input.available()"},{"type":"text","text":" when the"},{"type":"text","text":" "},{"type":"text","text":"resource may be absent; a missing required resource produces a diagnostic."}],"type":"paragraph"},{"syntax":"adascript","code":["@res var input: Input;","","func update(context) {","    if (input.isActionJustPressed(\"Jump\")) {","        \/\/ Start a jump once per press.","    }","    var movement = input.getActionStrength(\"MoveRight\");","}"],"type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"code":"isActionPressed(name)","type":"codeVoice"},{"text":" remains true while an input is held.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"isActionJustPressed(name)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"isActionJustReleased(name)","type":"codeVoice"},{"text":" describe transitions","type":"text"},{"text":" ","type":"text"},{"text":"during the current frame. Both can be true for a tap completed within one frame.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"getActionStrength(name)","type":"codeVoice"},{"type":"text","text":" returns 0…1. Gamepad axes use a direction and the"},{"type":"text","text":" "},{"type":"text","text":"action’s dead zone; buttons and touch return either zero or one."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Gamepad bindings match any connected controller. "},{"type":"codeVoice","code":"Any Finger Held"},{"type":"text","text":" stays active"},{"type":"text","text":" "},{"type":"text","text":"until every contact ends or is cancelled. Touch lifecycle events, mouse motion,"},{"type":"text","text":" "},{"type":"text","text":"and wheel bindings produce frame pulses."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Input snapshots are scoped to a callback; query input again on the next update.","type":"text"},{"text":" ","type":"text"},{"text":"Unknown action names return false or zero. Names are case-sensitive.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Swift systems use the same methods on their ","type":"text"},{"code":"Input","type":"codeVoice"},{"type":"text","text":" resource. "},{"code":"InputPlugin()","type":"codeVoice"},{"text":" ","type":"text"},{"text":"loads the ","type":"text"},{"code":"inputActions","type":"codeVoice"},{"text":" section from ","type":"text"},{"code":".ada\/project.json","type":"codeVoice"},{"text":" in the current working","type":"text"},{"text":" ","type":"text"},{"text":"directory, including games launched from the editor. Packaged Swift applications","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"can decode "},{"code":"[InputAction]","type":"codeVoice"},{"text":" from an included resource and pass it to","type":"text"},{"type":"text","text":" "},{"code":"InputPlugin(actions:)","type":"codeVoice"},{"type":"text","text":", or call "},{"code":"try input.setInputActions(actions)","type":"codeVoice"},{"text":" on an existing","type":"text"},{"text":" ","type":"text"},{"text":"resource. Explicit ","type":"text"},{"code":"InputPlugin(actions: [])","type":"codeVoice"},{"text":" disables automatic project loading.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adascripting\/adascriptecs"]}],"identifier":{"url":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS","interfaceLanguage":"swift"},"abstract":[{"text":"Declare annotation-driven systems and iterate native AdaECS component columns.","type":"text"}],"seeAlsoSections":[{"title":"ECS Integration","anchor":"ECS-Integration","identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptDiagnosticsAndPerformance","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTesting"],"generated":true}],"metadata":{"title":"Ada Script ECS","modules":[{"name":"Ada Script"}],"roleHeading":"Article","role":"article"},"sections":[],"hierarchy":{"paths":[["doc:\/\/AdaScripting\/documentation\/AdaScripting"]]},"references":{"doc://AdaScripting/documentation/AdaScripting/AdaScriptTesting":{"url":"\/documentation\/adascripting\/adascripttesting","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTesting","role":"collectionGroup","title":"Testing Ada Script","kind":"article","abstract":[{"text":"Write tests next to your gameplay code, run them with ","type":"text"},{"code":"swift test","type":"codeVoice"},{"text":" or a command, and keep them out of shipped builds.","type":"text"}],"type":"topic"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptAnnotations":{"url":"\/documentation\/adascripting\/adascriptannotations","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","role":"article","title":"Ada Script Annotation Reference","kind":"article","abstract":[{"text":"Choose an annotation by the declaration it describes. Annotation arguments","type":"text"},{"text":" ","type":"text"},{"text":"are literals, identifiers, or lists of those values, not runtime expressions.","type":"text"},{"text":" ","type":"text"},{"text":"The same spelling can have different roles: ","type":"text"},{"code":"@component","type":"codeVoice"},{"text":" declares a struct,","type":"text"},{"text":" ","type":"text"},{"text":"while ","type":"text"},{"code":"@component(required: true)","type":"codeVoice"},{"text":" binds an existing component to a scriptable","type":"text"},{"text":" ","type":"text"},{"text":"instance.","type":"text"}],"type":"topic"},"doc://AdaScripting/documentation/AdaScripting":{"role":"collection","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting","url":"\/documentation\/adascripting","type":"topic","abstract":[{"type":"text","text":"Write gameplay systems in Ada Script while keeping entity filtering and access planning in AdaEngine’s native ECS."}],"kind":"symbol","title":"Ada Script"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptDiagnosticsAndPerformance":{"abstract":[{"text":"Understand annotation, setup, and runtime failures and keep ECS work on the","type":"text"},{"text":" ","type":"text"},{"text":"native chunk path.","type":"text"}],"kind":"article","type":"topic","url":"\/documentation\/adascripting\/adascriptdiagnosticsandperformance","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptDiagnosticsAndPerformance","title":"Ada Script Diagnostics and Performance","role":"article"}}}