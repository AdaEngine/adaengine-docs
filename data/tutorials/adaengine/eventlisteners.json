{"hierarchy":{"paths":[["doc:\/\/AdaEngine\/tutorials\/AdaEngine","doc:\/\/AdaEngine\/tutorials\/AdaEngine\/$volume","doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project."]],"modules":[{"projects":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject#Create-project-using-Xcode","kind":"task"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Intro","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-an-app","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-a-main-camera","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#First-sprite","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Make-it-move","kind":"task"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Player-component","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Text-component","kind":"task"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Base-of-Event-Subscriber-pattern","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Subscribe-to-scene-events","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Type-of-events","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Additional-for-physics","kind":"task"}]}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project."},{"projects":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Create-the-app-shell","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Layout-with-stacks","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Add-a-button-and-state","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Debug-overlays","kind":"task"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-the-view","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Prepare-layout-helpers","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-a-custom-TextRenderer","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Apply-and-animate","kind":"task"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Set-up-the-world","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Create-the-input-system","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Read-buttons","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Move-and-rumble","kind":"task"}]}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UI-and-Input"}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine"},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"project","identifier":{"url":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners","interfaceLanguage":"swift"},"metadata":{"categoryPathComponent":"AdaEngine","category":"Ada","role":"project","title":"Event Listeners in Ada"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/adaengine\/eventlisteners"]}],"sections":[{"chapter":"Create your first 2D game project.","estimatedTimeInMinutes":5,"kind":"hero","xcodeRequirement":"Xcode 26.2 or later","content":[{"inlineContent":[{"text":"In this tutorial you will learn about the event listeners system in Ada.","type":"text"},{"text":" ","type":"text"},{"text":"How can you catch events and process them","type":"text"}],"type":"paragraph"}],"title":"Event Listeners in Ada"},{"kind":"tasks","tasks":[{"anchor":"Base-of-Event-Subscriber-pattern","stepsSection":[],"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Event listeners in Ada are built on the Observer pattern."},{"type":"text","text":" "},{"type":"text","text":"Its main concept is based on the fact that there is a certain Subject that can send any events."},{"type":"text","text":" "},{"type":"text","text":"And there is an Observer that can receive and process this event."},{"type":"text","text":" "},{"type":"text","text":"In addition, Observer “subscribes” to events, as if you had subscribed to your favorite blog or magazine - as soon as an event occurs, Observer immediately knows about it."}]}],"kind":"contentAndMedia","mediaPosition":"trailing","media":"EL-1.jpg"}],"title":"Base of Event-Subscriber pattern"},{"anchor":"Subscribe-to-scene-events","stepsSection":[{"code":"EL-2-1-scene.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Let’s say we have a plugin in which we would like to listen to some events."}]}],"runtimePreview":null,"type":"step","caption":[],"media":null},{"code":"EL-2-2-scene.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"First of all, to control subscription\/unsubscription to events and for proper memory management, we must create a "},{"type":"codeVoice","code":"disposeBag"},{"type":"text","text":" using the "},{"type":"codeVoice","code":"@Local"},{"type":"text","text":" property wrapper."},{"type":"text","text":" "},{"type":"text","text":"We also mark our plugin with "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" to ensure thread safety."}]}],"runtimePreview":null,"type":"step","caption":[],"media":null},{"code":"EL-2-3-scene.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"After that, in the "},{"type":"codeVoice","code":"setup(in:)"},{"type":"text","text":" method you can call some code to subscribe to the event."},{"type":"text","text":" "},{"type":"text","text":"The "},{"type":"codeVoice","code":"app.main.subscribe"},{"type":"text","text":" method helps with this."},{"type":"text","text":" "},{"type":"text","text":"When an event is triggered, our listener subscribes to it and in the callback we can process our event."}]}],"runtimePreview":null,"type":"step","caption":[],"media":null}],"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Having understood how the Observer pattern works, let’s look at how to subscribe to scene events using the Plugin pattern."}]}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"title":"Subscribe to scene events"},{"anchor":"Type-of-events","stepsSection":[{"code":"EL-2-3-scene.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In the previous section, we saw the "},{"type":"codeVoice","code":"SceneEvents.OnReady"},{"type":"text","text":" event."},{"type":"text","text":" "},{"type":"text","text":"Ada has several available events that you can handle."},{"type":"text","text":" "},{"type":"text","text":"For example, you can find out what state your current game scene is in."},{"type":"text","text":" "},{"type":"text","text":"You can add your own additional logic when any built-in event occurs."}]}],"runtimePreview":null,"type":"step","caption":[],"media":null},{"code":"EL-2-4-events.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Here, as an example, are some built-in events that may be useful to you."},{"type":"text","text":" "},{"type":"text","text":"Familiar scene events and new collision events."}]}],"runtimePreview":null,"type":"step","caption":[],"media":null}],"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What events can we use? Let’s look at a couple of code examples in Ada."}]}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"title":"Type of events"},{"anchor":"Additional-for-physics","stepsSection":[{"code":"EL-2-5-physics.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Let’s continue with the example we looked at earlier."},{"type":"text","text":" "},{"type":"text","text":"We can access our event and assign the necessary parameters to the properties of the physical component."},{"type":"text","text":" "},{"type":"text","text":"Note that we use "},{"type":"codeVoice","code":"Task { @MainActor in ... }"},{"type":"text","text":" to ensure we’re on the main actor when modifying physics properties."}]}],"runtimePreview":null,"type":"step","caption":[],"media":null}],"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Additional information for handling physics in a game engine."},{"type":"text","text":" "},{"type":"text","text":"With the "},{"type":"codeVoice","code":"physicsWorld2D"},{"type":"text","text":" component you can control the physics settings for any objects in our game."},{"type":"text","text":" "},{"type":"text","text":"For example, you can set the gravity to zero for the scene creation event."}]}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"title":"Additional for physics"}]},{"featuredEyebrow":"Tutorial","kind":"callToAction","abstract":[{"text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state.","type":"text"}],"action":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics","isActive":true,"overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"overridingTitle":"Get started","type":"reference"},"title":"UI Basics"}],"references":{"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#First-sprite":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#First-sprite","kind":"section","url":"\/tutorials\/adaengine\/createfirst2dscene#First-sprite","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}],"type":"section","role":"pseudoSymbol","title":"First sprite"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Set-up-the-world":{"kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Set-up-the-world","url":"\/tutorials\/adaengine\/gamepadinput#Set-up-the-world","abstract":[{"text":"Build a small scene that spawns a player entity and moves it with a gamepad.","type":"text"}],"type":"section","role":"pseudoSymbol","title":"Set up the world"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Read-buttons":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Read-buttons","kind":"section","url":"\/tutorials\/adaengine\/gamepadinput#Read-buttons","abstract":[{"text":"Build a small scene that spawns a player entity and moves it with a gamepad.","type":"text"}],"type":"section","role":"pseudoSymbol","title":"Read buttons"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Create-an-app":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-an-app","kind":"section","url":"\/tutorials\/adaengine\/createfirst2dscene#Create-an-app","abstract":[{"text":"In this tutorial, you will learn how to create your first 2D scene using Ada.","type":"text"}],"type":"section","role":"pseudoSymbol","title":"Create an app"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Create-the-input-system":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Create-the-input-system","kind":"section","url":"\/tutorials\/adaengine\/gamepadinput#Create-the-input-system","abstract":[{"text":"Build a small scene that spawns a player entity and moves it with a gamepad.","type":"text"}],"type":"section","role":"pseudoSymbol","title":"Create the input system"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics#Create-the-app-shell":{"type":"section","url":"\/tutorials\/adaengine\/uibasics#Create-the-app-shell","kind":"section","abstract":[{"type":"text","text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state."}],"title":"Create the app shell","role":"pseudoSymbol","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Create-the-app-shell"},"doc://AdaEngine/tutorials/AdaEngine/CreateProject#Create-project-using-Xcode":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject#Create-project-using-Xcode","kind":"section","url":"\/tutorials\/adaengine\/createproject#Create-project-using-Xcode","abstract":[{"text":"In this tutorial, you will learn how to create your first Ada project.","type":"text"}],"type":"section","role":"pseudoSymbol","title":"Create project using Xcode"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Intro":{"type":"section","url":"\/tutorials\/adaengine\/createfirst2dscene#Intro","kind":"section","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}],"title":"Intro","role":"pseudoSymbol","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Intro"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics","kind":"project","url":"\/tutorials\/adaengine\/uibasics","abstract":[{"text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state.","type":"text"}],"estimatedTime":"15min","type":"topic","role":"project","title":"UI Basics"},"doc://AdaEngine/tutorials/AdaEngine/CreateProject":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject","kind":"project","url":"\/tutorials\/adaengine\/createproject","abstract":[{"text":"In this tutorial, you will learn how to create your first Ada project.","type":"text"}],"estimatedTime":"5min","type":"topic","role":"project","title":"Create your first game project"},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText","kind":"project","url":"\/tutorials\/adaengine\/animatedtext","abstract":[{"text":"Create a custom ","type":"text"},{"code":"TextRenderer","type":"codeVoice"},{"text":" that draws text along a sine wave and animate it by updating renderer state.","type":"text"}],"estimatedTime":"20min","type":"topic","role":"project","title":"Animated Text Renderer"},"doc://AdaEngine/tutorials/AdaEngine/UI-and-Input":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UI-and-Input","kind":"article","url":"\/tutorials\/adaengine\/ui-and-input","abstract":[],"type":"topic","role":"article","title":"UI and Input"},"EL-2-2-scene.swift":{"fileName":"EventListenerPlugin.swift","fileType":"swift","syntax":"swift","identifier":"EL-2-2-scene.swift","content":["import AdaEngine","","@MainActor","struct EventListenerPlugin: Plugin {","    @Local var disposeBag: Set<AnyCancellable> = []","","    func setup(in _: borrowing AppWorlds) {","","    }","}"],"highlights":[{"line":3},{"line":5},{"line":6}],"type":"file"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Type-of-events":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Type-of-events","kind":"section","url":"\/tutorials\/adaengine\/eventlisteners#Type-of-events","abstract":[{"text":"In this tutorial you will learn about the event listeners system in Ada.","type":"text"},{"text":" ","type":"text"},{"text":"How can you catch events and process them","type":"text"}],"type":"section","role":"pseudoSymbol","title":"Type of events"},"doc://AdaEngine/tutorials/AdaEngine/PlayerAndText":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText","kind":"project","url":"\/tutorials\/adaengine\/playerandtext","abstract":[{"text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene.","type":"text"}],"estimatedTime":"5min","type":"topic","role":"project","title":"Player and Text in Ada"},"EL-2-4-events.swift":{"fileName":"Events.swift","fileType":"swift","syntax":"swift","identifier":"EL-2-4-events.swift","content":["\/\/\/ Events the scene triggers.","public enum SceneEvents {","","    \/\/\/ An event triggered once when scene is ready to use and will starts update soon.","    public struct OnReady: Event {","        public let scene: Scene","    }","","    \/\/\/ Raised after an entity is added to the scene.","    public struct DidAddEntity: Event {","        public let entity: Entity","    }","","    \/\/\/ Raised before an entity is removed from the scene.","    public struct WillRemoveEntity: Event {","        public let entity: Entity","    }","","    \/\/\/ An event triggered once per frame interval that you can use to execute custom logic for each frame.","    public struct Update: Event {","","        \/\/\/ The updated scene.","        public let scene: Scene","","        \/\/\/ The elapsed time since the last update.","        public let deltaTime: TimeInterval","    }","}","","\/\/\/ Events associated with collisions.","public enum CollisionEvents {","","    \/\/\/ An event raised when two objects collide.","    public struct Began: Event {","","        \/\/\/ The first entity involved in the collision.","        public let entityA: Entity","","        \/\/\/ The second entity involved in the collision.","        public let entityB: Entity","","        \/\/\/ The estimated strength of the impact.","        public let impulse: Float","    }","","    \/\/\/ An event raised when two objects, previously in contact, separate.","    public struct Ended: Event {","","        \/\/\/ The first entity involved in the collision.","        public let entityA: Entity","","        \/\/\/ The second entity involved in the collision.","        public let entityB: Entity","    }","}"],"highlights":[],"type":"file"},"EL-2-5-physics.swift":{"fileName":"PhysicsHandler.swift","fileType":"swift","syntax":"swift","identifier":"EL-2-5-physics.swift","content":["import AdaEngine","","@MainActor","struct EventListenerPlugin: Plugin {","    @Local var disposeBag: Set<AnyCancellable> = []","","    func setup(in app: borrowing AppWorlds) {","        app.main","            .subscribe(to: SceneEvents.OnReady.self) { event in","                Task { @MainActor in","                    event.scene.world.physicsWorld2D?.gravity = .zero","                }","            }","            .store(in: &self.disposeBag)","    }","}"],"highlights":[],"type":"file"},"Xcode 26.2 or later":{"type":"xcodeRequirement","title":"Xcode 26.2 or later","url":"https:\/\/developer.apple.com\/download\/","identifier":"Xcode 26.2 or later"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics#Debug-overlays":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Debug-overlays","kind":"section","url":"\/tutorials\/adaengine\/uibasics#Debug-overlays","abstract":[{"text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state.","type":"text"}],"type":"section","role":"pseudoSymbol","title":"Debug overlays"},"doc://AdaEngine/tutorials/AdaEngine":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine","kind":"overview","url":"\/tutorials\/adaengine","abstract":[{"text":"Learn the basics of Ada and start developing your own games!","type":"text"}],"type":"topic","role":"overview","title":"Meet Ada"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Create-a-main-camera":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-a-main-camera","kind":"section","url":"\/tutorials\/adaengine\/createfirst2dscene#Create-a-main-camera","abstract":[{"text":"