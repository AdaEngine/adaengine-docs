{"abstract":[{"type":"text","text":"Opts a subworld, normally a render world, into pipelined updates."}],"identifier":{"url":"doc:\/\/AdaApp\/documentation\/AdaApp\/RenderPipelining","interfaceLanguage":"swift"},"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/AdaECS\/documentation\/AdaECS\/Resource","doc:\/\/AdaApp\/s8SendableP","doc:\/\/AdaApp\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To"}],"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RenderPipelining"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"text":"A pipelined subworld runs one frame behind its parent. The parent extracts frame N into it,","type":"text"},{"text":" ","type":"text"},{"text":"starts its update and continues with frame N+1 without waiting. Before the next extraction the","type":"text"},{"text":" ","type":"text"},{"text":"parent waits for that update to finish, so extraction remains the only point where both worlds","type":"text"},{"text":" ","type":"text"},{"text":"meet. Frame time approaches the longer of the two paths instead of their sum, at the cost of","type":"text"},{"text":" ","type":"text"},{"text":"one frame of input latency.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"While a pipelined update is in flight, systems of the subworld must not read the parent world","type":"text"},{"text":" ","type":"text"},{"text":"(see ","type":"text"},{"code":"Extract","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"MainWorld","type":"codeVoice"},{"text":"), and parent systems must not mutate objects the subworld reads.","type":"text"},{"text":" ","type":"text"},{"text":"Set ","type":"text"},{"code":"ADAENGINE_PIPELINED_RENDERING=0|1","type":"codeVoice"},{"text":" to override the setting of every world that declares this","type":"text"},{"text":" ","type":"text"},{"text":"resource, for measurements.","type":"text"},{"text":" ","type":"text"},{"text":"Pipelining is unavailable on WebAssembly, where the setting is ignored.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"roleHeading":"Structure","role":"symbol","title":"RenderPipelining","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RenderPipelining"}],"externalID":"s:6AdaApp16RenderPipeliningV","navigatorTitle":[{"kind":"identifier","text":"RenderPipelining"}],"symbolKind":"struct","modules":[{"name":"AdaApp"}]},"topicSections":[{"identifiers":["doc:\/\/AdaApp\/documentation\/AdaApp\/RenderPipelining\/init(isEnabled:)"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/AdaApp\/documentation\/AdaApp\/RenderPipelining\/isActive","doc:\/\/AdaApp\/documentation\/AdaApp\/RenderPipelining\/isEnabled"],"generated":true,"anchor":"Instance-Properties","title":"Instance Properties"},{"identifiers":["doc:\/\/AdaApp\/documentation\/AdaApp\/RenderPipelining\/isActive(in:)"],"generated":true,"anchor":"Type-Methods","title":"Type Methods"},{"identifiers":["doc:\/\/AdaApp\/documentation\/AdaApp\/RenderPipelining\/Resource-Implementations"],"generated":true,"anchor":"Default-Implementations","title":"Default Implementations"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adaapp\/renderpipelining"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/AdaApp\/documentation\/AdaApp"]]},"references":{"doc://AdaApp/documentation/AdaApp/RenderPipelining/isEnabled":{"abstract":[{"type":"text","text":"Whether this subworld updates one frame behind its parent."}],"kind":"symbol","type":"topic","title":"isEnabled","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isEnabled","kind":"identifier