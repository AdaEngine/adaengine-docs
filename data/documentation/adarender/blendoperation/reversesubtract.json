{"abstract":[{"text":"Subtract a portion of the source values from a portion of the destination pixel values.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/AdaRender\/documentation\/AdaRender","doc:\/\/AdaRender\/documentation\/AdaRender\/BlendOperation"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adarender\/blendoperation\/reversesubtract"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"metadata":{"role":"symbol","title":"BlendOperation.reverseSubtract","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reverseSubtract","kind":"identifier"}],"symbolKind":"case","externalID":"s:9AdaRender14BlendOperationO15reverseSubtractyA2CmF","roleHeading":"Case","modules":[{"name":"AdaRender"}]},"kind":"symbol","identifier":{"url":"doc:\/\/AdaRender\/documentation\/AdaRender\/BlendOperation\/reverseSubtract","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reverseSubtract","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"RGB = Dest.rgb * DBF - Source.rgb * SBF","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A = Dest.a * DBF - Source.a * SBF","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://AdaRender/documentation/AdaRender":{"abstract":[],"title":"AdaRender","type":"topic","kind":"symbol","url":"\/documentation\/adarender","identifier":"doc:\/\/AdaRender\/documentation\/AdaRender","role":"collection"},"doc://AdaRender/documentation/AdaRender/BlendOperation":{"url":"\/documentation\/adarender\/blendoperation","abstract":[{"type":"text","text":"For every pixel, "},{"type":"reference","identifier":"doc:\/\/AdaRender\/documentation\/AdaRender\/BlendOperation","isActive":true},{"type":"text","text":" determines how to combine and weight the source fragment values with the destination values."},{"type":"text","text":" "},{"type":"text","text":"Some blend operations multiply the source values by a source blend factor (SBF),"},{"type":"text","text":" "},{"type":"text","text":"multiply the destination values by a destination blend factor (DBF), and then combine the results using addition or subtraction."},{"type":"text","text":" "},{"type":"text","text":"Other blend operations use either a minimum or maximum function to determine the result."}],"kind":"symbol","type":"topic","role":"symbol","title":"BlendOperation","identifier":"doc:\/\/AdaRender\/documentation\/AdaRender\/BlendOperation","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BlendOperation","kind":"identifier"}],"navigatorTitle":[{"text":"BlendOperation","kind":"identifier"}]},"doc://AdaRender/documentation/AdaRender/BlendOperation/reverseSubtract":{"abstract":[{"text":"Subtract a portion of the source values from a portion of the destination pixel values.","type":"text"}],"identifier":"doc:\/\/AdaRender\/documentation\/AdaRender\/BlendOperation\/reverseSubtract","title":"BlendOperation.reverseSubtract","kind":"symbol","type":"topic","url":"\/documentation\/adarender\/blendoperation\/reversesubtract","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"reverseSubtract"}],"role":"symbol"}}}