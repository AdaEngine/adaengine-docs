ponent","type":"codeVoice"},{"text":"; visual scale does not resize the capsule.","type":"text"},{"text":" ","type":"text"},{"text":"The controller collides with physics bodies, ignores sensors, and does not push dynamic bodies","type":"text"},{"text":" ","type":"text"},{"text":"or register a body that other character controllers can collide with.","type":"text"},{"text":" ","type":"text"},{"text":"Supported walking automatically steps over solid ledges up to 5% of the resolved height,","type":"text"},{"text":" ","type":"text"},{"text":"provided the full capsule can sweep up, forward, and down to a walkable landing.","type":"text"}],"kind":"symbol","role":"symbol","url":"\/documentation\/adaphysics\/charactercontroller3dcomponent","navigatorTitle":[{"text":"CharacterController3DComponent","kind":"identifier"}]},"doc://AdaPhysics/documentation/AdaPhysics/CharacterController3DComponent/resetMotion":{"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"resetMotion","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"url":"\/documentation\/adaphysics\/charactercontroller3dcomponent\/resetmotion","title":"resetMotion","kind":"symbol","identifier":"doc:\/\/AdaPhysics\/documentation\/AdaPhysics\/CharacterController3DComponent\/resetMotion","abstract":[{"text":"Clears accumulated motion on the next fixed tick after a scripted teleport.","type":"text"}],"type":"topic"},"doc://AdaPhysics/documentation/AdaPhysics":{"role":"collection","url":"\/documentation\/adaphysics","title":"AdaPhysics","identifier":"doc:\/\/AdaPhysics\/documentation\/AdaPhysics","kind":"symbol","abstract":[],"type":"topic"}}}