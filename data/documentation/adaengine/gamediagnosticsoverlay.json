ollision."}],"role":"article"},"doc://AdaEngine/documentation/AdaEngine":{"role":"collection","title":"AdaEngine","url":"\/documentation\/adaengine","abstract":[{"text":"Bringing simple and powerful game engine for your awesome games.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine","type":"topic"},"doc://AdaEngine/documentation/AdaEngine/Building":{"type":"topic","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/Building","url":"\/documentation\/adaengine\/building","kind":"article","title":"Building Ada","abstract":[{"type":"text","text":"This guide covers two scenarios:"}],"role":"article"},"doc://AdaEngine/documentation/AdaEngine/Contributing":{"url":"\/documentation\/adaengine\/contributing","kind":"article","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/Contributing","role":"article","type":"topic","abstract":[{"type":"text","text":"We welcome contributions of all kinds: bug fixes, features, documentation, and examples."}],"title":"Contributing to Ada"},"doc://AdaEngine/documentation/AdaEngine/AdaUIIdentity":{"abstract":[{"text":"AdaUI reconciles a new view tree against the mounted ","type":"text"},{"code":"ViewNode","type":"codeVoice"},{"text":" tree. A node is preserved only when the new node and old node describe the same identity and the new node can update the old node. Preserved nodes keep their ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":", focus state, in-flight animation controllers, layers, and other node-local runtime state. Recreated nodes start with fresh runtime state.","type":"text"}],"identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/AdaUIIdentity","type":"topic","role":"article","title":"AdaUI View Identity","url":"\/documentation\/adaengine\/adauiidentity","kind":"article"},"doc://AdaEngine/documentation/AdaEngine/MovieMaker":{"kind":"symbol","abstract":[{"type":"text","text":"Records a fresh game world at a fixed simulation rate, waiting for every GPU"},{"type":"text","text":" "},{"type":"text","text":"frame and disk write before advancing. Rendering speed never drops movie frames."},{"type":"text","text":" "},{"type":"text","text":"Configure the same gameplay plugins and cameras as your game in "},{"type":"codeVoice","code":"make"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Platform\/window plugins are unnecessary for this offscreen runtime."}],"type":"topic","url":"\/documentation\/adaengine\/moviemaker","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MovieMaker"}],"title":"MovieMaker","navigatorTitle":[{"kind":"identifier","text":"MovieMaker"}],"identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/MovieMaker"},"doc://AdaEngine/documentation/AdaEngine/ImageDecoders":{"url":"\/documentation\/adaengine\/imagedecoders","kind":"article","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/ImageDecoders","role":"article","type":"topic","abstract":[{"type":"text","text":"Load PNG, JPEG ("},{"type":"codeVoice","code":"jpg"},{"type":"text","text":" or "},{"type":"codeVoice","code":"jpeg"},{"type":"text","text":"), BMP and TGA images as CPU pixels using"},{"type":"text","text":" "},{"type":"codeVoice","code":"Image"},{"text":", or load a GPU texture through ","type":"text"},{"type":"codeVoice","code":"Texture2D"},{"text":":","type":"text"}],"title":"Loading images and adding formats"},"doc://AdaEngine/documentation/AdaEngine/WESLShaders":{"type":"topic","url":"\/documentation\/adaengine\/weslshaders","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/WESLShaders","title":"Compile modular WESL shaders","kind":"article","abstract":[{"text":"Link local shader modules and compile feature variants to WGSL with the AdaEngine host tool.","type":"text"}],"role":"article"},"doc://AdaEngine/documentation/AdaEngine/AnimationAuthoring":{"url":"\/documentation\/adaengine\/animationauthoring","kind":"article","id