:\/\/AdaScripting\/documentation\/AdaScripting\/AdaUI"],"generated":true}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdaScripting\/documentation\/AdaScripting"},"variants":[{"paths":["\/documentation\/adascripting"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Ada Script is AdaEngine’s scripting layer for gameplay and ECS integration. Its source files use the ","type":"text"},{"code":".ada","type":"codeVoice"},{"text":" extension. The current implementation uses an embedded language runtime, while the public API, diagnostics, and tooling consistently present Ada Script concepts.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Annotations are not only syntax. AdaEngine resolves every query into native archetypes and component columns and publishes its component access to the scheduler."}]},{"type":"paragraph","inlineContent":[{"text":"Use Ada Script for gameplay rules that benefit from quick iteration. Keep rendering backends, custom data structures, and other low-level or performance-critical facilities in Swift.","type":"text"}]},{"type":"codeListing","syntax":"ada","code":["@system(scheduler: \"update\")","class MovementSystem {","    @query(Transform, Movement)","    var movers;","","    func update(context) {","        for (var entity in movers) {","            var position = entity.transform.position;","            var velocity = entity.movement.velocity;","            position[0] += velocity[0] * context.deltaTime;","            position[1] += velocity[1] * context.deltaTime;","            entity.transform.position = position;","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"AdaEditor projects configure automatic script discovery by default. For an existing Swift package, follow "},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript","isActive":true},{"type":"text","text":" to enable the build plugin and register the generated script plugins."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"Write gameplay systems in Ada Script while keeping entity filtering and access planning in AdaEngine’s native ECS.","type":"text"}],"references":{"doc://AdaScripting/documentation/AdaScripting/AdaScriptToolEntity":{"navigatorTitle":[{"text":"AdaScriptToolEntity","kind":"identifier"}],"title":"AdaScriptToolEntity","abstract":[{"text":"An entity creation requested by a tool; the editor applies the complete batch atomically.","type":"text"}],"role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/adascripting\/adascripttoolentity","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptToolEntity","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptToolEntity","kind":"identifier"}]},"doc://AdaScripting/documentation/AdaScripting/AdaScriptTesting":{"title":"Testing Ada Script","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTesting","url":"\/documentation\/adascripting\/adascripttesting","kind":"article","type":"topic","abstract":[{"type":"text","text":"Write tests next to your gameplay code, run them with "},{"code":"swift test","type":"codeVoice"},{"type":"text","text":" or a command, and keep them out of shipped builds."}],"role":"collectionGroup"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptUIExport":{"kind":"symbol","title":"AdaScriptUIExport","abstract":[{"text":"Explicit export metadata. Parameter names address stored properties on the @view type.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"AdaScriptUIExport","kind":"identifier"}],"url":"\/documentation\/adascripting\/adascriptuiexport","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptUIExport","kind":"identifier"