fier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Base-of-Event-Subscriber-pattern","abstract":[{"type":"text","text":"In this tutorial you will learn about the event listeners system in Ada."},{"type":"text","text":" "},{"type":"text","text":"How can you catch events and process them"}],"role":"pseudoSymbol","kind":"section","title":"Base of Event-Subscriber pattern","type":"section","url":"\/tutorials\/adaengine\/eventlisteners#Base-of-Event-Subscriber-pattern"},"AT-2-2-renderer.swift":{"identifier":"AT-2-2-renderer.swift","fileType":"swift","type":"file","fileName":"AnimatedSineWaveRenderer.swift","content":["import AdaEngine","","struct AnimatedSineWaveRenderer: TextRenderer {","    var timeOffset: Double","","    var animatableData: Double {","        get { timeOffset }","        set { timeOffset = newValue }","    }","","    init(timeOffset: Double) {","        self.timeOffset = timeOffset","    }","}"],"syntax":"swift","highlights":[]},"AT-3-3-view.swift":{"syntax":"swift","fileName":"ContentView.swift","content":["import AdaEngine","","struct ContentView: View {","    @State private var timeOffset: Double = 0","    @State private var animationTask: Task<Void, Never>?","","    var body: some View {","        Text(\"Sine Wave\")","            .textRendered(AnimatedSineWaveRenderer(timeOffset: timeOffset))","            .onAppear {","                startAnimation()","            }","            .onDisappear {","                animationTask?.cancel()","                animationTask = nil","            }","    }","","    private func startAnimation() {","        animationTask?.cancel()","        animationTask = Task { @MainActor in","            while !Task.isCancelled {","                timeOffset += 0.12","                try? await Task.sleep(nanoseconds: 16_000_000)","            }","        }","    }","}"],"type":"file","fileType":"swift","highlights":[{"line":13},{"line":14},{"line":15},{"line":16}],"identifier":"AT-3-3-view.swift"},"doc://A