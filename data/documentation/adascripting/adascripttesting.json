{"topicSections":[{"anchor":"Running-tests","title":"Running tests","identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestProject","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestReport","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestCase","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestResult"]}],"seeAlsoSections":[{"anchor":"ECS-Integration","generated":true,"title":"ECS Integration","identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptDiagnosticsAndPerformance"]}],"hierarchy":{"paths":[["doc:\/\/AdaScripting\/documentation\/AdaScripting"]]},"abstract":[{"text":"Write tests next to your gameplay code, run them with ","type":"text"},{"code":"swift test","type":"codeVoice"},{"text":" or a command, and keep them out of shipped builds.","type":"text"}],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"A function annotated with ","type":"text"},{"code":"@test","type":"codeVoice"},{"text":" is a test. It takes no parameters and may sit in any ","type":"text"},{"code":".ada","type":"codeVoice"},{"text":" file, where it can see that file’s ","type":"text"},{"code":"private","type":"codeVoice"},{"text":" declarations, or under a ","type":"text"},{"code":"Tests\/","type":"codeVoice"},{"text":" directory, where it sees public declarations only.","type":"text"}]},{"syntax":"ada","code":["@system(id: \"gravity\")","class GravitySystem {","    @query(Body)","    var bodies;","","    func update(context) { \/* … *\/ }","}","","private func clampSpeed(speed) { return Math.max(speed, -50.0); }","","@test(\"speed is capped\")","func speedIsCapped() {","    expectEqual(clampSpeed(-100.0), -50.0);","}"],"type":"codeListing"},{"text":"Assertions","anchor":"Assertions","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"expect(condition)"},{"type":"text","text":", "},{"type":"codeVoice","code":"expectEqual(actual, expected)"},{"type":"text","text":", "},{"type":"codeVoice","code":"expectNear(actual, expected, tolerance)"},{"type":"text","text":", "},{"type":"codeVoice","code":"expectNil(value)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"fail(message)"},{"text":" record a failure and let the test continue. ","type":"text"},{"type":"codeVoice","code":"require(condition)"},{"text":" records a failure and ends the test. Each failure is reported as ","type":"text"},{"type":"codeVoice","code":"path:line:column: message"},{"text":".","type":"text"}]},{"text":"TestWorld","level":3,"type":"heading","anchor":"TestWorld"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TestWorld()"},{"text":" creates an isolated world with the module’s components and systems. Time moves only when the test says so.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Run synchronous ","type":"text"},{"code":"TestWorld","type":"codeVoice"},{"text":" steps on the host. Browser players cannot block their","type":"text"},{"text":" ","type":"text"},{"text":"single thread while awaiting the scheduler; they report a diagnostic if asked to","type":"text"},{"text":" ","type":"text"},{"text":"step a test world. Gameplay systems continue through the normal async frame loop.","type":"text"}]},{"syntax":"ada","type":"codeListing","code":["@test(\"a body falls\")","func falls() {","    var world = TestWorld();","    var body = world.spawn([Body(y: 10.0, speed: 0.0)]);","    world.run(30);","    expect(world.read(body, \"Body\", \"y\") < 10.0);","}"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"spawn(components)","type":"codeVoice"},{"type":"text","text":", "},{"code":"insert(entity, component)","type":"codeVoice"},{"type":"text","text":", "},{"code":"remove(entity, name)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"despawn(entity)","type":"codeVoice"},{"type":"text","text":" change entities at once."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"has(entity, name)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"read(entity, name, field)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"count(name)"},{"text":" inspect them.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"run(ticks)"},{"text":" installs every system and runs fixed 1\/60 s ticks. ","type":"text"},{"type":"codeVoice","code":"runSystem(System, ticks)"},{"text":" installs only that system. ","type":"text"},{"type":"codeVoice","code":"advance(seconds)"},{"text":" runs one step of an exact length.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Each test gets its own world. Module-level "},{"type":"codeVoice","code":"var"},{"type":"text","text":" values that are numbers, booleans, strings or null are restored after each test; lists and maps are not."}],"type":"paragraph"},{"anchor":"The-Tests-directory","type":"heading","level":3,"text":"The Tests directory"},{"inlineContent":[{"type":"text","text":"Files under "},{"type":"codeVoice","code":"Tests\/"},{"type":"text","text":" are compiled only when tests run, and gameplay code cannot import from them."}],"type":"paragraph"},{"anchor":"Running-tests","type":"heading","level":3,"text":"Running tests"},{"inlineContent":[{"type":"text","text":"Load a project with tests and run it from Swift:"}],"type":"paragraph"},{"code":["let plugin = try AdaScriptPlugin(sources: sources, name: \"Game\", includeTests: true)","let results = plugin.runTests()"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"or point "},{"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestProject","type":"reference","isActive":true},{"type":"text","text":" at a directory, which picks up every "},{"type":"codeVoice","code":".ada"},{"type":"text","text":" file, and render the outcome with "},{"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestReport","type":"reference","isActive":true},{"type":"text","text":" as text, JUnit or JSON. The "},{"type":"codeVoice","code":"AdaScriptTest"},{"type":"text","text":" command does the same from a terminal and exits non-zero on failure:"}],"type":"paragraph"},{"code":["swift run AdaScriptTest Path\/To\/Project --format junit"],"type":"codeListing","syntax":null},{"inlineContent":[{"text":"Production modules never contain tests. Loading without ","type":"text"},{"code":"includeTests","type":"codeVoice"},{"text":" removes every ","type":"text"},{"code":"@test","type":"codeVoice"},{"text":" function and the ","type":"text"},{"code":"Tests\/","type":"codeVoice"},{"text":" directory, and reports any gameplay code that refers to a test-only name such as ","type":"text"},{"type":"codeVoice","code":"expect"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"TestWorld"},{"type":"text","text":"."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adascripting\/adascripttesting"]}],"metadata":{"role":"collectionGroup","title":"Testing Ada Script","roleHeading":"API Collection","modules":[{"name":"Ada Script"}]},"identifier":{"url":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTesting","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"references":{"doc://AdaScripting/documentation/AdaScripting/AdaScriptTestReport":{"url":"\/documentation\/adascripting\/adascripttestreport","kind":"symbol","abstract":[{"type":"text","text":"Text, JUnit and JSON renderings of test results, for terminals and CI."}],"navigatorTitle":[{"text":"AdaScriptTestReport","kind":"identifier"}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptTestReport","kind":"identifier"}],"title":"AdaScriptTestReport","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestReport","type":"topic"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptTestCase":{"title":"AdaScriptTestCase","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestCase","url":"\/documentation\/adascripting\/adascripttestcase","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptTestCase","kind":"identifier"}],"type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"AdaScriptTestCase"}],"abstract":[{"text":"One ","type":"text"},{"code":"@test","type":"codeVoice"},{"text":" function discovered in an Ada Script module (ADR-0024).","type":"text"}],"role":"symbol"},"doc://AdaScripting/documentation/AdaScripting":{"type":"topic","kind":"symbol","url":"\/documentation\/adascripting","role":"collection","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting","title":"Ada Script","abstract":[{"type":"text","text":"Write gameplay systems in Ada Script while keeping entity filtering and access planning in AdaEngine’s native ECS."}]},"doc://AdaScripting/documentation/AdaScripting/AdaScriptTestProject":{"navigatorTitle":[{"kind":"identifier","text":"AdaScriptTestProject"}],"title":"AdaScriptTestProject","abstract":[{"type":"text","text":"Runs the "},{"code":"@test","type":"codeVoice"},{"type":"text","text":" functions of an Ada Script project on disk (ADR-0024)."}],"role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/adascripting\/adascripttestproject","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestProject","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AdaScriptTestProject"}]},"doc://AdaScripting/documentation/AdaScripting/AdaScriptDiagnosticsAndPerformance":{"abstract":[{"text":"Understand annotation, setup, and runtime failures and keep ECS work on the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"native chunk path."}],"type":"topic","title":"Ada Script Diagnostics and Performance","url":"\/documentation\/adascripting\/adascriptdiagnosticsandperformance","kind":"article","role":"article","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptDiagnosticsAndPerformance"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptTestResult":{"navigatorTitle":[{"kind":"identifier","text":"AdaScriptTestResult"}],"abstract":[{"type":"text","text":"The outcome of running one "},{"code":"@test","type":"codeVoice"},{"type":"text","text":" function."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AdaScriptTestResult"}],"url":"\/documentation\/adascripting\/adascripttestresult","kind":"symbol","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTestResult","title":"AdaScriptTestResult","type":"topic"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptECS":{"type":"topic","abstract":[{"type":"text","text":"Declare annotation-driven systems and iterate native AdaECS component columns."}],"kind":"article","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS","url":"\/documentation\/adascripting\/adascriptecs","role":"article","title":"Ada Script ECS"}}}