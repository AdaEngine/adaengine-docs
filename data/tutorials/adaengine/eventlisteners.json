AdaEngine\/tutorials\/AdaEngine\/UIBasics#Create-the-app-shell"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Layout-with-stacks","kind":"task"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Add-a-button-and-state"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Debug-overlays","kind":"task"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText","sections":[{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-the-view"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Prepare-layout-helpers"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-a-custom-TextRenderer"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Apply-and-animate"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Set-up-the-world","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Create-the-input-system","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Read-buttons","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Move-and-rumble","kind":"task"}]}]}],"paths":[["doc:\/\/AdaEngine\/tutorials\/AdaEngine","doc:\/\/AdaEngine\/tutorials\/AdaEngine\/$volume","doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project."]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/adaengine\/eventlisteners"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners"},"metadata":{"categoryPathComponent":"AdaEngine","category":"Ada","title":"Event Listeners in Ada","role":"project"},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[{"content":[{"inlineContent":[{"type":"text","text":"In this tutorial you will learn about the event listeners system in Ada."},{"type":"text","text":" "},{"type":"text","text":"How can you catch events and process them"}],"type":"paragraph"}],"title":"Event Listeners in Ada","chapter":"Create your first 2D game project.","estimatedTimeInMinutes":5,"xcodeRequirement":"Xcode 26.2 or later","kind":"hero"},{"tasks":[{"stepsSection":[],"anchor":"Base-of-Event-Subscriber-pattern","title":"Base of Event-Subscriber pattern","contentSection":[{"media":"EL-1.jpg","kind":"contentAndMedia","content":[{"inlineContent":[{"text":"Event listeners in Ada are built on the Observer pattern.","type":"text"},{"text":" ","type":"text"},{"text":"Its main concept is based on the fact that there is a certain Subject that can send any events.","type":"text"},{"text":" ","type":"text"},{"text":"And there is an Observer that can receive and process this event.","type":"text"},{"text":" ","type":"text"},{"text":"In addition, Observer “subscribes” to events, as if you had subscribed to your favorite blog or magazine - as soon as an event occurs, Observer immediately knows about it.","type":"text"}],"type":"paragraph"}],"mediaPosition":"trailing"}]},{"stepsSection":[{"code":"EL-2-1-scene.swift","type":"step","content":[{"inlineContent":[{"text":"Let’s say we have a plugin in which we would like to listen to some events.","type":"text"}],"type":"paragraph"}],"media":null,"runtimePreview":null,"caption":[]},{"caption":[],"media":null,"code":"EL-2-2-scene.swift","runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"First of all, to control subscription\/unsubscription to events and for proper memory management, we must create a "},{"code":"disposeBag","type":"codeVoice"},{"type":"text","text":" using the "},{"code":"@Local","type":"codeVoice"},{"type":"text","text":" property wrapper."},{"type":"text","text":" "},{"type":"text","text":"We also mark our plugin with "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" to ensure thread safety."}]}]},{"caption":[],"media":null,"code":"EL-2-3-scene.swift","runtimePreview":null,"type":"step","content":[{"inlineContent":[{"text":"After that, in the ","type":"text"},{"type":"codeVoice","code":"setup(in:)"},{"type":"text","text":" method you can call some code to subscribe to the event."},{"type":"text","text":" "},{"type":"text","text":"The "},{"type":"codeVoice","code":"app.main.subscribe"},{"text":" method helps with this.","type":"text"},{"text":" ","type":"text"},{"text":"When an event is triggered, our listener subscribes to it and in the callback we can process our event.","type":"text"}],"type":"paragraph"}]}],"anchor":"Subscribe-to-scene-events","title":"Subscribe to scene events","contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Having understood how the Observer pattern works, let’s look at how to subscribe to scene events using the Plugin pattern."}]}],"mediaPosition":"trailing","kind":"contentAndMedia"}]},{"anchor":"Type-of-events","stepsSection":[{"code":"EL-2-3-scene.swift","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In the previous section, we saw the "},{"type":"codeVoice","code":"SceneEvents.OnReady"},{"type":"text","text":" event."},{"type":"text","text":" "},{"type":"text","text":"Ada has several available events that you can handle."},{"text":" ","type":"text"},{"text":"For example, you can find out what state your current game scene is in.","type":"text"},{"text":" ","type":"text"},{"text":"You can add your own additional logic when any built-in event occurs.","type":"text"}]}],"type":"step","media":null,"caption":[]},{"caption":[],"media":null,"runtimePreview":null,"type":"step","code":"EL-2-4-events.swift","content":[{"inlineContent":[{"text":"Here, as an example, are some built-in events that may be useful to you.","type":"text"},{"text":" ","type":"text"},{"text":"Familiar scene events and new collision events.","type":"text"}],"type":"paragraph"}]}],"title":"Type of events","contentSection":[{"content":[{"inlineContent":[{"type":"text","text":"What events can we use? Let’s look at a couple of code examples in Ada."}],"type":"paragraph"}],"kind":"contentAndMedia","mediaPosition":"trailing"}]},{"stepsSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Let’s continue with the example we looked at earlier."},{"type":"text","text":" "},{"type":"text","text":"We can access our event and assign the necessary parameters to the properties of the physical component."},{"type":"text","text":" "},{"type":"text","text":"Note that we use "},{"code":"Task { @MainActor in ... }","type":"codeVoice"},{"text":" to ensure we’re on the main actor when modifying physics properties.","type":"text"}]}],"media":null,"runtimePreview":null,"caption":[],"code":"EL-2-5-physics.swift","type":"step"}],"anchor":"Additional-for-physics","contentSection":[{"content":[{"inlineContent":[{"text":"Additional information for handling physics in a game engine.","type":"text"},{"text":" ","type":"text"},{"text":"With the ","type":"text"},{"code":"physicsWorld2D","type":"codeVoice"},{"text":" component you can control the physics settings for any objects in our game.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"For example, you can set the gravity to zero for the scene creation event."}],"type":"paragraph"}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"title":"Additional for physics"}],"kind":"tasks"},{"kind":"callToAction","abstract":[{"text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state.","type":"text"}],"action":{"overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"type":"reference","isActive":true,"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics","overridingTitle":"Get started"},"title":"UI Basics","featuredEyebrow":"Tutorial"}],"kind":"project","references":{"doc://AdaEngine/tutorials/AdaEngine/UIBasics#Add-a-button-and-state":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Add-a-button-and-state","abstract":[{"text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state.","type":"text"}],"title":"Add a button and state","role":"pseudoSymbol","kind":"section","url":"\/tutorials\/adaengine\/uibasics#Add-a-button-and-state","type":"section"},"EL-1.jpg":{"type":"image","alt":"Observer pattern scheme","identifier":"EL-1.jpg","variants":[{"traits":["1x","light"],"url":"\/images\/AdaEngine\/EL-1.jpg"}]},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Move-and-rumble":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Move-and-rumble","title":"Move and rumble","abstract":[{"text":"Build a small scene that spawns a player entity and moves it with a gamepad.","type":"text"}],"kind":"section","url":"\/tutorials\/adaengine\/gamepadinput#Move-and-rumble","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText":{"abstract":[{"text":"Create a custom ","type":"text"},{"type":"codeVoice","code":"TextRenderer"},{"text":" that draws text along a sine wave and animate it by updating renderer state.","type":"text"}],"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText","title":"Animated Text Renderer","role":"project","kind":"project","url":"\/tutorials\/adaengine\/animatedtext","estimatedTime":"20min","type":"topic"},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Prepare-layout-helpers":{"url":"\/tutorials\/adaengine\/animatedtext#Prepare-layout-helpers","type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Prepare-layout-helpers","title":"Prepare layout helpers","abstract":[{"text":"Create a custom ","type":"text"},{"type":"codeVoice","code":"TextRenderer"},{"text":" that draws text along a sine wave and animate it by updating renderer state.","type":"text"}],"kind":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Create-a-main-camera":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-a-main-camera","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}],"title":"Create a main camera.","role":"pseudoSymbol","kind":"section","url":"\/tutorials\/adaengine\/createfirst2dscene#Create-a-main-camera","type":"section"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#First-sprite":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#First-sprite","title":"First sprite","abstract":[{"text":"In this tutorial, you will learn how to create your first 2D scene using Ada.","type":"text"}],"kind":"section","url":"\/tutorials\/adaengine\/createfirst2dscene#First-sprite","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Create-a-custom-TextRenderer":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-a-custom-TextRenderer","abstract":[{"text":"Create a custom ","type":"text"},{"code":"TextRenderer","type":"codeVoice"},{"text":" that draws text along a sine wave and animate it by updating renderer state.","type":"text"}],"title":"Create a custom TextRenderer","kind":"section","url":"\/tutorials\/adaengine\/animatedtext#Create-a-custom-TextRenderer","role":"pseudoSymbol"},"EL-2-5-physics.swift":{"content":["import AdaEngine","","@MainActor","struct EventListenerPlugin: Plugin {","    @Local var disposeBag: Set<AnyCancellable> = []","","    func setup(in app: borrowing AppWorlds) {","        app.main","            .subscribe(to: SceneEvents.OnReady.self) { event in","                Task { @MainActor in","                    event.scene.world.physicsWorld2D?.gravity = .zero","                }","            }","            .store(in: &self.disposeBag)","    }","}"],"identi