ut","projects":[{"sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Create-the-app-shell","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Layout-with-stacks","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Add-a-button-and-state","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Debug-overlays","kind":"task"}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics"},{"sections":[{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-the-view"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Prepare-layout-helpers"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-a-custom-TextRenderer"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Apply-and-animate"}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText"},{"sections":[{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Set-up-the-world"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Create-the-input-system"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Read-buttons"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Move-and-rumble"}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput"}]}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine"},"sections":[{"xcodeRequirement":"Xcode 26.2 or later","chapter":"Create your first 2D game project.","title":"Player and Text in Ada","kind":"hero","estimatedTimeInMinutes":5,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene."}]}]},{"kind":"tasks","tasks":[{"anchor":"Add-Player-component","title":"Add Player component","stepsSection":[{"caption":[],"code":"PAT-1-1-player-component.swift","runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"First of all you have to add the player component. For Ada to understand you, just specify the following code.","type":"text"}]}],"media":null},{"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"We will create a separate makePlayer function where we will spawn an entity with various components."}]}],"code":"PAT-1-2-makePlayer.swift","runtimePreview":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"We must add our player to the scene. To do this we will use "},{"code":"World\/spawn(_:)","type":"codeVoice"},{"type":"text","text":" to spawn entities. Follow the code!"}],"type":"paragraph"}],"media":null},{"media":null,"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Next, let’s spawn an entity with the "},{"code":"PlayerComponent","type":"codeVoice"},{"type":"text","text":", which we discussed earlier, so that we can easily identify this entity as our player."}]}],"caption":[],"type":"step","code":"PAT-1-3-makePlayer.swift"},{"media":null,"runtimePreview":null,"content":[{"inlineContent":[{"text":"Ada knows that the player has been added to the scene, but… he can’t do anything and doesn’t have any properties. Let’s fix this! To begin with, we will give the player the opportunity to move and, in general, somehow change his size and position. Let’s use the built-in Transform component and set some initial values.","type":"text"}],"type":"paragraph"}],"caption":[],"type":"step","code":"PAT-1-4-makePlayer.swift"},{"media":null,"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"One more component is missing - what will the player look like? To do this, you can use sprites and the corresponding component in Ada. We pass a ","type":"text"},{"code":"characterAtlas","type":"codeVoice"},{"text":" parameter to get the texture for our player.","type":"text"}]}],"caption":[],"type":"step","code":"PAT-1-5-makePlayer.swift"},{"media":null,"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"After all the preparations, let’s create a Plugin that will set up our player. The Plugin pattern is the recommended way to organize game logic in Ada.","type":"text"}]}],"caption":[],"type":"step","code":"PAT-1-6-makeScene.swift"}],"contentSection":[{"content":[{"inlineContent":[{"text":"Here we will start adding our Components and Entity, so that Ada will correctly render our player and make him alive!","type":"text"}],"type":"paragraph"}],"mediaPosition":"trailing","kind":"contentAndMedia"}]},{"contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"inlineContent":[{"type":"text","text":"Let’s dive deeper into the Ada text component"}],"type":"paragraph"}]}],"anchor":"Add-Text-component","stepsSection":[{"type":"step","media":null,"runtimePreview":null,"code":"PAT-2-1-gameState.swift","content":[{"inlineContent":[{"text":"Okay, most likely you want to count some points for your player. Let’s start creating the GameState resource. Note that we use ","type":"text"},{"type":"codeVoice","code":"Resource"},{"text":" protocol for global game state.","type":"text"}],"type":"paragraph"}],"caption":[]},{"content":[{"inlineContent":[{"type":"text","text":"By analogy with the player, we will create a separate function for adding score text to the scene. Here, we spawn an entity with a "},{"type":"codeVoice","code":"TextComponent"},{"type":"text","text":" - it will help us draw the text. We also add Transform for positioning and insert our GameState as a resource."}],"type":"paragraph"}],"caption":[{"inlineContent":[{"type":"text","text":"To customize the text, you can use TextAttributeContainer."}],"type":"paragraph"}],"media":null,"code":"PAT-2-2-makeScore.swift","type":"step","runtimePreview":null}],"title":"Add Text component"}]},{"kind":"callToAction","abstract":[{"type":"text","text":"In this tutorial you will learn about the event listeners system in Ada."},{"type":"text","text":" "},{"type":"text","text":"How can you catch events and process them"}],"featuredEyebrow":"Tutorial","title":"Event Listeners in Ada","action":{"overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"overridingTitle":"Get started","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners","type":"reference","isActive":true}}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"categoryPathComponent":"AdaEngine","category":"Ada","role":"project","title":"Player and Text in Ada"},"kind":"project","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/adaengine\/playerandtext"]}],"identifier":{"url":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText","interfaceLanguage":"swift"},"references":{"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Intro":{"type":"section","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}],"kind":"section","title":"Intro","role":"pseudoSymbol","url":"\/tutorials\/adaengine\/createfirst2dscene#Intro","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Intro"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene":{"type":"topic","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}],"kind":"project","title":"Create your first 2D scene","role":"project","estimatedTime":"20min","url":"\/tutorials\/adaengine\/createfirst2dscene","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Create-a-main-camera":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-a-main-camera","url":"\/tutorials\/adaengine\/createfirst2dscene#Create-a-main-cam