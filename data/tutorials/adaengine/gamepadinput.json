eventlisteners","estimatedTime":"5min"},"GP-2-1-system.swift":{"fileName":"GamepadInputSystem.swift","fileType":"swift","content":["import AdaEngine","","@PlainSystem","struct GamepadInputSystem {","","    @FilterQuery<Ref<Transform>, With<PlayerComponent>>","    private var playerQuery","","    @Res<Input>","    private var input","","    @Res<DeltaTime>","    private var deltaTime","","    init(world _: World) {}","","    func update(context _: UpdateContext) {","        \/\/ Handle input here","    }","}"],"syntax":"swift","type":"file","identifier":"GP-2-1-system.swift","highlights":[]},"GP-1-1-app.swift":{"syntax":"swift","fileName":"GamepadInputApp.swift","content":["import AdaEngine","","@Component","struct PlayerComponent {}","","@main","struct GamepadInputApp: App {","    var body: some AppScene {","        DefaultAppWindow()","            .transformAppWorlds { appWorld in","                appWorld.spawn(","                    \"Camera\",","                    bundle: Camera2D(","                        camera: Camera(),","                        transform: Transform(position: [0, 0, 0])","                    )","                )","            }","            .windowMode(.windowed)","            .windowTitle(\"Gamepad Input\")","    }","}"],"highlights":[],"type":"file","fileType":"swift","identifier":"GP-1-1-app.swift"},"GP-2-4-system.swift":{"fileName":"GamepadInputSystem.swift","fileType":"swift","content":["import AdaEngine","","@PlainSystem","struct GamepadInputSystem {","","    @FilterQuery<Ref<Transform>, With<PlayerComponent>>","    private var playerQuery","","    @Res<Input>","    private var input","","    @Res<DeltaTime>","    private var deltaTime","","    init(world _: World) {}","","    func update(context _: UpdateContext) {","        let gamepads = input.getConnectedGamepads()","","        if gamepads.isEmpty {","            return","        }","","        for gamepad in gamepads {","            let leftStickX = gamepad.getAxisValue(.leftStickX)","            let leftStickY = gamepad.getAxisValue(.leftStickY)","            let deadzone: Float = 0.1","","            if abs(leftStickX) > deadzone || abs(leftStickY) > deadzone {","                playerQuery.forEach { transform in","                    let speed: Float = 2.0","                    transform.position.x += leftStickX * Float(deltaTime.deltaTime) * speed","                    transform.position.y -= leftStickY * Float(deltaTime.deltaTime) * speed","                }","            }","        }","    }","}"],"syntax":"swift","type":"file","identifier":"GP-2-4-system.swift","highlights":[]}}}