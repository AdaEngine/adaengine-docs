{"identifier":{"url":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene","interfaceLanguage":"swift"},"metadata":{"categoryPathComponent":"AdaEngine","title":"Create your first 2D scene","category":"Ada","role":"project"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/adaengine\/createfirst2dscene"]}],"hierarchy":{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine","modules":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project.","projects":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject#Create-project-using-Xcode","kind":"task"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Intro","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-an-app","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-a-main-camera","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#First-sprite","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Make-it-move","kind":"task"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Player-component","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Text-component","kind":"task"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Base-of-Event-Subscriber-pattern","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Subscribe-to-scene-events","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Type-of-events","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Additional-for-physics","kind":"task"}]}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UI-and-Input","projects":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Create-the-app-shell","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Layout-with-stacks","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Add-a-button-and-state","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Debug-overlays","kind":"task"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-the-view","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Prepare-layout-helpers","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-a-custom-TextRenderer","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Apply-and-animate","kind":"task"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Set-up-the-world","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Create-the-input-system","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Read-buttons","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Move-and-rumble","kind":"task"}]}]}],"paths":[["doc:\/\/AdaEngine\/tutorials\/AdaEngine","doc:\/\/AdaEngine\/tutorials\/AdaEngine\/$volume","doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project."]]},"kind":"project","schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[{"title":"Create your first 2D scene","chapter":"Create your first 2D game project.","estimatedTimeInMinutes":20,"xcodeRequirement":"Xcode 26.2 or later","content":[{"inlineContent":[{"text":"In this tutorial, you will learn how to create your first 2D scene using Ada.","type":"text"}],"type":"paragraph"}],"kind":"hero"},{"tasks":[{"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For the first 2D scene, we will try to repeat this example. We’ll look at adding a scene and a camera."},{"type":"text","text":" "},{"type":"text","text":"In addition, we’ll learn how to add sprites and movement systems."}]}],"mediaPosition":"trailing","kind":"contentAndMedia","media":"CF2G-3-5.mov"}],"stepsSection":[],"title":"Intro","anchor":"Intro"},{"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"First, we need to create base files to launch our application."}]}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"stepsSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In the previous tutorial, we’ve created an app and an empty window scene."}]}],"code":"CF2G-1-1-app.swift","caption":[],"type":"step","media":null,"runtimePreview":null},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Let’s create the game logic. To do this, let’s create a file named "},{"type":"codeVoice","code":"FirstScene.swift"},{"type":"text","text":" and import AdaEngine."},{"type":"text","text":" "},{"type":"text","text":"After that, create a struct named "},{"type":"codeVoice","code":"FirstScene"},{"type":"text","text":" that conforms to "},{"type":"codeVoice","code":"Plugin"},{"type":"text","text":" and add a method named "},{"type":"codeVoice","code":"setup(in app: AppWorlds)"},{"type":"text","text":" where we will set up entities in our game world."}]}],"code":"CF2G-1-2-scene.swift","caption":[],"type":"step","media":null,"runtimePreview":null},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Now add the "},{"type":"codeVoice","code":"FirstScene"},{"type":"text","text":" plugin to the app using the "},{"type":"codeVoice","code":"addPlugins"},{"type":"text","text":" method."}]}],"code":"CF2G-1-4-app.swift","caption":[],"type":"step","media":null,"runtimePreview":null}],"title":"Create an app","anchor":"Create-an-app"},{"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ada uses the Entity Component System paradigm where all game objects are called "},{"type":"codeVoice","code":"Entity"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Entities are objects that store user or engine data like position, scale, mesh instance, audio, etc. This data is called components, and they should conform to the "},{"type":"codeVoice","code":"Component"},{"type":"text","text":" protocol."},{"type":"text","text":" "},{"type":"text","text":"By default, "},{"type":"codeVoice","code":"Entity"},{"type":"text","text":" is an empty object without any components."}]}],"mediaPosition":"trailing","kind":"contentAndMedia"},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Camera"},{"type":"text","text":" is a component that determines where all entities will be rendered. Ada supports rendering to a texture or to the "},{"type":"codeVoice","code":"Window"},{"type":"text","text":". We recommend using engine component bundles like "},{"type":"codeVoice","code":"Camera2D"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Camera3D"},{"type":"text","text":", because the engine provides additional components for rendering and audio capabilities."}]}],"kind":"fullWidth"}],"stepsSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Let’s create our 2D camera. Spawn an entity with the "},{"type":"codeVoice","code":"Camera2D"},{"type":"text","text":" bundle."}]}],"code":"CF2G-2-1-camera.swift","caption":[],"type":"step","media":null,"runtimePreview":null},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Now let’s fill the camera background with a sky blue color."}]}],"code":"CF2G-2-2-camera.swift","caption":[],"type":"step","media":null,"runtimePreview":"CF2G-2-1.png"}],"title":"Create a main camera.","anchor":"Create-a-main-camera"},{"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Now we can create our first custom sprite."}]}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"stepsSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"First, we should create an assets folder where we will store our game assets, like sprite sheets, sounds, shaders, etc. Let’s create a folder named "},{"type":"codeVoice","code":"Assets"},{"type":"text","text":" and add any sprite sheets you want. We will use this sprite sheet:"}]}],"code":null,"caption":[],"type":"step","media":"CF2G-3-1.png","runtimePreview":null},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In the end, we should have this file structure in our project. Ada doesn’t use xcassets."}]}],"code":null,"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You can download this texture by right-clicking on the image and saving it to the downloads folder."}]}],"type":"step","media":"CF2G-3-2.png","runtimePreview":null},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Spawn a player entity in the game world. The player entity will store our sprite component and other player data in the future."}]}],"code":"CF2G-3-1-sprite.swift","caption":[],"type":"step","media":null,"runtimePreview":null},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Let’s create an image from a file using a special resource manager object. "},{"type":"codeVoice","code":"AssetsManager"},{"type":"text","text":" manages and caches game and engine resources. In our case, we should load an image from a file named "},{"type":"codeVoice","code":"characters_packed.png"},{"type":"text","text":" and use "},{"type":"codeVoice","code":"Bundle.main"},{"type":"text","text":" as a search path."}]}],"code":"CF2G-3-2-sprite.swift","caption":[],"type":"step","media":null,"runtimePreview":null},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"To split the sprite sheet image into sprites, we can use the "},{"type":"codeVoice","code":"TextureAtlas"},{"type":"text","text":" object. This object takes an image, sprite size, and margin between sprites if needed. In our case, we have a margin between sprites of 4px horizontally and 1px vertically, and a sprite size of 20px width and 23px height."}]}],"code":"CF2G-3-3-sprite.swift","caption":[],"type":"step","media":null,"runtimePreview":null},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Now we can add our sprite to the player entity using the "},{"type":"codeVoice","code":"Sprite"},{"type":"text","text":" component. This component is efficient for rendering because it uses a special batching system and requires fewer drawing calls."}]}],"code":"CF2G-3-4-sprite.swift","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a new sprite component to the entity in the "},{"type":"codeVoice","code":"spawn"},{"type":"text","text":" method. As you can see, we use subscripts in our "},{"type":"codeVoice","code":"TextureAtlas"},{"type":"text","text":" instance where 7 is the column number in our sprite sheet and 1 is the row number."}]}],"type":"step","media":null,"runtimePreview":"CF2G-3-3.png"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"And finally, let’s add a special "},{"type":"codeVoice","code":"Transform"},{"type":"text","text":" component that describes the position of our entity on the screen."}]}],"code":"CF2G-3-5-sprite.swift","caption":[],"type":"step","media":null,"runtimePreview":"CF2G-3-4.png"}],"title":"First sprite","anchor":"First-sprite"},{"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"We did a lot of work, but our scene looks very simple. We should add more life to our player entity. All game logic is described in special objects named "},{"type":"codeVoice","code":"System"},{"type":"text","text":". A system is a unit that executes each game loop and manipulates entities and their data. We will use one to add life to our player."}]}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"stepsSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"First, we should create a special tag component named "},{"type":"codeVoice","code":"PlayerComponent"},{"type":"text","text":". We will use this component in the near future; it indicates that this entity is a player."}]}],"code":"CF2G-4-1-player.swift","caption":[],"type":"step","media":null,"runtimePreview":null},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a new function named "},{"type":"codeVoice","code":"PlayerMovement"},{"type":"text","text":" and annotate this function with the "},{"type":"codeVoice","code":"System"},{"type":"text","text":" macro. This system will listen to user inputs and move our player component on the screen."}]}],"code":"CF2G-4-2-player.swift","caption":[],"type":"step","media":null,"runtimePreview":null},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the new system to our game scene. The "},{"type":"codeVoice","code":"System"},{"type":"text","text":" macro will create a new system with the same name as the function with the suffix "},{"type":"codeVoice","code":"System"},{"type":"text","text":". Our system will be initialized once on app launch."}]}],"code":"CF2G-4-3-player.swift","caption":[],"type":"step","media":null,"runtimePreview":null},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"PlayerMovementSystem"},{"type":"text","text":", add a new function parameter named "},{"type":"codeVoice","code":"playerTransform"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"FilterQuery<Ref<Transform>, With<PlayerComponent>>"},{"type":"text","text":" type."},{"type":"text","text":" "},{"type":"text","text":"This object will query the world and return components that conform to your predicate. In our case, we require one mutable component "},{"type":"codeVoice","code":"Transform"},{"type":"text","text":" and a filter that indicates we need entities with the "},{"type":"codeVoice","code":"PlayerComponent"},{"type":"text","text":"."}]}],"code":"CF2G-4-4-player.swift","caption":[],"type":"step","media":null,"runtimePreview":null},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a new function parameter named "},{"type":"codeVoice","code":"speed"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"Local<Float>"},{"type":"text","text":" type. This is a special type that stores a value available only within the system."}]}],"code":"CF2G-4-5-player.swift","caption":[],"type":"step","media":null,"runtimePreview":null},{"inlineContent":[{"text":"Now we can update our player position. Ada can handle keyboard inputs for us. We should listen to keyboard inputs, and if a key is pressed, we should change the player transform.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Let’s add a new function parameter named "},{"type":"codeVoice","code":"deltaTime"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"Res<DeltaTime>"},{"type":"text","text":" type and "},{"type":"codeVoice","code":"input"},{"type":"text","text":" with "},{"type":"codeVoice","code":"Res<Input>"},{"type":"text","text":". These are queries to resources in the world."}]}],"code":"CF2G-4-6-player.swift","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Using the special "},{"type":"codeVoice","code":"Input"},{"type":"text","text":" object, we can check if a key is pressed."},{"type":"text","text":" "},{"type":"text","text":"Add an "},{"code":"if","type":"codeVoice"},{"type":"text","text":" condition where we will listen to the "},{"type":"codeVoice","code":"w"},{"type":"text","text":" key. If the key is pressed, add the speed multiplied by delta time. We do this for a smooth transition between frames."}]}],"type":"step","media":null,"runtimePreview":null},{"runtimePreview":"CF2G-3-5.mov","code":"CF2G-4-7-player.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Finally, add the same logic for other keys — "},{"code":"a","type":"codeVoice"},{"type":"text","text":", "},{"code":"s","type":"codeVoice"},{"type":"text","text":", and "},{"code":"d","type":"codeVoice"},{"type":"text","text":"."}]}],"caption":[{"inlineContent":[{"type":"text","text":"Run the app and try to move your player."}],"type":"paragraph"}],"media":null,"type":"step"}],"title":"Make it move","anchor":"Make-it-move"}],"kind":"tasks"},{"title":"Player and Text in Ada","abstract":[{"text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene.","type":"text"}],"action":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText","isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"overridingTitle":"Get started","type":"reference"},"featuredEyebrow":"Tutorial","kind":"callToAction"}],"references":{"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Make-it-move":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Make-it-move","role":"pseudoSymbol","url":"\/tutorials\/adaengine\/createfirst2dscene#Make-it-move","kind":"section","title":"Make it move","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}]},"CF2G-2-1-camera.swift":{"identifier":"CF2G-2-1-camera.swift","type":"file","syntax":"swift","highlights":[],"fileType":"swift","fileName":"FirstScene.swift","content":["import AdaEngine","","struct FirstScene: Plugin {","    func setup(in app: AppWorlds) {","        app.spawn(bundle: Camera2D())","    }","}"]},"doc://AdaEngine/tutorials/AdaEngine/UIBasics#Layout-with-stacks":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Layout-with-stacks","url":"\/tutorials\/adaengine\/uibasics#Layout-with-stacks","abstract":[{"text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state.","type":"text"}],"type":"section","role":"pseudoSymbol","kind":"section","title":"Layout with stacks"},"CF2G-4-6-player.swift":{"identifier":"CF2G-4-6-player.swift","type":"file","syntax":"swift","highlights":[{"line":14},{"line":15},{"line":16},{"line":17},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23}],"fileType":"swift","fileName":"FirstScene.swift","content":["import AdaEngine","","struct FirstScene: Plugin {","    func setup(in _: AppWorlds) {","        \/** Collapsed code *\/","    }","}","","@Component","struct PlayerComponent {}","","@System","func PlayerMovement(","    _ playerTransform: FIlterQuery<Ref<Transform>, With<PlayerComponent>>,","    _ speed: Local<Float> = 3.0,","    _ deltaTime: Res<DeltaTime>,","    _ input: Res<Input>",") {","    playerTransform.forEach { transform in","        if input.wrappedValue.isKeyPressed(.w) {","            transform.position.y += speed.wrappedValue * deltaTime.wrappedValue.deltaTime","        }","    }","}"]},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Move-and-rumble":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Move-and-rumble","type":"section","role":"pseudoSymbol","url":"\/tutorials\/adaengine\/gamepadinput#Move-and-rumble","kind":"section","title":"Move and rumble","abstract":[{"text":"Build a small scene that spawns a player entity and moves it with a gamepad.","type":"text"}]},"doc://AdaEngine/tutorials/AdaEngine/Create-your-first-2D-game-project.":{"type":"topic","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project.","role":"article","url":"\/tutorials\/adaengine\/create-your-first-2d-game-project.","kind":"article","title":"Create your first 2D game project.","abstract":[]},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Additional-for-physics":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Additional-for-physics","type":"section","role":"pseudoSymbol","url":"\/tutorials\/adaengine\/eventlisteners#Additional-for-physics","kind":"section","title":"Additional for physics","abstract":[{"text":"In this tutorial you will learn about the event listeners system in Ada.","type":"text"},{"text":" ","type":"text"},{"text":"How can you catch events and process them","type":"text"}]},"CF2G-3-3.png":{"type":"image","alt":"Our sprite sheet","identifier":"CF2G-3-3.png","variants":[{"traits":["1x","light"],"url":"\/images\/AdaEngine\/CF2G-3-3.png"}]},"CF2G-3-5.mov":{"type":"video","alt":null,"identifier":"CF2G-3-5.mov","poster":null,"variants":[{"traits":["1x","light"],"url":"\/videos\/AdaEngine\/CF2G-3-5.mov"}]},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#First-sprite":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#First-sprite","role":"pseudoSymbol","url":"\/tutorials\/adaengine\/createfirst2dscene#First-sprite","kind":"section","title":"First sprite","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}]},"CF2G-4-5-player.swift":{"type":"file","identifier":"CF2G-4-5-player.swift","syntax":"swift","highlights":[{"line":4},{"line":5},{"line":14},{"line":15}],"fileType":"swift","fileName":"FirstScene.swift","content":["import AdaEngine","","struct FirstScene: Plugin {","    func setup(in _: AppWorlds) {","        \/** Collapsed code *\/","    }","}","","@Component","struct PlayerComponent {}","","@System","func PlayerMovement(","    _: FIlterQuery<Ref<Transform>, With<PlayerComponent>>,","    _: Local<Float> = 3.0",") {","","}"]},"doc://AdaEngine/tutorials/AdaEngine/UIBasics#Create-the-app-shell":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Create-the-app-shell","role":"pseudoSymbol","url":"\/tutorials\/adaengine\/uibasics#Create-the-app-shell","kind":"section","title":"Create the app shell","abstract":[{"type":"text","text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state."}]},"CF2G-4-2-player.swift":{"type":"file","identifier":"CF2G-4-2-player.swift","syntax":"swift","highlights":[{"line":25},{"line":26},{"line":27},{"line":28},{"line":29}],"fileType":"swift","fileName":"FirstScene.swift","content":["import AdaEngine","","struct FirstScene: Plugin {","    func setup(in app: AppWorlds) {","        let camera = Camera()","        camera.backgroundColor = Color(45 \/ 255, 171 \/ 255, 255 \/ 255, 1)","        app.spawn(bundle: Camera2D(camera: camera))","","        let spriteSheetImage = try! AssetsManager.loadSync(Image.self, at: \"@res:\/\/characters_packed.png\").asset!","        let spriteSheet = TextureAtlas(from: spriteSheetImage, size: [20, 23], margin: [4, 1])","","        app.spawn(\"Player\") {","            Sprite(","                texture: spriteSheet[7, 1],","                size: Size(width: 24, height: 24)","            )","            Transform()","            PlayerComponent()","        }","    }","}","","@Component","struct PlayerComponent {}","","@System","func PlayerMovement() {","","}"]},"doc://AdaEngine/tutorials/AdaEngine/CreateProject#Create-project-using-Xcode":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject#Create-project-using-Xcode","role":"pseudoSymbol","url":"\/tutorials\/adaengine\/createproject#Create-project-using-Xcode","kind":"section","title":"Create p