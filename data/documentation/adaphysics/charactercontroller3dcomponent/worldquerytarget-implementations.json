ragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"access"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"SystemAccessSet","preciseIdentifier":"s:6AdaECS15SystemAccessSetV"}],"abstract":[],"kind":"symbol"},"doc://AdaPhysics/documentation/AdaPhysics":{"title":"AdaPhysics","identifier":"doc:\/\/AdaPhysics\/documentation\/AdaPhysics","role":"collection","type":"topic","url":"\/documentation\/adaphysics","abstract":[],"kind":"symbol"},"doc://AdaPhysics/documentation/AdaPhysics/CharacterController3DComponent":{"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"CharacterController3DComponent","kind":"identifier"}],"identifier":"doc:\/\/AdaPhysics\/documentation\/AdaPhysics\/CharacterController3DComponent","abstract":[{"text":"An upright capsule mover. Its entity’s position is the bottom of the capsule in world units.","type":"text"},{"text":" ","type":"text"},{"text":"Use on a root entity without ","type":"text"},{"type":"codeVoice","code":"PhysicsBody3DComponent"},{"text":"; visual scale does not resize the capsule.","type":"text"},{"text":" ","type":"text"},{"text":"The controller collides with physics bodies, ignores sensors, and does not push dynamic bodies","type":"text"},{"text":" ","type":"text"},{"text":"or register a body that other character controllers can collide with.","type":"text"},{"text":" ","type":"text"},{"text":"Supported walking automatically steps over solid ledges up to 5% of the resolved height,","type":"text"},{"text":" ","type":"text"},{"text":"provided the full capsule can sweep up, forward, and down to a walkable landing.","type":"text"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CharacterController3DComponent","kind":"identifier"}],"title":"CharacterController3DComponent","url":"\/documentation\/adaphysics\/charactercontroller3dcomponent"}}}