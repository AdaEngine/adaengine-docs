:"codeVoice","code":"Environment"},{"text":" property wrapper:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct MyView: View {","    @Environment(\\.myCustomValue) var customValue: String","","    var body: some View {","        Text(customValue) \/\/ Displays \"Another string\".","    }","}"]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/adautils\/environmentkey"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"symbol","metadata":{"role":"symbol","navigatorTitle":[{"text":"EnvironmentKey","kind":"identifier"}],"externalID":"s:8AdaUtils14EnvironmentKeyP","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"kind":"identifier","text":"EnvironmentKey"}],"symbolKind":"protocol","roleHeading":"Protocol","title":"EnvironmentKey","modules":[{"name":"AdaUtils"}]},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdaUtils\/documentation\/AdaUtils\/EnvironmentKey"},"hierarchy":{"paths":[["doc:\/\/AdaUtils\/documentation\/AdaUtils"]]},"abstract":[{"text":"A key for accessing values in the environment.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/AdaUtils\/documentation\/AdaUtils\/EnvironmentKey\/Value"],"title":"Associated Types","anchor":"Associated-Types","generated":true},{"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/AdaUtils\/documentation\/AdaUtils\/EnvironmentKey\/defaultValue"],"generated":true}],"references":{"doc://AdaUtils/documentation/AdaUtils/EnvironmentKey":{"type":"topic","url":"\/documentation\/adautils\/environmentkey","identifier":"doc:\/\/AdaUtils\/documentation\/AdaUtils\/EnvironmentKey","navigatorTitle":[{"text":"EnvironmentKey","kind":"identifier"}],"title":"EnvironmentKey","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EnvironmentKey","kind":"identifier"}],"role":"symbol","kind":"symbol","abstract":[{"text":"A key for