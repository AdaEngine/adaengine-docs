{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene"},"hierarchy":{"modules":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project.","projects":[{"sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject#Create-project-using-Xcode","kind":"task"}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject"},{"sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Intro","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-an-app","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-a-main-camera","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#First-sprite","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Make-it-move","kind":"task"}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene"},{"sections":[{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Player-component"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Text-component"}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText"},{"sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Base-of-Event-Subscriber-pattern","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Subscribe-to-scene-events","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Type-of-events","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Additional-for-physics","kind":"task"}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UI-and-Input","projects":[{"sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Create-the-app-shell","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Layout-with-stacks","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Add-a-button-and-state","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Debug-overlays","kind":"task"}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics"},{"sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-the-view","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Prepare-layout-helpers","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-a-custom-TextRenderer","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Apply-and-animate","kind":"task"}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText"},{"sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Set-up-the-world","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Create-the-input-system","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Read-buttons","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Move-and-rumble","kind":"task"}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput"}]}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine","paths":[["doc:\/\/AdaEngine\/tutorials\/AdaEngine","doc:\/\/AdaEngine\/tutorials\/AdaEngine\/$volume","doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project."]]},"metadata":{"title":"Create your first 2D scene","category":"Ada","categoryPathComponent":"AdaEngine","role":"project"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/adaengine\/createfirst2dscene"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"project","sections":[{"content":[{"inlineContent":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}],"type":"paragraph"}],"title":"Create your first 2D scene","chapter":"Create your first 2D game project.","xcodeRequirement":"Xcode 26.2 or later","estimatedTimeInMinutes":20,"kind":"hero"},{"kind":"tasks","tasks":[{"anchor":"Intro","title":"Intro","contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"For the first 2D scene, we will try to repeat this example. We’ll look at adding a scene and a camera.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"In addition, we’ll learn how to add sprites and movement systems."}]}],"media":"CF2G-3-5.mov"}],"stepsSection":[]},{"contentSection":[{"kind":"contentAndMedia","content":[{"inlineContent":[{"text":"First, we need to create base files to launch our application.","type":"text"}],"type":"paragraph"}],"mediaPosition":"trailing"}],"title":"Create an app","anchor":"Create-an-app","stepsSection":[{"media":null,"caption":[],"code":"CF2G-1-1-app.swift","type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In the previous tutorial, we’ve created an app and an empty window scene."}]}],"runtimePreview":null},{"media":null,"caption":[],"code":"CF2G-1-2-scene.swift","type":"step","content":[{"inlineContent":[{"text":"Let’s create the game logic. To do this, let’s create a file named ","type":"text"},{"type":"codeVoice","code":"FirstScene.swift"},{"text":" and import AdaEngine.","type":"text"},{"type":"text","text":" "},{"text":"After that, create a struct named ","type":"text"},{"code":"FirstScene","type":"codeVoice"},{"text":" that conforms to ","type":"text"},{"code":"Plugin","type":"codeVoice"},{"type":"text","text":" and add a method named "},{"type":"codeVoice","code":"setup(in app: AppWorlds)"},{"type":"text","text":" where we will set up entities in our game world."}],"type":"paragraph"}],"runtimePreview":null},{"media":null,"caption":[],"code":"CF2G-1-4-app.swift","type":"step","content":[{"inlineContent":[{"text":"Now add the ","type":"text"},{"code":"FirstScene","type":"codeVoice"},{"text":" plugin to the app using the ","type":"text"},{"code":"addPlugins","type":"codeVoice"},{"text":" method.","type":"text"}],"type":"paragraph"}],"runtimePreview":null}]},{"contentSection":[{"kind":"contentAndMedia","content":[{"inlineContent":[{"text":"Ada uses the Entity Component System paradigm where all game objects are called ","type":"text"},{"type":"codeVoice","code":"Entity"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Entities are objects that store user or engine data like position, scale, mesh instance, audio, etc. This data is called components, and they should conform to the ","type":"text"},{"type":"codeVoice","code":"Component"},{"text":" protocol.","type":"text"},{"text":" ","type":"text"},{"text":"By default, ","type":"text"},{"type":"codeVoice","code":"Entity"},{"text":" is an empty object without any components.","type":"text"}],"type":"paragraph"}],"mediaPosition":"trailing"},{"kind":"fullWidth","content":[{"inlineContent":[{"code":"Camera","type":"codeVoice"},{"text":" is a component that determines where all entities will be rendered. Ada supports rendering to a texture or to the ","type":"text"},{"code":"Window","type":"codeVoice"},{"text":". We recommend using engine component bundles like ","type":"text"},{"code":"Camera2D","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"Camera3D","type":"codeVoice"},{"text":", because the engine provides additional components for rendering and audio capabilities.","type":"text"}],"type":"paragraph"}]}],"stepsSection":[{"runtimePreview":null,"type":"step","caption":[],"media":null,"content":[{"inlineContent":[{"text":"Let’s create our 2D camera. Spawn an entity with the ","type":"text"},{"type":"codeVoice","code":"Camera2D"},{"type":"text","text":" bundle."}],"type":"paragraph"}],"code":"CF2G-2-1-camera.swift"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Now let’s fill the camera background with a sky blue color.","type":"text"}]}],"code":"CF2G-2-2-camera.swift","runtimePreview":"CF2G-2-1.png","type":"step","caption":[],"media":null}],"title":"Create a main camera.","anchor":"Create-a-main-camera"},{"title":"First sprite","contentSection":[{"content":[{"inlineContent":[{"type":"text","text":"Now we can create our first custom sprite."}],"type":"paragraph"}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"stepsSection":[{"type":"step","content":[{"inlineContent":[{"text":"First, we should create an assets folder where we will store our game assets, like sprite sheets, sounds, shaders, etc. Let’s create a folder named ","type":"text"},{"code":"Assets","type":"codeVoice"},{"text":" and add any sprite sheets you want. We will use this sprite sheet:","type":"text"}],"type":"paragraph"}],"caption":[],"code":null,"media":"CF2G-3-1.png","runtimePreview":null},{"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You can download this texture by right-clicking on the image and saving it to the downloads folder."}]}],"media":"CF2G-3-2.png","type":"step","code":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In the end, we should have this file structure in our project. Ada doesn’t use xcassets."}]}],"runtimePreview":null},{"caption":[],"media":null,"type":"step","code":"CF2G-3-1-sprite.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Spawn a player entity in the game world. The player entity will store our sprite component and other player data in the future."}]}],"runtimePreview":null},{"caption":[],"media":null,"type":"step","code":"CF2G-3-2-sprite.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Let’s create an image from a file using a special resource manager object. "},{"code":"AssetsManager","type":"codeVoice"},{"type":"text","text":" manages and caches game and engine resources. In our case, we should load an image from a file named "},{"code":"characters_packed.png","type":"codeVoice"},{"type":"text","text":" and use "},{"type":"codeVoice","code":"Bundle.main"},{"type":"text","text":" as a search path."}]}],"runtimePreview":null},{"code":"CF2G-3-3-sprite.swift","type":"step","content":[{"inlineContent":[{"text":"To split the sprite sheet image into sprites, we can use the ","type":"text"},{"code":"TextureAtlas","type":"codeVoice"},{"text":" object. This object takes an image, sprite size, and margin between sprites if needed. In our case, we have a margin between sprites of 4px horizontally and 1px vertically, and a sprite size of 20px width and 23px height.","type":"text"}],"type":"paragraph"}],"caption":[],"media":null,"runtimePreview":null},{"code":"CF2G-3-4-sprite.swift","type":"step","content":[{"inlineContent":[{"type":"text","text":"Now we can add our sprite to the player entity using the "},{"type":"codeVoice","code":"Sprite"},{"type":"text","text":" component. This component is efficient for rendering because it uses a special batching system and requires fewer drawing calls."}],"type":"paragraph"}],"caption":[{"inlineContent":[{"type":"text","text":"Add a new sprite component to the entity in the "},{"type":"codeVoice","code":"spawn"},{"type":"text","text":" method. As you can see, we use subscripts in our "},{"type":"codeVoice","code":"TextureAtlas"},{"type":"text","text":" instance where 7 is the column number in our sprite sheet and 1 is the row number."}],"type":"paragraph"}],"media":null,"runtimePreview":"CF2G-3-3.png"},{"code":"CF2G-3-5-sprite.swift","type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"And finally, let’s add a special "},{"type":"codeVoice","code":"Transform"},{"type":"text","text":" component that describes the position of our entity on the screen."}]}],"caption":[],"media":null,"runtimePreview":"CF2G-3-4.png"}],"anchor":"First-sprite"},{"title":"Make it move","anchor":"Make-it-move","stepsSection":[{"caption":[],"type":"step","content":[{"inlineContent":[{"type":"text","text":"First, we should create a special tag component named "},{"code":"PlayerComponent","type":"codeVoice"},{"type":"text","text":". We will use this component in the near future; it indicates that this entity is a player."}],"type":"paragraph"}],"code":"CF2G-4-1-player.swift","runtimePreview":null,"media":null},{"caption":[],"type":"step","content":[{"inlineContent":[{"text":"Create a new function named ","type":"text"},{"code":"PlayerMovement","type":"codeVoice"},{"text":" and annotate this function with the ","type":"text"},{"code":"System","type":"codeVoice"},{"text":" macro. This system will listen to user inputs and move our player component on the screen.","type":"text"}],"type":"paragraph"}],"code":"CF2G-4-2-player.swift","runtimePreview":null,"media":null},{"code":"CF2G-4-3-player.swift","runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the new system to our game scene. The "},{"type":"codeVoice","code":"System"},{"type":"text","text":" macro will create a new system with the same name as the function with the suffix "},{"type":"codeVoice","code":"System"},{"type":"text","text":". Our system will be initialized once on app launch."}]}],"caption":[],"media":null},{"code":"CF2G-4-4-player.swift","runtimePreview":null,"type":"step","content":[{"inlineContent":[{"text":"In ","type":"text"},{"type":"codeVoice","code":"PlayerMovementSystem"},{"text":", add a new function parameter named ","type":"text"},{"type":"codeVoice","code":"playerTransform"},{"text":" with the ","type":"text"},{"type":"codeVoice","code":"FilterQuery<Ref<Transform>, With<PlayerComponent>>"},{"text":" type.","type":"text"},{"text":" ","type":"text"},{"text":"This object will query the world and return components that conform to your predicate. In our case, we require one mutable component ","type":"text"},{"type":"codeVoice","code":"Transform"},{"text":" and a filter that indicates we need entities with the ","type":"text"},{"type":"codeVoice","code":"PlayerComponent"},{"text":".","type":"text"}],"type":"paragraph"}],"caption":[],"media":null},{"code":"CF2G-4-5-player.swift","runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Add a new function parameter named ","type":"text"},{"type":"codeVoice","code":"speed"},{"text":" with the ","type":"text"},{"type":"codeVoice","code":"Local<Float>"},{"text":" type. This is a special type that stores a value available only within the system.","type":"text"}]}],"caption":[],"media":null},{"type":"paragraph","inlineContent":[{"text":"Now we can update our player position. Ada can handle keyboard inputs for us. We should listen to keyboard inputs, and if a key is pressed, we should change the player transform.","type":"text"}]},{"type":"step","media":null,"runtimePreview":null,"code":"CF2G-4-6-player.swift","content":[{"type":"paragraph","inlineContent":[{"text":"Let’s add a new function parameter named ","type":"text"},{"code":"deltaTime","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"Res<DeltaTime>","type":"codeVoice"},{"text":" type and ","type":"text"},{"code":"input","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"Res<Input>","type":"codeVoice"},{"text":". These are queries to resources in the world.","type":"text"}]}],"caption":[{"type":"paragraph","inlineContent":[{"text":"Using the special ","type":"text"},{"code":"Input","type":"codeVoice"},{"text":" object, we can check if a key is pressed.","type":"text"},{"text":" ","type":"text"},{"text":"Add an ","type":"text"},{"code":"if","type":"codeVoice"},{"text":" condition where we will listen to the ","type":"text"},{"code":"w","type":"codeVoice"},{"text":" key. If the key is pressed, add the speed multiplied by delta time. We do this for a smooth transition between frames.","type":"text"}]}]},{"type":"step","media":null,"runtimePreview":"CF2G-3-5.mov","code":"CF2G-4-7-player.swift","content":[{"type":"paragraph","inlineContent":[{"text":"Finally, add the same logic for other keys — ","type":"text"},{"code":"a","type":"codeVoice"},{"text":", ","type":"text"},{"code":"s","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"d","type":"codeVoice"},{"text":".","type":"text"}]}],"caption":[{"type":"paragraph","inlineContent":[{"text":"Run the app and try to move your player.","type":"text"}]}]}],"contentSection":[{"kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"We did a lot of work, but our scene looks very simple. We should add more life to our player entity. All game logic is described in special objects named ","type":"text"},{"code":"System","type":"codeVoice"},{"text":". A system is a unit that executes each game loop and manipulates entities and their data. We will use one to add life to our player.","type":"text"}]}],"mediaPosition":"trailing"}]}]},{"action":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText","isActive":true,"type":"reference","overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"overridingTitle":"Get started"},"featuredEyebrow":"Tutorial","kind":"callToAction","title":"Player and Text in Ada","abstract":[{"text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene.","type":"text"}]}],"references":{"CF2G-4-6-player.swift":{"fileName":"FirstScene.swift","type":"file","identifier":"CF2G-4-6-player.swift","content":["import AdaEngine","","struct FirstScene: Plugin {","    func setup(in _: AppWorlds) {","        \/** Collapsed code *\/","    }","}","","@Component","struct PlayerComponent {}","","@System","func PlayerMovement(","    _ playerTransform: FIlterQuery<Ref<Transform>, With<PlayerComponent>>,","    _ speed: Local<Float> = 3.0,","    _ deltaTime: Res<DeltaTime>,","    _ input: Res<Input>",") {","    playerTransform.forEach { transform in","        if input.wrappedValue.isKeyPressed(.w) {","            transform.position.y += speed.wrappedValue * deltaTime.wrappedValue.deltaTime","        }","    }","}"],"highlights":[{"line":14},{"line":15},{"line":16},{"line":17},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23}],"fileType":"swift","syntax":"swift"},"CF2G-3-4.png":{"alt":"Our sprite sheet","variants":[{"url":"\/images\/AdaEngine\/CF2G-3-4.png","traits":["1x","light"]}],"identifier":"CF2G-3-4.png","type":"image"},"CF2G-3-1-sprite.swift":{"type":"file","highlights":[],"identifier":"CF2G-3-1-sprite.swift","fileName":"FirstScene.swift","content":["import AdaEngine","","struct FirstScene: Plugin {","    func setup(in app: AppWorlds) {","        let camera = Camera()","        camera.backgroundColor = Color(45 \/ 255, 171 \/ 255, 255 \/ 255, 1)","        app.spawn(bundle: Camera2D(camera: camera))","","        app.spawn(\"Player\")","    }","}"],"syntax":"swift","fileType":"swift"},"doc://AdaEngine/tutorials/AdaEngine/CreateProject#Create-project-using-Xcode":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject#Create-project-using-Xcode","abstract":[{"text":"In this tutorial, you will learn how to create your first Ada project.","type":"text"}],"title":"Create project using Xcode","role":"pseudoSymbol","kind":"section","url":"\/tutorials\/adaengine\/createproject#Create-project-using-Xcode","type":"section"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Create-the-input-system":{"url":"\/tutorials\/adaengine\/gamepadinput#Create-the-input-system","type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Create-the-input-system","title":"Create the input system","abstract":[{"type":"text","text":"Build a small scene that spawns a player entity and moves it with a gamepad."}],"kind":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput":{"abstract":[{"type":"text","text":"Build a small scene that spawns a player entity and moves it with a gamepad."}],"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput","title":"Gamepad Input","role":"project","kind":"project","url":"\/tutorials\/adaengine\/gamepadinput","estimatedTime":"20min","type":"topic"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics#Create-the-app-shell":{"url":"\/tutorials\/adaengine\/uibasics#Create-the-app-shell","type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Create-the-app-shell","title":"Create the app shell","abstract":[{"text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state.","type":"text"}],"kind":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Read-buttons":{"abstract":[{"type":"text","text":"Build a small scene that spawns a player entity and moves it with a gamepad."}],"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Read-buttons","title":"Read buttons","role":"pseudoSymbol","kind":"section","url":"\/tutorials\/adaengine\/gamepadinput#Read-buttons","type":"section"},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Create-a-custom-TextRenderer":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-a-custom-TextRenderer","abstract":[{"text":"Create a custom ","type":"text"},{"code":"TextRenderer","type":"codeVoice"},{"text":" that draws text along a sine wave and animate it by updating renderer state.","type":"text"}],"title":"Create a custom TextRenderer","kind":"section","url":"\/tutorials\/adaengine\/animatedtext#Create-a-custom-TextRenderer","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Move-and-rumble":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Move-and-rumble","title":"Move and rumble","abstract":[{"text":"Build a small scene that spawns a player entity and moves it with a gamepad.","type":"text"}],"kind":"section","url":"\/tutorials\/adaengine\/gamepadinput#Move-and-rumble","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Make-it-move":{"abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}],"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Make-it-move","title":"Make it move","role":"pseudoSymbol","kind":"section","url":"\/tutorials\/adaengine\/createfirst2dscene#Make-it-move","type":"section"},"CF2G-3-3-sprite.swift":{"fileName":"FirstScene.swift","type":"file","identifier":"CF2G-3-3-sprite.swift","content":["import AdaEngine","","struct FirstScene: Plugin {","    func setup(in app: AppWorlds) {","        let camera = Camera()","        camera.backgroundColor = Color(45 \/ 255, 171 \/ 255, 255 \/ 255, 1)","        app.spawn(bundle: Camera2D(camera: camera))","","        let spriteSheetImage = try! AssetsManager.loadSync(Image.self, at: \"@res:\/\/characters_packed.png\").asset!","        let spriteSheet = TextureAtlas(from: spriteSheetImage, size: [20, 23], margin: [4, 1])","","        app.spawn(\"Player\")","    }","}"],"highlights":[{"line":10}],"fileType":"swift","syntax":"swift"},"doc://AdaEngine/tutorials/AdaEngine/Create-your-first-2D-game-project.":{"kind":"article","role":"article","type":"topic","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project.","abstract":[],"url":"\/tutorials\/adaengine\/create-your-first-2d-game-project.","title":"Create your first 2D game project."},"doc://AdaEngine/tutorials/AdaEngine/UIBasics":{"abstract":[{"type":"text","text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state."}],"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics","title":"UI Basics","role":"project","kind":"project","url":"\/tutorials\/adaengine\/uibasics","estimatedTime":"15min","