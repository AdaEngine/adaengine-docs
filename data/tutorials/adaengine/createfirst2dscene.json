identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#First-sprite","abstract":[{"text":"In this tutorial, you will learn how to create your first 2D scene using Ada.","type":"text"}],"url":"\/tutorials\/adaengine\/createfirst2dscene#First-sprite","title":"First sprite","role":"pseudoSymbol","kind":"section"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Additional-for-physics":{"role":"pseudoSymbol","abstract":[{"text":"In this tutorial you will learn about the event listeners system in Ada.","type":"text"},{"text":" ","type":"text"},{"text":"How can you catch events and process them","type":"text"}],"type":"section","kind":"section","url":"\/tutorials\/adaengine\/eventlisteners#Additional-for-physics","title":"Additional for physics","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Additional-for-physics"},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Prepare-layout-helpers":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Prepare-layout-helpers","abstract":[{"type":"text","text":"Create a custom "},{"type":"codeVoice","code":"TextRenderer"},{"type":"text","text":" that draws text along a sine wave and animate it by updating renderer state."}],"url":"\/tutorials\/adaengine\/animatedtext#Prepare-layout-helpers","title":"Prepare layout helpers","role":"pseudoSymbol","kind":"section"},"CF2G-3-4.png":{"alt":"Our sprite sheet","identifier":"CF2G-3-4.png","variants":[{"url":"\/images\/AdaEngine\/CF2G-3-4.png","traits":["1x","light"]}],"type":"image"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners":{"kind":"project","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners","url":"\/tutorials\/adaengine\/eventlisteners","estimatedTime":"5min","title":"Event Listeners in Ada","type":"topic","role":"project","abstract":[{"text":"In this tutorial you will learn about the event listeners system in Ada.","type":"text"},{"text":" ","type":"text"},{"text":"How can you catch events and process them","type":"text"}]},"doc://AdaEngine/tutorials/AdaEngine/Create-your-first-2D-game-project.":{"type":"topic","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project.","abstract":[],"url":"\/tutorials\/adaengine\/create-your-first-2d-game-project.","title":"Create your first 2D game project.","role":"article","kind":"article"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput":{"abstract":[{"type":"text","text":"Build a small scene that spawns a player entity and moves it with a gamepad."}],"kind":"project","url":"\/tutorials\/adaengine\/gamepadinput","estimatedTime":"20min","title":"Gamepad Input","type":"topic","role":"project","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput"},"CF2G-2-2-camera.swift":{"identifier":"CF2G-2-2-camera.swift","fileName":"FirstScene.swift","fileType":"swift","type":"file","highlights":[{"line":5},{"line":6},{"line":7}],"content":["import AdaEngine","","struct FirstScene: Plugin {","    func setup(in app: AppWorlds) {","        let camera = Camera()","        camera.backgroundColor = Color(45 \/ 255, 171 \/ 255, 255 \/ 255, 1)","        app.spawn(bundle: Camera2D(camera: camera))","    }","}"],"syntax":"swift"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Type-of-events":{"kind":"section","url":"\/tutorials\/adaengine\/eventlisteners#Type-of-events","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Type-of-events","title":"Type of events","type":"section","role":"pseudoSymbol","abstract":[{"text":"In this tutorial you will learn about the event listeners system in Ada.","type":"text"},{"text":" ","type":"text"},{"text":"How can you catch events and process them","type":"text"}]},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Create-a-custom-TextRenderer":{"role":"pseudoSymbol","abstract":[{"type":"text","text":"Create a custom "},{"type":"codeVoice","code":"TextRenderer"},{"type":"text","text":" that draws text along a sine wave and ani