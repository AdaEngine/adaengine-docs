{"metadata":{"role":"article","title":"Ada Script Basics","roleHeading":"Article","modules":[{"name":"Ada Script"}]},"abstract":[{"type":"text","text":"Learn the syntax of Ada Script before connecting a script to a scene or ECS"},{"type":"text","text":" "},{"type":"text","text":"world. Ada Script files use the "},{"type":"codeVoice","code":".ada"},{"type":"text","text":" extension. The examples on this page are"},{"type":"text","text":" "},{"type":"text","text":"small pieces you can combine in one file; a game does not need a "},{"type":"codeVoice","code":"main()"},{"type":"text","text":" "},{"type":"text","text":"function. Start with "},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript","isActive":true},{"type":"text","text":" to run a complete system."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptBasics"},"seeAlsoSections":[{"anchor":"Essentials","title":"Essentials","generated":true,"identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLibraries"]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/AdaScripting\/documentation\/AdaScripting"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"A-first-look","text":"A first look","type":"heading"},{"syntax":"ada","code":["\/\/ A class keeps state between calls.","class Counter {","    var value = 0;","","    func increment() {","        value += 1;","        return value;","    }","}","","var counter = Counter();","var first = counter.increment(); \/\/ 1"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"\/\/"},{"type":"text","text":" starts a line comment; "},{"type":"codeVoice","code":"\/* ... *\/"},{"type":"text","text":" surrounds a block comment. Braces"},{"type":"text","text":" "},{"type":"text","text":"delimit blocks. Semicolons can separate statements and are used throughout"},{"type":"text","text":" "},{"type":"text","text":"AdaEngine’s examples. Names are case-sensitive: "},{"type":"codeVoice","code":"Counter"},{"type":"text","text":" and "},{"type":"codeVoice","code":"counter"},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"text","text":"different names."}],"type":"paragraph"},{"level":2,"anchor":"Values-and-basic-types","text":"Values and basic types","type":"heading"},{"inlineContent":[{"text":"Ada Script is dynamically typed. A ","type":"text"},{"code":"var","type":"codeVoice"},{"text":" holds a value, and later assignments","type":"text"},{"text":" ","type":"text"},{"text":"can replace it. Type annotations such as ","type":"text"},{"code":"var score: Int","type":"codeVoice"},{"text":" describe an API and","type":"text"},{"text":" ","type":"text"},{"text":"support tooling. They are enforced only when strict type checking is enabled","type":"text"},{"text":" ","type":"text"},{"text":"for the project or source file; dynamic mode remains the default.","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Example","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"What it represents","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"Bool"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"true"},{"text":", ","type":"text"},{"type":"codeVoice","code":"false"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A condition."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Int"}],"type":"paragraph"}],[{"inlineContent":[{"code":"42","type":"codeVoice"},{"text":", ","type":"text"},{"code":"-3","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"An integer."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Float"}],"type":"paragraph"}],[{"inlineContent":[{"code":"3.5","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A fractional number."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"String"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"\"player\""}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Text."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Null"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"null"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"No value."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"List","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"[10, 20, 30]","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"An indexed sequence, starting at index "},{"type":"codeVoice","code":"0"},{"type":"text","text":"."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Map","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"[\"hp\": 100, \"mp\": 20]","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Values looked up by key. Use ","type":"text"},{"code":"[:]","type":"codeVoice"},{"text":" for an empty map.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Range","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"0..<3","type":"codeVoice"},{"type":"text","text":", "},{"code":"1...3","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"An exclusive or inclusive integer range."}],"type":"paragraph"}]]],"type":"table"},{"syntax":"ada","code":["var name = \"Ada\";","var lives: Int = 3;","var inventory = [\"key\", \"torch\"];","var healthByPlayer = [\"ada\": 100, \"lee\": 80];","","inventory[0] = \"map\";","healthByPlayer[\"ada\"] -= 10;","","const startingLives = 3;"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"const"},{"type":"text","text":" declares a value you do not reassign. A list has a "},{"type":"codeVoice","code":"count"},{"type":"text","text":" property;"},{"type":"text","text":" "},{"type":"text","text":"maps have "},{"type":"codeVoice","code":"keys()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"hasKey(key)"},{"type":"text","text":". A range "},{"code":"0..<3","type":"codeVoice"},{"text":" visits ","type":"text"},{"code":"0","type":"codeVoice"},{"type":"text","text":", "},{"code":"1","type":"codeVoice"},{"type":"text","text":", and"},{"type":"text","text":" "},{"code":"2","type":"codeVoice"},{"type":"text","text":"; "},{"code":"1...3","type":"codeVoice"},{"type":"text","text":" also includes "},{"code":"3","type":"codeVoice"},{"type":"text","text":". Engine types such as "},{"code":"Vector3","type":"codeVoice"},{"type":"text","text":", "},{"code":"Transform","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"Sprite","type":"codeVoice"},{"type":"text","text":" come from registered AdaEngine APIs rather than the basic language"},{"type":"text","text":" "},{"type":"text","text":"types. Values passed to Swift or stored in ECS fields have narrower supported"},{"type":"text","text":" "},{"type":"text","text":"types than arbitrary script values; see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Functions","text":"Functions"},{"type":"paragraph","inlineContent":[{"text":"Declare a function with ","type":"text"},{"code":"func","type":"codeVoice"},{"text":", pass arguments in parentheses, and use","type":"text"},{"text":" ","type":"text"},{"code":"return","type":"codeVoice"},{"text":" to send a value back. A function without an explicit ","type":"text"},{"code":"return","type":"codeVoice"},{"text":" ","type":"text"},{"text":"returns ","type":"text"},{"code":"null","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"ada","code":["func doubled(value) { return value * 2; }","var next = doubled(5); \/\/ 10"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Parameters can have defaults and type annotations:"}]},{"type":"codeListing","syntax":"ada","code":["func addPoints(score: Int, bonus = 10) {","    return score + bonus;","}","","var updated = addPoints(5); \/\/ 15"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Annotations on parameters describe types for tooling; runtime calls still"},{"type":"text","text":" "},{"type":"text","text":"need values of the form the function expects. A helper function is ordinary"},{"type":"text","text":" "},{"type":"text","text":"code. An ECS callback such as "},{"type":"codeVoice","code":"update(context)"},{"type":"text","text":" runs only because its class is"},{"type":"text","text":" "},{"type":"text","text":"registered as a system."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"AdaScript provides "},{"type":"codeVoice","code":"print(...)"},{"type":"text","text":", "},{"type":"codeVoice","code":"put(...)"},{"type":"text","text":", "},{"type":"codeVoice","code":"input(removeTrailingNewline = true)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"nanotime()"},{"type":"text","text":", and "},{"type":"codeVoice","code":"exit(code = 0)"},{"type":"text","text":" as free functions. They forward to the"},{"type":"text","text":" "},{"type":"text","text":"corresponding "},{"type":"codeVoice","code":"System"},{"type":"text","text":" methods. "},{"type":"codeVoice","code":"assert(condition, message = \"Assertion failed\")"},{"text":" ","type":"text"},{"text":"stops the current script with a diagnostic when its condition is false.","type":"text"},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"code":"System","type":"codeVoice"},{"text":" spellings remain available for existing scripts. Avoid ","type":"text"},{"code":"input","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"exit","type":"codeVoice"},{"text":" in game callbacks because they block for console input or terminate","type":"text"},{"text":" ","type":"text"},{"text":"the host process.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"AdaScript also supports "},{"code":"Math.clamp","type":"codeVoice"},{"type":"text","text":", "},{"code":"Math.saturate","type":"codeVoice"},{"type":"text","text":", "},{"code":"Math.addVector","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"Math.subtractVector","type":"codeVoice"},{"type":"text","text":", "},{"code":"Math.scaleVector","type":"codeVoice"},{"type":"text","text":", "},{"code":"Math.dot","type":"codeVoice"},{"type":"text","text":", "},{"code":"Math.cross","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"Math.length","type":"codeVoice"},{"type":"text","text":", "},{"code":"Math.normalize","type":"codeVoice"},{"type":"text","text":", "},{"code":"Math.distance","type":"codeVoice"},{"type":"text","text":", "},{"code":"Math.lerpVector","type":"codeVoice"},{"type":"text","text":", and"},{"type":"text","text":" "},{"code":"Math.clampVector","type":"codeVoice"},{"type":"text","text":". Vectors are lists of numbers;"},{"type":"text","text":" "},{"code":"cross","type":"codeVoice"},{"type":"text","text":" requires three components. Matrices are nonempty lists of equal-length"},{"type":"text","text":" "},{"type":"text","text":"rows. "},{"code":"Math.identityMatrix(size)","type":"codeVoice"},{"type":"text","text":", "},{"code":"transposeMatrix(matrix)","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"multiplyMatrix(left, right)","type":"codeVoice"},{"type":"text","text":", and "},{"code":"transformVector(matrix, vector)","type":"codeVoice"},{"type":"text","text":" use row-major"},{"type":"text","text":" "},{"type":"text","text":"order and treat vectors as columns:"}]},{"code":["var safeHealth = Math.clamp(120, 0, 100); \/\/ 100","var point = [3.0, 4.0, 1.0];","var translation = [[1.0, 0.0, 2.0], [0.0, 1.0, 5.0], [0.0, 0.0, 1.0]];","var moved = Math.transformVector(translation, point); \/\/ [5.0, 9.0, 1.0]"],"syntax":"ada","type":"codeListing"},{"anchor":"Structs-and-classes","level":2,"text":"Structs and classes","type":"heading"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"struct"},{"type":"text","text":" for a small value that should be copied on assignment. Use"},{"type":"text","text":" "},{"type":"codeVoice","code":"class"},{"type":"text","text":" when several names should refer to the same mutable instance."}],"type":"paragraph"},{"code":["struct Point {","    var x = 0;","    var y = 0;","}","","class Player {","    var health = 100;","}","","var point = Point();","var otherPoint = point;","otherPoint.x = 5; \/\/ point.x stays 0","","var player = Player();","var teammate = player;","teammate.health = 80; \/\/ player.health is now 80"],"syntax":"ada","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Classes can inherit from one parent class with "},{"code":"class Child : Parent","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Both kinds of declaration can contain stored properties and methods. A plain"},{"type":"text","text":" "},{"type":"text","text":"script "},{"type":"codeVoice","code":"struct"},{"type":"text","text":" is not automatically an ECS component or resource: use"},{"type":"text","text":" "},{"type":"codeVoice","code":"@component"},{"type":"text","text":" or "},{"type":"codeVoice","code":"@resource"},{"text":" and the supported exported field schema for that.","type":"text"},{"text":" ","type":"text"},{"text":"See ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS"},{"type":"text","text":"."}]},{"type":"heading","level":2,"text":"Static members","anchor":"Static-members"},{"type":"paragraph","inlineContent":[{"text":"An instance member belongs to one object. A ","type":"text"},{"type":"codeVoice","code":"static"},{"type":"text","text":" member belongs to the"},{"type":"text","text":" "},{"type":"text","text":"declaration itself and is accessed through its type name:"}]},{"code":["class Difficulty {","    static var multiplier = 2;","","    static func apply(baseScore) {","        return baseScore * multiplier;","    }","}","","var points = Difficulty.apply(10); \/\/ 20"],"type":"codeListing","syntax":"ada"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use static state sparingly for gameplay. ECS components hold per-entity state,"},{"type":"text","text":" "},{"type":"text","text":"and resources hold shared world state with an explicit lifecycle."}]},{"type":"heading","anchor":"Initialization-and-cleanup","level":2,"text":"Initialization and cleanup"},{"inlineContent":[{"code":"func init(...)","type":"codeVoice"},{"text":" is called when a class or struct instance is created.","type":"text"},{"text":" ","type":"text"},{"code":"func deinit()","type":"codeVoice"},{"text":" runs when a class instance is reclaimed; its timing depends on","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the script runtime, so it is not a reliable place for a gameplay event."}],"type":"paragraph"},{"syntax":"ada","type":"codeListing","code":["class TimerLabel {","    var title;","","    func init(name) {","        title = name;","    }","","    func deinit() {","        System.print(\"TimerLabel released\");","    }","}","","var label = TimerLabel(\"Countdown\");"]},{"inlineContent":[{"type":"text","text":"Neither method receives an ECS "},{"type":"codeVoice","code":"context"},{"type":"text","text":". To initialize a world once, create"},{"type":"text","text":" "},{"type":"text","text":"an "},{"type":"codeVoice","code":"@system(scheduler: \"startup\")"},{"type":"text","text":" class with "},{"type":"codeVoice","code":"update(context)"},{"type":"text","text":". To react to"},{"type":"text","text":" "},{"type":"text","text":"per-entity attachment or detachment, use a "},{"type":"codeVoice","code":"@scriptable"},{"type":"text","text":" class’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"ready(context)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"destroy(context)"},{"text":". There is currently no function-level","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@init"},{"text":" annotation. See ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations"},{"text":" for these lifetimes.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Stored-and-computed-properties","level":2,"text":"Stored and computed properties"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"var"},{"type":"text","text":" inside a type is a stored property. A computed property runs "},{"type":"codeVoice","code":"get"},{"text":" when","type":"text"},{"text":" ","type":"text"},{"text":"read and ","type":"text"},{"code":"set","type":"codeVoice"},{"text":" when assigned. Inside ","type":"text"},{"code":"set","type":"codeVoice"},{"text":", ","type":"text"},{"code":"value","type":"codeVoice"},{"type":"text","text":" is the new value unless"},{"type":"text","text":" "},{"text":"you give the setter parameter another name.","type":"text"}]},{"type":"codeListing","syntax":"ada","code":["class HealthBar {","    private var storedHealth = 100;","","    var health {","        get { return storedHealth; }","        set (newHealth) {","            if (newHealth < 0) {","                storedHealth = 0;","            } else if (newHealth > 100) {","                storedHealth = 100;","            } else {","                storedHealth = newHealth;","            }","        }","    };","}","","var bar = HealthBar();","bar.health = 120;","var visibleHealth = bar.health; \/\/ 100"]},{"inlineContent":[{"text":"A property with only ","type":"text"},{"type":"codeVoice","code":"get"},{"type":"text","text":" is read-only. These accessors are ordinary script"},{"type":"text","text":" "},{"type":"text","text":"behavior. They do not by themselves export an Inspector property or define an"},{"type":"text","text":" "},{"text":"ECS field; ","type":"text"},{"type":"codeVoice","code":"@export"},{"text":" on a supported stored field does that. See","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Conditions-and-loops","text":"Conditions and loops","type":"heading"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"if"},{"type":"text","text":", "},{"type":"codeVoice","code":"else if"},{"text":", and ","type":"text"},{"code":"else","type":"codeVoice"},{"text":" to choose a branch. ","type":"text"},{"code":"&&","type":"codeVoice"},{"text":", ","type":"text"},{"code":"||","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"!","type":"codeVoice"},{"text":" combine","type":"text"},{"text":" ","type":"text"},{"text":"Boolean conditions.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"ada","code":["func healthMessage(health) {","    if (health <= 0) {","        return \"defeated\";","    } else if (health < 25) {","        return \"critical\";","    } else {","        return \"ready\";","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"for (var item in collection)"},{"text":" for a list, range, or ECS query. ","type":"text"},{"code":"while","type":"codeVoice"},{"type":"text","text":" "},{"text":"checks before each iteration; ","type":"text"},{"code":"repeat ... while","type":"codeVoice"},{"text":" checks after one iteration.","type":"text"},{"text":" ","type":"text"},{"code":"break","type":"codeVoice"},{"text":" ends a loop, and ","type":"text"},{"code":"continue","type":"codeVoice"},{"text":" skips to its next iteration.","type":"text"}]},{"type":"codeListing","syntax":"ada","code":["var total = 0;","for (var number in 1...3) {","    total += number; \/\/ 1 + 2 + 3","}","","var attempts = 0;","while (attempts < 3) {","    attempts += 1;","}","","repeat {","    attempts -= 1;","} while (attempts > 0);"]},{"type":"paragraph","inlineContent":[{"code":"switch (value)","type":"codeVoice"},{"type":"text","text":" selects "},{"code":"case","type":"codeVoice"},{"type":"text","text":" branches and an optional "},{"code":"default","type":"codeVoice"},{"type":"text","text":". Add"},{"type":"text","text":" "},{"code":"break","type":"codeVoice"},{"type":"text","text":" to stop at the end of a case when no "},{"type":"codeVoice","code":"return"},{"type":"text","text":" exits it; execution can"},{"type":"text","text":" "},{"type":"text","text":"otherwise continue into the next case."}]},{"code":["func teamName(team) {","    switch (team) {","        case 1:","            return \"blue\";","        case 2:","            return \"red\";","        default:","            return \"unknown\";","    }","}"],"syntax":"ada","type":"codeListing"},{"level":2,"text":"Async functions and `await`","anchor":"Async-functions-and-await","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"type":"codeVoice","code":"async func"},{"text":" may suspend at ","type":"text"},{"type":"codeVoice","code":"await"},{"text":". Awaiting an operation pauses that","type":"text"},{"text":" ","type":"text"},{"text":"script task while the game keeps updating. A synchronous callback starts an","type":"text"},{"text":" ","type":"text"},{"text":"async function with ","type":"text"},{"type":"codeVoice","code":"Tasks.start(...)"},{"text":":","type":"text"}]},{"code":["async func announceLater() {","    await Time.sleep(1.0);","    System.print(\"One game-time second passed\");","}","","@system","class AnnouncementSystem {","    var started = false;","","    func update(context) {","        if (!started) {","            started = true;","            Tasks.start(announceLater());","        }","    }","}"],"syntax":"ada","type":"codeListing"},{"inlineContent":[{"code":"update(context)","type":"codeVoice"},{"text":" and scriptable callbacks remain","type":"text"},{"text":" ","type":"text"},{"text":"synchronous. Do not keep ","type":"text"},{"type":"codeVoice","code":"context"},{"text":", query rows, resource views, or commands","type":"text"},{"text":" ","type":"text"},{"text":"across ","type":"text"},{"type":"codeVoice","code":"await"},{"text":": those values expire when the callback returns. Pass detached","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"values into the task. "},{"type":"codeVoice","code":"Time.sleep"},{"text":" uses game time; ","type":"text"},{"type":"codeVoice","code":"Time.sleepRealTime"},{"text":" uses a","type":"text"},{"text":" ","type":"text"},{"text":"monotonic clock. Read ","type":"text"},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage","isActive":true},{"text":" for asset operations, save","type":"text"},{"text":" ","type":"text"},{"text":"results, cancellation, and task lifetimes.","type":"text"}],"type":"paragraph"},{"text":"Scene navigation","anchor":"Scene-navigation","level":2,"type":"heading"},{"inlineContent":[{"text":"With ","type":"text"},{"type":"codeVoice","code":"ScenePlugin"},{"type":"text","text":" installed, an AdaScript system or scriptable callback can"},{"type":"text","text":" "},{"type":"text","text":"request a level change through its scoped world context:"}],"type":"paragraph"},{"code":["context.world.changeScene(\"@res:\/\/Scenes\/Level02.ascn\");","context.world.reloadScene(); \/\/ Restart after game over."],"syntax":"ada","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Both calls return ","type":"text"},{"code":"Bool","type":"codeVoice"},{"type":"text","text":" to indicate whether the request was accepted. Scene"},{"text":" ","type":"text"},{"text":"loading happens asynchronously, and the prepared scene replaces the old one","type":"text"},{"type":"text","text":" "},{"type":"text","text":"after an update pass. The current scene remains active if loading fails."},{"type":"text","text":" "},{"type":"codeVoice","code":"reloadScene()"},{"type":"text","text":" loads a fresh copy of the active scene, recreating its entities"},{"type":"text","text":" "},{"type":"text","text":"and scene resources. Entities spawned through AdaScript world commands are"},{"type":"text","text":" "},{"type":"text","text":"tracked as part of that scene and removed on reload. Application resources"},{"type":"text","text":" "},{"type":"text","text":"and entities created outside the scene remain available across transitions."},{"type":"text","text":" "},{"type":"text","text":"AdaScript tasks for the outgoing world are canceled and "},{"type":"codeVoice","code":"@system"},{"type":"text","text":" instances"},{"type":"text","text":" "},{"type":"text","text":"are recreated; module globals remain part of the application session."},{"text":" ","type":"text"},{"text":"World contexts expire when their callback returns, so do not retain one in an","type":"text"},{"text":" ","type":"text"},{"text":"async task.","type":"text"}]},{"text":"Annotations","anchor":"Annotations","type":"heading","level":2},{"inlineContent":[{"text":"Annotations begin with ","type":"text"},{"code":"@","type":"codeVoice"},{"text":" and attach metadata to a declaration. They are","type":"text"},{"text":" ","type":"text"},{"text":"AdaEngine features, not ordinary function calls:","type":"text"}],"type":"paragraph"},{"syntax":"ada","type":"codeListing","code":["@component(id: \"game.health\")","struct Health {","    @export var current = 100;","}","","@system(scheduler: \"startup\")","class CreatePlayer {","    func update(context) {","        context.world.spawn([Health(current: 100)]);","    }","}"]},{"inlineContent":[{"type":"codeVoice","code":"@component"},{"type":"text","text":" tells AdaEngine to register data; "},{"type":"codeVoice","code":"@export"},{"type":"text","text":" gives a supported"},{"type":"text","text":" "},{"type":"text","text":"field a default. "},{"type":"codeVoice","code":"@system"},{"type":"text","text":" registers an ECS callback. Other annotations define"},{"type":"text","text":" "},{"type":"text","text":"queries, resources, scriptable behavior, editor tools, and multiplayer"},{"type":"text","text":" "},{"type":"text","text":"messages. Arguments are constants or symbolic identifiers used during module"},{"type":"text","text":" "},{"type":"text","text":"discovery. See "},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","isActive":true},{"type":"text","text":" for their valid targets, arguments,"},{"type":"text","text":" "},{"type":"text","text":"defaults, and limitations."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/adascripting\/adascriptbasics"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"references":{"doc://AdaScripting/documentation/AdaScripting/GettingStartedWithAdaScript":{"title":"Getting Started with Ada Script","abstract":[{"text":"Add an ","type":"text"},{"code":".ada","type":"codeVoice"},{"text":" file to an AdaEngine executable and run its systems without manually loading each script.","type":"text"}],"type":"topic","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript","url":"\/documentation\/adascripting\/gettingstartedwithadascript","kind":"article","role":"article"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptLanguage":{"type":"topic","url":"\/documentation\/adascripting\/adascriptlanguage","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage","title":"Ada Script Language","abstract":[{"text":"Use Ada Script syntax with AdaEngine declaration annotations. New to the","type":"text"},{"text":" ","type":"text"},{"text":"language? Start with ","type":"text"},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptBasics","isActive":true},{"text":" for values, functions, types,","type":"text"},{"text":" ","type":"text"},{"text":"properties, control flow, asynchronous work, and annotations.","type":"text"}],"kind":"article","role":"article"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptAnnotations":{"url":"\/documentation\/adascripting\/adascriptannotations","abstract":[{"type":"text","text":"Choose an annotation by the declaration it describes. Annotation arguments"},{"type":"text","text":" "},{"type":"text","text":"are literals, identifiers, or lists of those values, not runtime expressions."},{"type":"text","text":" "},{"type":"text","text":"The same spelling can have different roles: "},{"type":"codeVoice","code":"@component"},{"type":"text","text":" declares a struct,"},{"type":"text","text":" "},{"type":"text","text":"while "},{"type":"codeVoice","code":"@component(required: true)"},{"type":"text","text":" binds an existing component to a scriptable"},{"type":"text","text":" "},{"type":"text","text":"instance."}],"role":"article","type":"topic","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","title":"Ada Script Annotation Reference","kind":"article"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptECS":{"abstract":[{"type":"text","text":"Declare annotation-driven systems and iterate native AdaECS component columns."}],"title":"Ada Script ECS","type":"topic","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS","kind":"article","url":"\/documentation\/adascripting\/adascriptecs","role":"article"},"doc://AdaScripting/documentation/AdaScripting":{"url":"\/documentation\/adascripting","title":"Ada Script","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting","kind":"symbol","abstract":[{"text":"Write gameplay systems in Ada Script while keeping entity filtering and access planning in AdaEngine’s native ECS.","type":"text"}],"type":"topic","role":"collection"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptBasics":{"title":"Ada Script Basics","abstract":[{"type":"text","text":"Learn the syntax of Ada Script before connecting a script to a scene or ECS"},{"type":"text","text":" "},{"type":"text","text":"world. Ada Script files use the "},{"code":".ada","type":"codeVoice"},{"type":"text","text":" extension. The examples on this page are"},{"type":"text","text":" "},{"type":"text","text":"small pieces you can combine in one file; a game does not need a "},{"code":"main()","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"function. Start with "},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript","isActive":true},{"type":"text","text":" to run a complete system."}],"type":"topic","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptBasics","kind":"article","url":"\/documentation\/adascripting\/adascriptbasics","role":"article"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptLibraries":{"type":"topic","url":"\/documentation\/adascripting\/adascriptlibraries","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLibraries","title":"AdaScript Libraries","abstract":[{"text":"Share reusable AdaScript functions, systems, and scriptable objects through a GitHub repository.","type":"text"},{"text":" ","type":"text"},{"text":"AdaEditor installs the library and its transitive dependencies into the project. Run, Play Mode,","type":"text"},{"text":" ","type":"text"},{"text":"Preview, and ","type":"text"},{"type":"codeVoice","code":"AdaScriptBuildPlugin"},{"text":" load the same installed sources without network access.","type":"text"}],"kind":"article","role":"article"}}}