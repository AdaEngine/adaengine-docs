imationTask: Task<Void, Never>?","","    var body: some View {","        Text(\"Sine Wave\")","            .textRendered(AnimatedSineWaveRenderer(timeOffset: timeOffset))","            .onAppear {","                startAnimation()","            }","            .onDisappear {","                animationTask?.cancel()","                animationTask = nil","            }","    }","","    private func startAnimation() {","        animationTask?.cancel()","        animationTask = Task { @MainActor in","            while !Task.isCancelled {","                timeOffset += 0.12","                try? await Task.sleep(nanoseconds: 16_000_000)","            }","        }","    }","}"],"fileType":"swift","type":"file","highlights":[{"line":13},{"line":14},{"line":15},{"line":16}],"fileName":"ContentView.swift","identifier":"AT-3-3-view.swift","syntax":"swift"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Intro":{"type":"section","url":"\/tutorials\/adaengine\/createfirst2dscene#Intro","kind":"section","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}],"title":"Intro","role":"pseudoSymbol","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Intro"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Create-the-input-system":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Create-the-input-system","kind":"section","url":"\/tutorials\/adaengine\/gamepadinput#Create-the-input-system","abstract":[{"text":"Build a small scene that spawns a player entity and moves it with a gamepad.","type":"text"}],"type":"section","role":"pseudoSymbol","title":"Create the input system"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics#Create-the-app-shell":{"type":"section","url":"\/tutorials\/adaengine\/uibasics#Create-the-app-shell","kind":"section","abstract":[{"type":"text","text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a