aEngine/Create-your-first-2D-game-project.":{"role":"article","kind":"article","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project.","abstract":[],"title":"Create your first 2D game project.","type":"topic","url":"\/tutorials\/adaengine\/create-your-first-2d-game-project."},"doc://AdaEngine/tutorials/AdaEngine/UIBasics#Layout-with-stacks":{"role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Layout-with-stacks","abstract":[{"type":"text","text":"Build a simple UI screen using AdaEngine views. You will create a window, layout a few elements, and add a button with state."}],"title":"Layout with stacks","type":"section","url":"\/tutorials\/adaengine\/uibasics#Layout-with-stacks"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Subscribe-to-scene-events":{"role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Subscribe-to-scene-events","abstract":[{"type":"text","text":"In this tutorial you will learn about the event listeners system in Ada Engine."},{"type":"text","text":" "},{"type":"text","text":"How can you catch events and process them"}],"title":"Subscribe to scene events","type":"section","url":"\/tutorials\/adaengine\/eventlisteners#Subscribe-to-scene-events"},"AT-2-3-renderer.swift":{"syntax":"swift","identifier":"AT-2-3-renderer.swift","content":["import AdaEngine","","struct AnimatedSineWaveRenderer: TextRenderer {","    var timeOffset: Double","","    var animatableData: Double {","        get { timeOffset }","        set { timeOffset = newValue }","    }","","    init(timeOffset: Double) {","        self.timeOffset = timeOffset","    }","","    func draw(layout: Text.Layout, in context: inout UIGraphicsContext) {","        let glyphs = layout.flattenedRuns","        let safeCount = max(glyphs.count, 1)","        let width = layout.first?.typographicBounds.rect.width ?? 1","        let height = layout.first?.typographicBounds.rect.height ?? 1","","        for (index, glyph) in glyphs.enumerated() {","            let offset = sineOffset(","                index: index,","                amplitude: Double(height) * 0.5,","                wavelength: Double(width),","                phase: timeOffset,","                total: safeCount","            )","","            var copy = context","            copy.translateBy(x: 0, y: Float(offset))","            copy.draw(glyph)","        }","    }","","    private func sineOffset(","        index: Int,","        amplitude: Double,","        wavelength: Double,","        phase: Double,","        total: Int","    ) -> Double {","        let x = Double(index)","        let position = (x \/ Double(total)) * wavelength","        let radians = ((position + phase) \/ wavelength) * 2 * .pi","        return Math.sin(radians) * amplitude","    }","}"],"type":"file","fileName":"AnimatedSineWaveRenderer.swift","fileType":"swift","highlights":[{"line":14},{"line":15},{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23},{"line":24},{"line":25},{"line":26},{"line":27},{"line":28},{"line":29},{"line":30},{"line":31},{"line":32},{"line":33},{"line":34},{"line":35},{"line":36},{"line":37},{"line":38},{"line":39},{"line":40},{"line":41},{"line":42},{"line":43},{"line":44},{"line":45},{"line":46},{"line":47}]},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Intro":{"role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Intro","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using AdaEngine."}],"title":"Intro","type":"section","url":"\/tutorials\/adaengine\/createfirst2dscene#Intro"},"AT-2-1-layout.swift":{"syntax":"swift","identifier":"AT-2-1-layout.swift","content":["import AdaEngine","","extension Text.Layout {","    var runs: some RandomAccessCollection<TextRun> {","        flatMap { line in","