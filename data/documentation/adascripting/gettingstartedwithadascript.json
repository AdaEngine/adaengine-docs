le","type":"text"},{"text":" ","type":"text"},{"text":"instance.","type":"text"}],"type":"topic"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptLibraries":{"url":"\/documentation\/adascripting\/adascriptlibraries","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLibraries","role":"article","kind":"article","title":"AdaScript Libraries","abstract":[{"text":"Share reusable AdaScript functions, systems, and scriptable objects through a GitHub repository.","type":"text"},{"text":" ","type":"text"},{"text":"AdaEditor installs the library and its transitive dependencies into the project. Run, Play Mode,","type":"text"},{"text":" ","type":"text"},{"text":"Preview, and ","type":"text"},{"code":"AdaScriptBuildPlugin","type":"codeVoice"},{"text":" load the same installed sources without network access.","type":"text"}],"type":"topic"},"doc://AdaScripting/documentation/AdaScripting":{"role":"collection","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting","url":"\/documentation\/adascripting","type":"topic","abstract":[{"type":"text","text":"Write gameplay systems in Ada Script while keeping entity filtering and access planning in AdaEngine’s native ECS."}],"kind":"symbol","title":"Ada Script"},"doc://AdaScripting/documentation/AdaScripting/GettingStartedWithAdaScript":{"url":"\/documentation\/adascripting\/gettingstartedwithadascript","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript","role":"article","kind":"article","title":"Getting Started with Ada Script","abstract":[{"text":"Add an ","type":"text"},{"code":".ada","type":"codeVoice"},{"text":" file to an AdaEngine executable and run its systems without manually loading each script.","type":"text"}],"type":"topic"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptSource":{"abstract":[{"type":"text","text":"One source file embedded in an Ada Script module."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"k