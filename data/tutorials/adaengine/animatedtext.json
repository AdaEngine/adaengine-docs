first 2D game project.","role":"article","url":"\/tutorials\/adaengine\/create-your-first-2d-game-project.","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project."},"AT-2-1-layout.swift":{"fileType":"swift","identifier":"AT-2-1-layout.swift","content":["import AdaEngine","","extension Text.Layout {","    var runs: some RandomAccessCollection<TextRun> {","        flatMap { line in","            line","        }","    }","","    var flattenedRuns: some RandomAccessCollection<Glyph> {","        runs.flatMap { $0 }","    }","}"],"fileName":"TextLayout+Helpers.swift","highlights":[],"type":"file","syntax":"swift"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Create-an-app":{"kind":"section","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}],"type":"section","url":"\/tutorials\/adaengine\/createfirst2dscene#Create-an-app","role":"pseudoSymbol","title":"Create an app","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-an-app"},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Create-a-custom-TextRenderer":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-a-custom-TextRenderer","url":"\/tutorials\/adaengine\/animatedtext#Create-a-custom-TextRenderer","title":"Create a custom TextRenderer","kind":"section","abstract":[{"text":"Create a custom ","type":"text"},{"code":"TextRenderer","type":"codeVoice"},{"text":" that draws text along a sine wave and animate it by updating renderer state.","type":"text"}],"role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Prepare-layout-helpers":{"type":"section","abstract":[{"type":"text","text":"Create a custom "},{"code":"TextRenderer","type":"codeVoice"},{"type":"text","text":" that draws text along a sine wave and animate it by updating renderer state."}],"kind":"section","title":"Prepare layout helpers","role":"pseudoSymbol","url":"\/t