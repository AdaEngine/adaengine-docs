{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adascripting\/adascriptdiagnosticsandperformance"]}],"seeAlsoSections":[{"anchor":"ECS-Integration","generated":true,"title":"ECS Integration","identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTesting"]}],"sections":[],"metadata":{"role":"article","modules":[{"name":"Ada Script"}],"title":"Ada Script Diagnostics and Performance","roleHeading":"Article"},"kind":"article","abstract":[{"text":"Understand annotation, setup, and runtime failures and keep ECS work on the","type":"text"},{"text":" ","type":"text"},{"text":"native chunk path.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptDiagnosticsAndPerformance","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/AdaScripting\/documentation\/AdaScripting"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Compilation diagnostics","type":"heading","anchor":"Compilation-diagnostics","level":2},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin","isActive":true},{"type":"text","text":" compiles the source and reads declaration metadata"},{"type":"text","text":" "},{"type":"text","text":"without executing a "},{"code":"main()","type":"codeVoice"},{"type":"text","text":" manifest. Initialization throws"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptError\/compilation(_:)","isActive":true},{"type":"text","text":" for syntax or semantic errors and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptError\/invalidManifest(_:)","isActive":true},{"type":"text","text":" for invalid AdaEngine annotations."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Examples include "},{"code":"@system","type":"codeVoice"},{"type":"text","text":" on a non-class declaration, duplicate system"},{"type":"text","text":" "},{"type":"text","text":"identifiers, "},{"code":"@query","type":"codeVoice"},{"type":"text","text":" outside a system class, a query with no fetched"},{"type":"text","text":" "},{"type":"text","text":"components, and a system class that cannot be initialized."}],"type":"paragraph"},{"text":"Setup diagnostics","type":"heading","anchor":"Setup-diagnostics","level":2},{"inlineContent":[{"type":"text","text":"Native component identifiers are resolved during plugin setup so earlier"},{"type":"text","text":" "},{"type":"text","text":"plugins can register game components. Unknown or ambiguous component names skip"},{"type":"text","text":" "},{"type":"text","text":"the affected system and append a diagnostic."}],"type":"paragraph"},{"text":"Runtime diagnostics","type":"heading","anchor":"Runtime-diagnostics","level":2},{"inlineContent":[{"type":"text","text":"Runtime diagnostics include unknown component aliases, unknown fields,"},{"type":"text","text":" "},{"type":"text","text":"unsupported values, invalid numeric conversions, and query capabilities used"},{"type":"text","text":" "},{"type":"text","text":"outside their callback lifetime."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Inspect "},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin\/diagnostics","isActive":true},{"type":"text","text":" after setup and during development."},{"type":"text","text":" "},{"type":"text","text":"System "},{"code":"update(context)","type":"codeVoice"},{"type":"text","text":" callbacks are command-style; their return values are"},{"type":"text","text":" "},{"type":"text","text":"ignored. Tests should assert observable ECS state and diagnostics."}],"type":"paragraph"},{"text":"Performance model","type":"heading","anchor":"Performance-model","level":2},{"inlineContent":[{"type":"text","text":"Ada Script query execution traverses native archetypes and chunks. Component"},{"type":"text","text":" "},{"type":"text","text":"columns are bound once per chunk, and field access advances a typed pointer by"},{"type":"text","text":" "},{"type":"text","text":"row stride. A successful write mutates the component in place and updates its"},{"type":"text","text":" "},{"type":"text","text":"change tick."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The hot path avoids arrays of matched entity identifiers, one Swift bridge"},{"type":"text","text":" "},{"type":"text","text":"object per entity, repeated entity-location lookups, existential component"},{"type":"text","text":" "},{"type":"text","text":"copies, and whole-component reinsertion."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The current embedded C runtime is globally shared and non-reentrant, so runtime entry remains"},{"type":"text","text":" "},{"type":"text","text":"serialized. Scalability comes from native filtering, column iteration, cached"},{"type":"text","text":" "},{"type":"text","text":"metadata, and narrow bridge calls rather than multiple concurrent VMs."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Benchmark scripting changes with multiple archetypes and chunks and compare"},{"type":"text","text":" "},{"type":"text","text":"them with a typed Swift query. Validate semantics before drawing performance"},{"type":"text","text":" "},{"type":"text","text":"conclusions."}],"type":"paragraph"}]}],"references":{"doc://AdaScripting/documentation/AdaScripting/AdaScriptPlugin":{"role":"symbol","kind":"symbol","type":"topic","abstract":[{"text":"Loads an annotation-driven Ada Script module.","type":"text"}],"fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"AdaScriptPlugin","kind":"identifier"}],"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin","url":"\/documentation\/adascripting\/adascriptplugin","title":"AdaScriptPlugin","navigatorTitle":[{"kind":"identifier","text":"AdaScriptPlugin"}]},"doc://AdaScripting/documentation/AdaScripting/AdaScriptTesting":{"url":"\/documentation\/adascripting\/adascripttesting","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTesting","role":"collectionGroup","title":"Testing Ada Script","kind":"article","abstract":[{"text":"Write tests next to your gameplay code, run them with ","type":"text"},{"code":"swift test","type":"codeVoice"},{"text":" or a command, and keep them out of shipped builds.","type":"text"}],"type":"topic"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptError/compilation(_:)":{"url":"\/documentation\/adascripting\/adascripterror\/compilation(_:)","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptError\/compilation(_:)","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"compilation","kind":"identifier"},{"text":"([","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"title":"AdaScriptError.compilation(_:)","kind":"symbol","abstract":[],"type":"topic"},"doc://AdaScripting/documentation/AdaScripting":{"role":"collection","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting","url":"\/documentation\/adascripting","type":"topic","abstract":[{"type":"text","text":"Write gameplay systems in Ada Script while keeping entity filtering and access planning in AdaEngine’s native ECS."}],"kind":"symbol","title":"Ada Script"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptPlugin/diagnostics":{"abstract":[],"kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"diagnostics","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"type":"topic","url":"\/documentation\/adascripting\/adascriptplugin\/diagnostics","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin\/diagnostics","title":"diagnostics","role":"symbol"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptError/invalidManifest(_:)":{"role":"symbol","kind":"symbol","type":"topic","abstract":[],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"invalidManifest","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":")","kind":"text"}],"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptError\/invalidManifest(_:)","url":"\/documentation\/adascripting\/adascripterror\/invalidmanifest(_:)","title":"AdaScriptError.invalidManifest(_:)"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptECS":{"role":"article","kind":"article","type":"topic","abstract":[{"type":"text","text":"Declare annotation-driven systems and iterate native AdaECS component columns."}],"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS","url":"\/documentation\/adascripting\/adascriptecs","title":"Ada Script ECS"}}}