{"sections":[],"kind":"article","seeAlsoSections":[{"generated":true,"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLibraries"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adascripting\/adascriptbasics"]}],"abstract":[{"text":"Learn the syntax of Ada Script before connecting a script to a scene or ECS","type":"text"},{"text":" ","type":"text"},{"text":"world. Ada Script files use the ","type":"text"},{"code":".ada","type":"codeVoice"},{"text":" extension. The examples on this page are","type":"text"},{"text":" ","type":"text"},{"text":"small pieces you can combine in one file; a game does not need a ","type":"text"},{"code":"main()","type":"codeVoice"},{"text":" ","type":"text"},{"text":"function. Start with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript","type":"reference"},{"text":" to run a complete system.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/AdaScripting\/documentation\/AdaScripting"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"A first look","anchor":"A-first-look","type":"heading"},{"syntax":"ada","code":["\/\/ A class keeps state between calls.","class Counter {","    var value = 0;","","    func increment() {","        value += 1;","        return value;","    }","}","","var counter = Counter();","var first = counter.increment(); \/\/ 1"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"\/\/"},{"type":"text","text":" starts a line comment; "},{"type":"codeVoice","code":"\/* ... *\/"},{"type":"text","text":" surrounds a block comment. Braces"},{"type":"text","text":" "},{"type":"text","text":"delimit blocks. Semicolons can separate statements and are used throughout"},{"type":"text","text":" "},{"type":"text","text":"AdaEngine’s examples. Names are case-sensitive: "},{"type":"codeVoice","code":"Counter"},{"type":"text","text":" and "},{"type":"codeVoice","code":"counter"},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"text","text":"different names."}],"type":"paragraph"},{"level":2,"text":"Values and basic types","anchor":"Values-and-basic-types","type":"heading"},{"inlineContent":[{"type":"text","text":"Ada Script is dynamically typed. A "},{"type":"codeVoice","code":"var"},{"type":"text","text":" holds a value, and later assignments"},{"type":"text","text":" "},{"type":"text","text":"can replace it. Type annotations such as "},{"type":"codeVoice","code":"var score: Int"},{"type":"text","text":" describe an API and"},{"type":"text","text":" "},{"type":"text","text":"support tooling. They are enforced only when strict type checking is enabled"},{"type":"text","text":" "},{"type":"text","text":"for the project or source file; dynamic mode remains the default."}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Example"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"What it represents"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Bool","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"true","type":"codeVoice"},{"type":"text","text":", "},{"code":"false","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A condition."}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Int","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"42","type":"codeVoice"},{"type":"text","text":", "},{"code":"-3","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"An integer."}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Float","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"3.5","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A fractional number."}]}]],[[{"type":"paragraph","inlineContent":[{"code":"String","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"\"player\"","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Text."}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Null","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"null","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"No value."}]}]],[[{"type":"paragraph","inlineContent":[{"code":"List","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"[10, 20, 30]","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"An indexed sequence, starting at index "},{"code":"0","type":"codeVoice"},{"type":"text","text":"."}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Map","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"[\"hp\": 100, \"mp\": 20]","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Values looked up by key. Use "},{"code":"[:]","type":"codeVoice"},{"type":"text","text":" for an empty map."}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Range","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"0..<3","type":"codeVoice"},{"type":"text","text":", "},{"code":"1...3","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"An exclusive or inclusive integer range."}]}]]],"header":"row","type":"table"},{"syntax":"ada","code":["var name = \"Ada\";","var lives: Int = 3;","var inventory = [\"key\", \"torch\"];","var healthByPlayer = [\"ada\": 100, \"lee\": 80];","","inventory[0] = \"map\";","healthByPlayer[\"ada\"] -= 10;","","const startingLives = 3;"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"const"},{"type":"text","text":" declares a value you do not reassign. A list has a "},{"type":"codeVoice","code":"count"},{"type":"text","text":" property;"},{"type":"text","text":" "},{"type":"text","text":"maps have "},{"type":"codeVoice","code":"keys()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"hasKey(key)"},{"type":"text","text":". A range "},{"type":"codeVoice","code":"0..<3"},{"type":"text","text":" visits "},{"type":"codeVoice","code":"0"},{"type":"text","text":", "},{"type":"codeVoice","code":"1"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"2"},{"type":"text","text":"; "},{"type":"codeVoice","code":"1...3"},{"type":"text","text":" also includes "},{"type":"codeVoice","code":"3"},{"type":"text","text":". Engine types such as "},{"type":"codeVoice","code":"Vector3"},{"type":"text","text":", "},{"type":"codeVoice","code":"Transform"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"Sprite"},{"type":"text","text":" come from registered AdaEngine APIs rather than the basic language"},{"type":"text","text":" "},{"type":"text","text":"types. Values passed to Swift or stored in ECS fields have narrower supported"},{"type":"text","text":" "},{"type":"text","text":"types than arbitrary script values; see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Functions","anchor":"Functions","type":"heading"},{"inlineContent":[{"type":"text","text":"Declare a function with "},{"type":"codeVoice","code":"func"},{"type":"text","text":", pass arguments in parentheses, and use"},{"type":"text","text":" "},{"type":"codeVoice","code":"return"},{"type":"text","text":" to send a value back. A function without an explicit "},{"type":"codeVoice","code":"return"},{"type":"text","text":" "},{"type":"text","text":"returns "},{"type":"codeVoice","code":"null"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"ada","code":["func doubled(value) { return value * 2; }","var next = doubled(5); \/\/ 10"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Parameters can have defaults and type annotations:"}],"type":"paragraph"},{"syntax":"ada","code":["func addPoints(score: Int, bonus = 10) {","    return score + bonus;","}","","var updated = addPoints(5); \/\/ 15"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Annotations on parameters describe types for tooling; runtime calls still"},{"type":"text","text":" "},{"type":"text","text":"need values of the form the function expects. A helper function is ordinary"},{"type":"text","text":" "},{"type":"text","text":"code. An ECS callback such as "},{"type":"codeVoice","code":"update(context)"},{"type":"text","text":" runs only because its class is"},{"type":"text","text":" "},{"type":"text","text":"registered as a system."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"AdaScript provides "},{"type":"codeVoice","code":"print(...)"},{"type":"text","text":", "},{"type":"codeVoice","code":"put(...)"},{"type":"text","text":", "},{"type":"codeVoice","code":"input(removeTrailingNewline = true)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"nanotime()"},{"type":"text","text":", and "},{"type":"codeVoice","code":"exit(code = 0)"},{"type":"text","text":" as free functions. They forward to the"},{"type":"text","text":" "},{"type":"text","text":"corresponding "},{"type":"codeVoice","code":"System"},{"type":"text","text":" methods. "},{"type":"codeVoice","code":"assert(condition, message = \"Assertion failed\")"},{"type":"text","text":" "},{"type":"text","text":"stops the current script with a diagnostic when its condition is false."},{"type":"text","text":" "},{"type":"text","text":"The "},{"type":"codeVoice","code":"System"},{"type":"text","text":" spellings remain available for existing scripts. Avoid "},{"type":"codeVoice","code":"input"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"exit"},{"type":"text","text":" in game callbacks because they block for console input or terminate"},{"type":"text","text":" "},{"type":"text","text":"the host process."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"AdaScript also supports "},{"type":"codeVoice","code":"Math.clamp"},{"type":"text","text":", "},{"type":"codeVoice","code":"Math.saturate"},{"type":"text","text":", "},{"type":"codeVoice","code":"Math.addVector"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"Math.subtractVector"},{"type":"text","text":", "},{"type":"codeVoice","code":"Math.scaleVector"},{"type":"text","text":", "},{"type":"codeVoice","code":"Math.dot"},{"type":"text","text":", "},{"type":"codeVoice","code":"Math.cross"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"Math.length"},{"type":"text","text":", "},{"type":"codeVoice","code":"Math.normalize"},{"type":"text","text":", "},{"type":"codeVoice","code":"Math.distance"},{"type":"text","text":", "},{"type":"codeVoice","code":"Math.lerpVector"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"Math.clampVector"},{"type":"text","text":". Vectors are lists of numbers;"},{"type":"text","text":" "},{"type":"codeVoice","code":"cross"},{"type":"text","text":" requires three components. Matrices are nonempty lists of equal-length"},{"type":"text","text":" "},{"type":"text","text":"rows. "},{"type":"codeVoice","code":"Math.identityMatrix(size)"},{"type":"text","text":", "},{"type":"codeVoice","code":"transposeMatrix(matrix)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"multiplyMatrix(left, right)"},{"type":"text","text":", and "},{"type":"codeVoice","code":"transformVector(matrix, vector)"},{"type":"text","text":" use row-major"},{"type":"text","text":" "},{"type":"text","text":"order and treat vectors as columns:"}],"type":"paragraph"},{"syntax":"ada","code":["var safeHealth = Math.clamp(120, 0, 100); \/\/ 100","var point = [3.0, 4.0, 1.0];","var translation = [[1.0, 0.0, 2.0], [0.0, 1.0, 5.0], [0.0, 0.0, 1.0]];","var moved = Math.transformVector(translation, point); \/\/ [5.0, 9.0, 1.0]"],"type":"codeListing"},{"level":2,"text":"Structs and classes","anchor":"Structs-and-classes","type":"heading"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"struct"},{"type":"text","text":" for a small value that should be copied on assignment. Use"},{"type":"text","text":" "},{"type":"codeVoice","code":"class"},{"type":"text","text":" when several names should refer to the same mutable instance."}],"type":"paragraph"},{"syntax":"ada","code":["struct Point {","    var x = 0;","    var y = 0;","}","","class Player {","    var health = 100;","}","","var point = Point();","var otherPoint = point;","otherPoint.x = 5; \/\/ point.x stays 0","","var player = Player();","var teammate = player;","teammate.health = 80; \/\/ player.health is now 80"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Classes can inherit from one parent class with "},{"type":"codeVoice","code":"class Child : Parent"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Both kinds of declaration can contain stored properties and methods. A plain"},{"type":"text","text":" "},{"type":"text","text":"script "},{"type":"codeVoice","code":"struct"},{"type":"text","text":" is not automatically an ECS component or resource: use"},{"type":"text","text":" "},{"type":"codeVoice","code":"@component"},{"type":"text","text":" or "},{"type":"codeVoice","code":"@resource"},{"type":"text","text":" and the supported exported field schema for that."},{"type":"text","text":" "},{"type":"text","text":"See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Static members","anchor":"Static-members","type":"heading"},{"inlineContent":[{"type":"text","text":"An instance member belongs to one object. A "},{"type":"codeVoice","code":"static"},{"type":"text","text":" member belongs to the"},{"type":"text","text":" "},{"type":"text","text":"declaration itself and is accessed through its type name:"}],"type":"paragraph"},{"syntax":"ada","code":["class Difficulty {","    static var multiplier = 2;","","    static func apply(baseScore) {","        return baseScore * multiplier;","    }","}","","var points = Difficulty.apply(10); \/\/ 20"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use static state sparingly for gameplay. ECS components hold per-entity state,"},{"type":"text","text":" "},{"type":"text","text":"and resources hold shared world state with an explicit lifecycle."}],"type":"paragraph"},{"level":2,"text":"Initialization and cleanup","anchor":"Initialization-and-cleanup","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"func init(...)"},{"type":"text","text":" is called when a class or struct instance is created."},{"type":"text","text":" "},{"type":"codeVoice","code":"func deinit()"},{"type":"text","text":" runs when a class instance is reclaimed; its timing depends on"},{"type":"text","text":" "},{"type":"text","text":"the script runtime, so it is not a reliable place for a gameplay event."}],"type":"paragraph"},{"syntax":"ada","code":["class TimerLabel {","    var title;","","    func init(name) {","        title = name;","    }","","    func deinit() {","        System.print(\"TimerLabel released\");","    }","}","","var label = TimerLabel(\"Countdown\");"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Neither method receives an ECS "},{"type":"codeVoice","code":"context"},{"type":"text","text":". To initialize a world once, create"},{"type":"text","text":" "},{"type":"text","text":"an "},{"type":"codeVoice","code":"@system(scheduler: \"startup\")"},{"type":"text","text":" class with "},{"type":"codeVoice","code":"update(context)"},{"type":"text","text":". To react to"},{"type":"text","text":" "},{"type":"text","text":"per-entity attachment or detachment, use a "},{"type":"codeVoice","code":"@scriptable"},{"type":"text","text":" class’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"ready(context)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"destroy(context)"},{"type":"text","text":". There is currently no function-level"},{"type":"text","text":" "},{"type":"codeVoice","code":"@init"},{"type":"text","text":" annotation. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations"},{"type":"text","text":" for these lifetimes."}],"type":"paragraph"},{"level":2,"text":"Stored and computed properties","anchor":"Stored-and-computed-properties","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"var"},{"type":"text","text":" inside a type is a stored property. A computed property runs "},{"type":"codeVoice","code":"get"},{"type":"text","text":" when"},{"type":"text","text":" "},{"type":"text","text":"read and "},{"type":"codeVoice","code":"set"},{"type":"text","text":" when assigned. Inside "},{"type":"codeVoice","code":"set"},{"type":"text","text":", "},{"type":"codeVoice","code":"value"},{"type":"text","text":" is the new value unless"},{"type":"text","text":" "},{"type":"text","text":"you give the setter parameter another name."}],"type":"paragraph"},{"syntax":"ada","code":["class HealthBar {","    private var storedHealth = 100;","","    var health {","        get { return storedHealth; }","        set (newHealth) {","            if (newHealth < 0) {","                storedHealth = 0;","            } else if (newHealth > 100) {","                storedHealth = 100;","            } else {","                storedHealth = newHealth;","            }","        }","    };","}","","var bar = HealthBar();","bar.health = 120;","var visibleHealth = bar.health; \/\/ 100"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A property with only "},{"type":"codeVoice","code":"get"},{"type":"text","text":" is read-only. These accessors are ordinary script"},{"type":"text","text":" "},{"type":"text","text":"behavior. They do not by themselves export an Inspector property or define an"},{"type":"text","text":" "},{"type":"text","text":"ECS field; "},{"type":"codeVoice","code":"@export"},{"type":"text","text":" on a supported stored field does that. See"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Conditions and loops","anchor":"Conditions-and-loops","type":"heading"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"if"},{"type":"text","text":", "},{"type":"codeVoice","code":"else if"},{"type":"text","text":", and "},{"type":"codeVoice","code":"else"},{"type":"text","text":" to choose a branch. "},{"type":"codeVoice","code":"&&"},{"type":"text","text":", "},{"type":"codeVoice","code":"||"},{"type":"text","text":", and "},{"type":"codeVoice","code":"!"},{"type":"text","text":" combine"},{"type":"text","text":" "},{"type":"text","text":"Boolean conditions."}],"type":"paragraph"},{"syntax":"ada","code":["func healthMessage(health) {","    if (health <= 0) {","        return \"defeated\";","    } else if (health < 25) {","        return \"critical\";","    } else {","        return \"ready\";","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"for (var item in collection)"},{"type":"text","text":" for a list, range, or ECS query. "},{"type":"codeVoice","code":"while"},{"type":"text","text":" "},{"type":"text","text":"checks before each iteration; "},{"type":"codeVoice","code":"repeat ... while"},{"type":"text","text":" checks after one iteration."},{"type":"text","text":" "},{"type":"codeVoice","code":"break"},{"type":"text","text":" ends a loop, and "},{"type":"codeVoice","code":"continue"},{"type":"text","text":" skips to its next iteration."}],"type":"paragraph"},{"syntax":"ada","code":["var total = 0;","for (var number in 1...3) {","    total += number; \/\/ 1 + 2 + 3","}","","var attempts = 0;","while (attempts < 3) {","    attempts += 1;","}","","repeat {","    attempts -= 1;","} while (attempts > 0);"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"switch (value)"},{"type":"text","text":" selects "},{"type":"codeVoice","code":"case"},{"type":"text","text":" branches and an optional "},{"type":"codeVoice","code":"default"},{"type":"text","text":". Add"},{"type":"text","text":" "},{"type":"codeVoice","code":"break"},{"type":"text","text":" to stop at the end of a case when no "},{"type":"codeVoice","code":"return"},{"type":"text","text":" exits it; execution can"},{"type":"text","text":" "},{"text":"otherwise continue into the next case.","type":"text"}],"type":"paragraph"},{"syntax":"ada","code":["func teamName(team) {","    switch (team) {","        case 1:","            return \"blue\";","        case 2:","            return \"red\";","        default:","            return \"unknown\";","    }","}"],"type":"codeListing"},{"level":2,"text":"Async functions and `await`","anchor":"Async-functions-and-await","type":"heading"},{"inlineContent":[{"text":"An ","type":"text"},{"code":"async func","type":"codeVoice"},{"text":" may suspend at ","type":"text"},{"code":"await","type":"codeVoice"},{"text":". Awaiting an operation pauses that","type":"text"},{"text":" ","type":"text"},{"text":"script task while the game keeps updating. A synchronous callback starts an","type":"text"},{"text":" ","type":"text"},{"text":"async function with ","type":"text"},{"code":"Tasks.start(...)","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"ada","code":["async func announceLater() {","    await Time.sleep(1.0);","    System.print(\"One game-time second passed\");","}","","@system","class AnnouncementSystem {","    var started = false;","","    func update(context) {","        if (!started) {","            started = true;","            Tasks.start(announceLater());","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"code":"update(context)","type":"codeVoice"},{"text":" and scriptable callbacks remain","type":"text"},{"text":" ","type":"text"},{"text":"synchronous. Do not keep ","type":"text"},{"code":"context","type":"codeVoice"},{"text":", query rows, resource views, or commands","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"across "},{"type":"codeVoice","code":"await"},{"type":"text","text":": those values expire when the callback returns. Pass detached"},{"type":"text","text":" "},{"type":"text","text":"values into the task. "},{"type":"codeVoice","code":"Time.sleep"},{"text":" uses game time; ","type":"text"},{"code":"Time.sleepRealTime","type":"codeVoice"},{"text":" uses a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"monotonic clock. Read "},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage","isActive":true},{"type":"text","text":" for asset operations, save"},{"text":" ","type":"text"},{"text":"results, cancellation, and task lifetimes.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Scene navigation","anchor":"Scene-navigation","type":"heading"},{"inlineContent":[{"type":"text","text":"With "},{"type":"codeVoice","code":"ScenePlugin"},{"type":"text","text":" installed, an AdaScript system or scriptable callback can"},{"text":" ","type":"text"},{"text":"request a level change through its scoped world context:","type":"text"}],"type":"paragraph"},{"syntax":"ada","code":["context.world.changeScene(\"@res:\/\/Scenes\/Level02.ascn\");","context.world.reloadScene(); \/\/ Restart after game over."],"type":"codeListing"},{"inlineContent":[{"text":"Both calls return ","type":"text"},{"code":"Bool","type":"codeVoice"},{"text":" to indicate whether the request was accepted. Scene","type":"text"},{"text":" ","type":"text"},{"text":"loading happens asynchronously, and the prepared scene replaces the old one","type":"text"},{"text":" ","type":"text"},{"text":"after an update pass. The current scene remains active if loading fails.","type":"text"},{"text":" ","type":"text"},{"code":"reloadScene()","type":"codeVoice"},{"type":"text","text":" loads a fresh copy of the active scene, recreating its entities"},{"type":"text","text":" "},{"type":"text","text":"and scene resources. Entities spawned through AdaScript world commands are"},{"type":"text","text":" "},{"type":"text","text":"tracked as part of that scene and removed on reload. Application resources"},{"type":"text","text":" "},{"type":"text","text":"and entities created outside the scene remain available across transitions."},{"type":"text","text":" "},{"type":"text","text":"AdaScript tasks for the outgoing world are canceled and "},{"type":"codeVoice","code":"@system"},{"type":"text","text":" instances"},{"type":"text","text":" "},{"type":"text","text":"are recreated; module globals remain part of the application session."},{"type":"text","text":" "},{"type":"text","text":"World contexts expire when their callback returns, so do not retain one in an"},{"type":"text","text":" "},{"type":"text","text":"async task."}],"type":"paragraph"},{"level":2,"text":"Annotations","anchor":"Annotations","type":"heading"},{"inlineContent":[{"text":"Annotations begin with ","type":"text"},{"code":"@","type":"codeVoice"},{"text":" and attach metadata to a declaration. They are","type":"text"},{"text":" ","type":"text"},{"text":"AdaEngine features, not ordinary function calls:","type":"text"}],"type":"paragraph"},{"code":["@component(id: \"game.health\")","struct Health {","    @export var current = 100;","}","","@system(scheduler: \"startup\")","class CreatePlayer {","    func update(context) {","        context.world.spawn([Health(current: 100)]);","    }","}"],"syntax":"ada","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@component"},{"type":"text","text":" tells AdaEngine to register data; "},{"type":"codeVoice","code":"@export"},{"type":"text","text":" gives a supported"},{"type":"text","text":" "},{"type":"text","text":"field a default. "},{"code":"@system","type":"codeVoice"},{"type":"text","text":" registers an ECS callback. Other annotations define"},{"type":"text","text":" "},{"type":"text","text":"queries, resources, scriptable behavior, editor tools, and multiplayer"},{"type":"text","text":" "},{"type":"text","text":"messages. Arguments are constants or symbolic identifiers used during module"},{"type":"text","text":" "},{"type":"text","text":"discovery. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations"},{"type":"text","text":" for their valid targets, arguments,"},{"type":"text","text":" "},{"type":"text","text":"defaults, and limitations."}]}]}],"metadata":{"title":"Ada Script Basics","modules":[{"name":"Ada Script"}],"roleHeading":"Article","role":"article"},"identifier":{"url":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptBasics","interfaceLanguage":"swift"},"references":{"doc://AdaScripting/documentation/AdaScripting/AdaScriptAnnotations":{"title":"Ada Script Annotation Reference","abstract":[{"type":"text","text":"Choose an annotation by the declaration it describes. Annotation arguments"},{"type":"text","text":" "},{"type":"text","text":"are literals, identifiers, or lists of those values, not runtime expressions."},{"type":"text","text":" "},{"type":"text","text":"The same spelling can have different roles: "},{"code":"@component","type":"codeVoice"},{"type":"text","text":" declares a struct,"},{"type":"text","text":" "},{"type":"text","text":"while "},{"code":"@component(required: true)","type":"codeVoice"},{"type":"text","text":" binds an existing component to a scriptable"},{"type":"text","text":" "},{"type":"text","text":"instance."}],"role":"article","type":"topic","url":"\/documentation\/adascripting\/adascriptannotations","kind":"article","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptBasics":{"title":"Ada Script Basics","abstract":[{"type":"text","text":"Learn the syntax of Ada Script before connecting a script to a scene or ECS"},{"type":"text","text":" "},{"type":"text","text":"world. Ada Script files use the "},{"code":".ada","type":"codeVoice"},{"type":"text","text":" extension. The examples on this page are"},{"type":"text","text":" "},{"type":"text","text":"small pieces you can combine in one file; a game does not need a "},{"code":"main()","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"function. Start with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript"},{"type":"text","text":" to run a complete system."}],"role":"article","type":"topic","url":"\/documentation\/adascripting\/adascriptbasics","kind":"article","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptBasics"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptECS":{"title":"Ada Script ECS","abstract":[{"type":"text","text":"Declare annotation-driven systems and iterate native AdaECS component columns."}],"role":"article","type":"topic","url":"\/documentation\/adascripting\/adascriptecs","kind":"article","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptLibraries":{"title":"AdaScript Libraries","abstract":[{"type":"text","text":"Share reusable AdaScript functions, systems, and scriptable objects through a GitHub repository."},{"type":"text","text":" "},{"type":"text","text":"AdaEditor installs the library and its transitive dependencies into the project. Run, Play Mode,"},{"type":"text","text":" "},{"type":"text","text":"Preview, and "},{"code":"AdaScriptBuildPlugin","type":"codeVoice"},{"type":"text","text":" load the same installed sources without network access."}],"role":"article","type":"topic","url":"\/documentation\/adascripting\/adascriptlibraries","kind":"article","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLibraries"},"doc://AdaScripting/documentation/AdaScripting":{"title":"Ada Script","abstract":[{"type":"text","text":"Write gameplay systems in Ada Script while keeping entity filtering and access planning in AdaEngine’s native ECS."}],"role":"collection","type":"topic","url":"\/documentation\/adascripting","kind":"symbol","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptLanguage":{"title":"Ada Script Language","abstract":[{"type":"text","text":"Use Ada Script syntax with AdaEngine declaration annotations. New to the"},{"type":"text","text":" "},{"type":"text","text":"language? Start with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptBasics"},{"type":"text","text":" for values, functions, types,"},{"type":"text","text":" "},{"type":"text","text":"properties, control flow, asynchronous work, and annotations."}],"role":"article","type":"topic","url":"\/documentation\/adascripting\/adascriptlanguage","kind":"article","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage"},"doc://AdaScripting/documentation/AdaScripting/GettingStartedWithAdaScript":{"title":"Getting Started with Ada Script","abstract":[{"type":"text","text":"Add an "},{"code":".ada","type":"codeVoice"},{"type":"text","text":" file to an AdaEngine executable and run its systems without manually loading each script."}],"role":"article","type":"topic","url":"\/documentation\/adascripting\/gettingstartedwithadascript","kind":"article","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript"}}}