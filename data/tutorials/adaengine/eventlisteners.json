nce":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Add-a-button-and-state"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Debug-overlays"}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics"},{"sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-the-view","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Prepare-layout-helpers","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-a-custom-TextRenderer","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Apply-and-animate","kind":"task"}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText"},{"sections":[{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Set-up-the-world"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Create-the-input-system"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Read-buttons"},{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Move-and-rumble"}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput"}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UI-and-Input"}],"paths":[["doc:\/\/AdaEngine\/tutorials\/AdaEngine","doc:\/\/AdaEngine\/tutorials\/AdaEngine\/$volume","doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project."]],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners"},"variants":[{"paths":["\/tutorials\/adaengine\/eventlisteners"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"category":"Ada","role":"project","categoryPathComponent":"AdaEngine","title":"Event Listeners in Ada"},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[{"kind":"hero","estimatedTimeInMinutes":5,"chapter":"Create your first 2D game project.","title":"Event Listeners in Ada","xcodeRequirement":"Xcode 26.2 or later","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In this tutorial you will learn about the event listeners system in Ada."},{"type":"text","text":" "},{"type":"text","text":"How can you catch events and process them"}]}]},{"tasks":[{"stepsSection":[],"title":"Base of Event-Subscriber pattern","contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Event listeners in Ada are built on the Observer pattern."},{"type":"text","text":" "},{"type":"text","text":"Its main concept is based on the fact that there is a certain Subject that can send any events."},{"type":"text","text":" "},{"type":"text","text":"And there is an Observer that can receive and process this event."},{"type":"text","text":" "},{"type":"text","text":"In addition, Observer “subscribes” to events, as if you had subscribed to your favorite blog or magazine - as soon as an event occurs, Observer immediately knows about it."}]}],"kind":"contentAndMedia","mediaPosition":"trailing","media":"EL-1.jpg"}],"anchor":"Base-of-Event-Subscriber-pattern"},{"contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"inlineContent":[{"type":"text","text":"Having understood how the Observer pattern works, let’s look at how to subscribe to scene events using the Plugin pattern."}],"type":"paragraph"}]}],"stepsSection":[{"code":"EL-2-1-scene.swift","runtimePreview":null,"type":"step","caption":[],"content":[{"inlineContent":[{"text":"Let’s say we have a plugin in which we would like to listen to some events.","type":"text"}],"type":"paragraph"}],"media":null},{"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"First of all, to control subscription\/unsubscription to events and for proper memory management, we must create a "},{"type":"codeVoice","code":"disposeBag"},{"type":"text","text":" using the "},{"type":"codeVoice","code":"@Local"},{"type":"text","text":" property wrapper."},{"text":" ","type":"text"},{"text":"We also mark our plugin with ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" to ensure thread safety."}]}],"caption":[],"type":"step","media":null,"code":"EL-2-2-scene.swift"},{"media":null,"runtimePreview":null,"code":"EL-2-3-scene.swift","content":[{"type":"paragraph","inlineContent":[{"text":"After that, in the ","type":"text"},{"type":"codeVoice","code":"setup(in:)"},{"text":" method you can call some code to subscribe to the event.","type":"text"},{"type":"text","text":" "},{"text":"The ","type":"text"},{"type":"codeVoice","code":"app.main.subscribe"},{"text":" method helps with this.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"When an event is triggered, our listener subscribes to it and in the callback we can process our event."}]}],"caption":[],"type":"step"}],"anchor":"Subscribe-to-scene-events","title":"Subscribe to scene events"},{"stepsSection":[{"media":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"In the previous section, we saw the ","type":"text"},{"type":"codeVoice","code":"SceneEvents.OnReady"},{"text":" event.","type":"text"},{"text":" ","type":"text"},{"text":"Ada has several available events that you can handle.","type":"text"},{"text":" ","type":"text"},{"text":"For example, you can find out what state your current game scene is in.","type":"text"},{"text":" ","type":"text"},{"text":"You can add your own additional logic when any built-in event occurs.","type":"text"}]}],"caption":[],"runtimePreview":null,"code":"EL-2-3-scene.swift"},{"media":null,"type":"step","content":[{"inlineContent":[{"text":"Here, as an example, are some built-in events that may be useful to you.","type":"text"},{"text":" ","type":"text"},{"text":"Familiar scene events and new collision events.","type":"text"}],"type":"paragraph"}],"caption":[],"runtimePreview":null,"code":"EL-2-4-events.swift"}],"contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"inlineContent":[{"type":"text","text":"What events can we use? Let’s look at a couple of code examples in Ada."}],"type":"paragraph"}]}],"anchor":"Type-of-events","title":"Type of events"},{"anchor":"Additional-for-physics","title":"Additional for physics","contentSection":[{"kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Additional information for handling physics in a game engine."},{"type":"text","text":" "},{"type":"text","text":"With the "},{"code":"physicsWorld2D","type":"codeVoice"},{"text":" component you can control the physics settings for any objects in our game.","type":"text"},{"text":" ","type":"text"},{"text":"For example, you can set the gravity to zero for the scene creation event.","type":"text"}]}],"mediaPosition":"trailing"}],"stepsSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Let’s continue with the example we looked at earlier."},{"type":"text","text":" "},{"type":"text","text":"We can access our event and assign the necessary parameters to the properties of the physical component."},{"type":"text","text":" "},{"type":"text","text":"Note that we use "},{"type":"codeVoice","code":"Task { @MainActor in ... }"},{"type":"text","text":" to ensure we’re on the main actor when modifying physics properties."}]}],"code":"EL-2-5-physics.swift","type":"step","caption":[],"media":null,"runtimePreview":null}]}],"kind":"tasks"},{"featuredEyebrow":"Tutorial","action":{"overridingTitle":"Get started","overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"type":"reference","isActive":true,"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics"},"title":"UI Basics","kind":"callToAction","abstract":[{"text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state.","type":"text"}]}],"kind":"project","references":{"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Create-a-custom-TextRenderer":{"url":"\/tutorials\/adaengine\/animatedtext#Create-a-custom-TextRenderer","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-a-custom-TextRenderer","abstract":[{"text":"Create a custom ","type":"text"},{"code":"TextRenderer","type":"codeVoice"},{"text":" that draws text along a sine wave and animate it by updating renderer state.","type":"text"}],"role":"pseudoSymbol","type":"section","kind":"section","title":"Create a custom TextRenderer"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene":{"role":"project","title":"Create your first 2D scene","kind":"project","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene","estimatedTime":"20min","abstract":[{"text":"In this tutorial, you will learn how to create your first 2D scene using Ada.","type":"text"}],"url":"\/tutorials\/adaengine\/createfirst2dscene","type":"topic"},"EL-2-2-scene.swift":{"fileName":"EventListenerPlugin.swift","content":["import AdaEngine","","@MainActor","struct EventListenerPlugin: Plugin {","    @Local var disposeBag: Set<AnyCancellable> = []","","    func setup(in _: borrowing AppWorlds) {","","    }","}"],"identifier":"EL-2-2-scene.swift","highlights":[{"line":3},{"line":5},{"line":6}],"type":"file","syntax":"swift","fileType":"swift"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Make-it-move":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Make-it-move","title":"Make it move","url":"\/tutorials\/adaengine\/createfirst2dscene#Make-it-move","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}],"kind":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Prepare-layout-helpers":{"role":"pseudoSymbol","title":"Prepare layout helpers","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEn