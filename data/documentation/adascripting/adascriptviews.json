{"abstract":[{"text":"Declare native AdaUI view trees in ","type":"text"},{"code":".ada","type":"codeVoice"},{"text":" files and preview them directly in AdaEditor.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"roleHeading":"Article","role":"article","title":"AdaUI Views in Ada Script","modules":[{"name":"Ada Script"}]},"hierarchy":{"paths":[["doc:\/\/AdaScripting\/documentation\/AdaScripting"]]},"kind":"article","identifier":{"url":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptViews","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adascripting\/adascriptviews"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Declare a view","anchor":"Declare-a-view","type":"heading"},{"inlineContent":[{"type":"text","text":"Annotate a class with "},{"type":"codeVoice","code":"@view"},{"type":"text","text":". The build plugin derives its runtime identity"},{"type":"text","text":" "},{"type":"text","text":"from the Swift module and class name, humanizes the class name for AdaEditor,"},{"type":"text","text":" "},{"type":"text","text":"and emits a typed accessor. Use "},{"type":"codeVoice","code":"id"},{"type":"text","text":" or "},{"type":"codeVoice","code":"title"},{"type":"text","text":" only when an explicit override"},{"type":"text","text":" "},{"type":"text","text":"is required."}],"type":"paragraph"},{"syntax":"ada","code":["@previewable","@view","class WelcomeView {","    @state var message = \"Hello from Ada Script\";","    @environment(colorScheme) var colorScheme;","","    func body() {","        VStack(spacing: 12) {","            Text(message).fontSize(28);","            Text(\"Appearance: \" + colorScheme);","            HStack {","                Text(\"Native AdaUI\");","                Spacer();","            }","            Button(\"Change message\") {","                message = \"State updated\";","            };","        }","        .padding(24)","        .background(\"#20232aff\");","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"body()"},{"type":"text","text":" is an implicit view-builder context. AdaEngine lowers its declarative"},{"type":"text","text":" "},{"type":"text","text":"expressions into the same native "},{"type":"codeVoice","code":"View"},{"type":"text","text":" graph used by Swift declarations. It"},{"type":"text","text":" "},{"type":"text","text":"does not use an immediate-mode drawing callback or retain live ECS pointers."}],"type":"paragraph"},{"level":2,"text":"Show a registered view","anchor":"Show-a-registered-view","type":"heading"},{"inlineContent":[{"code":"AdaScriptBuildPlugin","type":"codeVoice"},{"type":"text","text":" embeds "},{"code":".ada","type":"codeVoice"},{"type":"text","text":" files and registers their "},{"code":"@view","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"declarations from "},{"code":"AdaScriptPluginsGenerated","type":"codeVoice"},{"type":"text","text":". Use the generated typed accessor"},{"type":"text","text":" "},{"type":"text","text":"in a Swift window or another AdaUI hierarchy:"}],"type":"paragraph"},{"syntax":"swift","code":["WindowGroup {","    AdaScriptViewsGenerated.welcomeView","}",".addPlugins(AdaScriptPluginsGenerated())"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The first view slice supports "},{"code":"Text","type":"codeVoice"},{"type":"text","text":", "},{"code":"VStack","type":"codeVoice"},{"type":"text","text":", "},{"code":"HStack","type":"codeVoice"},{"type":"text","text":", "},{"code":"ZStack","type":"codeVoice"},{"type":"text","text":", "},{"code":"Spacer","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"Divider","type":"codeVoice"},{"type":"text","text":", and "},{"code":"EmptyView","type":"codeVoice"},{"type":"text","text":". Container children are collected implicitly by the"},{"type":"text","text":" "},{"code":"body()","type":"codeVoice"},{"type":"text","text":" view builder. Available modifiers are"},{"type":"text","text":" "},{"code":".padding","type":"codeVoice"},{"type":"text","text":", "},{"code":".frame","type":"codeVoice"},{"type":"text","text":", "},{"code":".fontSize","type":"codeVoice"},{"type":"text","text":", "},{"code":".foregroundColor","type":"codeVoice"},{"type":"text","text":", "},{"code":".background","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":".opacity","type":"codeVoice"},{"type":"text","text":", and "},{"code":".accessibilityIdentifier","type":"codeVoice"},{"type":"text","text":". Colors accept common names or"},{"type":"text","text":" "},{"type":"codeVoice","code":"#RRGGBB"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"#RRGGBBAA"},{"type":"text","text":" strings."}],"type":"paragraph"},{"level":2,"text":"State and environment","anchor":"State-and-environment","type":"heading"},{"inlineContent":[{"text":"Declare view-owned values with ","type":"text"},{"type":"codeVoice","code":"@state"},{"text":". The script view instance remains alive","type":"text"},{"type":"text","text":" "},{"text":"while its AdaUI identity remains alive. A ","type":"text"},{"type":"codeVoice","code":"Button"},{"text":" action mutates that same","type":"text"},{"text":" ","type":"text"},{"text":"instance, reevaluates ","type":"text"},{"code":"body()","type":"codeVoice"},{"type":"text","text":", and invalidates the native view subtree."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"@environment(key)","type":"codeVoice"},{"text":" to bind a read-only AdaUI environment value before each","type":"text"},{"text":" ","type":"text"},{"text":"evaluation. The current keys are ","type":"text"},{"code":"colorScheme","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isEnabled","type":"codeVoice"},{"type":"text","text":", "},{"code":"scaleFactor","type":"codeVoice"},{"type":"text","text":", and"},{"type":"text","text":" "},{"code":"userInterfaceIdiom","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The intended two-way child-view syntax is "},{"code":"@binding var value;","type":"codeVoice"},{"type":"text","text":" with "},{"code":"$value","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"at the call site. Nested script-view parameters are not implemented in this"},{"type":"text","text":" "},{"type":"text","text":"slice, so "},{"code":"@binding","type":"codeVoice"},{"type":"text","text":" currently produces a compile-time diagnostic instead of a"},{"type":"text","text":" "},{"type":"text","text":"silently disconnected value."}]},{"type":"heading","anchor":"Preview-in-AdaEditor","level":2,"text":"Preview in AdaEditor"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add "},{"code":"@previewable","type":"codeVoice"},{"type":"text","text":" to an "},{"code":"@view","type":"codeVoice"},{"type":"text","text":" class that should be an AdaEditor Preview entry"},{"type":"text","text":" "},{"type":"text","text":"point. Runtime-only views remain plain "},{"code":"@view","type":"codeVoice"},{"type":"text","text":" declarations and do not clutter"},{"type":"text","text":" "},{"type":"text","text":"the Preview list."}]},{"syntax":"ada","type":"codeListing","code":["@previewable(title: \"Welcome – Dark\")","@view","class WelcomeDarkPreview {","    func body() {","        Text(\"Welcome preview\").background(\"#20232aff\");","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"title","type":"codeVoice"},{"text":" argument is optional; AdaEditor otherwise uses ","type":"text"},{"code":"@view(title:)","type":"codeVoice"},{"type":"text","text":" or a"},{"type":"text","text":" "},{"type":"text","text":"humanized class name. "},{"code":"@previewable","type":"codeVoice"},{"text":" without ","type":"text"},{"code":"@view","type":"codeVoice"},{"text":", duplicate annotations, and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"non-string titles produce compile-time diagnostics."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a "},{"code":".ada","type":"codeVoice"},{"type":"text","text":" file is open, AdaEditor lists its "},{"code":"@previewable","type":"codeVoice"},{"type":"text","text":" declarations,"},{"type":"text","text":" "},{"type":"text","text":"gathers the target’s "},{"code":".ada","type":"codeVoice"},{"type":"text","text":" sources, substitutes the current unsaved document,"},{"type":"text","text":" "},{"type":"text","text":"evaluates the selected view, and mounts the resulting native AdaUI tree in the"},{"type":"text","text":" "},{"type":"text","text":"Preview panel."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Preview actions and state use the same persistent instance path as runtime"},{"text":" ","type":"text"},{"text":"views. Cross-view bindings and state migration across source generations remain","type":"text"},{"text":" ","type":"text"},{"text":"follow-up work.","type":"text"}]}]}],"sections":[],"references":{"doc://AdaScripting/documentation/AdaScripting":{"role":"collection","type":"topic","kind":"symbol","url":"\/documentation\/adascripting","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting","title":"Ada Script","abstract":[{"type":"text","text":"Write gameplay systems in Ada Script while keeping entity filtering and access planning in AdaEngine’s native ECS."}]}}}