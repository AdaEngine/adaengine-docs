{"kind":"symbol","relationshipsSections":[{"title":"Inherits From","kind":"relationships","type":"inheritsFrom","identifiers":["doc:\/\/AdaRender\/documentation\/AdaRender\/Material"]},{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/AdaAssets\/documentation\/AdaAssets\/Asset","doc:\/\/AdaRender\/SQ","doc:\/\/AdaRender\/SH","doc:\/\/AdaRender\/s8SendableP","doc:\/\/AdaRender\/s16SendableMetatypeP"]}],"sections":[],"variants":[{"paths":["\/documentation\/adarender\/custommaterial"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"@propertyWrapper","kind":"attribute"},{"text":" ","kind":"text"},{"text":"@dynamicMemberLookup","kind":"attribute"},{"text":" ","kind":"text"},{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CustomMaterial","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"ReflectedMaterial","preciseIdentifier":"s:9AdaRender17ReflectedMaterialP","kind":"typeIdentifier","identifier":"doc:\/\/AdaRender\/documentation\/AdaRender\/ReflectedMaterial"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"inlineContent":[{"text":"It’s very powerful tool for creating your own materials using power of Swift.","type":"text"},{"text":" ","type":"text"},{"text":"You can declare any materials and describe what kind of values can be used in your shader.","type":"text"},{"text":" ","type":"text"},{"text":"Like example, we can define our custom canvas material.","type":"text"}],"type":"paragraph"},{"code":["struct MyCanvasMaterial: CanvasMaterial {","","    \/\/ Bind color with u_Color uniform value in 