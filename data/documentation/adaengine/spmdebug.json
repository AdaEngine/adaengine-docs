{"hierarchy":{"paths":[["doc:\/\/AdaEngine\/documentation\/AdaEngine"]]},"kind":"article","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adaengine\/spmdebug"]}],"metadata":{"title":"Known issues and how to debug SPM targets","modules":[{"name":"AdaEngine"}],"role":"article","roleHeading":"Article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/SPMDebug"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Xcode-Instruments-Required-kernel-recording-resources-are-in-use-by-another-document","text":"Xcode Instruments: “Required kernel recording resources are in use by another document”"},{"inlineContent":[{"type":"text","text":"When profiling an SPM project (without an xcodeproj) in Instruments, you may see a message about kernel recording resources being in use, even when no other Instruments documents are open."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Cause:","type":"text"}],"type":"strong"},{"type":"text","text":" The message is misleading. The real cause is that the binary does not have the "},{"code":"get-task-allow","type":"codeVoice"},{"text":" entitlement. SPM does not distinguish between “release” and “profiling,” so profiling uses a release build without this entitlement.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Solution:"}],"type":"strong"},{"type":"text","text":" Re-sign the binary with the "},{"code":"get-task-allow","type":"codeVoice"},{"type":"text","text":" entitlement before launching Instruments."}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Open your scheme (Cmd-Shift-,)."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"type":"text","text":"Profile → Pre-actions"}]},{"text":", add a Pre-action.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Set the shell to "},{"type":"codeVoice","code":"\/bin\/zsh"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Paste the re-sign script below (the ","type":"text"},{"code":"=(...)","type":"codeVoice"},{"text":" syntax is zsh process substitution):","type":"text"}]}]}]},{"syntax":"zsh","type":"codeListing","code":["# For Instruments, re-sign binary with get-task-allow entitlement","codesign -s - -v -f --entitlements =(echo -n '<?xml version=\"1.0\" encoding=\"UTF-8\"?>","<!DOCTYPE plist PUBLIC \"-\/\/Apple\/\/DTD PLIST 1.0\/\/EN\" \"https:\/\/www.apple.com\/DTDs\/PropertyList-1.0.dtd\">","<plist version=\"1.0\">","    <dict>","        <key>com.apple.security.get-task-allow<\/key>","        <true\/>","    <\/dict>","<\/plist>') ${TARGET_BUILD_DIR}\/${PRODUCT_NAME}"]},{"inlineContent":[{"text":"See also: ","type":"text"},{"isActive":true,"identifier":"https:\/\/cocoaphony.micro.blog\/2022\/10\/29\/solving-required-kernel.html","type":"reference"},{"text":" (Rob Napier).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The script is stored in "},{"type":"codeVoice","code":".swiftpm\/xcode\/xcshareddata\/xcschemes\/<schemename>.xcscheme"},{"type":"text","text":". The pre-action runs only for Profile, so it does not affect normal builds."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Note:","type":"text"}]},{"type":"text","text":" Pre-action scripts do not receive "},{"type":"codeVoice","code":"SRCROOT"},{"type":"text","text":"; if the script fails, Xcode will not show details—check Console.app for logs."}],"type":"paragraph"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://AdaEngine/documentation/AdaEngine":{"role":"collection","title":"AdaEngine","url":"\/documentation\/adaengine","abstract":[{"text":"Bringing simple and powerful game engine for your awesome games.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine","type":"topic"},"https://cocoaphony.micro.blog/2022/10/29/solving-required-kernel.html":{"titleInlineContent":[{"type":"text","text":"Solving “Required kernel recording resources…” in Instruments"}],"type":"link","url":"https:\/\/cocoaphony.micro.blog\/2022\/10\/29\/solving-required-kernel.html","identifier":"https:\/\/cocoaphony.micro.blog\/2022\/10\/29\/solving-required-kernel.html","title":"Solving “Required kernel recording resources…” in Instruments"}}}