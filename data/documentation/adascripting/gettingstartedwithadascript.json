{"hierarchy":{"paths":[["doc:\/\/AdaScripting\/documentation\/AdaScripting"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript"},"abstract":[{"type":"text","text":"Add an "},{"code":".ada","type":"codeVoice"},{"type":"text","text":" file to an AdaEngine executable and run its systems without manually loading each script."}],"kind":"article","variants":[{"paths":["\/documentation\/adascripting\/gettingstartedwithadascript"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"article","roleHeading":"Article","title":"Getting Started with Ada Script","modules":[{"name":"Ada Script"}]},"sections":[],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"AdaEngine provides two ways to install Ada Script plugins:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Automatic discovery","type":"text"}]},{"type":"text","text":" embeds every "},{"code":".ada","type":"codeVoice"},{"type":"text","text":" file in an executable target at"},{"type":"text","text":" "},{"type":"text","text":"build time and generates one plugin backed by one target-level script module."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Manual loading","type":"text"}]},{"type":"text","text":" creates an "},{"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin","type":"reference","isActive":true},{"type":"text","text":" from source text or a file URL at runtime."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"AdaEditor-created projects use automatic discovery. Use manual loading when scripts live outside the Swift target, come from a downloaded package, or need explicit error handling.","type":"text"}],"type":"paragraph"},{"anchor":"Create-a-script","level":2,"text":"Create a script","type":"heading"},{"inlineContent":[{"text":"Add ","type":"text"},{"type":"codeVoice","code":"Movement.ada"},{"text":" anywhere below the executable target’s source directory, for example:","type":"text"}],"type":"paragraph"},{"syntax":"text","code":["Sources\/MyGame\/","├── main.swift","└── Scripts\/","    └── Movement.ada"],"type":"codeListing"},{"inlineContent":[{"text":"Declare a system and its query with annotations:","type":"text"}],"type":"paragraph"},{"syntax":"ada","code":["@system(scheduler: \"update\")","class MovementSystem {","    @query(Transform)","    var transforms;","","    func update(context) {","        for (var entity in transforms) {","            var position = entity.transform.position;","            position[0] += 100 * context.deltaTime;","            entity.transform.position = position;","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"AdaEngine discovers ","type":"text"},{"type":"codeVoice","code":"@system"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"@query"},{"text":" metadata and calls ","type":"text"},{"type":"codeVoice","code":"update(context)"},{"text":" whenever the selected scheduler runs.","type":"text"}],"type":"paragraph"},{"anchor":"Enable-automatic-discovery","level":2,"text":"Enable automatic discovery","type":"heading"},{"inlineContent":[{"text":"Expose ","type":"text"},{"type":"codeVoice","code":"AdaScriptBuildPlugin"},{"text":" to your executable target in ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ swift-tools-version: 6.2","import PackageDescription","","let package = Package(","    name: \"MyGame\",","    platforms: [","        .macOS(.v15)","    ],","    dependencies: [","        .package(","            url: \"https:\/\/github.com\/AdaEngine\/AdaEngine.git\",","            branch: \"main\"","        )","    ],","    targets: [","        .executableTarget(","            name: \"MyGame\",","            dependencies: [","                .product(name: \"AdaEngine\", package: \"AdaEngine\")","            ],","            plugins: [","                .plugin(name: \"AdaScriptBuildPlugin\", package: \"AdaEngine\")","            ]","        )","    ]",")"],"type":"codeListing"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Choose a version requirement appropriate for your project instead of a branch dependency when consuming a released AdaEngine version."}]}],"style":"important","type":"aside","name":"Important"},{"inlineContent":[{"text":"The build plugin finds ","type":"text"},{"type":"codeVoice","code":".ada"},{"text":" files through SwiftPM, sorts them by target-relative","type":"text"},{"text":" ","type":"text"},{"text":"path, and generates ","type":"text"},{"type":"codeVoice","code":"AdaScriptPluginsGenerated.swift"},{"text":" in the plugin work","type":"text"},{"text":" ","type":"text"},{"text":"directory. The generated plugin passes one source map to one","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin"},{"text":". Script source is embedded in the executable; the","type":"text"},{"text":" ","type":"text"},{"text":"original files are not read at runtime.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Install the generated plugin in your app scene:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import AdaEngine","","@main","struct MyGame: App {","    var body: some AppScene {","        WindowGroup {","            GameView()","        }","        .addPlugins(AdaScriptPluginsGenerated())","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Rebuilding the target after adding, removing, renaming, or editing an ","type":"text"},{"type":"codeVoice","code":".ada"},{"text":" file refreshes the generated source.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In a portable AdaScript project running in AdaEditor’s macOS game window, edits","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"type":"codeVoice","code":".ada"},{"text":" files hot reload after a short pause, including unsaved editor buffers.","type":"text"},{"text":" ","type":"text"},{"text":"The current ECS world remains active. A failed candidate leaves the last valid","type":"text"},{"text":" ","type":"text"},{"text":"code running and reports the error in Output. System instances and ordinary","type":"text"},{"text":" ","type":"text"},{"text":"script globals restart, and startup systems run once for the new version;","type":"text"},{"text":" ","type":"text"},{"text":"exported scriptable-object fields survive. Changes to","type":"text"},{"text":" ","type":"text"},{"text":"component, resource, network, or scriptable-object schemas require restarting","type":"text"},{"text":" ","type":"text"},{"text":"the game.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The same generated source contains native backing structs and registration for","type":"text"},{"text":" ","type":"text"},{"text":"scalar ","type":"text"},{"type":"codeVoice","code":"@component"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"@resource"},{"text":" declarations. Because these declarations","type":"text"},{"text":" ","type":"text"},{"text":"change Swift layout, adding or editing their stored fields requires rebuilding","type":"text"},{"text":" ","type":"text"},{"text":"the target rather than source-only reload.","type":"text"}],"type":"paragraph"},{"anchor":"Register-custom-components","level":2,"text":"Register custom components","type":"heading"},{"inlineContent":[{"text":"Ada Script resolves component names while plugins are set up. Register custom Swift components before the generated script plugin:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import AdaEngine","","@Component","struct Movement: Codable, Sendable {","    var velocity: Vector2","}","","struct GameComponentsPlugin: Plugin {","    @MainActor","    func setup(in app: borrowing AppWorlds) {","        Movement.registerComponent()","    }","}","","@main","struct MyGame: App {","    var body: some AppScene {","        WindowGroup {","            GameView()","        }","        .addPlugins(","            GameComponentsPlugin(),","            AdaScriptPluginsGenerated()","        )","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"@Component"},{"text":" macro supplies field reflection for supported property types. A plain ","type":"text"},{"type":"codeVoice","code":"Component"},{"text":" can participate in query matching, but its fields are not automatically available through the script bridge.","type":"text"}],"type":"paragraph"},{"anchor":"Load-a-script-manually","level":2,"text":"Load a script manually","type":"heading"},{"inlineContent":[{"text":"Create an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin"},{"text":" when you need control over the source location or loading failure:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import AdaEngine","","struct RuntimeScriptsPlugin: Plugin {","    let scriptURL: URL","","    @MainActor","    func setup(in app: borrowing AppWorlds) {","        do {","            let script = try AdaScriptPlugin(contentsOf: scriptURL)","            app.addPlugin(script)","        } catch {","            print(\"Could not load Ada Script: \\(error)\")","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"You can also use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin\/init(source:name:)"},{"text":" when one source is","type":"text"},{"text":" ","type":"text"},{"text":"already in memory, or ","type":"text"},{"type":"codeVoice","code":"AdaScriptPlugin\/init(sources:name:)"},{"text":" with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptSource"},{"text":" values for a multi-file module. Script compilation,","type":"text"},{"text":" ","type":"text"},{"text":"import resolution, and annotation validation happen during initialization.","type":"text"},{"text":" ","type":"text"},{"text":"Native component resolution happens later during plugin setup.","type":"text"}],"type":"paragraph"},{"anchor":"Next-steps","level":2,"text":"Next steps","type":"heading"},{"inlineContent":[{"text":"Read ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage"},{"text":" for annotation syntax, then ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS"},{"text":" for queries, component fields, and native iterator behavior.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"seeAlsoSections":[{"generated":true,"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptBasics","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLibraries"]}],"references":{"doc://AdaScripting/documentation/AdaScripting/AdaScriptAnnotations":{"kind":"article","abstract":[{"text":"Choose an annotation by the declaration it describes. Annotation arguments","type":"text"},{"text":" ","type":"text"},{"text":"are literals, identifiers, or lists of those values, not runtime expressions.","type":"text"},{"text":" ","type":"text"},{"text":"The same spelling can have different roles: ","type":"text"},{"code":