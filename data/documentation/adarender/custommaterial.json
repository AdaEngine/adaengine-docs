{"sections":[],"metadata":{"role":"symbol","modules":[{"name":"AdaRender"}],"symbolKind":"class","title":"CustomMaterial","navigatorTitle":[{"text":"CustomMaterial","kind":"identifier"}],"externalID":"s:9AdaRender14CustomMaterialC","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CustomMaterial","kind":"identifier"}],"roleHeading":"Class"},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial"},"abstract":[{"type":"text","text":"This material supports user declared materials."}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AdaRender\/documentation\/AdaRender"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@propertyWrapper","kind":"attribute"},{"text":" ","kind":"text"},{"text":"@dynamicMemberLookup","kind":"attribute"},{"text":" ","kind":"text"},{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CustomMaterial","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:9AdaRender17ReflectedMaterialP","text":"ReflectedMaterial","kind":"typeIdentifier","identifier":"doc:\/\/AdaRender\/documentation\/AdaRender\/ReflectedMaterial"}]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"It’s very powerful tool for creating your own materials using power of Swift.","type":"text"},{"text":" ","type":"text"},{"text":"You can declare any materials and describe what kind of values can be used in your shader.","type":"text"},{"text":" ","type":"text"},{"text":"Like example, we can define our custom canvas material.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct MyCanvasMaterial: CanvasMaterial {","","    \/\/ Bind color with u_Color uniform value in shader","    @Uniform(binding: 0, propertyName: \"u_Color\")","    var color: Color = .blue","","    \/\/ Path to glsl shader source","    static func fragment() throws -> ShaderSource {","        try ResourceLoader.loadSync(\"PATH_TO_FRAGMENT_SHADER.glsl\")","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"After that, we should write our own fragment shader code:","type":"text"}]},{"type":"codeListing","syntax":"c++","code":["#version 330 core","#pragma stage : frag \/\/ Declare that this code can be used for fragment shading","","#include <AdaEngine\/CanvasMaterial.frag> \/\/ Include basic canvas header code for you shader","","\/\/ Declare you material uniform","layout (std140, binding = 2) uniform CustomMaterial {","    vec4 u_Color; \/\/ This property will be changed from MyCanvasMaterial","};","","[[main]]","void my_material_fragment()","{","    COLOR = u_Color; \/\/ Set material color to output color value.","}"]},{"type":"paragraph","inlineContent":[{"text":"And than, you can pass our new material to anywhere you want. Also CustomMaterial supports @propertyWrapper magic","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let mesh = Mesh()","let customMaterial = CustomMaterial(MyCanvasMaterial())","let meshComponent = Mesh2D(mesh: mesh, materials: [customMaterial])","","entity.components += meshComponent","","\/\/ -- or --","let mesh = Mesh()","@CustomMaterial var customMaterial = MyCanvasMaterial()","","\/\/ Send custom material using $ symbol. We should pass CustomMaterial<MyCanvasMaterial> instance","let meshComponent = Mesh2D(mesh: mesh, materials: [$customMaterial])","","entity.components += meshComponent"]},{"type":"paragraph","inlineContent":[{"text":"You can update material values with two different ways with reflection or string literals.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let customMaterial = CustomMaterial(MyCanvasMaterial())","","\/\/ Pass new value into material using reflection.","customMaterial.color = .blue","","\/\/ Pass new value into material using string literals","\/\/ In this case we should think about correct name of uniform member.","customMaterial.setValue(Color.blue, for: \"u_Color\")"]}]}],"relationshipsSections":[{"kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/AdaRender\/documentation\/AdaRender\/Material"],"type":"inheritsFrom"},{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/AdaAssets\/documentation\/AdaAssets\/Asset","doc:\/\/AdaRender\/SQ","doc:\/\/AdaRender\/SH","doc:\/\/AdaRender\/s8SendableP","doc:\/\/AdaRender\/s16SendableMetatypeP"],"type":"conformsTo"}],"variants":[{"paths":["\/documentation\/adarender\/custommaterial"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial\/init(_:)","doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial\/init(from:)","doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial\/init(wrappedValue:)"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial\/material","doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial\/projectedValue","doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial\/wrappedValue"],"generated":true},{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial\/collectDefines(for:keys:)","doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial\/configureRenderPipeline(for:keys:shaderModule:)","doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial\/update()"],"generated":true},{"anchor":"Subscripts","title":"Subsc