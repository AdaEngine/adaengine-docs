e":"Add a button and state","type":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics#Layout-with-stacks":{"url":"\/tutorials\/adaengine\/uibasics#Layout-with-stacks","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Layout-with-stacks","title":"Layout with stacks","abstract":[{"text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state.","type":"text"}],"kind":"section","type":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine","role":"overview","kind":"overview","title":"Meet Ada","abstract":[{"text":"Learn the basics of Ada and start developing your own games!","type":"text"}],"url":"\/tutorials\/adaengine","type":"topic"},"doc://AdaEngine/tutorials/AdaEngine/Create-your-first-2D-game-project.":{"url":"\/tutorials\/adaengine\/create-your-first-2d-game-project.","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project.","kind":"article","abstract":[],"title":"Create your first 2D game project.","type":"topic","role":"article"},"doc://AdaEngine/tutorials/AdaEngine/PlayerAndText#Add-Text-component":{"url":"\/tutorials\/adaengine\/playerandtext#Add-Text-component","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Text-component","kind":"section","abstract":[{"text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene.","type":"text"}],"title":"Add Text component","type":"section","role":"pseudoSymbol"},"GP-2-5-system.swift":{"content":["import AdaEngine","","@PlainSystem","struct GamepadInputSystem {","","    @FilterQuery<Ref<Transform>, With<PlayerComponent>>","    private var playerQuery","","    @Res<Input>","    private var input","","    @Res<DeltaTime>","    private var deltaTime","","    init(world _: World) {}","","    func update(context _: UpdateContext) {","        let gamepads = input.getConnectedGamepads()","","        if gamepads.isEmpty {","            return","        }","","        for gamepad in gamepads {","            let leftStickX = gamepad.getAxisValue(.leftStickX)","            let leftStickY = gamepad.getAxisValue(.leftStickY)","            let deadzone: Float = 0.1","","            if abs(leftStickX) > deadzone || abs(leftStickY) > deadzone {","                playerQuery.forEach { transform in","                    let speed: Float = 2.0","                    transform.position.x += leftStickX * Float(deltaTime.deltaTime) * speed","                    transform.position.y -= leftStickY * Float(deltaTime.deltaTime) * speed","                }","            }","","            if gamepad.isGamepadButtonPressed(.x) {","                gamepad.rumble(lowFrequency: 0.5, highFrequency: 0.75, duration: 0.5)","            }","        }","    }","}"],"type":"file","identifier":"GP-2-5-system.swift","highlights":[{"line":36},{"line":37},{"line":38},{"line":39}],"syntax":"swift","fileType":"swift","fileName":"GamepadInputSystem.swift"},"GP-2-2-system.swift":{"content":["import AdaEngine","","@PlainSystem","struct GamepadInputSystem {","","    @FilterQuery<Ref<Transform>, With<PlayerComponent>>","    private var playerQuery","","    @Res<Input>","    private var input","","    @Res<DeltaTime>","    private var deltaTime","","    init(world _: World) {}","","    func update(context _: UpdateContext) {","        let gamepads = input.getConnectedGamepads()","","        if gamepads.isEmpty {","            return","        }","","        for gamepad in gamepads {","            \/\/ Handle per-gamepad input","        }","    }","}"],"type":"file","identifier":"GP-2-2-system.swift","highlights":[],"syntax":"swift","fileType":"swift","fileName":"GamepadInputSystem.swift"},"doc://AdaEngine/tutorials/AdaEngine/PlayerAndText#Add-Player-component":{"url":"\/tutorials\/adaengine\/playerandtext#Add-Player-component","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Player-component","abstract":[{"text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene.","type":"text"}],"kind":"section","title":"Add Player component","type":"section","role":"pseudoSymbol"},"GP-1-1-app.swift":{"content":["import AdaEngine","","@Component","struct PlayerComponent {}","","@main","struct GamepadInputApp: App {","    var body: some AppScene {","        DefaultAppWindow()","            .transformAppWorlds { appWorld in","                appWorld.spawn(","                    \"Camera\",","                    bundle: Camera2D(","                        camera: Camera(),","                        transform: Transform(position: [0, 0, 0])","                    )","                )","            }","            .windowMode(.windowed)","            .windowTitle(\"Gamepad Input\")","    }","}"],"type":"file","identifier":"GP-1-1-app.swift","highlights":[],"syntax":"swift","fileType":"swift","fileName":"GamepadInputApp.swift"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Read-buttons":{"url":"\/tutorials\/adaengine\/gamepadinput#Read-buttons","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Read-buttons","title":"Read buttons","abstract":[{"text":"Build a small scene that spawns a player entity and moves it with a gamepad.","type":"text"}],"kind":"section","type":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Create-a-main-camera":{"url":"\/tutorials\/adaengine\/createfirst2dscene#Create-a-main-camera","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-a-main-camera","abstract":[{"text":"In this tutorial, you will learn how to create your first 2D scene using Ada.","type":"text"}],"kind":"section","title":"Create a main camera.","type":"section","role":"pseudoSymbol"},"doc://AdaEngine/tut