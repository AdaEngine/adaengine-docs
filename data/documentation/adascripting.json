{"abstract":[{"text":"Write gameplay systems in Ada Script while keeping entity filtering and access planning in AdaEngine’s native ECS.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adascripting"]}],"identifier":{"url":"doc:\/\/AdaScripting\/documentation\/AdaScripting","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptBasics","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLibraries"],"anchor":"Essentials","title":"Essentials"},{"identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptDiagnosticsAndPerformance"],"anchor":"ECS-Integration","title":"ECS Integration"},{"identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptSource","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptError"],"anchor":"Runtime-API","title":"Runtime API"},{"identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptObjectBinding","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptObjectSchema","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptUIExport","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptView","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptViewEnvironment","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptViewMetadata"],"anchor":"Structures","title":"Structures","generated":true},{"identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptObjectRegistration","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptUISource","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptViewRegistry","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptViewScanner"],"anchor":"Enumerations","title":"Enumerations","generated":true},{"identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaUI"],"anchor":"Extended-Modules","title":"Extended Modules","generated":true}],"sections":[],"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"Ada Script is AdaEngine’s scripting layer for gameplay and ECS integration. Its source files use the ","type":"text"},{"type":"codeVoice","code":".ada"},{"text":" extension. The current implementation uses an embedded language runtime, while the public API, diagnostics, and tooling consistently present Ada Script concepts.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Annotations are not only syntax. AdaEngine resolves every query into native archetypes and component columns and publishes its component access to the scheduler.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Use Ada Script for gameplay rules that benefit from quick iteration. Keep rendering backends, custom data structures, and other low-level or performance-critical facilities in Swift.","type":"text"}],"type":"paragraph"},{"code":["@system(scheduler: \"update\")","class MovementSystem {","    @query(Transform, Movement)","    var movers;","","    func update(context) {","        for (var entity in movers) {","            var position = entity.transform.position;","            var velocity = entity.movement.velocity;","            position[0] += velocity[0] * context.deltaTime;","            position[1] += velocity[1] * context.deltaTime;","            entity.transform.position = position;","        }","    }","}"],"syntax":"ada","type":"codeListing"},{"inlineContent":[{"text":"AdaEditor projects configure automatic script discovery by default. For an existing Swift package, follow ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript"},{"text":" to enable the build plugin and register the generated script plugins.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"externalID":"AdaScripting","symbolKind":"module","roleHeading":"Framework","modules":[{"name":"Ada Script"}],"role":"collection","title":"Ada Script"},"hierarchy":{"paths":[[]]},"references":{"doc://AdaScripting/documentation/AdaScripting/AdaScriptDiagnosticsAndPerformance":{"url":"\/documentation\/adascripting\/adascriptdiagnosticsandperformance","role":"article","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptDiagnosticsAndPerformance","kind":"article","title":"Ada Script Diagnostics and Performance","abstract":[{"text":"Understand annotation, setup, and runtime failures and keep ECS work on the","type":"text"},{"type":"text","text":" "},{"text":"native chunk path.","type":"text"}],"type":"topic"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptViewEnvironment":{"kind":"symbol","title":"AdaScriptViewEnvironment","role":"symbol","url":"\/documentation\/adascripting\/adascriptviewenvironment","abstract":[],"navigatorTitle":[{"text":"AdaScriptViewEnvironment","kind":"identifier"}],"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptViewEnvironment","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptViewEnvironment","kind":"identifier"}],"type":"topic"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptECS":{"title":"Ada Script ECS","type":"topic","url":"\/documentation\/adascripting\/adascriptecs","role":"article","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS","abstract":[{"type":"text","text":"Declare annotation-driven systems and iterate native AdaECS component columns."}],"kind":"article"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptViewMetadata":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"AdaScriptViewMetadata","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"AdaScriptViewMetadata","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptViewMetadata","abstract":[{"text":"Metadata for an AdaUI view declared with ","type":"text"},{"code":"@view","type":"codeVoice"},{"text":" in Ada Script.","type":"text"}],"title":"AdaScriptViewMetadata","url":"\/documentation\/adascripting\/adascriptviewmetadata"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptUISource":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptUISource","kind":"identifier"}],"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptUISource","title":"AdaScriptUISource","type":"topic","role":"symbol","abstract":[],"navigatorTitle":[{"text":"AdaScriptUISource","kind":"identifier"}],"url":"\/documentation\/adascripting\/adascriptuisource","kind":"symbol"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptObjectBinding":{"url":"\/documentation\/adascripting\/adascriptobjectbinding","role":"symbol","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptObjectBinding","title":"AdaScriptObjectBinding","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptObjectBinding","kind":"identifier"}],"navigatorTitle":[{"text":"AdaScriptObjectBinding","kind":"identifier"}],"abstract":[],"type":"topic"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptViewRegistry":{"title":"AdaScriptViewRegistry","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Compatibility entry point retained while the AdaScript UI integration is redesigned."}],"url":"\/documentation\/adascripting\/adascriptviewregistry",