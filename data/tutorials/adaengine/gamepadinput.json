":[{"text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state.","type":"text"}],"kind":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput":{"abstract":[{"type":"text","text":"Build a small scene that spawns a player entity and moves it with a gamepad."}],"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput","title":"Gamepad Input","role":"project","kind":"project","url":"\/tutorials\/adaengine\/gamepadinput","estimatedTime":"20min","type":"topic"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Create-the-input-system":{"url":"\/tutorials\/adaengine\/gamepadinput#Create-the-input-system","type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Create-the-input-system","title":"Create the input system","abstract":[{"type":"text","text":"Build a small scene that spawns a player entity and moves it with a gamepad."}],"kind":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/CreateProject#Create-project-using-Xcode":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject#Create-project-using-Xcode","abstract":[{"text":"In this tutorial, you will learn how to create your first Ada project.","type":"text"}],"title":"Create project using Xcode","role":"pseudoSymbol","kind":"section","url":"\/tutorials\/adaengine\/createproject#Create-project-using-Xcode","type":"section"},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Apply-and-animate":{"url":"\/tutorials\/adaengine\/animatedtext#Apply-and-animate","type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Apply-and-animate","title":"Apply and animate","abstract":[{"type":"text","text":"Create a custom "},{"type":"codeVoice","code":"TextRenderer"},{"type":"text","text":" that draws text along a sine wave and animate it by updating renderer state."}],"kind":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics":{"abstract":[{"type":"text","text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state."}],"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics","title":"UI Basics","role":"project","kind":"project","url":"\/tutorials\/adaengine\/uibasics","estimatedTime":"15min","type":"topic"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Create-an-app":{"url":"\/tutorials\/adaengine\/createfirst2dscene#Create-an-app","type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-an-app","title":"Create an app","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}],"kind":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Intro":{"url":"\/tutorials\/adaengine\/createfirst2dscene#Intro","type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Intro","title":"Intro","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}],"kind":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/PlayerAndText":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText","abstract":[{"text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene.","type":"text"}],"title":"Player and Text in Ada","role":"project","kind":"project","url":"\/tutorials\/adaengine\/playerandtext","estimatedTime":"5min","type":"topic"},"doc://AdaEngine/tutorials/AdaEngine/CreateProject":{"abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first Ada project."}],"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject","title":"Create your first game project","role":"project","kind":"project","url":"\/tutorials\/adaengine\/createproject","estimatedTime":"5min","type":"topic"},"GP-2-4-system.swift":{"highlights":[],"content":["import AdaEngine","","@PlainSystem","struct GamepadInputSystem {","","    @FilterQuery<Ref<Transform>, With<PlayerComponent>>","    private var playerQuery","","    @Res<Input>","    private var input","","    @Res<DeltaTime>","    private var deltaTime","","    init(world _: World) {}","","    func update(context _: UpdateContext) {","        let gamepads = input.getConnectedGamepads()","","        if gamepads.isEmpty {","            return","        }","","        for gamepad in gamepads {","            let leftStickX = gamepad.getAxisValue(.leftStickX)","            let leftStickY = gamepad.getAxisValue(.leftStickY)","            let deadzone: Float = 0.1","","            if abs(leftStickX) > deadzone || abs(leftStickY) > deadzone {","                playerQuery.forEach { transform in","                    let speed: Float = 2.0","                    transform.position.x += leftStickX * Float(deltaTime.deltaTime) * speed","                    transform.position.y -= leftStickY * Float(deltaTime.deltaTime) * speed","                }","            }","        }","    }","}"],"type":"file","fileType":"swift","syntax":"swift","identifier":"GP-2-4-system.swift","fileName":"GamepadInputSystem.swift"},"GP-2-1-system.swift":{"type":"file","highlights":[],"identifier":"GP-2-1-system.swift","fileName":"GamepadInputSystem.swift","content":["import AdaEngine","","@PlainSystem","struct GamepadInputSystem {","","    @FilterQuery<Ref<Transform>, With<PlayerComponent>>","    private var playerQuery","","    @Res<Input>","    private var input","","    @Res<DeltaTime>","    private var deltaTime","","    init(world _: World) {}","","    func update(context _: UpdateContext) {","        \/\/ Handle input here","    }","}"],"syntax":"swift","fileType":"swift"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Additional-for-physics":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Ev