{"metadata":{"categoryPathComponent":"AdaEngine","category":"Ada","role":"project","title":"Create your first 2D scene"},"sections":[{"title":"Create your first 2D scene","estimatedTimeInMinutes":20,"xcodeRequirement":"Xcode 26.2 or later","content":[{"inlineContent":[{"text":"In this tutorial, you will learn how to create your first 2D scene using Ada.","type":"text"}],"type":"paragraph"}],"kind":"hero","chapter":"Create your first 2D game project."},{"kind":"tasks","tasks":[{"title":"Intro","contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","media":"CF2G-3-5.mov","content":[{"inlineContent":[{"text":"For the first 2D scene, we will try to repeat this example. We’ll look at adding a scene and a camera.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"In addition, we’ll learn how to add sprites and movement systems."}],"type":"paragraph"}]}],"stepsSection":[],"anchor":"Intro"},{"title":"Create an app","contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"inlineContent":[{"type":"text","text":"First, we need to create base files to launch our application."}],"type":"paragraph"}]}],"stepsSection":[{"caption":[],"media":null,"type":"step","code":"CF2G-1-1-app.swift","runtimePreview":null,"content":[{"inlineContent":[{"type":"text","text":"In the previous tutorial, we’ve created an app and an empty window scene."}],"type":"paragraph"}]},{"caption":[],"media":null,"type":"step","code":"CF2G-1-2-scene.swift","runtimePreview":null,"content":[{"inlineContent":[{"type":"text","text":"Let’s create the game logic. To do this, let’s create a file named "},{"type":"codeVoice","code":"FirstScene.swift"},{"type":"text","text":" and import AdaEngine."},{"type":"text","text":" "},{"type":"text","text":"After that, create a struct named "},{"type":"codeVoice","code":"FirstScene"},{"type":"text","text":" that conforms to "},{"type":"codeVoice","code":"Plugin"},{"type":"text","text":" and add a method named "},{"type":"codeVoice","code":"setup(in app: AppWorlds)"},{"type":"text","text":" where we will set up entities in our game world."}],"type":"paragraph"}]},{"caption":[],"media":null,"type":"step","code":"CF2G-1-4-app.swift","runtimePreview":null,"content":[{"inlineContent":[{"type":"text","text":"Now add the "},{"type":"codeVoice","code":"FirstScene"},{"type":"text","text":" plugin to the app using the "},{"type":"codeVoice","code":"addPlugins"},{"type":"text","text":" method."}],"type":"paragraph"}]}],"anchor":"Create-an-app"},{"contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"text":"Ada uses the Entity Component System paradigm where all game objects are called ","type":"text"},{"code":"Entity","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Entities are objects that store user or engine data like position, scale, mesh instance, audio, etc. This data is called components, and they should conform to the ","type":"text"},{"code":"Component","type":"codeVoice"},{"type":"text","text":" protocol."},{"type":"text","text":" "},{"type":"text","text":"By default, "},{"type":"codeVoice","code":"Entity"},{"type":"text","text":" is an empty object without any components."}]}]},{"kind":"fullWidth","content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Camera"},{"type":"text","text":" is a component that determines where all entities will be rendered. Ada supports rendering to a texture or to the "},{"type":"codeVoice","code":"Window"},{"type":"text","text":". We recommend using engine component bundles like "},{"type":"codeVoice","code":"Camera2D"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Camera3D"},{"type":"text","text":", because the engine provides additional components for rendering and audio capabilities."}]}]}],"anchor":"Create-a-main-camera","title":"Create a main camera.","stepsSection":[{"caption":[],"type":"step","code":"CF2G-2-1-camera.swift","runtimePreview":null,"content":[{"inlineContent":[{"type":"text","text":"Let’s create our 2D camera. Spawn an entity with the "},{"code":"Camera2D","type":"codeVoice"},{"type":"text","text":" bundle."}],"type":"paragraph"}],"media":null},{"caption":[],"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Now let’s fill the camera background with a sky blue color."}]}],"media":null,"runtimePreview":"CF2G-2-1.png","code":"CF2G-2-2-camera.swift"}]},{"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Now we can create our first custom sprite."}]}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"anchor":"First-sprite","title":"First sprite","stepsSection":[{"caption":[],"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"First, we should create an assets folder where we will store our game assets, like sprite sheets, sounds, shaders, etc. Let’s create a folder named ","type":"text"},{"type":"codeVoice","code":"Assets"},{"type":"text","text":" and add any sprite sheets you want. We will use this sprite sheet:"}]}],"media":"CF2G-3-1.png","runtimePreview":null,"code":null},{"caption":[{"inlineContent":[{"type":"text","text":"You can download this texture by right-clicking on the image and saving it to the downloads folder."}],"type":"paragraph"}],"type":"step","content":[{"inlineContent":[{"type":"text","text":"In the end, we should have this file structure in our project. Ada doesn’t use xcassets."}],"type":"paragraph"}],"media":"CF2G-3-2.png","runtimePreview":null,"code":null},{"caption":[],"type":"step","content":[{"inlineContent":[{"type":"text","text":"Spawn a player entity in the game world. The player entity will store our sprite component and other player data in the future."}],"type":"paragraph"}],"media":null,"runtimePreview":null,"code":"CF2G-3-1-sprite.swift"},{"caption":[],"type":"step","content":[{"inlineContent":[{"type":"text","text":"Let’s create an image from a file using a special resource manager object. "},{"code":"AssetsManager","type":"codeVoice"},{"type":"text","text":" manages and caches game and engine resources. In our case, we should load an image from a file named "},{"code":"characters_packed.png","type":"codeVoice"},{"type":"text","text":" and use "},{"code":"Bundle.main","type":"codeVoice"},{"type":"text","text":" as a search path."}],"type":"paragraph"}],"media":null,"runtimePreview":null,"code":"CF2G-3-2-sprite.swift"},{"caption":[],"type":"step","content":[{"inlineContent":[{"type":"text","text":"To split the sprite sheet image into sprites, we can use the "},{"code":"TextureAtlas","type":"codeVoice"},{"type":"text","text":" object. This object takes an image, sprite size, and margin between sprites if needed. In our case, we have a margin between sprites of 4px horizontally and 1px vertically, and a sprite size of 20px width and 23px height."}],"type":"paragraph"}],"media":null,"runtimePreview":null,"code":"CF2G-3-3-sprite.swift"},{"caption":[{"inlineContent":[{"type":"text","text":"Add a new sprite component to the entity in the "},{"code":"spawn","type":"codeVoice"},{"type":"text","text":" method. As you can see, we use subscripts in our "},{"code":"TextureAtlas","type":"codeVoice"},{"type":"text","text":" instance where 7 is the column number in our sprite sheet and 1 is the row number."}],"type":"paragraph"}],"type":"step","content":[{"inlineContent":[{"type":"text","text":"Now we can add our sprite to the player entity using the "},{"code":"Sprite","type":"codeVoice"},{"type":"text","text":" component. This component is efficient for rendering because it uses a special batching system and requires fewer drawing calls."}],"type":"paragraph"}],"media":null,"runtimePreview":"CF2G-3-3.png","code":"CF2G-3-4-sprite.swift"},{"caption":[],"type":"step","content":[{"inlineContent":[{"type":"text","text":"And finally, let’s add a special "},{"code":"Transform","type":"codeVoice"},{"type":"text","text":" component that describes the position of our entity on the screen."}],"type":"paragraph"}],"media":null,"runtimePreview":"CF2G-3-4.png","code":"CF2G-3-5-sprite.swift"}]},{"contentSection":[{"content":[{"inlineContent":[{"type":"text","text":"We did a lot of work, but our scene looks very simple. We should add more life to our player entity. All game logic is described in special objects named "},{"code":"System","type":"codeVoice"},{"type":"text","text":". A system is a unit that executes each game loop and manipulates entities and their data. We will use one to add life to our player."}],"type":"paragraph"}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"anchor":"Make-it-move","title":"Make it move","stepsSection":[{"caption":[],"type":"step","content":[{"inlineContent":[{"type":"text","text":"First, we should create a special tag component named "},{"code":"PlayerComponent","type":"codeVoice"},{"type":"text","text":". We will use this component in the near future; it indicates that this entity is a player."}],"type":"paragraph"}],"media":null,"runtimePreview":null,"code":"CF2G-4-1-player.swift"},{"caption":[],"type":"step","content":[{"inlineContent":[{"type":"text","text":"Create a new function named "},{"code":"PlayerMovement","type":"codeVoice"},{"type":"text","text":" and annotate this function with the "},{"code":"System","type":"codeVoice"},{"type":"text","text":" macro. This system will listen to user inputs and move our player component on the screen."}],"type":"paragraph"}],"media":null,"runtimePreview":null,"code":"CF2G-4-2-player.swift"},{"caption":[],"type":"step","content":[{"inlineContent":[{"type":"text","text":"Add the new system to our game scene. The "},{"code":"System","type":"codeVoice"},{"type":"text","text":" macro will create a new system with the same name as the function with the suffix "},{"code":"System","type":"codeVoice"},{"type":"text","text":". Our system will be initialized once on app launch."}],"type":"paragraph"}],"media":null,"runtimePreview":null,"code":"CF2G-4-3-player.swift"},{"caption":[],"type":"step","content":[{"inlineContent":[{"type":"text","text":"In "},{"code":"PlayerMovementSystem","type":"codeVoice"},{"type":"text","text":", add a new function parameter named "},{"code":"playerTransform","type":"codeVoice"},{"type":"text","text":" with the "},{"code":"FilterQuery<Ref<Transform>, With<PlayerComponent>>","type":"codeVoice"},{"type":"text","text":" type."},{"type":"text","text":" "},{"type":"text","text":"This object will query the world and return components that conform to your predicate. In our case, we require one mutable component "},{"code":"Transform","type":"codeVoice"},{"type":"text","text":" and a filter that indicates we need entities with the "},{"code":"PlayerComponent","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"media":null,"runtimePreview":null,"code":"CF2G-4-4-player.swift"},{"caption":[],"type":"step","content":[{"inlineContent":[{"type":"text","text":"Add a new function parameter named "},{"code":"speed","type":"codeVoice"},{"type":"text","text":" with the "},{"code":"Local<Float>","type":"codeVoice"},{"type":"text","text":" type. This is a special type that stores a value available only within the system."}],"type":"paragraph"}],"media":null,"runtimePreview":null,"code":"CF2G-4-5-player.swift"},{"inlineContent":[{"text":"Now we can update our player position. Ada can handle keyboard inputs for us. We should listen to keyboard inputs, and if a key is pressed, we should change the player transform.","type":"text"}],"type":"paragraph"},{"caption":[{"inlineContent":[{"type":"text","text":"Using the special "},{"code":"Input","type":"codeVoice"},{"type":"text","text":" object, we can check if a key is pressed."},{"type":"text","text":" "},{"type":"text","text":"Add an "},{"code":"if","type":"codeVoice"},{"type":"text","text":" condition where we will listen to the "},{"code":"w","type":"codeVoice"},{"type":"text","text":" key. If the key is pressed, add the speed multiplied by delta time. We do this for a smooth transition between frames."}],"type":"paragraph"}],"type":"step","content":[{"inlineContent":[{"type":"text","text":"Let’s add a new function parameter named "},{"code":"deltaTime","type":"codeVoice"},{"type":"text","text":" with the "},{"code":"Res<DeltaTime>","type":"codeVoice"},{"type":"text","text":" type and "},{"code":"input","type":"codeVoice"},{"type":"text","text":" with "},{"code":"Res<Input>","type":"codeVoice"},{"type":"text","text":". These are queries to resources in the world."}],"type":"paragraph"}],"media":null,"runtimePreview":null,"code":"CF2G-4-6-player.swift"},{"caption":[{"inlineContent":[{"type":"text","text":"Run the app and try to move your player."}],"type":"paragraph"}],"type":"step","content":[{"inlineContent":[{"type":"text","text":"Finally, add the same logic for other keys — "},{"code":"a","type":"codeVoice"},{"type":"text","text":", "},{"code":"s","type":"codeVoice"},{"type":"text","text":", and "},{"code":"d","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"media":null,"runtimePreview":"CF2G-3-5.mov","code":"CF2G-4-7-player.swift"}]}]},{"featuredEyebrow":"Tutorial","kind":"callToAction","title":"Player and Text in Ada","abstract":[{"text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene.","type":"text"}],"action":{"overridingTitle":"Get started","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText","overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"type":"reference","isActive":true}}],"hierarchy":{"modules":[{"projects":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject#Create-project-using-Xcode","kind":"task"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Intro","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-an-app","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-a-main-camera","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#First-sprite","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Make-it-move","kind":"task"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Player-component","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Text-component","kind":"task"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Base-of-Event-Subscriber-pattern","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Subscribe-to-scene-events","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Type-of-events","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Additional-for-physics","kind":"task"}]}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project."},{"projects":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Create-the-app-shell","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Layout-with-stacks","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Add-a-button-and-state","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Debug-overlays","kind":"task"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-the-view","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Prepare-layout-helpers","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-a-custom-TextRenderer","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Apply-and-animate","kind":"task"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Set-up-the-world","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Create-the-input-system","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Read-buttons","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Move-and-rumble","kind":"task"}]}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UI-and-Input"}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine","paths":[["doc:\/\/AdaEngine\/tutorials\/AdaEngine","doc:\/\/AdaEngine\/tutorials\/AdaEngine\/$volume","doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project."]]},"kind":"project","identifier":{"url":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/adaengine\/createfirst2dscene"]}],"references":{"CF2G-4-7-player.swift":{"content":["import AdaEngine","","struct FirstScene: Plugin {","    func setup(in _: AppWorlds) {","        \/** Collapsed code *\/","    }","}","","@Component","struct PlayerComponent {}","","@System","func PlayerMovement(","    _ playerTransform: FIlterQuery<Ref<Transform>, With<PlayerComponent>>,","    _ speed: Local<Float> = 3.0,","    _ deltaTime: Res<DeltaTime>,","    _ input: Res<Input>",") {","    playerTransform.forEach { transform in","        if input.wrappedValue.isKeyPressed(.w) {","            transform.position.y += speed.wrappedValue * deltaTime.wrappedValue.deltaTime","        }","","        if input.wrappedValue.isKeyPressed(.s) {","            transform.position.y -= speed.wrappedValue * deltaTime.wrappedValue.deltaTime","        }","","        if input.wrappedValue.isKeyPressed(.a) {","            transform.position.x -= speed.wrappedValue * deltaTime.wrappedValue.deltaTime","        }","","        if input.wrappedValue.isKeyPressed(.d) {","            transform.position.x += speed.wrappedValue * deltaTime.wrappedValue.deltaTime","        }","    }","}"],"fileType":"swift","syntax":"swift","identifier":"CF2G-4-7-player.swift","highlights":[{"line":23},{"line":24},{"line":25},{"line":26},{"line":27},{"line":28},{"line":29},{"line":30},{"line":31},{"line":32},{"line":33},{"line":34}],"type":"file","fileName":"FirstScene.swift"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#First-sprite":{"url":"\/tutorials\/adaengine\/createfirst2dscene#First-sprite","abstract":[{"text":"In this tutorial, you will learn how to create your first 2D scene using Ada.","type":"text"}],"kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#First-sprite","type":"section","role":"pseudoSymbol","title":"First sprite"},"CF2G-3-4.png":{"variants":[{"url":"\/images\/AdaEngine\/CF2G-3-4.png","traits":["1x","light"]}],"type":"image","identifier":"CF2G-3-4.png","alt":"Our sprite sheet"},"Xcode 26.2 or later":{"title":"Xcode 26.2 or later","identifier":"Xcode 26.2 or later","type":"xcodeRequirement","url":"https:\/\/developer.apple.com\/download\/"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics#Layout-with-stacks":{"url":"\/tutorials\/adaengine\/uibasics#Layout-with-stacks","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Layout-with-stacks","title":"Layout with stacks","abstract":[{"text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state.","type":"text"}],"kind":"section","type":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Base-of-Event-Subscriber-pattern":{"url":"\/tutorials\/adaengine\/eventlisteners#Base-of-Event-Subscriber-pattern","abstract":[{"text":"In this tutorial you will learn about the event listeners system in Ada.","type":"text"},{"text":" ","type":"text"},{"text":"How can you catch events and process them","type":"text"}],"kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Base-of-Event-Subscriber-pattern","type":"section","role":"pseudoSymbol","title":"Base of Event-Subscriber pattern"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Type-of-events":{"url":"\/tutorials\/adaengine\/eventlisteners#Type-of-events","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Type-of-events","kind":"section","abstract":[{"text":"In this tutorial you will learn about the event listeners system in Ada.","type":"text"},{"text":" ","type":"text"},{"text":"How can you catch events and process them","type":"text"}],"title":"Type of events","type":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Read-buttons":{"url":"\/tutorials\/adaengine\/gamepadinput#Read-buttons","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Read-buttons","title":"Read buttons","abstract":[{"text":"Build a small scene that spawns a player entity and moves it with a gamepad.","type":"text"}],"kind":"section","type":"section","role":"pseudoSymbol"},"CF2G-1-1-app.swift":{"content":["import AdaEngine","","@main","struct FirstPackageApp: App {","    var body: some AppScene {","        DefaultAppWindow()","            .windowMode(.windowed)","            .windowTitle(\"First Ada App\")","    }","}"],"fileType":"swift","syntax":"swift","identifier":"CF2G-1-1-app.swift","highlights":[],"type":"file","fileName":"FirstGameApp.swift"},"doc://AdaEngine/tutorials/AdaEngine/Create-your-first-2D-game-project.":{"url":"\/tutorials\/adaengine\/create-your-first-2d-game-project.","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project.","kind":"article","abstract":[],"title":"Create your first 2D game project.","type":"topic","role":"article"},"CF2G-4-3-player.swift":{"content":["import AdaEngine","","struct FirstScene: Plugin {","    func setup(in app: AppWorlds) {","        let camera = Camera()","        camera.backgroundColor = Color(45 \/ 255, 171 \/ 255, 255 \/ 255, 1)","        app.spawn(bundle: Camera2D(camera: camera))","","        let spriteSheetImage = try! AssetsManager.loadSync(Image.self, at: \"@res:\/\/characters_packed.png\").asset!","        let spriteSheet = TextureAtlas(from: spriteSheetImage, size: [20, 23], margin: [4, 1])","","        app.spawn(\"Player\") {","            Sprite(","                texture: spriteSheet[7, 1],","                size: Size(width: 24, height: 24)","            )","            Transform()","            PlayerComponent()","        }","","        app.addSystem(PlayerMovementSystem.self)","    }","}","","@Component","struct PlayerComponent {}","","@System","func PlayerMovement() {","","}"],"fileType":"swift","fileName":"FirstScene.swift","highlights":[{"line":20},{"line":21}],"identifier":"CF2G-4-3-player.swift","type":"file","syntax":"swift"},"CF2G-3-2.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/AdaEngine\/CF2G-3-2.png"}],"type":"image","alt":"Our sprite sheet","identifier":"CF2G-3-2.png"},"CF2G-4-6-player.swift":{"fileType":"swift","content":["import AdaEngine","","struct FirstScene: Plugin {","    func setup(in _: AppWorlds) {","        \/** Collapsed code *\/","    }","}","","@Component","struct PlayerComponent {}","","@System","func PlayerMovement(","    _ playerTransform: FIlterQuery<Ref<Transform>, With<PlayerComponent>>,","    _ speed: Local<Float> = 3.0,","    _ deltaTime: Res<DeltaTime>,","    _ input: Res<Input>