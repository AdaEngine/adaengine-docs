"title":"Create your first 2D game project.","role":"article","kind":"article"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics#Add-a-button-and-state":{"role":"pseudoSymbol","abstract":[{"type":"text","text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state."}],"type":"section","kind":"section","title":"Add a button and state","url":"\/tutorials\/adaengine\/uibasics#Add-a-button-and-state","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Add-a-button-and-state"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Subscribe-to-scene-events":{"kind":"section","abstract":[{"text":"In this tutorial you will learn about the event listeners system in Ada.","type":"text"},{"text":" ","type":"text"},{"text":"How can you catch events and process them","type":"text"}],"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Subscribe-to-scene-events","type":"section","url":"\/tutorials\/adaengine\/eventlisteners#Subscribe-to-scene-events","role":"pseudoSymbol","title":"Subscribe to scene events"},"AT-3-2-view.swift":{"content":["import AdaEngine","","struct ContentView: View {","    @State private var timeOffset: Double = 0","    @State private var animationTask: Task<Void, Never>?","","    var body: some View {","        Text(\"Sine Wave\")","            .textRendered(AnimatedSineWaveRenderer(timeOffset: timeOffset))","            .onAppear {","                startAnimation()","            }","    }","","    private func startAnimation() {","        animationTask?.cancel()","        animationTask = Task { @MainActor in","            while !Task.isCancelled {","                timeOffset += 0.12","                try? await Task.sleep(nanoseconds: 16_000_000)","            }","        }","    }","}"],"identifier":"AT-3-2-view.swift","highlights":[{"line":5},{"line":10},{"line":11},{"line":12},{"line":13},{"line":14},{"line":15},{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22}],"type":"file","syntax":"swift","fileType":"swift","fileName":"ContentView.swift"},"Xcode 26.3 or later":{"identifier":"Xcode 26.3 or later","type":"xcodeRequirement","title":"Xcode 26.3 or later","url":"https:\/\/developer.apple.com\/download\/"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics":{"role":"project","estimatedTime":"15min","abstract":[{"type":"text","text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state."}],"type":"topic","url":"\/tutorials\/adaengine\/uibasics","title":"UI Basics","kind":"project","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics"},"AT-2-2-renderer.swift":{"highlights":[],"type":"file","identifier":"AT-2-2-renderer.swift","syntax":"swift","fileName":"AnimatedSineWaveRenderer.swift","content":["import AdaEngine","","struct AnimatedSineWaveRenderer: TextRenderer {","    var timeOffset: Double","","    var animatableData: Double {","        get { timeOffset }","        set { timeOffset = newValue }","    }","","    init(timeOffset: Double) {","        self.timeOffset = timeOffset","    }","}"],"fileType":"swift"},"AT-2-3-renderer.swift":{"highlights":[{"line":14},{"line":15},{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23},{"line":24},{"line":25},{"line":26},{"line":27},{"line":28},{"line":29},{"line":30},{"line":31},{"line":32},{"line":33},{"line":34},{"line":35},{"line":36},{"line":37},{"line":38},{"line":39},{"line":40},{"line":41},{"line":42},{"line":43},{"line":44},{"line":45},{"line":46},{"line":47}],"type":"file","identifier":"AT-2-3-renderer.swift","syntax":"swift","fileName":"AnimatedSineWaveRenderer.swift","content":["import AdaEngine","","struct AnimatedSineWaveRenderer: TextRenderer {","    var timeOffset: Double","","    var animatableData: Double {","        get { timeOffset }","        set { timeOffset = newValue }","    }","","    init(timeOffset: Double) {","        self.timeOffset = timeOffset","    }","","    func draw(layout: Text.Layout, in context: inout UIGraphicsContext) {","        let glyphs = layout.flattenedRuns","        let safeCount = max(glyphs.count, 1)","        let width = layout.first?.typographicBounds.rect.width ?? 1","        let height = layout.first?.typographicBounds.rect.height ?? 1","","        for (index, glyph) in glyphs.enumerated() {","            let offset = sineOffset(","                index: index,","                amplitude: Double(height) * 0.5,","                wavelength: Double(width),","                phase: timeOffset,","                total: safeCount","            )","","            var copy = context","            copy.translateBy(x: 0, y: Float(offset))","            copy.draw(glyph)","        }","    }","","    private func sineOffset(","        index: Int,","        amplitude: Double,","        wavelength: Double,","        phase: Double,","        total: Int","    ) -> Double {","        let x = Double(index)","        let position = (x \/ Double(total)) * wavelength","        let radians = ((position + phase) \/ wavelength) * 2 * .pi","        return Math.sin(radians) * amplitude","    }","}"],"fileType":"swift"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Read-buttons":{"kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Read-buttons","url":"\/tutorials\/adaengine\/gamepadinput#Read-buttons","title":"Read buttons","type":"section","role":"pseudoSymbol","abstract":[{"text":"Build a small scene that spawns a player entity and moves it with a gamepad.","type":"text"}]},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene":{"role":"project","estimatedTime":"20min","abstract":[{"text":"In this tutorial, you will learn how to create your first 2D scene using Ada.","type":"text"}],"type":"topic","kind":"project","title":"Create your first 2D scene","url":"\/tutorials\/adaengine\/createfirst2dscene","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Create-a-main-camera":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-a-main-camera","abstract":[{"text":"In this tutorial, you will learn how to create your first 2D scene using Ada.","type":"text"}],"url":"\/tutorials\/adaengine\/createfirst2dscene#Create-a-main-camera","title":"Create a main camera.","role":"pseudoSymbol","kind":"section"},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText":{"title":"Animated Text Renderer","kind":"project","type":"topic","role":"project","estimatedTime":"20min","abstract":[{"type":"text","text":"Create a custom "},{"type":"codeVoice","code":"TextRenderer"},{"text":" that draws text along a sine wave and animate it by updating renderer state.","type":"text"}],"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText","url":"\/tutorials\/adaengine\/animatedtext"},"AT-3-3-view.swift":{"highlights":[{"line":13},{"line":14},{"line":15},{"line":16}],"type":"file","identifier":"AT-3-3-view.swift","syntax":"swift","fileName":"ContentView.swift","content":["import AdaEngine","","struct ContentView: View {","    @State private var timeOffset: Double = 0","    @State private var animationTask: Task<Void, Never>?","","    var body: some View {","        Text(\"Sine Wave\")","            .textRendered(AnimatedSineWaveRenderer(timeOffset: timeOffset))","            .onAppear {","                startAnimation()","            }","            .onDisappear {","                animationTask?.cancel()","                animationTask = nil","            }","    }","","    private func startAnimation() {","        animationTask?.cancel()","        animationTask = Task { @MainActor in","            while !Task.isCancelled {","                timeOffset += 0.12","                try? await Task.sleep(nanoseconds: 16_000_000)","            }","        }","    }","}"],"fileType":"swift"},"AT-3-1-view.swift":{"fileType":"swift","syntax":"swift","type":"file","identifier":"AT-3-1-view.swift","fileName":"ContentView.swift","content":["import AdaEngine","","struct ContentView: View {","    @State private var timeOffset: Double = 0","","    var body: some View {","        Text(\"Sine Wave\")","            .textRendered(AnimatedSineWaveRenderer(timeOffset: timeOffset))","    }","}"],"highlights":[]},"AT-2-1-layout.swift":{"highlights":[],"type":"file","identifier":"AT-2-1-layout.swift","syntax":"swift","fileName":"TextLayout+Helpers.swift","content":["import AdaEngine","","extension Text.Layout {","    var runs: some RandomAccessCollection<TextRun> {","        flatMap { line in","            line","        }","    }","","    var flattenedRuns: some RandomAccessCollection<Glyph> {","        runs.flatMap { $0 }","    }","}"],"fileType":"swift"},"AT-1-1-app.swift":{"fileType":"swift","syntax":"swift","type":"file","identifier":"AT-1-1-app.swift","fileName":"AnimatedTextApp.swift","content":["import AdaEngine","","@main","struct AnimatedTextApp: App {","    var body: some AppScene {","        WindowGroup {","            ContentView()","        }","        .windowMode(.windowed)","        .windowTitle(\"Animated Text\")","    }","}"],"highlights":[]},"doc://AdaEngine/tutorials/AdaEngine/UIBasics#Layout-with-stacks":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Layout-with-stacks","abstract":[{"type":"text","text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state."}],"url":"\/tutorials\/adaengine\/uibasics#Layout-with-stacks","title":"Layout with stacks","role":"pseudoSymbol","kind":"section"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners":{"kind":"project","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners","url":"\/tutorials\/adaengine\/eventlisteners","estimatedTime":"5min","title":"Event Listeners in Ada","type":"topic","role":"project","