{"abstract":[{"type":"text","text":"Subtract a portion of the destination pixel values from a portion of the source."}],"metadata":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"subtract"}],"externalID":"s:9AdaRender14BlendOperationO8subtractyA2CmF","title":"BlendOperation.subtract","modules":[{"name":"AdaRender"}],"role":"symbol","roleHeading":"Case","symbolKind":"case"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"subtract","kind":"identifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"inlineContent":[{"type":"text","text":"RGB = Source.rgb * SBF - Dest.rgb * DBF"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A = Source.a * SBF - Dest.a * DBF"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/adarender\/blendoperation\/subtract"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","identifier":{"url":"doc:\/\/AdaRender\/documentation\/AdaRender\/BlendOperation\/subtract","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/AdaRender\/documentation\/AdaRender","doc:\/\/AdaRender\/documentation\/AdaRender\/BlendOperation"]]},"sections":[],"references":{"doc://AdaRender/documentation/AdaRender/BlendOperation/subtract":{"abstract":[{"text":"Subtract a portion of the destination pixel values from a portion of the source.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/AdaRender\/documentation\/AdaRender\/BlendOperation\/subtract","type":"topic","url":"\/documentation\/adarender\/blendoperation\/subtract","title":"BlendOperation.subtract","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"subtract"}]},"doc://AdaRender/documentation/AdaRender/BlendOperation":{"abstract":[{"text":"For every pixel, ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AdaRender\/documentation\/AdaRender\/BlendOperation"},{"text":" determines how to combine and weight the source fragment values with the destination values.","type":"text"},{"text":" ","type":"text"},{"text":"Some blend operations multiply the source values by a source blend factor (SBF),","type":"text"},{"text":" ","type":"text"},{"text":"multiply the destination values by a destination blend factor (DBF), and then combine the results using addition or subtraction.","type":"text"},{"text":" ","type":"text"},{"text":"Other blend operations use either a minimum or maximum function to determine the result.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"BlendOperation"}],"kind":"symbol","identifier":"doc:\/\/AdaRender\/documentation\/AdaRender\/BlendOperation","type":"topic","url":"\/documentation\/adarender\/blendoperation","title":"BlendOperation","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"BlendOperation"}]},"doc://AdaRender/documentation/AdaRender":{"type":"topic","url":"\/documentation\/adarender","abstract":[],"identifier":"doc:\/\/AdaRender\/documentation\/AdaRender","title":"AdaRender","role":"collection","kind":"symbol"}}}