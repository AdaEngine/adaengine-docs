{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial"},"topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial\/init(_:)","doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial\/init(from:)","doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial\/init(wrappedValue:)"],"anchor":"Initializers"},{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial\/material","doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial\/projectedValue","doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial\/wrappedValue"],"anchor":"Instance-Properties"},{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial\/collectDefines(for:keys:)","doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial\/configureRenderPipeline(for:keys:shaderModule:)","doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial\/update()"],"anchor":"Instance-Methods"},{"title":"Subscripts","generated":true,"identifiers":["doc:\/\/AdaRender\/documentation\/AdaRender\/CustomMaterial\/subscript(dynamicMember:)"],"anchor":"Subscripts"}],"hierarchy":{"paths":[["doc:\/\/AdaRender\/documentation\/AdaRender"]]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@propertyWrapper"},{"kind":"text","text":" "},{"kind":"attribute","text":"@dynamicMemberLookup"},{"kind":"text","text":" "},{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"CustomMaterial"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/AdaRender\/documentation\/AdaRender\/ReflectedMaterial","kind":"typeIdentifier","preciseIdentifier":"s:9AdaRender17ReflectedMaterialP","text":"ReflectedMaterial"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"It’s very powerful tool for creating your own materials using power of Swift.","type":"text"},{"text":" ","type":"text"},{"text":"You can declare any materials and describe what kind of values can be used in your shader.","type":"text"},{"text":" ","type":"text"},{"text":"Like example, we can define our custom canvas material.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct MyCanvasMaterial: CanvasMaterial {","","    \/\/ Bind color with u_Color uniform value in shader","    @Uniform(binding: 0, propertyName: \"u_Color\")","    var color: Color = .blue","","    \/\/ Path to glsl shader source","    static func fragment() throws -> ShaderSource {","        try ResourceLoader.loadSync(\"PATH_TO_FRAGMENT_SHADER.glsl\")","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"After that, we should write our own fragment shader code:","type":"text"}],"type":"paragraph"},{"syntax":"c++","code":["#version 330 core","#pragma stage : frag \/\/ Declare that this code can be used for fragment shading","","#include <AdaEngine\/CanvasMaterial.frag> \/\/ Include basic canvas header code for you shader","","\/\/ Declare you material uniform","layout (std140, binding = 2) uniform CustomMaterial {","    vec4 u_Color; \/\/ This property will be changed from MyCanvasMaterial","};","","[[main]]","void my_material_fragment()","{","    COLOR = u_Color; \/\/ Set material color to output color value.","}"],"type":"codeListing"},{"inlineContent":[{"text":"And than, you can pass our new material to anywhere you want. Also CustomMaterial supports @propertyWrapper magic","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let mesh = Mesh()","let customMaterial = CustomMaterial(MyCanvasMaterial())","let meshComponent = Mesh2D(mesh: mesh, materials: [customMaterial])","","entity.components += meshComponent","","\/\/ -- or --","let mesh = Mesh()","@CustomMaterial var customMaterial = MyCanvasMaterial()","","\/\/ Send custom material using $ symbol. We should pass CustomMaterial<MyCanvasMaterial> instance","let meshComponent = Mesh2D(mesh: mesh, materials: [$customMaterial])","","entity.components += meshComponent"],"type":"codeListing"},{"inlineContent":[{"text":"You can update material values with two different ways with reflection or string literals.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let customMaterial = CustomMaterial(MyCanvasMaterial())","","\/\/ Pass new value into material using reflection.","customMaterial.color = .blue","","\/\/ Pass new value into material using string literals","\/\/ In this case we should think about correct name of uniform member.","customMaterial.setValue(Color.blue, for: \"u_Color\")"],"type":"codeListing"}]}],"kind":"symbol","sections":[],"abstract":[{"text":"This material supports user declared materials.","type":"text"}],"relationshipsSections":[{"title":"Inherits From","type":"inheritsFrom","identifiers":["doc:\/\/AdaRender\/documentation\/AdaRender\/Material"],"kind":"relationships"},{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/AdaAssets\/documentation\/AdaAssets\/Asset","doc:\/\/AdaRender\/SQ","doc:\/\/AdaRender\/SH","doc:\/\/AdaRender\/s8SendableP","doc:\/\/AdaRender\/s16SendableMetatypeP"],"kind":"relationships"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adarender\/custommaterial"]}],"metadata":{"symbolKind":"class","roleHeading":"Class","role":"symbol","navigatorTitle":[{"text":"CustomMaterial","kind":"identifier"}],"modules":[{"name":"AdaRender"}],"externalID":"s:9AdaRender14CustomMaterialC","title":"CustomM