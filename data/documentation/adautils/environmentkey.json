ent":[{"type":"text","text":"Then use the key to define a new environment value property:"}],"type":"paragraph"},{"syntax":"swift","code":["extension EnvironmentValues {","    var myCustomValue: String {","        get { self[MyEnvironmentKey.self] }","        set { self[MyEnvironmentKey.self] = newValue }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Clients of your environment value never use the key directly. Instead, they use the key path of your"},{"type":"text","text":" "},{"type":"text","text":"custom environment value property. To set the environment value for a view and all its subviews,"},{"type":"text","text":" "},{"type":"text","text":"add the "},{"code":"View\/environment(_:_:)","type":"codeVoice"},{"type":"text","text":" view modifier to that view:"}],"type":"paragraph"},{"syntax":"swift","code":["MyView()","   .environment(\\.myCustomValue, \"Another string\")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"To read the value from inside MyView or one of its descendants, use the "},{"code":"Environment","type":"codeVoice"},{"type":"text","text":" property wrapper:"}],"type":"paragraph"},{"syntax":"swift","code":["struct MyView: View {","    @Environment(\\.myCustomValue) var customValue: String","","    var body: some View {","        Text(customValue) \/\/ Displays \"Another string\".","    }","}"],"type":"codeListing"}]}],"identifier":{"url":"doc:\/\/AdaUtils\/documentation\/AdaUtils\/EnvironmentKey","interfaceLanguage":"swift"},"references":{"doc://AdaUtils/documentation/AdaUtils/EnvironmentKey/Value":{"type":"topic","title":"Value","role":"symbol","identifier":"doc:\/\/AdaUtils\/documentation\/AdaUtils\/EnvironmentKey\/Value","abstract":[],"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Value"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier","text":"Sendable"}],"url":"\/documentation\/adautils\/env