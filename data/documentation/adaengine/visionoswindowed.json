{"sections":[],"kind":"article","seeAlsoSections":[{"generated":true,"anchor":"Guides","identifiers":["doc:\/\/AdaEngine\/documentation\/AdaEngine\/Building","doc:\/\/AdaEngine\/documentation\/AdaEngine\/Contributing","doc:\/\/AdaEngine\/documentation\/AdaEngine\/AdaUIIdentity","doc:\/\/AdaEngine\/documentation\/AdaEngine\/ImageDecoders"],"title":"Guides"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Ada’s first visionOS milestone is windowed rendering. Apps launch as normal visionOS windows backed by UIKit scenes, "},{"type":"codeVoice","code":"MTKView"},{"type":"text","text":", and the Metal render backend. Existing apps that use "},{"type":"codeVoice","code":"WindowGroup"},{"type":"text","text":" do not need a new public API for this mode."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import AdaEngine","","@main","struct VisionOSWindowedApp: App {","    var body: some AppScene {","        WindowGroup {","            Text(\"Ada on visionOS\")","                .padding()","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"Windowed mode intentionally does not create a Full Space, stereo renderer, ARKit session, or "},{"code":"CompositorServices.LayerRenderer","type":"codeVoice"},{"type":"text","text":" surface. Those belong to a later immersive rendering milestone."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adaengine\/visionoswindowed"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/VisionOSWindowed"},"metadata":{"role":"article","title":"visionOS Windowed Mode","modules":[{"name":"AdaEngine"}],"roleHeading":"Article"},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Run Ada apps in visionOS Shared Space using the existing "},{"type":"codeVoice","code":"WindowGroup"},{"type":"text","text":" scene model."}],"hierarchy":{"paths":[["doc:\/\/AdaEngine\/documentation\/AdaEngine"]]},"references":{"doc://AdaEngine/documentation/AdaEngine/ImageDecoders":{"kind":"article","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/ImageDecoders","url":"\/documentation\/adaengine\/imagedecoders","title":"Loading images and adding formats","abstract":[{"type":"text","text":"Load PNG, JPEG ("},{"code":"jpg","type":"codeVoice"},{"type":"text","text":" or "},{"code":"jpeg","type":"codeVoice"},{"type":"text","text":"), BMP and TGA images as CPU pixels using"},{"type":"text","text":" "},{"code":"Image","type":"codeVoice"},{"type":"text","text":", or load a GPU texture through "},{"code":"Texture2D","type":"codeVoice"},{"type":"text","text":":"}],"role":"article","type":"topic"},"doc://AdaEngine/documentation/AdaEngine/AdaUIIdentity":{"url":"\/documentation\/adaengine\/adauiidentity","role":"article","kind":"article","type":"topic","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/AdaUIIdentity","title":"AdaUI View Identity","abstract":[{"type":"text","text":"AdaUI reconciles a new view tree against the mounted "},{"type":"codeVoice","code":"ViewNode"},{"type":"text","text":" tree. A node is preserved only when the new node and old node describe the same identity and the new node can update the old node. Preserved nodes keep their "},{"type":"codeVoice","code":"@State"},{"type":"text","text":", focus state, in-flight animation controllers, layers, and other node-local runtime state. Recreated nodes start with fresh runtime state."}]},"doc://AdaEngine/documentation/AdaEngine":{"url":"\/documentation\/adaengine","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine","abstract":[{"type":"text","text":"Bringing simple and powerful game engine for your awesome games."}],"role":"collection","kind":"symbol","type":"topic","title":"AdaEngine"},"doc://AdaEngine/documentation/AdaEngine/Building":{"url":"\/documentation\/adaengine\/building","role":"article","kind":"article","type":"topic","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/Building","title":"Building Ada","abstract":[{"type":"text","text":"This guide covers two scenarios:"}]},"doc://AdaEngine/documentation/AdaEngine/Contributing":{"url":"\/documentation\/adaengine\/contributing","role":"article","kind":"article","type":"topic","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/Contributing","title":"Contributing to Ada","abstract":[{"text":"We welcome contributions of all kinds: bug fixes, features, documentation, and examples.","type":"text"}]}}}