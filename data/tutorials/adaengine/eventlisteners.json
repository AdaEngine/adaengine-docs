c://AdaEngine/tutorials/AdaEngine/EventListeners#Subscribe-to-scene-events":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Subscribe-to-scene-events","title":"Subscribe to scene events","url":"\/tutorials\/adaengine\/eventlisteners#Subscribe-to-scene-events","abstract":[{"type":"text","text":"In this tutorial you will learn about the event listeners system in Ada."},{"type":"text","text":" "},{"type":"text","text":"How can you catch events and process them"}],"kind":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Additional-for-physics":{"role":"pseudoSymbol","kind":"section","title":"Additional for physics","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Additional-for-physics","abstract":[{"text":"In this tutorial you will learn about the event listeners system in Ada.","type":"text"},{"text":" ","type":"text"},{"text":"How can you catch events and process them","type":"text"}],"type":"section","url":"\/tutorials\/adaengine\/eventlisteners#Additional-for-physics"},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText":{"role":"project","title":"Animated Text Renderer","kind":"project","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText","estimatedTime":"20min","abstract":[{"type":"text","text":"Create a custom "},{"type":"codeVoice","code":"TextRenderer"},{"type":"text","text":" that draws text along a sine wave and animate it by updating renderer state."}],"type":"topic","url":"\/tutorials\/adaengine\/animatedtext"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Move-and-rumble":{"type":"section","title":"Move and rumble","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Move-and-rumble","url":"\/tutorials\/adaengine\/gamepadinput#Move-and-rumble","abstract":[{"type":"text","text":"Build a small scene that spawns a player entity and moves it with a gamepad."}],"kind":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics#Create-the-app-shell":{"role":"pseudoSymbol","kind":"section","title":"Create the app shell","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Create-the-app-shell","abstract":[{"text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state.","type":"text"}],"type":"section","url":"\/tutorials\/adaengine\/uibasics#Create-the-app-shell"},"EL-2-5-physics.swift":{"fileName":"PhysicsHandler.swift","content":["import AdaEngine","","@MainActor","struct EventListenerPlugin: Plugin {","    @Local var disposeBag: Set<AnyCancellable> = []","","    func setup(in app: borrowing AppWorlds) {","        app.main","            .subscribe(to: SceneEvents.OnReady.self) { event in","                Task { @MainActor in","                    event.scene.world.physicsWorld2D?.gravity = .zero","                }","            }","            .store(in: &self.disposeBag)","    }","}"],"identifier":"EL-2-5-physics.swift","highlights":[],"syntax":"swift","type":"file","fileType":"swift"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Base-of-Event-Subscriber-pattern":{"role":"pseudoSymbol","kind":"section","title":"Base of Event-Subscriber pattern","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Base-of-Event-Subscriber-pattern","abstract":[{"type":"text","text":"In this tutorial you will learn about the event listeners system in Ada."},{"type":"text","text":" "},{"type":"text","text":"How can you catch events and process them"}],"type":"section","url":"\/tutorials\/adaengine\/eventlisteners#Base-of-Event-Subscriber-pattern"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Type-of-events":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Type-of-events","title":"Type of events","url":"\/tutorials\/adaengine\/eventlisteners#Type-of-events","abstract":[{"type":"text","text":"In this tutorial you will learn about the event listeners system in Ada."},{"type":"text","text":" "},{"type":"text","text":"How can you catch events and process them"}],"kind":"section","role":"pseudoSymbol"},"EL-2-4-events.swift":{"highlights":[],"type":"file","identifier":"EL-2-4-events.swift","fileName":"Events.swift","fileType":"swift","syntax":"swift","content":["\/\/\/ Events the scene triggers.","public enum SceneEvents {","","    \/\/\/ An event triggered once when scene is ready to use and will starts update soon.","    public struct OnReady: Event {","        public let scene: Scene","    }","","    \/\/\/ Raised after an entity is added to the scene.","    public struct DidAddEntity: Event {","        public let entity: Entity","    }","","    \/\/\/ Raised before an entity is removed from the scene.","    public struct WillRemoveEntity: Event {","        public let entity: Entity","    }","","    \/\/\/ An event triggered once per frame interval that you can use to execute custom logic for each frame.","    public struct Update: Event {","","        \/\/\/ The updated scene.","        public let scene: Scene","","        \/\/\/ The elapsed time since the last update.","        public let deltaTime: TimeInterval","    }","}","","\/\/\/ Events associated with collisions.","public enum CollisionEvents {","","    \/\/\/ An event raised when two objects collide.","    public struct Began: Event {","","        \/\/\/ The first entity involved in the collision.","        public let entityA: Entity","","        \/\/\/ The second entity involved in the collision.","        public let entityB: Entity","","        \/\/\/ The estimated strength of the impact.","        public let impulse: Float","    }","","    \/\/\/ An event raised when two objects, previously in contact, separate.","    public struct Ended: Event {","","        \/\/\/ The first entity involved in the collision.","        public let entityA: Entity","","        \/\/\/ The second entity involved in the collision.","        public let entityB: Entity","    }","}"]},"doc://AdaEngine/tutorials/AdaEngine/PlayerAndText":{"role":"project","kind":"project","title":"Player and Text in Ada","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText","estimatedTime":"5min","abstract":[{"type":"text","text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene."}],"type":"topic","url":"\/tutorials\/adaengine\/playerandtext"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics#Layout-with-stacks":{"type":"section","title":"Layout with stacks","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Layout-with-stacks","url":"\/tutorials\/adaengine\/uibasics#Layout-with-stacks","abstract":[{"type":"text","text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state."}],"kind":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics#Debug-overlays":{"role":"pseudoSymbol","kind":"section","title":"Debug overlays","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Debug-overlays","abstract":[{"text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state.","type":"text"}],"type":"section","url":"\/tutorials\/adaengine\/uibasics#Debug-overlays"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Set-up-the-world":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Set-up-the-world","title":"Set up the world","url":"\/tutorials\/adaengine\/gamepadinput#Set-up-the-world","abstract":[{"type":"text","text":"Build a small scene that spawns a player entity and moves it with a gamepad."}],"kind":"section","role":"pseudoSymbol"},"doc://AdaEngine/tutorials/AdaEngine/CreateProject":{"role":"project","kind":"project","title":"Create your first game project","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject","estimatedTime":"5min","abst