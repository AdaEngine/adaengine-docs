{"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"generated":true,"anchor":"Guides","identifiers":["doc:\/\/AdaEngine\/documentation\/AdaEngine\/Building","doc:\/\/AdaEngine\/documentation\/AdaEngine\/Contributing","doc:\/\/AdaEngine\/documentation\/AdaEngine\/AdaUIIdentity","doc:\/\/AdaEngine\/documentation\/AdaEngine\/ImageDecoders","doc:\/\/AdaEngine\/documentation\/AdaEngine\/AnimationAuthoring","doc:\/\/AdaEngine\/documentation\/AdaEngine\/CharacterLocomotion3D","doc:\/\/AdaEngine\/documentation\/AdaEngine\/AnimationIK","doc:\/\/AdaEngine\/documentation\/AdaEngine\/Atmosphere","doc:\/\/AdaEngine\/documentation\/AdaEngine\/MovieMaker","doc:\/\/AdaEngine\/documentation\/AdaEngine\/PipelinedRendering","doc:\/\/AdaEngine\/documentation\/AdaEngine\/DLSSUpscaling","doc:\/\/AdaEngine\/documentation\/AdaEngine\/HardwarePathTracing","doc:\/\/AdaEngine\/documentation\/AdaEngine\/Terrain","doc:\/\/AdaEngine\/documentation\/AdaEngine\/ProceduralNoise","doc:\/\/AdaEngine\/documentation\/AdaEngine\/VisionOSWindowed"],"title":"Guides"}],"hierarchy":{"paths":[["doc:\/\/AdaEngine\/documentation\/AdaEngine"]]},"variants":[{"paths":["\/documentation\/adaengine\/gamediagnosticsoverlay"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/GameDiagnosticsOverlay","interfaceLanguage":"swift"},"sections":[],"abstract":[{"type":"text","text":"See the game’s update rate while you play. The overlay shows "},{"inlineContent":[{"type":"text","text":"FPS"}],"type":"strong"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"Frame time"}]},{"type":"text","text":" in the top-left corner of the game window. Mouse and keyboard"},{"type":"text","text":" "},{"type":"text","text":"input still reach the game under the overlay."}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"AdaEngine"}],"title":"Game diagnostics overlay"},"primaryContentSections":[{"content":[{"anchor":"Enable-it-in-Ada-Studio","text":"Enable it in Ada Studio","level":2,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Open the build-target picker and choose ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Edit Build Targets…"}]},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select a target with a local desktop ","type":"text"},{"inlineContent":[{"text":"Run Destination","type":"text"}],"type":"strong"},{"text":", then turn on","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"Diagnostics overlay","type":"text"}],"type":"strong"},{"text":" and select ","type":"text"},{"inlineContent":[{"text":"Save Build Targets","type":"text"}],"type":"strong"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Run the selected target. The first readings appear after about one second.","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"text":"For example, duplicate the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Main"}]},{"text":" target, call the copy ","type":"text"},{"type":"strong","inlineContent":[{"text":"Performance","type":"text"}]},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"enable the overlay only for that copy. Run ","type":"text"},{"type":"strong","inlineContent":[{"text":"Performance","type":"text"}]},{"text":" to inspect frame","type":"text"},{"text":" ","type":"text"},{"text":"pacing, then select and run ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Main"}]},{"text":" to play without the readout.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The setting applies to local product runs on Windows, macOS, and Linux for"},{"type":"text","text":" "},{"type":"text","text":"AdaScript games and compatible Swift apps. It works in both Debug and Release."},{"type":"text","text":" "},{"type":"text","text":"It is off by default and applies on the next run. Scene-document Play, debugger"},{"type":"text","text":" "},{"type":"text","text":"sessions, AdaPlayer, exports, and Movie Maker run independently of this setting."}]},{"type":"heading","text":"Enable it from a shell","level":2,"anchor":"Enable-it-from-a-shell"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a Swift app using "},{"type":"codeVoice","code":"DefaultAppWindow"},{"type":"text","text":" or "},{"type":"codeVoice","code":"WindowGroup"},{"text":", set the environment","type":"text"},{"text":" ","type":"text"},{"text":"variable when you launch the product. The app must be built with an AdaEngine","type":"text"},{"text":" ","type":"text"},{"text":"version that includes the overlay.","type":"text"}]},{"syntax":"bash","type":"codeListing","code":["ADAENGINE_DIAGNOSTICS_OVERLAY=1 swift run -c release"]},{"syntax":"powershell","type":"codeListing","code":["$env:ADAENGINE_DIAGNOSTICS_OVERLAY = '1'","swift run -c release","Remove-Item Env:ADAENGINE_DIAGNOSTICS_OVERLAY"]},{"type":"heading","level":2,"text":"Read the numbers","anchor":"Read-the-numbers"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"FPS"}],"type":"strong"},{"type":"text","text":" is the number of game update intervals per second. "},{"type":"strong","inlineContent":[{"text":"Frame time","type":"text"}]},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"average duration of those intervals in milliseconds. At a steady 60 FPS, it"},{"type":"text","text":" "},{"type":"text","text":"reads about 16.7 ms. Both numbers include frame pacing and stalls between"},{"type":"text","text":" "},{"type":"text","text":"updates. They describe the game’s update loop. Use profiling tools to measure"},{"type":"text","text":" "},{"type":"text","text":"GPU work or investigate individual slow systems."}]},{"inlineContent":[{"type":"text","text":"The overlay refreshes its text about once per second. It displays dashes while"},{"type":"text","text":" "},{"type":"text","text":"collecting the first sample window and after an explicit simulation pause."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://AdaEngine/documentation/AdaEngine":{"abstract":[{"text":"Bringing simple and powerful game engine for your awesome games.","type":"text"}],"identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine","role":"collection","type":"topic","url":"\/documentation\/adaengine","kind":"symbol","title":"AdaEngine"},"doc://AdaEngine/documentation/AdaEngine/MovieMaker":{"identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/MovieMaker","abstract":[{"type":"text","text":"Records a fresh game world at a fixed simulation rate, waiting for every GPU"},{"type":"text","text":" "},{"type":"text","text":"frame and disk write before advancing. Rendering speed never drops movie frames."},{"type":"text","text":" "},{"type":"text","text":"Configure the same gameplay plugins and cameras as your game in "},{"code":"make","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Platform\/window plugins are unnecessary for this offscreen runtime."}],"role":"symbol","kind":"symbol","title":"MovieMaker","navigatorTitle":[{"kind":"identifier","text":"MovieMaker"}],"type":"topic","url":"\/documentation\/adaengine\/moviemaker","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MovieMaker"}]},"doc://AdaEngine/documentation/AdaEngine/AnimationAuthoring":{"url":"\/documentation\/adaengine\/animationauthoring","abstract":[{"type":"text","text":"Copy an imported animation or capture a rest\/current pose into a project-owned"},{"text":" ","type":"text"},{"type":"codeVoice","code":".animlib"},{"type":"text","text":" resource. Source GLB\/glTF bytes remain unchanged. Swift code, Studio’s"},{"type":"text","text":" "},{"text":"Animator, the editor agent and project Tools share the same data and edit commands.","type":"text"}],"role":"article","type":"topic","kind":"article","title":"Authoring skeletal animation","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/AnimationAuthoring"},"doc://AdaEngine/documentation/AdaEngine/Terrain":{"url":"\/documentation\/adaengine\/terrain","abstract":[{"type":"text","text":"Create editable ground with "},{"type":"codeVoice","code":"Terrain3D"},{"type":"text","text":". Its heights describe one square surface"},{"type":"text","text":" "},{"type":"text","text":"in the entity’s local X\/Z plane. "},{"code":"Model3DPlugin","type":"codeVoice"},{"text":" generates the visible geometry;","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"Physics3DPlugin"},{"text":" adds matching static triangle collision.","type":"text"}],"role":"article","type":"topic","title":"Terrain","kind":"article","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/Terrain"},"doc://AdaEngine/documentation/AdaEngine/CharacterLocomotion3D":{"role":"article","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/CharacterLocomotion3D","url":"\/documentation\/adaengine\/characterlocomotion3d","kind":"article","abstract":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"CharacterLocomotion3DComponent"},{"type":"text","text":" to play skeletal animations from an upright 3D character’s"},{"text":" ","type":"text"},{"type":"text","text":"actual movement. Add it to the root entity that owns the character controller and skinned model."},{"text":" ","type":"text"},{"type":"text","text":"Your input or AI continues to set "},{"code":"desiredVelocity","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"jumpRequested"},{"type":"text","text":". Locomotion reads the"},{"type":"text","text":" "},{"text":"resolved motion after physics, so holding forward against a wall can leave the character idle.","type":"text"}],"type":"topic","title":"Animate a 3D character from movement"},"doc://AdaEngine/documentation/AdaEngine/Building":{"abstract":[{"text":"This guide covers two scenarios:","type":"text"}],"identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/Building","role":"article","type":"topic","kind":"article","title":"Building Ada","url":"\/documentation\/adaengine\/building"},"doc://AdaEngine/documentation/AdaEngine/AnimationIK":{"abstract":[{"type":"text","text":"Constrain a skeletal chain after its clip, Animation Graph and visual LOD pose have been mixed."}],"role":"article","kind":"article","url":"\/documentation\/adaengine\/animationik","type":"topic","title":"Animation IK and pose modifiers","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/AnimationIK"},"doc://AdaEngine/documentation/AdaEngine/HardwarePathTracing":{"abstract":[{"type":"text","text":"Let a path-traced view find ray intersections with the GPU’s ray-tracing hardware instead of a shader BVH. The image,"},{"type":"text","text":" "},{"type":"text","text":"lighting and denoisers stay the same; only the intersection step changes, and the shader BVH remains the fallback"},{"text":" ","type":"text"},{"text":"wherever hardware cannot be used.","type":"text"}],"url":"\/documentation\/adaengine\/hardwarepathtracing","role":"article","kind":"article","title":"Hardware Path Tracing","type":"topic","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/HardwarePathTracing"},"doc://AdaEngine/documentation/AdaEngine/Atmosphere":{"url":"\/documentation\/adaengine\/atmosphere","abstract":[{"type":"text","text":"Give a 3D camera a physically based sky. The atmosphere scatters the sun’s light"},{"type":"text","text":" "},{"text":"the way air does, so the sky turns from blue at noon to orange near the horizon","type":"text"},{"type":"text","text":" "},{"type":"text","text":"and dark at night, the sun appears as a disc that the air reddens, and distant"},{"type":"text","text":" "},{"type":"text","text":"geometry fades into haze."}],"role":"article","kind":"article","title":"Atmosphere","type":"topic","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/Atmosphere"},"doc://AdaEngine/documentation/AdaEngine/ProceduralNoise":{"abstract":[{"text":"Use a noise generator as a deterministic scalar field for terrain heights,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"procedural placement, or volume density. Import "},{"type":"codeVoice","code":"Math"},{"type":"text","text":" directly, or use its"},{"type":"text","text":" "},{"type":"text","text":"re-export from "},{"type":"codeVoice","code":"AdaEngine"},{"type":"text","text":". No GPU or editor state is needed."}],"url":"\/documentation\/adaengine\/proceduralnoise","role":"article","kind":"article","type":"topic","title":"Procedural Noise","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/ProceduralNoise"},"doc://AdaEngine/documentation/AdaEngine/Contributing":{"abstract":[{"text":"We welcome contributions of all kinds: bug fixes, features, documentation, and examples.","type":"text"}],"identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/Contributing","role":"article","kind":"article","title":"Contributing to Ada","type":"topic","url":"\/documentation\/adaengine\/contributing"},"doc://AdaEngine/documentation/AdaEngine/AdaUIIdentity":{"role":"article","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/AdaUIIdentity","url":"\/documentation\/adaengine\/adauiidentity","kind":"article","abstract":[{"type":"text","text":"AdaUI reconciles a new view tree against the mounted "},{"type":"codeVoice","code":"ViewNode"},{"text":" tree. A node is preserved only when the new node and old node describe the same identity and the new node can update the old node. Preserved nodes keep their ","type":"text"},{"type":"codeVoice","code":"@State"},{"type":"text","text":", focus state, in-flight animation controllers, layers, and other node-local runtime state. Recreated nodes start with fresh runtime state."}],"type":"topic","title":"AdaUI View Identity"},"doc://AdaEngine/documentation/AdaEngine/PipelinedRendering":{"role":"article","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/PipelinedRendering","url":"\/documentation\/adaengine\/pipelinedrendering","kind":"article","abstract":[{"type":"text","text":"Render a scene one frame behind its simulation to overlap rendering with the next frame’s work."}],"type":"topic","title":"Pipelined Rendering"},"doc://AdaEngine/documentation/AdaEngine/ImageDecoders":{"role":"article","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/ImageDecoders","url":"\/documentation\/adaengine\/imagedecoders","kind":"article","abstract":[{"text":"Load PNG, JPEG (","type":"text"},{"code":"jpg","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"jpeg","type":"codeVoice"},{"text":"), BMP and TGA images as CPU pixels using","type":"text"},{"text":" ","type":"text"},{"code":"Image","type":"codeVoice"},{"text":", or load a GPU texture through ","type":"text"},{"code":"Texture2D","type":"codeVoice"},{"text":":","type":"text"}],"type":"topic","title":"Loading images and adding formats"},"doc://AdaEngine/documentation/AdaEngine/VisionOSWindowed":{"identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/VisionOSWindowed","url":"\/documentation\/adaengine\/visionoswindowed","role":"article","kind":"article","title":"visionOS Windowed Mode","type":"topic","abstract":[{"type":"text","text":"Run Ada apps in visionOS Shared Space using the existing "},{"type":"codeVoice","code":"WindowGroup"},{"type":"text","text":" scene model."}]},"doc://AdaEngine/documentation/AdaEngine/DLSSUpscaling":{"role":"article","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/DLSSUpscaling","url":"\/documentation\/adaengine\/dlssupscaling","kind":"article","abstract":[{"text":"Render a 3D view below its output resolution and reconstruct it with NVIDIA DLSS Super Resolution, or denoise a","type":"text"},{"text":" ","type":"text"},{"text":"path-traced view with DLSS Ray Reconstruction. DLSS is optional: without it a camera uses the portable temporal","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"reconstruction that ships with the engine, and nothing else changes."}],"type":"topic","title":"DLSS Upscaling"}}}