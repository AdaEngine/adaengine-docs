essed\")","            }","","            if gamepad.isGamepadButtonPressed(.b) {","                print(\"Gamepad \\(gamepad.gamepadId): Button B pressed\")","            }","        }","    }","}"],"identifier":"GP-2-3-system.swift","highlights":[{"line":25},{"line":26},{"line":27},{"line":28},{"line":29},{"line":30},{"line":31}],"syntax":"swift","type":"file","fileType":"swift"},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Create-a-custom-TextRenderer":{"url":"\/tutorials\/adaengine\/animatedtext#Create-a-custom-TextRenderer","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-a-custom-TextRenderer","abstract":[{"text":"Create a custom ","type":"text"},{"code":"TextRenderer","type":"codeVoice"},{"text":" that draws text along a sine wave and animate it by updating renderer state.","type":"text"}],"role":"pseudoSymbol","type":"section","kind":"section","title":"Create a custom TextRenderer"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene":{"role":"project","title":"Create your first 2D scene","kind":"project","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene","estimatedTime":"20min","abstract":[{"text":"In this tutorial, you will learn how to create your first 2D scene using Ada.","type":"text"}],"url":"\/tutorials\/adaengine\/createfirst2dscene","type":"topic"},"GP-1-2-app.swift":{"fileType":"swift","syntax":"swift","highlights":[{"line":18},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23}],"identifier":"GP-1-2-app.swift","content":["import AdaEngine","","@Component","struct PlayerComponent {}","","@main","struct GamepadInputApp: App {","    var body: some AppScene {","        DefaultAppWindow()","            .transformAppWorlds { appWorld in","                appWorld.spawn(","                    \"Camera\",","                    bundle: Camera2D(","                        camera: Camera(),","                        transform: Transform(position: [0, 0, 0])","                    )","       