{"abstract":[{"type":"text","text":"Add an "},{"code":".ada","type":"codeVoice"},{"type":"text","text":" file to an AdaEngine executable and run its systems without manually loading each script."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage"],"title":"Essentials","generated":true,"anchor":"Essentials"}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"Ada Script"}],"title":"Getting Started with Ada Script"},"hierarchy":{"paths":[["doc:\/\/AdaScripting\/documentation\/AdaScripting"]]},"kind":"article","identifier":{"url":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adascripting\/gettingstartedwithadascript"]}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"inlineContent":[{"text":"AdaEngine provides two ways to install Ada Script plugins:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Automatic discovery"}]},{"type":"text","text":" embeds every "},{"code":".ada","type":"codeVoice"},{"type":"text","text":" file in an executable target at"},{"type":"text","text":" "},{"type":"text","text":"build time and generates one plugin backed by one target-level script module."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Manual loading"}]},{"type":"text","text":" creates an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin"},{"type":"text","text":" from source text or a file URL at runtime."}]}]}]},{"inlineContent":[{"text":"AdaEditor-created projects use automatic discovery. Use manual loading when scripts live outside the Swift target, come from a downloaded package, or need explicit error handling.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Create a script","level":2,"anchor":"Create-a-script"},{"inlineContent":[{"text":"Add ","type":"text"},{"code":"Movement.ada","type":"codeVoice"},{"text":" anywhere below the executable target’s source directory, for example:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"text","code":["Sources\/MyGame\/","├── main.swift","└── Scripts\/","    └── Movement.ada"]},{"inlineContent":[{"text":"Declare a system and its query with annotations:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"ada","code":["@system(scheduler: \"update\")","class MovementSystem {","    @query(Transform)","    var transforms;","","    func update(context) {","        for (var entity in transforms) {","            var position = entity.transform.position;","            position[0] += 100 * context.deltaTime;","            entity.transform.position = position;","        }","    }","}"]},{"inlineContent":[{"text":"AdaEngine discovers ","type":"text"},{"code":"@system","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@query","type":"codeVoice"},{"text":" metadata and calls ","type":"text"},{"code":"update(context)","type":"codeVoice"},{"text":" whenever the selected scheduler runs.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Enable automatic discovery","level":2,"anchor":"Enable-automatic-discovery"},{"inlineContent":[{"text":"Expose ","type":"text"},{"code":"AdaScriptBuildPlugin","type":"codeVoice"},{"text":" to your executable target in ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ swift-tools-version: 6.2","import PackageDescription","","let package = Package(","    name: \"MyGame\",","    platforms: [","        .macOS(.v15)","    ],","    dependencies: [","        .package(","            url: \"https:\/\/github.com\/AdaEngine\/AdaEngine.git\",","            branch: \"main\"","        )","    ],","    targets: [","        .executableTarget(","            name: \"MyGame\",","            dependencies: [","                .product(name: \"AdaEngine\", package: \"AdaEngine\")","            ],","            plugins: [","                .plugin(name: \"AdaScriptBuildPlugin\", package: \"AdaEngine\")","            ]","        )","    ]",")"]},{"type":"aside","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Choose a version requirement appropriate for your project instead of a branch dependency when consuming a released AdaEngine version."}]}],"name":"Important"},{"inlineContent":[{"text":"The build plugin finds ","type":"text"},{"code":".ada","type":"codeVoice"},{"text":" files through SwiftPM, sorts them by target-relative","type":"text"},{"text":" ","type":"text"},{"text":"path, and generates ","type":"text"},{"code":"AdaScriptPluginsGenerated.swift","type":"codeVoice"},{"text":" in the plugin work","type":"text"},{"text":" ","type":"text"},{"text":"directory. The generated plugin passes one source map to one","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin","isActive":true},{"text":". Script source is embedded in the executable; the","type":"text"},{"text":" ","type":"text"},{"text":"original files are not read at runtime.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Install the generated plugin in your app scene:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import AdaEngine","","@main","struct MyGame: App {","    var body: some AppScene {","        WindowGroup {","            GameView()","        }","        .addPlugins(AdaScriptPluginsGenerated())","    }","}"]},{"inlineContent":[{"text":"Rebuilding the target after adding, removing, renaming, or editing an ","type":"text"},{"code":".ada","type":"codeVoice"},{"text":" file refreshes the generated source.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The same generated source contains native backing structs and registration for","type":"text"},{"text":" ","type":"text"},{"text":"scalar ","type":"text"},{"code":"@component","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@resource","type":"codeVoice"},{"text":" declarations. Because these declarations","type":"text"},{"text":" ","type":"text"},{"text":"change Swift layout, adding or editing their stored fields requires rebuilding","type":"text"},{"text":" ","type":"text"},{"text":"the target rather than source-only reload.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Register custom components","level":2,"anchor":"Register-custom-components"},{"inlineContent":[{"text":"Ada Script resolves component names while plugins are set up. Register custom Swift components before the generated script plugin:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import AdaEngine","","@Component","struct Movement: Codable, Sendable {","    var velocity: Vector2","}","","struct GameComponentsPlugin: Plugin {","    @MainActor","    func setup(in app: borrowing AppWorlds) {","        Movement.registerComponent()","    }","}","","@main","struct MyGame: App {","    var body: some AppScene {","        WindowGroup {","            GameView()","        }","        .addPlugins(","            GameComponentsPlugin(),","            AdaScriptPluginsGenerated()","        )","    }","}"]},{"inlineContent":[{"text":"The ","type":"text"},{"code":"@Component","type":"codeVoice"},{"text":" macro supplies field reflection for supported property types. A plain ","type":"text"},{"code":"Component","type":"codeVoice"},{"text":" can participate in query matching, but its fields are not automatically available through the script bridge.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Load a script manually","level":2,"anchor":"Load-a-script-manually"},{"inlineContent":[{"text":"Create an ","type":"text"},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin","isActive":true},{"text":" when you need control over the source location or loading failure:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import AdaEngine","","struct RuntimeScriptsPlugin: Plugin {","    let scriptURL: URL","","    @MainActor","    func setup(in app: borrowing AppWorlds) {","        do {","            let script = try AdaScriptPlugin(contentsOf: scriptURL)","            app.addPlugin(script)","        } catch {","            print(\"Could not load Ada Script: \\(error)\")","        }","    }","}"]},{"inlineContent":[{"text":"You can also use ","type":"text"},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin\/init(source:name:)","isActive":true},{"text":" when one source is","type":"text"},{"text":" ","type":"text"},{"text":"already in memory, or ","type":"text"},{"code":"AdaScriptPlugin\/init(sources:name:)","type":"codeVoice"},{"text":" with","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptSource","isActive":true},{"text":" values for a multi-file module. Script compilation,","type":"text"},{"text":" ","type":"text"},{"text":"import resolution, and annotation validation happen during initialization.","type":"text"},{"text":" ","type":"text"},{"text":"Native component resolution happens later during plugin setup.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Next steps","level":2,"anchor":"Next-steps"},{"inlineContent":[{"text":"Read ","type":"text"},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage","isActive":true},{"text":" for annotation syntax, then ","type":"text"},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS","isActive":true},{"text":" for queries, component fields, and native iterator behavior.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"references":{"doc://AdaScripting/documentation/AdaScripting":{"role":"collection","type":"topic","kind":"symbol","url":"\/documentation\/adascripting","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting","title":"Ada Script","abstract":[{"type":"text","text":"Write gameplay systems in Ada Script while keeping entity filtering and access planning in AdaEngine’s native ECS."}]},"doc://AdaScripting/documentation/AdaScripting/AdaScriptPlugin":{"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin","navigatorTitle":[{"kind":"identifier","text":"AdaScriptPlugin"}],"role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"AdaScriptPlugin"}],"title":"AdaScriptPlugin","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Loads an annotation-driven Ada Script module."}],"url":"\/documentation\/adascripting\/adascriptplugin"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptSource":{"fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptSource","kind":"identifier"}],"kind":"symbol","title":"AdaScriptSource","type":"topic","abstract":[{"type":"text","text":"One source file embedded in an Ada Script module."}],"role":"symbol","url":"\/documentation\/adascripting\/adascriptsource","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptSource","navigatorTitle":[{"text":"AdaScriptSource","kind":"identifier"}]},"doc://AdaScripting/documentation/AdaScripting/AdaScriptECS":{"role":"article","type":"topic","kind":"article","url":"\/documentation\/adascripting\/adascriptecs","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS","title":"Ada Script ECS","abstract":[{"type":"text","text":"Declare annotation-driven systems and iterate native AdaECS component columns."}]},"doc://AdaScripting/documentation/AdaScripting/AdaScriptPlugin/init(source:name:)":{"fragments":[{"text":"convenience","kind":"keyword"},{"text":" ","kind":"text"},{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"source","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"name","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"kind":"symbol","title":"init(source:name:)","type":"topic","abstract":[],"role":"symbol","url":"\/documentation\/adascripting\/adascriptplugin\/init(source:name:)","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin\/init(source:name:)"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptLanguage":{"role":"article","type":"topic","kind":"article","url":"\/documentation\/adascripting\/adascriptlanguage","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage","title":"Ada Script Language","abstract":[{"type":"text","text":"Use Ada Script syntax with AdaEngine declaration annotations."}]}}}