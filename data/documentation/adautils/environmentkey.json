{"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"EnvironmentKey"}],"roleHeading":"Protocol","role":"symbol","title":"EnvironmentKey","symbolKind":"protocol","externalID":"s:8AdaUtils14EnvironmentKeyP","modules":[{"name":"AdaUtils"}],"navigatorTitle":[{"text":"EnvironmentKey","kind":"identifier"}]},"sections":[],"topicSections":[{"anchor":"Associated-Types","identifiers":["doc:\/\/AdaUtils\/documentation\/AdaUtils\/EnvironmentKey\/Value"],"generated":true,"title":"Associated Types"},{"anchor":"Type-Properties","identifiers":["doc:\/\/AdaUtils\/documentation\/AdaUtils\/EnvironmentKey\/defaultValue"],"generated":true,"title":"Type Properties"}],"abstract":[{"text":"A key for accessing values in the environment.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adautils\/environmentkey"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"EnvironmentKey"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"inlineContent":[{"type":"text","text":"You can create custom environment values by extending the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AdaUtils\/documentation\/AdaUtils\/EnvironmentValues"},{"type":"text","text":" structure with new properties."},{"type":"text","text":" "},{"type":"text","text":"First declare a new environment key type and specify a value for the required defaultValue property:"}],"type":"paragraph"},{"syntax":"swift","code":["private struct MyEnvironmentKey: EnvironmentKey {","    static let defaultValue: String = \"Default value\"","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Then use the key to define a new environment value property:"}],"type":"paragraph"},{"syntax":"swift","code":["extension EnvironmentValues {","    var myCustomValue: String {","        get { self[MyEnvironmentKey.self] }","        set { self[MyEnvironmentKey.self] = newValue }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Clients of your environment value never use the key directly. Instead, they use the key path of your"},{"type":"text","text":" "},{"type":"text","text":"custom environment value property. To set the environment value for a view and all its subviews,"},{"type":"text","text":" "},{"type":"text","text":"add the "},{"type":"codeVoice","code":"View\/environment(_:_:)"},{"type":"text","text":" view modifier to that view:"}],"type":"paragraph"},{"syntax":"swift","code":["MyView()","   .environment(\\.myCustomValue, \"Another string\")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"To read the value from inside MyView or one of its descendants, use the "},{"type":"codeVoice","code":"Environment"},{"type":"text","text":" property wrapper:"}],"type":"paragraph"},{"syntax":"swift","code":["struct MyView: View {","    @Environment(\\.myCustomValue) var customValue: String","","    var body: some View {","        Text(customValue) \/\/ Displays \"Another string\".","    }","}"],"type":"codeListing"}]}],"hierarchy":{"paths":[["doc:\/\/AdaUtils\/documentation\/AdaUtils"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/AdaUtils\/documentation\/AdaUtils\/EnvironmentKey","interfaceLanguage":"swift"},"references":{"doc://AdaUtils/documentation/AdaUtils/EnvironmentValues":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EnvironmentValues","kind":"identifier"}],"navigatorTitle":[{"text":"EnvironmentValues","kind":"identifier"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"A collection of environment values propagated through a view hierarchy."}],"title":"EnvironmentValues","url":"\/documentation\/adautils\