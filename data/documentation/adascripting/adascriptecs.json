{"primaryContentSections":[{"content":[{"anchor":"Declare-a-system","text":"Declare a system","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Apply "},{"type":"codeVoice","code":"@system"},{"type":"text","text":" to a class and implement "},{"type":"codeVoice","code":"update(context)"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"ada","code":["@system(scheduler: \"update\", id: \"game.movement\")","class MovementSystem {","    func update(context) {","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The scheduler defaults to "},{"type":"codeVoice","code":"update"},{"type":"text","text":". System identifiers must be unique within a"},{"type":"text","text":" "},{"type":"text","text":"script module."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For one-time world setup, use "},{"type":"codeVoice","code":"@system(scheduler: \"startup\")"},{"type":"text","text":". Its"},{"type":"text","text":" "},{"type":"codeVoice","code":"update(context)"},{"type":"text","text":" runs on the default scheduler runner’s first update, before"},{"type":"text","text":" "},{"type":"text","text":"the regular frame stages. A script class constructor does not receive a world"},{"type":"text","text":" "},{"type":"text","text":"context. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations"},{"type":"text","text":" for all annotation arguments."}],"type":"paragraph"},{"anchor":"Order-systems","text":"Order systems","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Use repeatable "},{"type":"codeVoice","code":"@after"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@before"},{"type":"text","text":" annotations when component and resource"},{"type":"text","text":" "},{"type":"text","text":"access alone does not express the required execution order:"}],"type":"paragraph"},{"syntax":"ada","code":["@after(id: \"game.input\")","@before(id: \"game.physics\")","@system(scheduler: \"update\", id: \"game.movement\")","class MovementSystem {","    func update(context) {","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Dependency IDs resolve within the same AdaScript module. Both systems must use"},{"type":"text","text":" "},{"type":"text","text":"the same scheduler. AdaScript rejects unknown IDs, self-dependencies, and"},{"type":"text","text":" "},{"type":"text","text":"dependency cycles while loading the module."}],"type":"paragraph"},{"anchor":"Declare-a-query","text":"Declare a query","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Apply "},{"type":"codeVoice","code":"@query"},{"type":"text","text":" to a stored system property:"}],"type":"paragraph"},{"syntax":"ada","code":["@query(","    Health,","    Movement,","    with: Movable,","    without: Frozen",")","var entities;"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Positional components are fetched and available on each row. "},{"type":"codeVoice","code":"with"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"without"},{"type":"text","text":" only filter matching archetypes."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Aliases use lower-camel-case component names:"}],"type":"paragraph"},{"syntax":"ada","code":["for (var entity in entities) {","    var position = entity.movement.position;","    entity.health.current -= 1.0;","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"entity.id"},{"type":"text","text":" exposes the native entity identifier."}],"type":"paragraph"},{"anchor":"Iterator-behavior","text":"Iterator behavior","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Ada Script queries are native iterators. AdaECS resolves matching archetypes,"},{"type":"text","text":" "},{"type":"text","text":"binds component columns when entering a chunk, and advances their pointers by"},{"type":"text","text":" "},{"type":"text","text":"row stride. The bridge does not create an entity proxy for every result and"},{"type":"text","text":" "},{"type":"text","text":"does not perform a world component lookup for every field access."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A query row and its component views are borrowed. Do not retain them after the"},{"type":"text","text":" "},{"type":"text","text":"loop or system update returns. Structural changes must use deferred commands."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Inactive entities are skipped. Empty queries execute zero loop iterations."}],"type":"paragraph"},{"anchor":"Component-fields","text":"Component fields","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"@Component"},{"type":"text","text":" Swift macro generates the runtime field accessors used by Ada"},{"type":"text","text":" "},{"type":"text","text":"Script. Register native components before the script plugin is set up."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Supported field values include booleans, integers, finite floating-point"},{"type":"text","text":" "},{"type":"text","text":"values, strings, vectors, quaternions, colors, and reflected enums. A rejected"},{"type":"text","text":" "},{"type":"text","text":"write leaves the component unchanged and appends a development diagnostic."}],"type":"paragraph"},{"anchor":"Access-planning","text":"Access planning","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The current implementation conservatively declares write access for fetched"},{"type":"text","text":" "},{"type":"text","text":"components. This keeps scheduling correct while compiler-level read\/write"},{"type":"text","text":" "},{"type":"text","text":"inference is completed. Filter-only components do not receive write access."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The intended final behavior derives read and write sets from row field usage,"},{"type":"text","text":" "},{"type":"text","text":"with explicit "},{"type":"codeVoice","code":"@access"},{"type":"text","text":" metadata as the escape hatch for dynamic code."}],"type":"paragraph"},{"anchor":"Multiple-queries","text":"Multiple queries","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"One system may declare multiple independent iterators:"}],"type":"paragraph"},{"syntax":"ada","code":["@system(scheduler: \"update\")","class TargetingSystem {","    @query(Player, Transform)","    var players;","","    @query(Enemy, Target, without: Dead)","    var enemies;","","    func update(context) {","        for (var enemy in enemies) {","            for (var player in players) {","                enemy.target.entity = player.id;","                break;","            }","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Queries are refreshed by the scheduler before each system execution."}],"type":"paragraph"},{"anchor":"Project-input-actions","text":"Project input actions","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"type":"text","text":"Project Settings → Input Bindings"}]},{"type":"text","text":", add an action such as "},{"code":"Jump","type":"codeVoice"},{"type":"text","text":", then add"},{"type":"text","text":" "},{"type":"text","text":"keyboard, mouse, gamepad or touch bindings. Click "},{"inlineContent":[{"type":"text","text":"Save Project Settings"}],"type":"strong"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Actions are stored in "},{"code":".ada\/project.json","type":"codeVoice"},{"type":"text","text":" and loaded by both Play Mode and the"},{"type":"text","text":" "},{"type":"text","text":"AdaScript project runtime. Multiple bindings act as alternatives: releasing one"},{"type":"text","text":" "},{"type":"text","text":"input does not release the action while another binding is held."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Systems and scriptable components declare input as a read-only resource dependency"},{"type":"text","text":" "},{"type":"text","text":"with "},{"code":"@res var input: Input;","type":"codeVoice"},{"type":"text","text":". Only declarations that request Input receive it."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"codeVoice","code":"@res(optional: true) var input: Input;"},{"type":"text","text":" and "},{"code":"input.available()","type":"codeVoice"},{"type":"text","text":" when the"},{"type":"text","text":" "},{"type":"text","text":"resource may be absent; a missing required resource produces a diagnostic."}],"type":"paragraph"},{"code":["@res var input: Input;","","func update(context) {","    if (input.isActionJustPressed(\"Jump\")) {","        \/\/ Start a jump once per press.","    }","    var movement = input.getActionStrength(\"MoveRight\");","}"],"type":"codeListing","syntax":"adascript"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"isActionPressed(name)","type":"codeVoice"},{"text":" remains true while an input is held.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"isActionJustPressed(name)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"isActionJustReleased(name)","type":"codeVoice"},{"type":"text","text":" describe transitions"},{"type":"text","text":" "},{"type":"text","text":"during the current frame. Both can be true for a tap completed within one frame."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"getActionStrength(name)","type":"codeVoice"},{"type":"text","text":" returns 0…1. Gamepad axes use a direction and the"},{"text":" ","type":"text"},{"text":"action’s dead zone; buttons and touch return either zero or one.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Gamepad bindings match any connected controller. ","type":"text"},{"code":"Any Finger Held","type":"codeVoice"},{"type":"text","text":" stays active"},{"type":"text","text":" "},{"text":"until every contact ends or is cancelled. Touch lifecycle events, mouse motion,","type":"text"},{"text":" ","type":"text"},{"text":"and wheel bindings produce frame pulses.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Input snapshots are scoped to a callback; query input again on the next update."},{"type":"text","text":" "},{"type":"text","text":"Unknown action names return false or zero. Names are case-sensitive."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Swift systems use the same methods on their "},{"type":"codeVoice","code":"Input"},{"type":"text","text":" resource. "},{"type":"codeVoice","code":"InputPlugin()"},{"type":"text","text":" "},{"type":"text","text":"loads the "},{"type":"codeVoice","code":"inputActions"},{"type":"text","text":" section from "},{"type":"codeVoice","code":".ada\/project.json"},{"type":"text","text":" in the current working"},{"type":"text","text":" "},{"type":"text","text":"directory, including games launched from the editor. Packaged Swift applications"},{"type":"text","text":" "},{"type":"text","text":"can decode "},{"type":"codeVoice","code":"[InputAction]"},{"type":"text","text":" from an included resource and pass it to"},{"type":"text","text":" "},{"type":"codeVoice","code":"InputPlugin(actions:)"},{"type":"text","text":", or call "},{"type":"codeVoice","code":"try input.setInputActions(actions)"},{"type":"text","text":" on an existing"},{"type":"text","text":" "},{"type":"text","text":"resource. Explicit "},{"type":"codeVoice","code":"InputPlugin(actions: [])"},{"type":"text","text":" disables automatic project loading."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Declare annotation-driven systems and iterate native AdaECS component columns.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/AdaScripting\/documentation\/AdaScripting"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adascripting\/adascriptecs"]}],"metadata":{"modules":[{"name":"Ada Script"}],"role":"article","roleHeading":"Article","title":"Ada Script ECS"},"kind":"article","seeAlsoSections":[{"anchor":"ECS-Integration","generated":true,"identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptDiagnosticsAndPerformance"],"title":"ECS Integration"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS"},"references":{"doc://AdaScripting/documentation/AdaScripting/AdaScriptAnnotations":{"role":"article","type":"topic","kind":"article","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","abstract":[{"type":"text","text":"Choose an annotation by the declaration it describes. Annotation arguments"},{"type":"text","text":" "},{"type":"text","text":"are literals, identifiers, or lists of those values, not runtime expressions."},{"type":"text","text":" "},{"type":"text","text":"The same spelling can have different roles: "},{"type":"codeVoice","code":"@component"},{"type":"text","text":" declares a struct,"},{"type":"text","text":" "},{"type":"text","text":"while "},{"type":"codeVoice","code":"@component(required: true)"},{"type":"text","text":" binds an existing component to a scriptable"},{"type":"text","text":" "},{"type":"text","text":"instance."}],"title":"Ada Script Annotation Reference","url":"\/documentation\/adascripting\/adascriptannotations"},"doc://AdaScripting/documentation/AdaScripting":{"url":"\/documentation\/adascripting","role":"collection","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting","kind":"symbol","title":"Ada Script","abstract":[{"type":"text","text":"Write gameplay systems in Ada Script while keeping entity filtering and access planning in AdaEngine’s native ECS."}],"type":"topic"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptDiagnosticsAndPerformance":{"url":"\/documentation\/adascripting\/adascriptdiagnosticsandperformance","role":"article","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptDiagnosticsAndPerformance","kind":"article","title":"Ada Script Diagnostics and Performance","abstract":[{"text":"Understand annotation, setup, and runtime failures and keep ECS work on the","type":"text"},{"type":"text","text":" "},{"text":"native chunk path.","type":"text"}],"type":"topic"}}}