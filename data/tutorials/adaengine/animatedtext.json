hell":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Create-the-app-shell","role":"pseudoSymbol","url":"\/tutorials\/adaengine\/uibasics#Create-the-app-shell","kind":"section","title":"Create the app shell","abstract":[{"type":"text","text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state."}]},"doc://AdaEngine/tutorials/AdaEngine/UI-and-Input":{"type":"topic","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UI-and-Input","role":"article","url":"\/tutorials\/adaengine\/ui-and-input","kind":"article","title":"UI and Input","abstract":[]},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Create-the-input-system":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Create-the-input-system","role":"pseudoSymbol","url":"\/tutorials\/adaengine\/gamepadinput#Create-the-input-system","kind":"section","title":"Create the input system","abstract":[{"text":"Build a small scene that spawns a player entity and moves it with a gamepad.","type":"text"}]},"AT-1-1-app.swift":{"fileType":"swift","fileName":"AnimatedTextApp.swift","content":["import AdaEngine","","@main","struct AnimatedTextApp: App {","    var body: some AppScene {","        WindowGroup {","            ContentView()","        }","        .windowMode(.windowed)","        .windowTitle(\"Animated Text\")","    }","}"],"identifier":"AT-1-1-app.swift","type":"file","syntax":"swift","highlights":[]},"AT-2-3-renderer.swift":{"type":"file","content":["import AdaEngine","","struct AnimatedSineWaveRenderer: TextRenderer {","    var timeOffset: Double","","    var animatableData: Double {","        get { timeOffset }","        set { timeOffset = newValue }","    }","","    init(timeOffset: Double) {","        self.timeOffset = timeOffset","    }","","    func draw(layout: Text.Layout, in context: inout UIGraphicsContext) {","        let glyphs = layout.flattenedRuns","        let safeCount = max(glyphs.count, 1)","        let width = layout.first?.typographicBounds.rect.width ?? 1","        let height = layout.first?.typographicBounds.rect.height ?? 1","","        for (index, glyph) in glyphs.enumerated() {","            let offset = sineOffset(","                index: index,","                amplitude: Double(height) * 0.5,","                wavelength: Double(width),","                phase: timeOffset,","                total: safeCount","            )","","            var copy = context","            copy.translateBy(x: 0, y: Float(offset))","            copy.draw(glyph)","        }","    }","","    private func sineOffset(","        index: Int,","        amplitude: Double,","        wavelength: Double,","        phase: Double,","        total: Int","    ) -> Double {","        let x = Double(index)","        let position = (x \/ Double(total)) * wavelength","        let radians = ((position + phase) \/ wavelength) * 2 * .pi","        return Math.sin(radians) * amplitude","    }","}"],"fileName":"AnimatedSineWaveRenderer.swift","highlights":[{"line":14},{"line":15},{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23},{"line":24},{"line":25},{"line":26},{"line":27},{"line":28},{"line":29},{"line":30},{"line":31},{"line":32},{"line":33},{"line":34},{"line":35},{"line":36},{"line":37},{"line":38},{"line":39},{"line":40},{"line":41},{"line":42},{"line":43},{"line":44},{"line":45},{"line":46},{"line":47}],"fileType":"swift","identifier":"AT-2-3-renderer.swift","syntax":"swift"},"AT-3-3-view.swift":{"fileType":"swift","fileName":"ContentView.swift","content":["import AdaEngine","","struct ContentView: View {","    @State private var timeOffset: Double = 0","    @State private var animationTask: Task<Void, Never>?","","    var body: some View {","        Text(\"Sine Wave\")","            .textRendered(AnimatedSineWaveRenderer(timeOffset: timeOffset))","            .onAppear {","                startAnimation()","            }","            .onDisappear {","                animationTask?.cancel()","                animationTask = nil","            }","    }","","    private func startAnimation() {","        animationTask?.cancel()","        animationTask = Task { @MainActor in","            while !Task.isCancelled {","                timeOffset += 0.12","                try? await Task.sleep(nanoseconds: 16_000_000)","            }","        }","    }","}"],"identifier":"AT-3-3-view.swift","type":"file","syntax":"swift","highlights":[{"line":13},{"line":14},{"line":15},{"line":16}]},"doc://AdaEngine/tutorials/AdaEngine":{"type":"topic","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine","role":"overview","url":"\/tutorials\/adaengine","kind":"overview","title":"Meet Ada","abstract":[{"type":"text","text":"Learn the basics of Ada and start developing your own games!"}]},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Prepare-layout-helpers":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Prepare-layout-helpers","role":"pseudoSymbol","url":"\/tutorials\/adaengine\/animatedtext#Prepare-layout-helpers","kind":"section","title":"Prepare layout helpers","abstract":[{"type":"text","text":"Create a custom "},{"type":"codeVoice","code":"TextRenderer"},{"type":"text","text":" that draws text along a sine wave and animate it by updating renderer state."}]},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Create-the-view":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-the-view","url":"\/tutorials\/adaengine\/animatedtext#Create-the-view","abstract":[{"text":"Create a custom ","type":"text"},{"type":"codeVoice","code":"TextRenderer"},{"text":" that draws text along a sine wave and animate it by updating renderer state.","type":"text"}],"type":"section","role":"pseudoSymbol","kind":"section","title":"Create the view"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics#Add-a-button-and-state":{"type":"section","iden