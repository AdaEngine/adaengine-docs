{"primaryContentSections":[{"kind":"content","content":[{"text":"Compilation diagnostics","type":"heading","level":2,"anchor":"Compilation-diagnostics"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin"},{"type":"text","text":" compiles the source and reads declaration metadata"},{"type":"text","text":" "},{"type":"text","text":"without executing a "},{"type":"codeVoice","code":"main()"},{"type":"text","text":" manifest. Initialization throws"},{"type":"text","text":" "},{"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptError\/compilation(_:)","isActive":true,"type":"reference"},{"text":" for syntax or semantic errors and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptError\/invalidManifest(_:)","isActive":true,"type":"reference"},{"text":" for invalid AdaEngine annotations.","type":"text"}]},{"inlineContent":[{"text":"Examples include ","type":"text"},{"code":"@system","type":"codeVoice"},{"text":" on a non-class declaration, duplicate system","type":"text"},{"text":" ","type":"text"},{"text":"identifiers, ","type":"text"},{"code":"@query","type":"codeVoice"},{"text":" outside a system class, a query with no fetched","type":"text"},{"text":" ","type":"text"},{"text":"components, and a system class that cannot be initialized.","type":"text"}],"type":"paragraph"},{"text":"Setup diagnostics","level":2,"type":"heading","anchor":"Setup-diagnostics"},{"inlineContent":[{"type":"text","text":"Native component identifiers are resolved during plugin setup so earlier"},{"type":"text","text":" "},{"type":"text","text":"plugins can register game components. Unknown or ambiguous component names skip"},{"type":"text","text":" "},{"type":"text","text":"the affected system and append a diagnostic."}],"type":"paragraph"},{"text":"Runtime diagnostics","level":2,"type":"heading","anchor":"Runtime-diagnostics"},{"inlineContent":[{"text":"Runtime diagnostics include unknown component aliases, unknown fields,","type":"text"},{"text":" ","type":"text"},{"text":"unsupported values, invalid numeric conversions, and query capabilities used","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"outside their callback lifetime."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Inspect "},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin\/diagnostics","isActive":true},{"type":"text","text":" after setup and during development."},{"type":"text","text":" "},{"type":"text","text":"System "},{"type":"codeVoice","code":"update(context)"},{"type":"text","text":" callbacks are command-style; their return values are"},{"type":"text","text":" "},{"type":"text","text":"ignored. Tests should assert observable ECS state and diagnostics."}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Performance-model","text":"Performance model"},{"type":"paragraph","inlineContent":[{"text":"Ada Script query execution traverses native archetypes and chunks. Component","type":"text"},{"text":" ","type":"text"},{"text":"columns are bound once per chunk, and field access advances a typed pointer by","type":"text"},{"text":" ","type":"text"},{"text":"row stride. A successful write mutates the component in place and updates its","type":"text"},{"text":" ","type":"text"},{"text":"change tick.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The hot path avoids arrays of matched entity identifiers, one Swift bridge","type":"text"},{"text":" ","type":"text"},{"text":"object per entity, repeated entity-location lookups, existential component","type":"text"},{"text":" ","type":"text"},{"text":"copies, and whole-component reinsertion.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The current embedded C runtime is globally shared and non-reentrant, so runtime entry remains"},{"type":"text","text":" "},{"type":"text","text":"serialized. Scalability comes from native filtering, column iteration, cached"},{"type":"text","text":" "},{"type":"text","text":"metadata, and narrow bridge calls rather than multiple concurrent VMs."}]},{"type":"paragraph","inlineContent":[{"text":"Benchmark scripting changes with multiple archetypes and chunks and compare","type":"text"},{"text":" ","type":"text"},{"text":"them with a typed Swift query. Validate semantics before drawing performance","type":"text"},{"text":" ","type":"text"},{"text":"conclusions.","type":"text"}]}]}],"metadata":{"modules":[{"name":"Ada Script"}],"roleHeading":"Article","role":"article","title":"Ada Script Diagnostics and Performance"},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Understand annotation, setup, and runtime failures and keep ECS work on the","type":"text"},{"text":" ","type":"text"},{"text":"native chunk path.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adascripting\/adascriptdiagnosticsandperformance"]}],"identifier":{"url":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptDiagnosticsAndPerformance","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"ECS Integration","generated":true,"identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTesting"],"anchor":"ECS-Integration"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/AdaScripting\/documentation\/AdaScripting"]]},"references":{"doc://AdaScripting/documentation/AdaScripting/AdaScriptError/compilation(_:)":{"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptError\/compilation(_:)","type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"compilation"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"])"}],"title":"AdaScriptError.compilation(_:)","url":"\/documentation\/adascripting\/adascripterror\/compilation(_:)","abstract":[]},"doc://AdaScripting/documentation/AdaScripting/AdaScriptTesting":{"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptTesting","type":"topic","role":"collectionGroup","kind":"article","title":"Testing Ada Script","abstract":[{"text":"Write tests next to your gameplay code, run them with ","type":"text"},{"code":"swift test","type":"codeVoice"},{"text":" or a command, and keep them out of shipped builds.","type":"text"}],"url":"\/documentation\/adascripting\/adascripttesting"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptECS":{"type":"topic","abstract":[{"type":"text","text":"Declare annotation-driven systems and iterate native AdaECS component columns."}],"url":"\/documentation\/adascripting\/adascriptecs","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS","title":"Ada Script ECS","role":"article","kind":"article"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptPlugin":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Loads an annotation-driven Ada Script module."}],"type":"topic","url":"\/documentation\/adascripting\/adascriptplugin","title":"AdaScriptPlugin","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin","navigatorTitle":[{"text":"AdaScriptPlugin","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptPlugin","kind":"identifier"}]},"doc://AdaScripting/documentation/AdaScripting":{"type":"topic","role":"collection","kind":"symbol","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting","title":"Ada Script","url":"\/documentation\/adascripting","abstract":[{"text":"Write gameplay systems in Ada Script while keeping entity filtering and access planning in AdaEngine’s native ECS.","type":"text"}]},"doc://AdaScripting/documentation/AdaScripting/AdaScriptError/invalidManifest(_:)":{"kind":"symbol","role":"symbol","abstract":[],"type":"topic","url":"\/documentation\/adascripting\/adascripterror\/invalidmanifest(_:)","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptError\/invalidManifest(_:)","title":"AdaScriptError.invalidManifest(_:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"invalidManifest","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://AdaScripting/documentation/AdaScripting/AdaScriptPlugin/diagnostics":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"diagnostics"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"]"}],"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin\/diagnostics","abstract":[],"url":"\/documentation\/adascripting\/adascriptplugin\/diagnostics","kind":"symbol","title":"diagnostics","type":"topic","role":"symbol"}}}