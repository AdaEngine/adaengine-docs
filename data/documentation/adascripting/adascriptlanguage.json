{"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Source files","anchor":"Source-files"},{"type":"paragraph","inlineContent":[{"text":"Ada Script uses ","type":"text"},{"code":".ada","type":"codeVoice"},{"text":" files. A file contains classes,","type":"text"},{"text":" ","type":"text"},{"text":"functions, variables, and control flow. Ada Script modules do not declare a","type":"text"},{"text":" ","type":"text"},{"code":"main()","type":"codeVoice"},{"text":" function and do not assemble plugin manifests.","type":"text"}]},{"type":"codeListing","syntax":"ada","code":["@system(scheduler: \"update\")","class CounterSystem {","    @query(Counter)","    var counters;","","    func update(context) {","        for (var entity in counters) {","            entity.counter.value += 1;","        }","    }","}"]},{"level":2,"type":"heading","text":"Optional strict type checking","anchor":"Optional-strict-type-checking"},{"type":"paragraph","inlineContent":[{"text":"Ada Script remains dynamically typed by default. Enable strict checking for a","type":"text"},{"text":" ","type":"text"},{"text":"single source by placing ","type":"text"},{"code":"@strict","type":"codeVoice"},{"text":" before its first declaration:","type":"text"}]},{"type":"codeListing","syntax":"ada","code":["@strict","","func addScore(score: Int, amount: Int) -> Int {","    return score + amount;","}"]},{"type":"paragraph","inlineContent":[{"text":"In an AdaEditor project, ","type":"text"},{"type":"strong","inlineContent":[{"text":"Project Settings → Runtime → Type Checking → Strict","type":"text"}]},{"text":" ","type":"text"},{"text":"enables the same analysis for every ","type":"text"},{"code":".ada","type":"codeVoice"},{"text":" source. The serialized setting is:","type":"text"}]},{"type":"codeListing","syntax":"json","code":["{","  \"build\": {","    \"system\": \"adascript\",","    \"adaScriptTypeChecking\": \"strict\"","  }","}"]},{"type":"paragraph","inlineContent":[{"text":"Strict checking validates annotated assignments, function arguments, member","type":"text"},{"text":" ","type":"text"},{"text":"access, and return values before the module runs. Use ","type":"text"},{"code":"Any","type":"codeVoice"},{"text":" for an intentional","type":"text"},{"text":" ","type":"text"},{"text":"dynamic boundary. Untyped code and projects using ","type":"text"},{"code":"\"dynamic\"","type":"codeVoice"},{"type":"text","text":" keep normal"},{"type":"text","text":" "},{"type":"text","text":"Ada Script runtime behavior."}]},{"level":2,"type":"heading","text":"Imports","anchor":"Imports"},{"type":"paragraph","inlineContent":[{"text":"Files with discovery annotations such as ","type":"text"},{"code":"@system","type":"codeVoice"},{"text":" are module roots. Import a","type":"text"},{"text":" ","type":"text"},{"text":"helper declaration explicitly from another target-relative source file:","type":"text"}]},{"type":"codeListing","syntax":"ada","code":["import {","    clampSpeed,","    MovementSettings","} from \"..\/Shared\/Movement\";"]},{"type":"paragraph","inlineContent":[{"text":"Relative imports are resolved from the importing file. The ","type":"text"},{"code":".ada","type":"codeVoice"},{"text":" extension is","type":"text"},{"text":" ","type":"text"},{"text":"optional. Absolute paths and imports which escape the Swift target source map","type":"text"},{"text":" ","type":"text"},{"text":"are rejected. A reachable source is compiled once, and an import cycle reports","type":"text"},{"text":" ","type":"text"},{"text":"the complete cycle.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The current implementation supports selected relative imports. Namespace","type":"text"},{"text":" ","type":"text"},{"text":"imports, public\/private visibility enforcement, and the ","type":"text"},{"code":"AdaEngine","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"AdaUI","type":"codeVoice"},{"text":" ","type":"text"},{"text":"virtual-module declarations remain part of the next module-language slice.","type":"text"}]},{"level":2,"type":"heading","text":"Annotations","anchor":"Annotations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ada Script declaration annotations have three forms:"}]},{"type":"codeListing","syntax":"ada","code":["@name","@name(value)","@name(key: value, other: [a, b])"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Arguments are compile-time constants or symbolic identifiers. They do not run"},{"type":"text","text":" "},{"type":"text","text":"user code during module discovery."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","isActive":true},{"type":"text","text":" for supported annotations, declaration targets,"},{"type":"text","text":" "},{"type":"text","text":"arguments, defaults, and lifetimes. A one-time world initializer is a"},{"type":"text","text":" "},{"type":"codeVoice","code":"@system(scheduler: \"startup\")"},{"type":"text","text":" class with "},{"type":"codeVoice","code":"update(context)"},{"type":"text","text":"; there is no"},{"type":"text","text":" "},{"type":"text","text":"function-level "},{"type":"codeVoice","code":"@init"},{"type":"text","text":" annotation yet."}]},{"level":2,"type":"heading","text":"Script-defined data","anchor":"Script-defined-data"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The build plugin generates native backing types for scalar component and"},{"type":"text","text":" "},{"type":"text","text":"resource schemas:"}]},{"type":"codeListing","syntax":"ada","code":["@component(id: \"game.health\")","struct Health {","    @export var current = 100.0;","    @export var maximum = 120;","}","","@resource(id: \"game.balance\", autoInsert: true)","struct GameBalance {","    @export var acceleration = 9.8;","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Generated Swift symbol names are private implementation details. Runtime lookup"},{"type":"text","text":" "},{"type":"text","text":"accepts both the Ada Script declaration name ("},{"type":"codeVoice","code":"Health"},{"type":"text","text":") and the stable ID"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"game.health"},{"type":"text","text":"). "},{"type":"codeVoice","code":"autoInsert: true"},{"type":"text","text":" inserts the resource before systems are"},{"type":"text","text":" "},{"type":"text","text":"installed. SwiftPM targets use generated backing types; AdaEditor can register"},{"type":"text","text":" "},{"type":"text","text":"supported runtime-defined component layouts for pure AdaScript projects."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Bind a resource directly on a system with "},{"type":"codeVoice","code":"@res"},{"type":"text","text":". The binding uses a native ECS"},{"type":"text","text":" "},{"type":"text","text":"resource pointer during "},{"type":"codeVoice","code":"update(context)"},{"type":"text","text":"; field writes update the resource"},{"type":"text","text":" "},{"text":"change tick:","type":"text"}]},{"type":"codeListing","syntax":"ada","code":["@system(id: \"physics.system\")","class PhysicsSystem {","    @res","    var balance: GameBalance;","","    func update(context) {","        balance.acceleration += 0.1;","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A missing required resource is reported through plugin diagnostics. Optional"},{"type":"text","text":" "},{"type":"text","text":"resources can be guarded with "},{"type":"codeVoice","code":"available()"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"ada","code":["@res(optional: true)","var debugSettings: DebugSettings;","","if (debugSettings.available()) {","    debugSettings.enabled = true;","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Resource access is currently conservative: each "},{"type":"codeVoice","code":"@res"},{"type":"text","text":" requests scheduler write"},{"text":" ","type":"text"},{"text":"access. Static read\/write inference and explicit access overrides are planned.","type":"text"}]},{"anchor":"World-commands","type":"heading","level":2,"text":"World commands"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Systems receive a capability-scoped world facade. Structural changes are"},{"type":"text","text":" "},{"type":"text","text":"queued through "},{"type":"codeVoice","code":"context.world.commands"},{"type":"text","text":" and applied only after the current"},{"type":"text","text":" "},{"type":"text","text":"system parameters finish, so an active query iterator cannot be invalidated:"}]},{"type":"codeListing","syntax":"ada","code":["@system(id: \"cleanup.system\")","class CleanupSystem {","    @query(Expired)","    var expired;","","    func update(context) {","        for (var entity in expired) {","            context.world.commands.despawn(entity.id);","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The initial command API creates registered component defaults by Ada Script name"},{"type":"text","text":" "},{"type":"text","text":"or stable ID:"}]},{"type":"codeListing","syntax":"ada","code":["var entity = context.world.commands.spawn([\"game.health\"]);","context.world.commands.insert(entity, \"game.poison\");","context.world.commands.remove(entity, \"game.poison\");","context.world.commands.despawn(entity);"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Direct command use is inferred per system and declares deferred-world access to"},{"type":"text","text":" "},{"type":"text","text":"the scheduler. Command facades expire when "},{"type":"codeVoice","code":"update(context)"},{"type":"text","text":" returns; using a"},{"type":"text","text":" "},{"type":"text","text":"retained or undeclared facade reports a plugin diagnostic and performs no"},{"type":"text","text":" "},{"type":"text","text":"mutation. Typed component constructors can be passed to"},{"type":"text","text":" "},{"type":"codeVoice","code":"context.world.spawn([...])"},{"type":"text","text":"; the legacy string-based command form remains"},{"type":"text","text":" "},{"type":"text","text":"available. Explicit dynamic "},{"type":"codeVoice","code":"@access"},{"type":"text","text":" and exclusive immediate world access"},{"type":"text","text":" "},{"type":"text","text":"are not implemented."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftPM generation of native backing types requires "},{"type":"codeVoice","code":"AdaScriptBuildPlugin"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"text","text":"supported pure AdaScript layouts can be registered by the runtime."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift and Editor tooling can attach the generated default without naming its"},{"type":"text","text":" "},{"type":"text","text":"private backing type:"}]},{"type":"codeListing","syntax":"swift","code":["world.insertDefaultComponent(named: \"game.health\", into: entity.id)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Field types and serialization support vary by schema and bridge. Check the"},{"type":"text","text":" "},{"type":"text","text":"nearest compiler diagnostic when a constructor argument or field default is"},{"type":"text","text":" "},{"type":"text","text":"unsupported."}]},{"anchor":"Scriptable-objects","type":"heading","level":2,"text":"Scriptable objects"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"@scriptable"},{"type":"text","text":" for low-cardinality behavior attached to one entity. Systems"},{"type":"text","text":" "},{"type":"text","text":"remain the scalable path for processing large entity sets."}]},{"type":"codeListing","syntax":"ada","code":["@scriptable(","    id: \"game.player-controller\",","    version: 2,","    aliases: [\"PlayerController\"]",")","class PlayerController {","    @export var speed = 8.0;","    @component(required: true) var transform: Transform;","    @res(optional: true) var settings: PlayerSettings;","","    func ready(context) {}","","    func update(context) {","        transform.position += speed * context.deltaTime;","    }","","    func fixedUpdate(context) {}","    func event(events, context) {}","    func destroy(context) {}","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The build plugin registers stable IDs, versions, aliases, exported scalar"},{"type":"text","text":" "},{"type":"text","text":"defaults, and transient component\/resource bindings. Required components are"},{"type":"text","text":" "},{"type":"text","text":"checked before "},{"type":"codeVoice","code":"ready"},{"type":"text","text":". Optional resources expose "},{"code":"available()","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ScriptableComponents"},{"type":"text","text":" encodes a polymorphic envelope containing only "},{"type":"codeVoice","code":"type"},{"type":"text","text":","},{"text":" ","type":"text"},{"type":"codeVoice","code":"version"},{"type":"text","text":", and detached "},{"code":"payload","type":"codeVoice"},{"text":". Entity bindings, resources, VM instances,","type":"text"},{"text":" ","type":"text"},{"text":"world contexts, and lifecycle state are never serialized. Decoding does not run","type":"text"},{"text":" ","type":"text"},{"text":"gameplay; attachment runs ","type":"text"},{"code":"ready","type":"codeVoice"},{"text":" once and detachment runs ","type":"text"},{"code":"destroy","type":"codeVoice"},{"text":" once.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Scriptable contexts expose the same expiring deferred commands facade as"},{"type":"text","text":" "},{"type":"text","text":"systems. Retaining it after a callback produces a diagnostic. Scriptable"},{"type":"text","text":" "},{"type":"text","text":"objects intentionally have no user-interface callback; compose interfaces in"},{"type":"text","text":" "},{"type":"text","text":"Swift with AdaUI."}],"type":"paragraph"},{"anchor":"Multiplayer-schemas","type":"heading","level":2,"text":"Multiplayer schemas"},{"inlineContent":[{"type":"text","text":"Use a typed command for peer intent. Field tags, rather than declaration order"},{"type":"text","text":" "},{"type":"text","text":"or source names, define the wire schema:"}],"type":"paragraph"},{"type":"codeListing","syntax":"ada","code":["@network_command(","    id: \"game.player-input\",","    delivery: \"unreliable_sequenced\",","    channel: \"input\"",")","struct PlayerInput {","    @network_field(1) var moveX = 0.0;","    @network_field(2) var moveY = 0.0;","    @network_field(3) var attackSequence = 0;","}"]},{"inlineContent":[{"type":"text","text":"Peers send the generated value through the scoped multiplayer resource. Host"},{"type":"text","text":" "},{"type":"text","text":"systems receive typed values and an authenticated transport source:"}],"type":"paragraph"},{"type":"codeListing","syntax":"ada","code":["@system","class InputSystem {","    @res var multiplayer: Multiplayer;","    @remote_commands(PlayerInput) var inputs;","","    func update(context) {","        multiplayer.send(PlayerInput(1.0, 0.0, 4));","        for (var message in inputs) {","            var peer = message.source;","            var movement = message.value.moveX;","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The runtime owns packet sequences and command envelopes. "},{"type":"codeVoice","code":"message.source"},{"type":"text","text":" "},{"type":"text","text":"cannot be supplied by script payload data. Swift and AdaScript declarations"},{"type":"text","text":" "},{"text":"with matching IDs, versions, tags, types, direction, delivery, and channel","type":"text"},{"text":" ","type":"text"},{"text":"produce the same compatibility schema.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"@replicated_component","type":"codeVoice"},{"text":" uses ","type":"text"},{"code":"@network_field","type":"codeVoice"},{"text":" plus optional ","type":"text"},{"code":"@local","type":"codeVoice"},{"text":" fields.","type":"text"},{"text":" ","type":"text"},{"text":"SwiftPM targets receive a generated native ECS backing component through","type":"text"},{"text":" ","type":"text"},{"code":"AdaScriptBuildPlugin","type":"codeVoice"},{"text":". Portable AdaEditor projects register each component as","type":"text"},{"text":" ","type":"text"},{"text":"a distinct runtime ECS layout without compiling Swift.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"@rpc","type":"codeVoice"},{"text":" declares both a typed wire command and an optional receiver method:","type":"text"}]},{"type":"codeListing","syntax":"ada","code":["@system class InputSystem {","    @res var multiplayer: Multiplayer;","    @res var playerInput: PlayerInputState;","","    @rpc(id: \"arena.input\", delivery: \"unreliable_sequenced\", channel: \"input\")","    func input(@network_field(1) moveX = 0.0, @network_field(2) attack = 0) {","        playerInput.peer = source;","        playerInput.moveX = moveX;","        playerInput.attack = attack;","    }","","    func update(context) {","        multiplayer.send(input(1.0, 2));","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Calling ","type":"text"},{"code":"input(...)","type":"codeVoice"},{"text":" constructs a typed command; ","type":"text"},{"code":"multiplayer.send(...)","type":"codeVoice"},{"text":" sends","type":"text"},{"text":" ","type":"text"},{"text":"it. The authored body does not run on the sender. On receipt, the system invokes","type":"text"},{"text":" ","type":"text"},{"text":"it before ","type":"text"},{"code":"update","type":"codeVoice"},{"text":", with ","type":"text"},{"code":"source","type":"codeVoice"},{"text":" bound to the authenticated transport peer ID.","type":"text"},{"text":" ","type":"text"},{"text":"Fields remain tagged and require constant defaults. An empty or bodyless method","type":"text"},{"text":" ","type":"text"},{"text":"still works as a command constructor; ","type":"text"},{"code":"@remote_commands(input)","type":"codeVoice"},{"text":" remains available","type":"text"},{"text":" ","type":"text"},{"text":"for explicit message processing. Request\/response and local echo are not yet","type":"text"},{"text":" ","type":"text"},{"text":"supported.","type":"text"}]},{"anchor":"Asynchronous-work","type":"heading","level":2,"text":"Asynchronous work"},{"type":"paragraph","inlineContent":[{"text":"Declare a function that can suspend with ","type":"text"},{"code":"async func","type":"codeVoice"},{"text":". Use ","type":"text"},{"code":"await","type":"codeVoice"},{"text":" inside that","type":"text"},{"text":" ","type":"text"},{"text":"function; a synchronous action starts it explicitly with ","type":"text"},{"code":"Tasks.start(...)","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The action returns immediately while the game or UI continues updating.","type":"text"}]},{"type":"codeListing","syntax":"ada","code":["async func loadShop() {","    var result = await Assets.loadAsync(\"@res:\/\/Catalog\/shop.json\");","    if (result.isSuccess()) {","        System.print(\"Shop asset: \" + result.value());","    } else {","        System.print(result.errorCode() + \": \" + result.message());","    }","}","","@system class ShopSystem {","    var started = false;","","    func update(context) {","        if (!started) {","            started = true;","            Tasks.start(loadShop());","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"Assets.loadAsync","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Assets.saveAsync","type":"codeVoice"},{"text":" use the native asset registry and","type":"text"},{"text":" ","type":"text"},{"text":"return an awaitable result. ","type":"text"},{"code":"Saves.writeAsync(\"@user:\/\/save.txt\", text)","type":"codeVoice"},{"text":" writes","type":"text"},{"text":" ","type":"text"},{"text":"an immutable string in the background and reports ","type":"text"},{"code":"committed()","type":"codeVoice"},{"text":" after its","type":"text"},{"text":" ","type":"text"},{"text":"atomic file replacement. For data that cannot be copied in one callback, use","type":"text"},{"text":" ","type":"text"},{"text":"bounded chunks:","type":"text"}]},{"type":"codeListing","syntax":"ada","code":["async func saveLargeData() {","    var writer = Saves.begin(\"@user:\/\/save.txt\");","    var first = await writer.appendAsync(\"first chunk\");","    if (!first.isSuccess()) { writer.cancel(); return; }","    var committed = await writer.finishAsync();","    if (!committed.committed()) { System.print(committed.message()); }","}"]},{"type":"paragraph","inlineContent":[{"text":"Each chunk is limited to 256 KiB. The writer appends to a temporary file and","type":"text"},{"text":" ","type":"text"},{"text":"replaces the destination only after ","type":"text"},{"code":"finishAsync()","type":"codeVoice"},{"text":" succeeds. Build large ECS","type":"text"},{"text":" ","type":"text"},{"text":"snapshots in bounded pieces; do not retain a query row or live component view","type":"text"},{"text":" ","type":"text"},{"text":"in a task.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Mark a script-owned type with ","type":"text"},{"code":"@nonsendable","type":"codeVoice"},{"text":" when its instances are tied to a","type":"text"},{"text":" ","type":"text"},{"text":"callback or another short lifetime. AdaScript rejects a typed async parameter","type":"text"},{"text":" ","type":"text"},{"text":"or method that would capture that type. Before a task starts, the runtime also","type":"text"},{"text":" ","type":"text"},{"text":"checks actual arguments, nested lists, returned values, and promise results;","type":"text"},{"text":" ","type":"text"},{"text":"this catches borrowed engine values passed through an untyped alias. Maps are","type":"text"},{"text":" ","type":"text"},{"text":"conservatively rejected until their entries can be inspected. See","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"await Time.sleep(seconds)","type":"codeVoice"},{"text":" advances with the scheduler’s ","type":"text"},{"code":"deltaTime","type":"codeVoice"},{"text":" and stops","type":"text"},{"text":" ","type":"text"},{"text":"advancing when that scheduler is paused. AdaEngine does not yet expose a","type":"text"},{"text":" ","type":"text"},{"text":"separate game time-scale resource.","type":"text"},{"text":" ","type":"text"},{"code":"await Time.sleepRealTime(seconds)","type":"codeVoice"},{"text":" uses a monotonic clock; continuation still","type":"text"},{"text":" ","type":"text"},{"text":"waits for a script dispatch point. ","type":"text"},{"code":"Tasks.promise()","type":"codeVoice"},{"text":" creates a one-shot wait","type":"text"},{"text":" ","type":"text"},{"text":"that another script callback can resolve with ","type":"text"},{"code":"complete(value)","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"code":"Tasks.start(...)","type":"codeVoice"},{"text":" returns a handle with ","type":"text"},{"code":"status()","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"cancel()","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"AdaScript callbacks such as ","type":"text"},{"code":"update(context)","type":"codeVoice"},{"text":" remain synchronous. Do not mark","type":"text"},{"text":" ","type":"text"},{"text":"them ","type":"text"},{"code":"async","type":"codeVoice"},{"text":"; start a separate async function and pass","type":"text"},{"text":" ","type":"text"},{"text":"detached values. Callback contexts, queries, resources, and commands expire at","type":"text"},{"text":" ","type":"text"},{"text":"callback exit. Awaited work resumes in the serialized script runtime, not on","type":"text"},{"text":" ","type":"text"},{"text":"the native I\/O worker. Cancelling a save does not roll back","type":"text"},{"text":" ","type":"text"},{"text":"a file that was already committed.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Fallible operations return a result with ","type":"text"},{"code":"isSuccess()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"value()","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"errorCode()","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"message()","type":"codeVoice"},{"text":"; inspect it after ","type":"text"},{"code":"await","type":"codeVoice"},{"text":". A script VM trap","type":"text"},{"text":" ","type":"text"},{"text":"currently stops that module and cancels its pending tasks. Diagnostics include","type":"text"},{"text":" ","type":"text"},{"text":"the failing task, owner, and trace ID; reload the module to continue. Other","type":"text"},{"text":" ","type":"text"},{"text":"module instances and native gameplay remain separate.","type":"text"}]},{"anchor":"System-context","type":"heading","level":2,"text":"System context"},{"type":"paragraph","inlineContent":[{"code":"update(context)","type":"codeVoice"},{"text":" receives a scoped system context. ","type":"text"},{"code":"context.deltaTime","type":"codeVoice"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"current scheduler delta. Context and query values must not be retained after","type":"text"},{"text":" ","type":"text"},{"text":"the callback.","type":"text"}]},{"anchor":"State","type":"heading","level":2,"text":"State"},{"type":"paragraph","inlineContent":[{"text":"Fields on a system instance persist between scheduler updates:","type":"text"}]},{"type":"codeListing","syntax":"ada","code":["@system(scheduler: \"update\")","class LifetimeSystem {","    var elapsed = 0.0;","","    func update(context) {","        elapsed += context.deltaTime;","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Use local variables for per-call calculations. Store ECS gameplay state in","type":"text"},{"text":" ","type":"text"},{"text":"components and shared singleton state in resources rather than global mutable","type":"text"},{"text":" ","type":"text"},{"text":"variables.","type":"text"}]},{"anchor":"Common-language-patterns","type":"heading","level":2,"text":"Common language patterns"},{"type":"paragraph","inlineContent":[{"text":"The syntax primer in ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptBasics","type":"reference"},{"text":" covers functions, conditions,","type":"text"},{"text":" ","type":"text"},{"text":"loops, structs, classes, static members, initializers, and accessors. In an ECS","type":"text"},{"text":" ","type":"text"},{"text":"system, use those language features together with query bindings:","type":"text"}]},{"type":"codeListing","syntax":"ada","code":["func clampHealth(value, maximum) {","    if (value < 0) { return 0; }","    if (value > maximum) { return maximum; }","    return value;","}","","@system","class DamageSystem {","    @query(Health, without: Invulnerable)","    var targets;","","    func update(context) {","        for (var target in targets) {","            target.health.current = clampHealth(target.health.current - 1, 100);","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Functions called by a system are ordinary helpers; they do not become","type":"text"},{"text":" ","type":"text"},{"text":"scheduler callbacks. A system’s ","type":"text"},{"code":"update(context)","type":"codeVoice"},{"text":" is the entry point selected","type":"text"},{"text":" ","type":"text"},{"text":"by ","type":"text"},{"code":"@system","type":"codeVoice"},{"text":". A scriptable object’s ","type":"text"},{"code":"ready(context)","type":"codeVoice"},{"text":" instead belongs to that","type":"text"},{"text":" ","type":"text"},{"text":"entity’s attachment lifecycle. For one-time world setup, use the ","type":"text"},{"code":"startup","type":"codeVoice"},{"text":" ","type":"text"},{"text":"scheduler described in ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"code":"import { name } from \".\/Helpers\";","type":"codeVoice"},{"text":" brings a helper into the target-level","type":"text"},{"text":" ","type":"text"},{"text":"module. Importing a file does not create a second world or a second run of its","type":"text"},{"text":" ","type":"text"},{"text":"systems. A library can contribute its own annotated declarations; keep IDs","type":"text"},{"text":" ","type":"text"},{"text":"unique across the assembled module. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLibraries","type":"reference"},{"text":".","type":"text"}]},{"anchor":"Values-crossing-the-bridge","type":"heading","level":2,"text":"Values crossing the bridge"},{"type":"paragraph","inlineContent":[{"text":"Ada Script bridge values are detached booleans, integers, finite floating-point","type":"text"},{"text":" ","type":"text"},{"text":"numbers, strings, lists, and null. ECS component views are borrowed native","type":"text"},{"text":" ","type":"text"},{"text":"capabilities rather than detached values.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Unsupported values and invalid numeric conversions are rejected without","type":"text"},{"text":" ","type":"text"},{"text":"partially mutating a component.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"System ","type":"text"},{"code":"update(context)","type":"codeVoice"},{"text":" callbacks are command-style. Their return values are","type":"text"},{"text":" ","type":"text"},{"text":"ignored; observable behavior belongs in components, resources, events, or","type":"text"},{"text":" ","type":"text"},{"text":"diagnostics.","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/AdaScripting\/documentation\/AdaScripting"]]},"sections":[],"kind":"article","seeAlsoSections":[{"title":"Essentials","generated":true,"anchor":"Essentials","identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptBasics","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLibraries"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adascripting\/adascriptlanguage"]}],"abstract":[{"type":"text","text":"Use Ada Script syntax with AdaEngine declaration annotations. New to the"},{"type":"text","text":" "},{"type":"text","text":"language? Start with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptBasics"},{"type":"text","text":" for values, functions, types,"},{"type":"text","text":" "},{"type":"text","text":"properties, control flow, asynchronous work, and annotations."}],"metadata":{"modules":[{"name":"Ada Script"}],"role":"article","title":"Ada Script Language","roleHeading":"Article"},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage","interfaceLanguage":"swift"},"references":{"doc://AdaScripting/documentation/AdaScripting/AdaScriptLibraries":{"title":"AdaScript Libraries","abstract":[{"type":"text","text":"Share reusable AdaScript functions, systems, and scriptable objects through a GitHub repository."},{"type":"text","text":" "},{"type":"text","text":"AdaEditor installs the library and its transitive dependencies into the project. Run, Play Mode,"},{"type":"text","text":" "},{"type":"text","text":"Preview, and "},{"code":"AdaScriptBuildPlugin","type":"codeVoice"},{"type":"text","text":" load the same installed sources without network access."}],"role":"article","type":"topic","url":"\/documentation\/adascripting\/adascriptlibraries","kind":"article","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLibraries"},"doc://AdaScripting/documentation/AdaScripting":{"title":"Ada Script","abstract":[{"type":"text","text":"Write gameplay systems in Ada Script while keeping entity filtering and access planning in AdaEngine’s native ECS."}],"role":"collection","type":"topic","url":"\/documentation\/adascripting","kind":"symbol","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptAnnotations":{"title":"Ada Script Annotation Reference","abstract":[{"type":"text","text":"Choose an annotation by the declaration it describes. Annotation arguments"},{"type":"text","text":" "},{"type":"text","text":"are literals, identifiers, or lists of those values, not runtime expressions."},{"type":"text","text":" "},{"type":"text","text":"The same spelling can have different roles: "},{"code":"@component","type":"codeVoice"},{"type":"text","text":" declares a struct,"},{"type":"text","text":" "},{"type":"text","text":"while "},{"code":"@component(required: true)","type":"codeVoice"},{"type":"text","text":" binds an existing component to a scriptable"},{"type":"text","text":" "},{"type":"text","text":"instance."}],"role":"article","type":"topic","url":"\/documentation\/adascripting\/adascriptannotations","kind":"article","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations"},"doc://AdaScripting/documentation/AdaScripting/GettingStartedWithAdaScript":{"title":"Getting Started with Ada Script","abstract":[{"type":"text","text":"Add an "},{"code":".ada","type":"codeVoice"},{"type":"text","text":" file to an AdaEngine executable and run its systems without manually loading each script."}],"role":"article","type":"topic","url":"\/documentation\/adascripting\/gettingstartedwithadascript","kind":"article","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptBasics":{"title":"Ada Script Basics","abstract":[{"type":"text","text":"Learn the syntax of Ada Script before connecting a script to a scene or ECS"},{"type":"text","text":" "},{"type":"text","text":"world. Ada Script files use the "},{"code":".ada","type":"codeVoice"},{"type":"text","text":" extension. The examples on this page are"},{"type":"text","text":" "},{"type":"text","text":"small pieces you can combine in one file; a game does not need a "},{"code":"main()","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"function. Start with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript"},{"type":"text","text":" to run a complete system."}],"role":"article","type":"topic","url":"\/documentation\/adascripting\/adascriptbasics","kind":"article","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptBasics"}}}