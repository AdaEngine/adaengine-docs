{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/ProceduralNoise"},"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/adaengine\/proceduralnoise"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"AdaEngine"}],"roleHeading":"Article","title":"Procedural Noise","role":"article"},"hierarchy":{"paths":[["doc:\/\/AdaEngine\/documentation\/AdaEngine"]]},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Sample-seeded-Perlin-noise","text":"Sample seeded Perlin noise","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"PerlinNoise2D"},{"type":"text","text":" and "},{"type":"codeVoice","code":"PerlinNoise3D"},{"type":"text","text":" return values within "},{"type":"codeVoice","code":"-1...1"},{"type":"text","text":" for finite"},{"type":"text","text":" "},{"type":"text","text":"coordinates and frequency. Fixed seeds and coordinates produce repeatable samples;"},{"type":"text","text":" "},{"type":"text","text":"sampling does not advance a random generator. These are hashed-gradient Perlin"},{"type":"text","text":" "},{"type":"text","text":"variants with quintic interpolation, not bit-compatible implementations of the"},{"type":"text","text":" "},{"type":"text","text":"canonical permutation-table algorithm. 2D noise is its own field, not a 3D slice."}],"type":"paragraph"},{"syntax":"swift","code":["import Math","","let perlin = PerlinNoise2D(seed: 1234)","let heightVariation = perlin.sample(at: Vector2(12.5, 8.25))","let volume = PerlinNoise3D(seed: 1234)","let density = volume.sample(at: Vector3(12.5, 8.25, -2))"],"type":"codeListing"},{"level":2,"anchor":"Layer-terrain-detail-with-FBM","text":"Layer terrain detail with FBM","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"FractalNoise"},{"type":"text","text":" combines samples at increasing frequencies and decreasing"},{"type":"text","text":" "},{"type":"text","text":"amplitudes. This example computes a height; it does not modify a terrain entity."}],"type":"paragraph"},{"syntax":"swift","code":["let terrain = FractalNoise(","    source: PerlinNoise2D(seed: 1234),","    octaves: 5,","    frequency: 0.02,","    lacunarity: 2,","    persistence: 0.5",")","let worldX: Float = 32","let worldZ: Float = -16","let height = terrain.sample(at: Vector2(worldX, worldZ)) * 20"],"type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"octaves","type":"codeVoice"},{"text":": number of layers, clamped to ","type":"text"},{"code":"1...32","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"frequency","type":"codeVoice"},{"text":": base coordinate scale. Nonfinite\/non-positive settings become ","type":"text"},{"code":"1","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"lacunarity","type":"codeVoice"},{"text":": frequency multiplier between octaves. Nonfinite\/non-positive settings become ","type":"text"},{"code":"2","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"persistence","type":"codeVoice"},{"text":": amplitude multiplier between octaves, clamped to ","type":"text"},{"code":"0...1","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Nonfinite settings become ","type":"text"},{"code":"0.5","type":"codeVoice"},{"text":". Zero uses only the first octave.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Output is divided by the sum of active octave amplitudes. Sources bounded to"},{"type":"text","text":" "},{"type":"codeVoice","code":"-1...1"},{"type":"text","text":" stay within that range; custom source ranges are not clipped."},{"type":"text","text":" "},{"type":"text","text":"The optional "},{"type":"codeVoice","code":"sample(at:frequency:)"},{"type":"text","text":" argument multiplies the base frequency,"},{"type":"text","text":" "},{"type":"text","text":"including when fractal fields are nested. Zero or negative call frequencies are"},{"type":"text","text":" "},{"type":"text","text":"valid coordinate transforms; the initializer’s positive settings have the"},{"type":"text","text":" "},{"type":"text","text":"normalization rules above."}],"type":"paragraph"},{"level":2,"anchor":"Implement-a-custom-generator","text":"Implement a custom generator","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"Noise"},{"type":"text","text":" has an associated "},{"type":"codeVoice","code":"Point"},{"type":"text","text":" type inferred from the sampling method. A 2D"},{"type":"text","text":" "},{"type":"text","text":"implementation cannot accidentally be called with a 3D point. A custom field only"},{"type":"text","text":" "},{"type":"text","text":"needs to be "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and implement one method:"}],"type":"paragraph"},{"syntax":"swift","code":["struct RidgeNoise: Noise {","    func sample(at point: Vector2, frequency: Double) -> Double {","        let x = Double(point.x) * frequency","        return 1 - abs(Math.sin(x))","    }","}","","let ridges = FractalNoise(source: RidgeNoise(), frequency: 0.1)","let ridgeHeight = ridges.sample(at: Vector2(10, 20))"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use the same type for a custom terrain field that composes several generators."},{"type":"text","text":" "},{"type":"text","text":"An immutable struct is usually sufficient; no base class or shared mutable seed"},{"type":"text","text":" "},{"type":"text","text":"is necessary. "},{"type":"codeVoice","code":"Noise.sample(at:)"},{"type":"text","text":" also works in generic code, using unit frequency."}],"type":"paragraph"},{"level":2,"anchor":"Limits-and-invalid-input","text":"Limits and invalid input","type":"heading"},{"inlineContent":[{"type":"text","text":"Vector2\/Vector3 store Float coordinates. Double interpolation cannot recover"},{"type":"text","text":" "},{"type":"text","text":"precision already lost in a large world position; use local coordinates before"},{"type":"text","text":" "},{"type":"text","text":"conversion for fine detail far from the origin. No serialization, shader noise,"},{"type":"text","text":" "},{"type":"text","text":"terrain wiring, or cross-library sample compatibility is provided here."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Perlin sampling returns NaN for nonfinite inputs or coordinate-scaling overflow."},{"type":"text","text":" "},{"type":"text","text":"FBM returns NaN for nonfinite call frequency or active-octave frequency overflow,"},{"type":"text","text":" "},{"type":"text","text":"and propagates invalid samples from its source. Custom sources define their own"},{"type":"text","text":" "},{"type":"text","text":"coordinate validation. Check "},{"type":"codeVoice","code":"isFinite"},{"type":"text","text":" before storing a computed terrain height;"},{"type":"text","text":" "},{"type":"text","text":"invalid sample input is not silently converted to a valid height."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"See "},{"identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/Terrain","type":"reference","isActive":true},{"type":"text","text":" for the separate terrain creation and editing API."}],"type":"paragraph"}]}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/AdaEngine\/documentation\/AdaEngine\/Building","doc:\/\/AdaEngine\/documentation\/AdaEngine\/Contributing","doc:\/\/AdaEngine\/documentation\/AdaEngine\/AdaUIIdentity","doc:\/\/AdaEngine\/documentation\/AdaEngine\/ImageDecoders","doc:\/\/AdaEngine\/documentation\/AdaEngine\/AnimationAuthoring","doc:\/\/AdaEngine\/documentation\/AdaEngine\/AnimationIK","doc:\/\/AdaEngine\/documentation\/AdaEngine\/Atmosphere","doc:\/\/AdaEngine\/documentation\/AdaEngine\/GameDiagnosticsOverlay","doc:\/\/AdaEngine\/documentation\/AdaEngine\/MovieMaker","doc:\/\/AdaEngine\/documentation\/AdaEngine\/PipelinedRendering","doc:\/\/AdaEngine\/documentation\/AdaEngine\/DLSSUpscaling","doc:\/\/AdaEngine\/documentation\/AdaEngine\/HardwarePathTracing","doc:\/\/AdaEngine\/documentation\/AdaEngine\/Terrain","doc:\/\/AdaEngine\/documentation\/AdaEngine\/VisionOSWindowed","doc:\/\/AdaEngine\/documentation\/AdaEngine\/WESLShaders"],"title":"Guides","anchor":"Guides"}],"abstract":[{"text":"Use a noise generator as a deterministic scalar field for terrain heights,","type":"text"},{"text":" ","type":"text"},{"text":"procedural placement, or volume density. Import ","type":"text"},{"code":"Math","type":"codeVoice"},{"text":" directly, or use its","type":"text"},{"text":" ","type":"text"},{"text":"re-export from ","type":"text"},{"code":"AdaEngine","type":"codeVoice"},{"text":". No GPU or editor state is needed.","type":"text"}],"references":{"doc://AdaEngine/documentation/AdaEngine/VisionOSWindowed":{"type":"topic","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/VisionOSWindowed","role":"article","title":"visionOS Windowed Mode","url":"\/documentation\/adaengine\/visionoswindowed","kind":"article","abstract":[{"type":"text","text":"Run Ada apps in visionOS Shared Space using the existing "},{"code":"WindowGroup","type":"codeVoice"},{"type":"text","text":" scene model."}]},"doc://AdaEngine/documentation/AdaEngine/DLSSUpscaling":{"abstract":[{"type":"text","text":"Render a 3D view below its output resolution and reconstruct it with NVIDIA DLSS Super Resolution, or denoise a"},{"type":"text","text":" "},{"type":"text","text":"path-traced view with DLSS Ray Reconstruction. DLSS is optional: without it a camera uses the portable temporal"},{"text":" ","type":"text"},{"type":"text","text":"reconstruction that ships with the engine, and nothing else changes."}],"title":"DLSS Upscaling","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/DLSSUpscaling","type":"topic","role":"article","kind":"article","url":"\/documentation\/adaengine\/dlssupscaling"},"doc://AdaEngine/documentation/AdaEngine/HardwarePathTracing":{"type":"topic","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/HardwarePathTracing","role":"article","title":"Hardware Path Tracing","url":"\/documentation\/adaengine\/hardwarepathtracing","kind":"article","abstract":[{"type":"text","text":"Let a path-traced view find ray intersections with the GPU’s ray-tracing hardware instead of a shader BVH. The image,"},{"type":"text","text":" "},{"type":"text","text":"lighting and denoisers stay the same; only the intersection step changes, and the shader BVH remains the fallback"},{"type":"text","text":" "},{"type":"text","text":"wherever hardware cannot be used."}]},"doc://AdaEngine/documentation/AdaEngine/GameDiagnosticsOverlay":{"type":"topic","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/GameDiagnosticsOverlay","role":"article","title":"Game diagnostics overlay","url":"\/documentation\/adaengine\/gamediagnosticsoverlay","kind":"article","abstract":[{"text":"See the game’s update rate while you play. The overlay shows ","type":"text"},{"inlineContent":[{"type":"text","text":"FPS"}],"type":"strong"},{"text":" and","type":"text"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"Frame time","type":"text"}]},{"type":"text","text":" in the top-left corner of the game window. Mouse and keyboard"},{"text":" ","type":"text"},{"text":"input still reach the game under the overlay.","type":"text"}]},"doc://AdaEngine/documentation/AdaEngine/AnimationAuthoring":{"identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/AnimationAuthoring","type":"topic","role":"article","abstract":[{"text":"Copy an imported animation or capture a rest\/current pose into a project-owned","type":"text"},{"text":" ","type":"text"},{"code":".animlib","type":"codeVoice"},{"text":" resource. Source GLB\/glTF bytes remain unchanged. Swift code, Studio’s","type":"text"},{"text":" ","type":"text"},{"text":"Animator, the editor agent and project Tools share the same data and edit commands.","type":"text"}],"title":"Authoring skeletal animation","url":"\/documentation\/adaengine\/animationauthoring","kind":"article"},"doc://AdaEngine/documentation/AdaEngine/Building":{"url":"\/documentation\/adaengine\/building","abstract":[{"text":"This guide covers two scenarios:","type":"text"}],"identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/Building","title":"Building Ada","type":"topic","kind":"article","role":"article"},"doc://AdaEngine/documentation/AdaEngine/AnimationIK":{"url":"\/documentation\/adaengine\/animationik","abstract":[{"text":"Constrain a skeletal chain after its clip, Animation Graph and visual LOD pose have been mixed.","type":"text"}],"identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/AnimationIK","title":"Animation IK and pose modifiers","type":"topic","kind":"article","role":"article"},"doc://AdaEngine/documentation/AdaEngine/ImageDecoders":{"type":"topic","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/ImageDecoders","role":"article","title":"Loading images and adding formats","url":"\/documentation\/adaengine\/imagedecoders","kind":"article","abstract":[{"type":"text","text":"Load PNG, JPEG ("},{"code":"jpg","type":"codeVoice"},{"type":"text","text":" or "},{"code":"jpeg","type":"codeVoice"},{"type":"text","text":"), BMP and TGA images as CPU pixels using"},{"type":"text","text":" "},{"code":"Image","type":"codeVoice"},{"type":"text","text":", or load a GPU texture through "},{"code":"Texture2D","type":"codeVoice"},{"type":"text","text":":"}]},"doc://AdaEngine/documentation/AdaEngine/Terrain":{"abstract":[{"text":"Create editable ground with ","type":"text"},{"code":"Terrain3D","type":"codeVoice"},{"type":"text","text":". Its heights describe one square surface"},{"text":" ","type":"text"},{"text":"in the entity’s local X\/Z plane. ","type":"text"},{"code":"Model3DPlugin","type":"codeVoice"},{"type":"text","text":" generates the visible geometry;"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Physics3DPlugin"},{"type":"text","text":" adds matching static triangle collision."}],"identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/Terrain","role":"article","title":"Terrain","url":"\/documentation\/adaengine\/terrain","kind":"article","type":"topic"},"doc://AdaEngine/documentation/AdaEngine/WESLShaders":{"abstract":[{"text":"Link local shader modules and compile feature variants to WGSL with the AdaEngine host tool.","type":"text"}],"identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/WESLShaders","role":"article","title":"Compile modular WESL shaders","url":"\/documentation\/adaengine\/weslshaders","kind":"article","type":"topic"},"doc://AdaEngine/documentation/AdaEngine/Atmosphere":{"type":"topic","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/Atmosphere","role":"article","title":"Atmosphere","url":"\/documentation\/adaengine\/atmosphere","kind":"article","abstract":[{"text":"Give a 3D camera a physically based sky. The atmosphere scatters the sun’s light","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the way air does, so the sky turns from blue at noon to orange near the horizon"},{"text":" ","type":"text"},{"text":"and dark at night, the sun appears as a disc that the air reddens, and distant","type":"text"},{"text":" ","type":"text"},{"text":"geometry fades into haze.","type":"text"}]},"doc://AdaEngine/documentation/AdaEngine/AdaUIIdentity":{"url":"\/documentation\/adaengine\/adauiidentity","abstract":[{"text":"AdaUI reconciles a new view tree against the mounted ","type":"text"},{"type":"codeVoice","code":"ViewNode"},{"text":" tree. A node is preserved only when the new node and old node describe the same identity and the new node can update the old node. Preserved nodes keep their ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":", focus state, in-flight animation controllers, layers, and other node-local runtime state. Recreated nodes start with fresh runtime state.","type":"text"}],"identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/AdaUIIdentity","title":"AdaUI View Identity","type":"topic","kind":"article","role":"article"},"doc://AdaEngine/documentation/AdaEngine":{"type":"topic","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine","role":"collection","title":"AdaEngine","url":"\/documentation\/adaengine","kind":"symbol","abstract":[{"text":"Bringing simple and powerful game engine for your awesome games.","type":"text"}]},"doc://AdaEngine/documentation/AdaEngine/PipelinedRendering":{"type":"topic","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/PipelinedRendering","role":"article","title":"Pipelined Rendering","url":"\/documentation\/adaengine\/pipelinedrendering","kind":"article","abstract":[{"type":"text","text":"Render a scene one frame behind its simulation to overlap rendering with the next frame’s work."}]},"doc://AdaEngine/documentation/AdaEngine/Contributing":{"type":"topic","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/Contributing","role":"article","title":"Contributing to Ada","url":"\/documentation\/adaengine\/contributing","kind":"article","abstract":[{"type":"text","text":"We welcome contributions of all kinds: bug fixes, features, documentation, and examples."}]},"doc://AdaEngine/documentation/AdaEngine/MovieMaker":{"navigatorTitle":[{"text":"MovieMaker","kind":"identifier"}],"url":"\/documentation\/adaengine\/moviemaker","abstract":[{"type":"text","text":"Records a fresh game world at a fixed simulation rate, waiting for every GPU"},{"type":"text","text":" "},{"type":"text","text":"frame and disk write before advancing. Rendering speed never drops movie frames."},{"type":"text","text":" "},{"type":"text","text":"Configure the same gameplay plugins and cameras as your game in "},{"type":"codeVoice","code":"make"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Platform\/window plugins are unnecessary for this offscreen runtime."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MovieMaker","kind":"identifier"}],"identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/MovieMaker","type":"topic","title":"MovieMaker","kind":"symbol","role":"symbol"}}}