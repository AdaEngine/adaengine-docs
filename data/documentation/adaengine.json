","text":"Physics, animation, input handling, audio, and UI systems"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Asset management pipeline and streamlined workflows","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Cross-platform support across Apple platforms and Linux"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Hot-reload capabilities for assets and scripts","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Modern Swift API with async\/await, property wrappers, and result builders"}]}]}]},{"inlineContent":[{"text":"With Ada, both beginners and experienced Swift developers can build games rapidly, focusing on gameplay instead of low-level boilerplate. Extensive documentation and tutorials make it easy to get started, from setting up your first scene to advanced gameplay mechanics.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Ada is actively developed, and contributions from the community are welcome.","type":"text"},{"text":" ","type":"text"},{"text":"For more details and guides, check out the tutorials below.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://AdaEngine/documentation/AdaEngine/AdaUIDebug3DVisibility":{"url":"\/documentation\/adaengine\/adauidebug3dvisibility","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"AdaUIDebug3DVisibility","kind":"identifier"}],"type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaUIDebug3DVisibility","kind":"identifier"}],"identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/AdaUIDebug3DVisibility","title":"AdaUIDebug3DVisibility","abstract":[]},"doc://AdaEngine/documentation/AdaEngine/DefaultPlugins":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DefaultPlugins","kind":"identifier"}],"navigatorTitle":[{"text":"DefaultPlugins","kind":"identi