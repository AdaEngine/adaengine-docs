{"primaryContentSections":[{"content":[{"type":"heading","text":"Declare a system","level":2,"anchor":"Declare-a-system"},{"type":"paragraph","inlineContent":[{"text":"Apply ","type":"text"},{"code":"@system","type":"codeVoice"},{"text":" to a class and implement ","type":"text"},{"code":"update(context)","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["@system(scheduler: \"update\", id: \"game.movement\")","class MovementSystem {","    func update(context) {","    }","}"],"type":"codeListing","syntax":"ada"},{"type":"paragraph","inlineContent":[{"text":"The scheduler defaults to ","type":"text"},{"code":"update","type":"codeVoice"},{"text":". System identifiers must be unique within a","type":"text"},{"text":" ","type":"text"},{"text":"script module.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For one-time world setup, use ","type":"text"},{"code":"@system(scheduler: \"startup\")","type":"codeVoice"},{"text":". Its","type":"text"},{"text":" ","type":"text"},{"code":"update(context)","type":"codeVoice"},{"text":" runs on the default scheduler runner’s first update, before","type":"text"},{"text":" ","type":"text"},{"text":"the regular frame stages. A script class constructor does not receive a world","type":"text"},{"text":" ","type":"text"},{"text":"context. See ","type":"text"},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","isActive":true},{"text":" for all annotation arguments.","type":"text"}]},{"type":"heading","text":"Order systems","level":2,"anchor":"Order-systems"},{"type":"paragraph","inlineContent":[{"text":"Use repeatable ","type":"text"},{"code":"@after","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@before","type":"codeVoice"},{"text":" annotations when component and resource","type":"text"},{"text":" ","type":"text"},{"text":"access alone does not express the required execution order:","type":"text"}]},{"code":["@after(id: \"game.input\")","@before(id: \"game.physics\")","@system(scheduler: \"update\", id: \"game.movement\")","class MovementSystem {","    func update(context) {","    }","}"],"type":"codeListing","syntax":"ada"},{"type":"paragraph","inlineContent":[{"text":"Dependency IDs resolve within the same AdaScript module. Both systems must use","type":"text"},{"text":" ","type":"text"},{"text":"the same scheduler. AdaScript rejects unknown IDs, self-dependencies, and","type":"text"},{"text":" ","type":"text"},{"text":"dependency cycles while loading the module.","type":"text"}]},{"type":"heading","text":"Declare a query","level":2,"anchor":"Declare-a-query"},{"type":"paragraph","inlineContent":[{"text":"Apply ","type":"text"},{"code":"@query","type":"codeVoice"},{"text":" to a stored system property:","type":"text"}]},{"code":["@query(","    Health,","    Movement,","    with: Movable,","    without: Frozen",")","var entities;"],"type":"codeListing","syntax":"ada"},{"type":"paragraph","inlineContent":[{"text":"Positional components are fetched and available on each row. ","type":"text"},{"code":"with","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"without","type":"codeVoice"},{"text":" only filter matching archetypes.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Aliases use lower-camel-case component names:","type":"text"}]},{"code":["for (var entity in entities) {","    var position = entity.movement.position;","    entity.health.current -= 1.0;","}"],"type":"codeListing","syntax":"ada"},{"type":"paragraph","inlineContent":[{"code":"entity.id","type":"codeVoice"},{"text":" exposes the native entity identifier.","type":"text"}]},{"type":"heading","text":"Iterator behavior","level":2,"anchor":"Iterator-behavior"},{"type":"paragraph","inlineContent":[{"text":"Ada Script queries are native iterators. AdaECS resolves matching archetypes,","type":"text"},{"text":" ","type":"text"},{"text":"binds component columns when entering a chunk, and advances their pointers by","type":"text"},{"text":" ","type":"text"},{"text":"row stride. The bridge does not create an entity proxy for every result and","type":"text"},{"text":" ","type":"text"},{"text":"does not perform a world component lookup for every field access.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A query row and its component views are borrowed. Do not retain them after the","type":"text"},{"text":" ","type":"text"},{"text":"loop or system update returns. Structural changes must use deferred commands.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Inactive entities are skipped. Empty queries execute zero loop iterations.","type":"text"}]},{"type":"heading","text":"Component fields","level":2,"anchor":"Component-fields"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"@Component","type":"codeVoice"},{"text":" Swift macro generates the runtime field accessors used by Ada","type":"text"},{"text":" ","type":"text"},{"text":"Script. Register native components before the script plugin is set up.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Supported field values include booleans, integers, finite floating-point","type":"text"},{"text":" ","type":"text"},{"text":"values, strings, vectors, quaternions, colors, and reflected enums. A rejected","type":"text"},{"text":" ","type":"text"},{"text":"write leaves the component unchanged and appends a development diagnostic.","type":"text"}]},{"type":"heading","text":"Access planning","level":2,"anchor":"Access-planning"},{"type":"paragraph","inlineContent":[{"text":"The current implementation conservatively declares write access for fetched","type":"text"},{"text":" ","type":"text"},{"text":"components. This keeps scheduling correct while compiler-level read\/write","type":"text"},{"text":" ","type":"text"},{"text":"inference is completed. Filter-only components do not receive write access.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The intended final behavior derives read and write sets from row field usage,","type":"text"},{"text":" ","type":"text"},{"text":"with explicit ","type":"text"},{"code":"@access","type":"codeVoice"},{"text":" metadata as the escape hatch for dynamic code.","type":"text"}]},{"type":"heading","text":"Multiple queries","level":2,"anchor":"Multiple-queries"},{"type":"paragraph","inlineContent":[{"text":"One system may declare multiple independent iterators:","type":"text"}]},{"code":["@system(scheduler: \"update\")","class TargetingSystem {","    @query(Player, Transform)","    var players;","","    @query(Enemy, Target, without: Dead)","    var enemies;","","    func update(context) {","        for (var enemy in enemies) {","            for (var player in players) {","                enemy.target.entity = player.id;","                break;","            }","        }","    }","}"],"type":"codeListing","syntax":"ada"},{"type":"paragraph","inlineContent":[{"text":"Queries are refreshed by the scheduler before each system execution.","type":"text"}]},{"type":"heading","text":"Project input actions","level":2,"anchor":"Project-input-actions"},{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Project Settings → Input Bindings"}]},{"text":", add an action such as ","type":"text"},{"code":"Jump","type":"codeVoice"},{"text":", then add","type":"text"},{"text":" ","type":"text"},{"text":"keyboard, mouse, gamepad or touch bindings. Click ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Save Project Settings"}]},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Actions are stored in ","type":"text"},{"code":".ada\/project.json","type":"codeVoice"},{"text":" and loaded by both Play Mode and the","type":"text"},{"text":" ","type":"text"},{"text":"AdaScript project runtime. Multiple bindings act as alternatives: releasing one","type":"text"},{"text":" ","type":"text"},{"text":"input does not release the action while another binding is held.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Systems and scriptable components declare input as a read-only resource dependency","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"@res var input: Input;","type":"codeVoice"},{"text":". Only declarations that request Input receive it.","type":"text"},{"text":" ","type":"text"},{"text":"Use ","type":"text"},{"code":"@res(optional: true) var input: Input;","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"input.available()","type":"codeVoice"},{"text":" when the","type":"text"},{"text":" ","type":"text"},{"text":"resource may be absent; a missing required resource produces a diagnostic.","type":"text"}]},{"code":["@res var input: Input;","","func update(context) {","    if (input.isActionJustPressed(\"Jump\")) {","        \/\/ Start a jump once per press.","    }","    var movement = input.getActionStrength(\"MoveRight\");","}"],"type":"codeListing","syntax":"adascript"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"isActionPressed(name)","type":"codeVoice"},{"text":" remains true while an input is held.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"isActionJustPressed(name)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"isActionJustReleased(name)","type":"codeVoice"},{"text":" describe transitions","type":"text"},{"text":" ","type":"text"},{"text":"during the current frame. Both can be true for a tap completed within one frame.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"getActionStrength(name)","type":"codeVoice"},{"text":" returns 0…1. Gamepad axes use a direction and the","type":"text"},{"text":" ","type":"text"},{"text":"action’s dead zone; buttons and touch return either zero or one.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Gamepad bindings match any connected controller. ","type":"text"},{"code":"Any Finger Held","type":"codeVoice"},{"text":" stays active","type":"text"},{"text":" ","type":"text"},{"text":"until every contact ends or is cancelled. Touch lifecycle events, mouse motion,","type":"text"},{"text":" ","type":"text"},{"text":"and wheel bindings produce frame pulses.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Input snapshots are scoped to a callback; query input again on the next update.","type":"text"},{"text":" ","type":"text"},{"text":"Unknown action names return false or zero. Names are case-sensitive.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Swift systems use the same methods on their ","type":"text"},{"code":"Input","type":"codeVoice"},{"text":" resource. ","type":"text"},{"code":"InputPlugin()","type":"codeVoice"},{"text":" ","type":"text"},{"text":"loads the ","type":"text"},{"code":"inputActions","type":"codeVoice"},{"text":" section from ","type":"text"},{"code":".ada\/project.json","type":"codeVoice"},{"text":" in the current working","type":"text"},{"text":" ","type":"text"},{"text":"directory, including games launched from the editor. Packaged Swift applications","type":"text"},{"text":" ","type":"text"},{"text":"can decode ","type":"text"},{"code":"[InputAction]","type":"codeVoice"},{"text":" from an included resource and pass it to","type":"text"},{"text":" ","type":"text"},{"code":"InputPlugin(actions:)","type":"codeVoice"},{"text":", or call ","type":"text"},{"code":"try input.setInputActions(actions)","type":"codeVoice"},{"text":" on an existing","type":"text"},{"text":" ","type":"text"},{"text":"resource. Explicit ","type":"text"},{"code":"InputPlugin(actions: [])","type":"codeVoice"},{"text":" disables automatic project loading.","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/AdaScripting\/documentation\/AdaScripting"]]},"sections":[],"kind":"article","seeAlsoSections":[{"title":"ECS Integration","identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptDiagnosticsAndPerformance"],"generated":true,"anchor":"ECS-Integration"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adascripting\/adascriptecs"]}],"abstract":[{"type":"text","text":"Declare annotation-driven systems and iterate native AdaECS component columns."}],"metadata":{"roleHeading":"Article","title":"Ada Script ECS","modules":[{"name":"Ada Script"}],"role":"article"},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS"},"references":{"doc://AdaScripting/documentation/AdaScripting":{"title":"Ada Script","abstract":[{"type":"text","text":"Write gameplay systems in Ada Script while keeping entity filtering and access planning in AdaEngine’s native ECS."}],"role":"collection","type":"topic","url":"\/documentation\/adascripting","kind":"symbol","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptAnnotations":{"title":"Ada Script Annotation Reference","abstract":[{"type":"text","text":"Choose an annotation by the declaration it describes. Annotation arguments"},{"type":"text","text":" "},{"type":"text","text":"are literals, identifiers, or lists of those values, not runtime expressions."},{"type":"text","text":" "},{"type":"text","text":"The same spelling can have different roles: "},{"code":"@component","type":"codeVoice"},{"type":"text","text":" declares a struct,"},{"type":"text","text":" "},{"type":"text","text":"while "},{"code":"@component(required: true)","type":"codeVoice"},{"type":"text","text":" binds an existing component to a scriptable"},{"type":"text","text":" "},{"type":"text","text":"instance."}],"role":"article","type":"topic","url":"\/documentation\/adascripting\/adascriptannotations","kind":"article","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptDiagnosticsAndPerformance":{"title":"Ada Script Diagnostics and Performance","abstract":[{"type":"text","text":"Understand annotation, setup, and runtime failures and keep ECS work on the"},{"type":"text","text":" "},{"type":"text","text":"native chunk path."}],"role":"article","type":"topic","url":"\/documentation\/adascripting\/adascriptdiagnosticsandperformance","kind":"article","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptDiagnosticsAndPerformance"}}}