nput#Move-and-rumble"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics#Add-a-button-and-state":{"role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Add-a-button-and-state","abstract":[{"type":"text","text":"Build a simple UI screen using AdaEngine views. You will create a window, layout a few elements, and add a button with state."}],"title":"Add a button and state","type":"section","url":"\/tutorials\/adaengine\/uibasics#Add-a-button-and-state"},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Prepare-layout-helpers":{"role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Prepare-layout-helpers","abstract":[{"type":"text","text":"Create a custom "},{"code":"TextRenderer","type":"codeVoice"},{"type":"text","text":" that draws text along a sine wave and animate it by updating renderer state."}],"title":"Prepare layout helpers","type":"section","url":"\/tutorials\/adaengine\/animatedtext#Prepare-layout-helpers"},"doc://AdaEngine/tutorials/AdaEngine/CreateProject#Create-project-using-Xcode":{"role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject#Create-project-using-Xcode","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first AdaEngine project."}],"title":"Create project using Xcode","type":"section","url":"\/tutorials\/adaengine\/createproject#Create-project-using-Xcode"},"doc://AdaEngine/tutorials/AdaEngine/PlayerAndText#Add-Player-component":{"role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Player-component","abstract":[{"type":"text","text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene."}],"title":"Add Player component","type":"section","url":"\/tutorials\/adaengine\/playerandtext#Add-Player-component"},"EL-2-5-physics.swift":{"fileType":"swift","syntax":"swift","fileName":"PhysicsHandler.swift","content":["import AdaEngine","","@MainActor","struct EventListenerPlugin: Plugin {","    @Local var disposeBag: Set<AnyCancellable> = []","","    func setup(in app: borrowing AppWorlds) {","        app.main.subscribe(to: SceneEvents.OnReady.self) { event in","            Task { @MainActor in","                event.scene.world.physicsWorld2D?.gravity = .zero","            }","        }","        .store(in: &self.disposeBag)","    }","}"],"identifier":"EL-2-5-physics.swift","highlights":[],"type":"file"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Read-buttons":{"role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Read-buttons","abstract":[{"type":"text","text":"Build a small scene that spawns a player entity and moves it with a gamepad."}],"title":"Read buttons","type":"section","url":"\/tutorials\/adaengine\/gamepadinput#Read-buttons"},"EL-1.jpg":{"type":"image","variants":[{"url":"\/images\/AdaEngine\/EL-1.jpg","traits":["1x","light"]}],"identifier":"EL-1.jpg","alt":"Observer pattern scheme"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Make-it-move":{"role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Make-it-move","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using AdaEngine."}],"title":"Make it move","type":"section","url":"\/tutorials\/adaengine\/createfirst2dscene#Make-it-move"},"EL-2-1-scene.swift":{"fileType":"swift","syntax":"swift","fileName":"EventListenerPlugin.swift","content":["import AdaEngine","","struct EventListenerPlugin: Plugin {","    func setup(in app: borrowing AppWorlds) {","        ","    }","}"],"identifier":"EL-2-1-scene.swift","highlights":[],"type":"file"},"doc://AdaEngine/tutorials/AdaEngine/PlayerAndText":{"estimatedTime":"5min","role":"project","kind":"project","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText","abstract":[{"type":"text","text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene."}],"title":"Player and Text in Ada Engine","type":"topic","url":"\/tutorials\/adaengine\/playerandtext"},"doc://AdaEngine/tutorials/AdaEngine/PlayerAndText#Add-Text-component":{"role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Text-component","abstract":[{"type":"text","text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene."}],"title":"Add Text component","type":"section","url":"\/tutorials\/adaengine\/playerandtext#Add-Text-component"},"Xcode 26.2 or later":{"type":"xcodeRequirement","title":"Xcode 26.2 or later","url":"https:\/\/developer.apple.com\/download\/","identifier":"Xcode 26.2 or later"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Base-of-Event-Subscriber-pattern":{"role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Base-of-Event-Subscriber-pattern","abstract":[{"type":"text","text":"In this tutorial you will learn about the event listeners system in Ada Engine."},{"type":"text","text":" "},{"type":"text","text":"How can you catch events and process them"}],"title":"Base of Event-Subscriber pattern","type":"section","url":"\/tutorials\/adaengine\/eventlisteners#Base-of-Event-Subscriber-pattern"},"EL-2-3-scene.swift":{"fileType":"swift","syntax":"swift","fileName":"EventListenerPlugin.swift","content":["import AdaEngine","","@MainActor","struct EventListenerPlugin: Plugin {","    @Local var disposeBag: Set<AnyCancellable> = []","","    func setup(in app: borrowing AppWorlds) {","        app.main.subscribe(to: SceneEvents.OnReady.self) { event in","            \/\/ Handle event here!","        }","        .store(in: &self.disposeBag)","    }","}"],"identifier":"EL-2-3-scene.swift","highlights":[],"type":"file"},"EL-2-4-events.swift":{"fileType":"swift","syntax":"swift","fileName":"Events.swift","content":["\/\/\/ Events the scene triggers.","public enum SceneEvents {","    ","    \/\/\/ An event triggered once when scene is ready to use and will starts update soon.","    public struct OnReady: Event {","        public let scene: Scene","    }","    ","    \/\/\/ Raised after an entity is added to the scene.","    public struct DidAddEntity: Event {","        public let entity: Entity","    }","    ","    \/\/\/ Raised before an entity is removed from the scene.","    public struct WillRemoveEntity: Event {","        public let entity: Entity","    }","","    \/\/\/ An event triggered once per frame interval that you can use to execute custom logic for each frame.","    public struct Update: Event {","","        \/\/\/ The updated scene.","        public let scene: Scene","","        \/\/\/ The elapsed time since the last update.","        public let deltaTime: TimeInterval","    }","}","","\/\/\/ Events associated with collisions.","public enum CollisionEvents {","    ","    \/\/\/ An event raised when two objects collide.","    public struct Began: Event {","        ","        \/\/\/ The first entity involved in the collision.","        public let entityA: Entity","        ","        \/\/\/ The second entity involved in the collision.","        public let entityB: Entity","        ","        \/\/\/ The estimated strength of the impact.","        public let impulse: Float","    }","    ","    \/\/\/ An event raised when two objects, previously in contact, separate.","    public struct Ended: Event {","        ","        \/\/\/ The first entity involved in the collision.","        public let entityA: Entity","        ","        \/\/\/ The second entity involved in the collision.","        public let entityB: Entity","    }","}"],"identifier":"EL-2-4-events.swift","h