"type":"codeVoice"},{"text":" that draws text along a sine wave and animate it by updating renderer state.","type":"text"}],"type":"section","role":"pseudoSymbol","title":"Prepare layout helpers"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Make-it-move":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Make-it-move","kind":"section","url":"\/tutorials\/adaengine\/createfirst2dscene#Make-it-move","abstract":[{"text":"In this tutorial, you will learn how to create your first 2D scene using Ada.","type":"text"}],"type":"section","role":"pseudoSymbol","title":"Make it move"},"GP-2-5-system.swift":{"content":["import AdaEngine","","@PlainSystem","struct GamepadInputSystem {","","    @FilterQuery<Ref<Transform>, With<PlayerComponent>>","    private var playerQuery","","    @Res<Input>","    private var input","","    @Res<DeltaTime>","    private var deltaTime","","    init(world _: World) {}","","    func update(context _: UpdateContext) {","        let gamepads = input.getConnectedGamepads()","","        if gamepads.isEmpty {","            return","        }","","        for gamepad in gamepads {","            let leftStickX = gamepad.getAxisValue(.leftStickX)","            let leftStickY = gamepad.getAxisValue(.leftStickY)","            let deadzone: Float = 0.1","","            if abs(leftStickX) > deadzone || abs(leftStickY) > deadzone {","                playerQuery.forEach { transform in","                    let speed: Float = 2.0","                    transform.position.x += leftStickX * Float(deltaTime.deltaTime) * speed","                    transform.position.y -= leftStickY * Float(deltaTime.deltaTime) * speed","                }","            }","","            if gamepad.isGamepadButtonPressed(.x) {","                gamepad.rumble(lowFrequency: 0.5, highFrequency: 0.75, duration: 0.5)","            }","        }","    }","}"],"fileType":"swift","type":"file","highlights":[{"line":36},{"line":37},{"line":38},{"line":39}],"fileName":"GamepadInputSystem.swift","identifier":"GP-2-5-system.swift","syntax":"swift"},"doc://AdaEngine/tutorials/AdaEngine/PlayerAndText#Add-Text-component":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Text-component","kind":"section","url":"\/tutorials\/adaengine\/playerandtext#Add-Text-component","abstract":[{"type":"text","text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene."}],"type":"section","role":"pseudoSymbol","title":"Add Text component"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Subscribe-to-scene-events":{"title":"Subscribe to scene events","role":"pseudoSymbol","type":"section","url":"\/tutorials\/adaengine\/eventlisteners#Subscribe-to-scene-events","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Subscribe-to-scene-events","abstract":[{"text":"In this tutorial you will learn about the event listeners system in Ada.","type":"text"},{"type":"text","text":" "},{"text":"How can you catch events and process them","type":"text"}]},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Create-the-view":{"title":"Create the view","role":"pseudoSymbol","type":"section","url":"\/tutorials\/adaengine\/animatedtext#Create-the-view","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-the-view","abstract":[{"text":"Create a custom ","type":"text"},{"code":"TextRenderer","type":"codeVoice"},{"text":" that draws text along a sine wave and animate it by updating renderer state.","type":"text"}]},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput":{"type":"topic","url":"\/tutorials\/adaengine\/gamepadinput","kind":"project","title":"Gamepad Input","abstract":[{"type":"text","text":"Build a small scene that spawns a player entity and moves it with a gamepad."}],"role":"project","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput","estimatedTime":"20min"},"GP-1-1-app.swift":{"content":["import AdaEngine","","@Component","struct PlayerComponent {}","","@main","struct GamepadInputApp: App {","    var body: some AppScene {","        DefaultAppWindow()","            .transformAppWorlds { appWorld in","                appWorld.spawn(","                    \"Camera\",","                    bundle: Camera2D(","                        camera: Camera(),","                        transform: Transform(position: [0, 0, 0])","                    )","                )","            }","            .windowMode(.windowed)","            .windowTitle(\"Gamepad Input\")","    }","}"],"fileType":"swift","type":"file","highlights":[],"fileName":"GamepadInputApp.swift","identifier":"GP-1-1-app.swift","syntax":"swift"},"GP-2-3-system.swift":{"content":["import AdaEngine","","@PlainSystem","struct GamepadInputSystem {","","    @FilterQuery<Ref<Transform>, With<PlayerComponent>>","    private var playerQuery","","    @Res<Input>","    private var input","","    @Res<DeltaTime>","    private var deltaTime","","    init(world _: World) {}","","    func update(context _: UpdateContext) {","        let gamepads = input.getConnectedGamepads()","","        if gamepads.isEmpty {","            return","        }","","        for gamepad in gamepads {","            if gamepad.isGamepadButtonPressed(.a) {","                print(\"Gamepad \\(gamepad.gamepadId): Button A pressed\")","            }","","            if gamepad.isGamepadButtonPressed(.b) {","                print(\"Gamepad \\(gamepad.gamepadId): Button B pressed\")","            }","        }","    }","}"],"fileType":"swift","type":"file","highlights":[{"line":25},{"line":26},{"line":27},{"line":28},{"line":29},{"line":30},{"line":31}],"fileName":"GamepadInputSystem.swift","identifier":"GP-2-3-system.swift","syntax":"swift"},"doc://AdaEngine/tutorials/AdaEngine/UIBasics#Add-a-button-and-state":{"title":"Add a button and state","role":"pseudoSymbol","type":"section","url":"\/tutorials\/adaengine\/uibasics#Add-a-button-and-state","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Add-a-button-and-state","abstract":[{"text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state.","type":"text"}]},"GP-1-3-app.swift":{"content":["import AdaEngine","","@Component","struct PlayerComponent {}","","@main","struct GamepadInputApp: App {","    var body: some AppScene {","        DefaultAppWindow()","            .transformAppWorlds { appWorld in","                appWorld.spawn(","                    \"Camera\",","                    bundle: Camera2D(","                        camera: Camera(),","                        transform: Transform(position: [0, 0, 0])","                    )","                )","","                appWorld.spawn(\"Player\") {","                    PlayerComponent()","                    Transform(scale: .init(0.5))","                    Sprite(tintColor: .red)","                }","","                appWorld.addSystem(GamepadInputSystem.self)","            }","            .windowMode(.windowed)","            .windowTitle(\"Gamepad Input\")","    }","}"],"fileType":"swift","type":"file","highlights":[{"line":24},{"line":25}],"fileName":"GamepadInputApp.swift","identifier":"GP-1-3-app.swift","syntax":"swift"},"doc://AdaEngine/tutorials/AdaEngine/PlayerAndText#Add-Player-component":{"title":"Add Player component","role":"pseudoSymbol","type":"section","url":"\/tutorials\/adaengine\/playerandtext#Add-Player-component","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText#Add-Player-component","abstract":[{"text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene.","type":"text"}]},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Create-a-custom-TextRenderer":{"title":"Create a custom TextRenderer","role":"pseudoSymbol","type":"section","url":"\/tutorials\/adaengine\/animatedtext#Create-a-custom-TextRenderer","kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-a-custom-TextRenderer","abstract":[{"text":"Create a custom ","type":"text"},{"code":"TextRenderer","type":"codeVoice"},{"type":"text","text":" that draws text along a sine wave and animate it by updating renderer state."}]},"GP-2-4-system.swift":{"content":["import AdaEngine","","@PlainSystem","struct GamepadInputSystem {","","    @FilterQuery<Ref<Transform>, With<PlayerComponent>>","    private var playerQuery","","    @Res<Input>","    private var input","","    @Res<DeltaTime>","    private var deltaTime","","    init(world _: World) {}","","    func update(context _: UpdateContext) {","        let gamepads = input.getConnectedGamepads()","","        if gamepads.isEmpty {","            return","        }","","        for gamepad in gamepads {","            let leftStickX = gamepad.getAxisValue(.leftStickX)","            let leftStickY = gamepad.getAxisValue(.leftStickY)","            let deadzone: Float = 0.1","","            if abs(leftStickX) > deadzone || abs(leftStickY) > deadzone {","                playerQuery.forEach { transform in","                    let speed: Float = 2.0","                    transform.position.x += leftStickX * Float(deltaTime.deltaTime) * speed","                    transform.position.y -= leftStickY * Float(deltaTime.deltaTime) * speed","                }","            }","        }","    }","}"],"fileType":"swift","type":"file","highlights":[],"fileName":"GamepadInputSystem.swift","identifier":"GP-2-4-system.swift","syntax":"swift"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Additional-for-physics":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Additional-for-physics","kind":"section","url":"\/tutorials\/adaengine\/eventlisteners#Additional-for-physics","abstract":[{"text":"In this tutorial you will learn about the event listeners system in Ada.","type":"text"},{"text":" ","type":"text"},{"text":"How can you catch events and process them","type":"text"}],"type":"section","role":"pseudoSymbol","title":"Additional for physics"},"doc://AdaEngine/tutorials/AdaEngine/AnimatedText#Apply-and-animate":{"type":"section","url":"\/tutorials\/adaengine\/animatedtext#Apply-and-animate","kind":"section","title":"Apply and animate","abstract":[{"type":"text","text":"Create a custom "},{"code":"TextRenderer","type":"codeVoice"},{"type":"text","text":" that draws text along a sine wave and animate it by updating renderer state."}],"role":"pseudoSymbol","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Apply-and-animate"},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Set-up-the-world":{"kind":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Set-up-the-world","url":"\/tutorials\/adaengine\/gamepadinput#Set-up-the-world","abstract":[{"text":"Build a small scene that spawns a player entity and moves it with a gamepad.","type":"text"}],"type":"section","role":"pseudoSymbol","title":"Set up the world"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Base-of-Event-Subscriber-pattern":{"type":"section","url":"\/tutorials\/adaengine\/eventlisteners#Base-of-Event-Subscriber-pattern","kind":"section","abstract":[{"type":"text","text":"In this tutorial you will learn about the event listeners system in Ada."},{"type":"text","text":" "},{"type":"text","text":"How can you catch events and process them"}],"title":"Base of Event-Subscriber pattern","role":"pseudoSymbol","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Base-of-Event-Subscriber-pattern"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners":{"type":"topic","url":"\/tutorials\/adaengine\/eventlisteners","kind":"project","title":"Event Listeners in Ada","abstract":[{"text":"In this tutorial you will learn about the event listeners system in Ada.","type":"text"},{"text":" ","type":"text"},{"text":"How can you catch events and process them","type":"text"}],"role":"project","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners","estimatedTime":"5min"},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#First-sprite":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#First-sprite","kind":"section","url":"\/tutorials\/adaengine\/createfirst2dscene#First-sprite","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}],"type":"section","role":"pseudoSymbol","title":"First sprite"}}}