 systems and iterate native AdaECS component columns."}],"kind":"article"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptPlugin":{"url":"\/documentation\/adascripting\/adascriptplugin","role":"symbol","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin","kind":"symbol","title":"AdaScriptPlugin","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptPlugin","kind":"identifier"}],"navigatorTitle":[{"text":"AdaScriptPlugin","kind":"identifier"}],"abstract":[{"text":"Loads an annotation-driven Ada Script module.","type":"text"}],"type":"topic"}}}