UIBasics#Create-the-app-shell":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Create-the-app-shell","role":"pseudoSymbol","url":"\/tutorials\/adaengine\/uibasics#Create-the-app-shell","kind":"section","title":"Create the app shell","abstract":[{"type":"text","text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state."}]},"GP-1-3-app.swift":{"type":"file","identifier":"GP-1-3-app.swift","syntax":"swift","highlights":[{"line":24},{"line":25}],"fileType":"swift","fileName":"GamepadInputApp.swift","content":["import AdaEngine","","@Component","struct PlayerComponent {}","","@main","struct GamepadInputApp: App {","    var body: some AppScene {","        DefaultAppWindow()","            .transformAppWorlds { appWorld in","                appWorld.spawn(","                    \"Camera\",","                    bundle: Camera2D(","                        camera: Camera(),","                        transform: Transform(position: [0, 0, 0])","                    )","                )","","                appWorld.spawn(\"Player\") {","                    PlayerComponent()","                    Transform(scale: .init(0.5))","                    Sprite(tintColor: .red)","                }","","                appWorld.addSystem(GamepadInputSystem.self)","            }","            .windowMode(.windowed)","            .windowTitle(\"Gamepad Input\")","    }","}"]},"GP-2-5-system.swift":{"type":"file","identifier":"GP-2-5-system.swift","syntax":"swift","highlights":[{"line":36},{"line":37},{"line":38},{"line":39}],"fileType":"swift","fileName":"GamepadInputSystem.swift","content":["import AdaEngine","","@PlainSystem","struct GamepadInputSystem {","","    @FilterQuery<Ref<Transform>, With<PlayerComponent>>","    private var playerQuery","","    @Res<Input>","    private var input","","    @Res<DeltaTime>","    private var deltaTime","","    init(world _: World) {}","","    func update(context _: UpdateContext) {","        let gamepads = input.getConnectedGamepads()","","        if gamepads.isEmpty {","            return","        }","","        for gamepad in gamepads {","            let leftStickX = gamepad.getAxisValue(.leftStickX)","            let leftStickY = gamepad.getAxisValue(.leftStickY)","            let deadzone: Float = 0.1","","            if abs(leftStickX) > deadzone || abs(leftStickY) > deadzone {","                playerQuery.forEach { transform in","                    let speed: Float = 2.0","                    transform.position.x += leftStickX * Float(deltaTime.deltaTime) * speed","                    transform.position.y -= leftStickY * Float(deltaTime.deltaTime) * speed","                }","            }","","            if gamepad.isGamepadButtonPressed(.x) {","                gamepad.rumble(lowFrequency: 0.5, highFrequency: 0.75, duration: 0.5)","            }","        }","    }","}"]},"doc://AdaEngine/tutorials/AdaEngine":{"type":"topic","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine","role":"overview","url":"\/tutorials\/adaengine","kind":"overview","title":"Meet Ada","abstract":[{"type":"text","text":"Learn the basics of Ada and start developing your own games!"}]},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Subscribe-to-scene-events":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Subscribe-to-scene-events","role":"pseudoSymbol","url":"\/tutorials\/adaengine\/eventlisteners#Subscribe-to-scene-events","kind":"section","title":"Subscribe to scene events","abstract":[{"type":"text","text":"In this tutorial you will learn about the event listeners system in Ada."},{"type":"text","text":" "},{"type":"text","text":"How can you catch events and process them"}]},"doc://AdaEngine/tutorials/AdaEngine/CreateProject":{"type":"topic","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject","role":"project","url":"\/tutorials\/adaengine\/createproject","kind":"project","title":"Create your first game project","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first Ada project."}],"estimatedTime":"5min"},"doc://AdaEngine/tutorials/AdaEngine/UI-and-Input":{"type":"topic","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UI-and-Input","role":"article","url":"\/tutorials\/adaengine\/ui-and-input","kind":"article","title":"UI and Input","abstract":[]},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#First-sprite":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#First-sprite","role":"pseudoSymbol","url":"\/tutorials\/adaengine\/createfirst2dscene#First-sprite","kind":"section","title":"First sprite","abstract":[{"type":"text","text":"In this tutorial, you will learn how to create your first 2D scene using Ada."}]},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Read-buttons":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Read-buttons","role":"pseudoSymbol","url":"\/tutorials\/adaengine\/gamepadinput#Read-buttons","kind":"section","title":"Read buttons","abstract":[{"type":"text","text":"Build a small scene that spawns a player entity and moves it with a gamepad."}]},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Type-of-events":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Type-of-events","role":"pseudoSymbol","url":"\/tutorials\/adaengine\/eventlisteners#Type-of-events","kind":"section","title":"Type of events","abstract":[{"type":"text","text":"In this tutorial you will learn about the event listeners system in Ada."},{"type":"text","text":" "},{"type":"text","text":"How can you catch events and process them"}]},"doc://AdaEngine/tutorials/AdaEngine/CreateFirst2DScene#Create-a-main-camera":{"type":"section","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Create-a-main-camera","role":"pseudoSymbol","url":"\/tutorials\/adaengine\/createfirst2dscene#Create-a-main-camera","kind":"section","title":"Create a main camera.","abstract":[{"text":"In this tutorial, you will learn how to create your first 2D scene using Ada.","type":"text"}]},"doc://AdaEngine/tutorials/AdaEngine/UIBasics":{"type":"topic","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics","role":"project","url":"\/tutorials\/adaengine\/uibasics","kind":"project","title":"UI Basics","abstract":[{"type":"text","text":"Build a simple UI screen using Ada views. You will create a window, layout a few elements, and add a button with state."}],"estimatedTime":"15min"}}}