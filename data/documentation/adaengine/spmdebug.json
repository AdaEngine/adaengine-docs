{"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","identifier":{"url":"doc:\/\/AdaEngine\/documentation\/AdaEngine\/SPMDebug","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/adaengine\/spmdebug"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Xcode Instruments: “Required kernel recording resources are in use by another document”","anchor":"Xcode-Instruments-Required-kernel-recording-resources-are-in-use-by-another-document","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"When profiling an SPM project (without an xcodeproj) in Instruments, you may see a message about kernel recording resources being in use, even when no other Instruments documents are open."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Cause:","type":"text"}]},{"type":"text","text":" The message is misleading. The real cause is that the binary does not have the "},{"type":"codeVoice","code":"get-task-allow"},{"type":"text","text":" entitlement. SPM does not distinguish between “release” and “profiling,” so profiling uses a release build without this entitlement."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Solution:","type":"text"}],"type":"strong"},{"text":" Re-sign the binary with the ","type":"text"},{"code":"get-task-allow","type":"codeVoice"},{"text":" entitlement before launching Instruments.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Open your scheme (Cmd-Shift-,).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"In ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Profile → Pre-actions"}]},{"type":"text","text":", add a Pre-action."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Set the shell to "},{"type":"codeVoice","code":"\/bin\/zsh"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Paste the re-sign script below (the ","type":"text"},{"code":"=(...)","type":"codeVoice"},{"text":" syntax is zsh process substitution):","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"codeListing","code":["# For Instruments, re-sign binary with get-task-allow entitlement","codesign -s - -v -f --entitlements =(echo -n '<?xml version=\"1.0\" encoding=\"UTF-8\"?>","<!DOCTYPE plist PUBLIC \"-\/\/Apple\/\/DTD PLIST 1.0\/\/EN\" \"https:\/\/www.apple.com\/DTDs\/PropertyList-1.0.dtd\">","<plist version=\"1.0\">","    <dict>","        <key>com.apple.security.get-task-allow<\/key>","        <true\/>","    <\/dict>","<\/plist>') ${TARGET_BUILD_DIR}\/${PRODUCT_NAME}"],"syntax":"zsh"},{"type":"paragraph","inlineContent":[{"text":"See also: ","type":"text"},{"isActive":true,"identifier":"https:\/\/cocoaphony.micro.blog\/2022\/10\/29\/solving-required-kernel.html","type":"reference"},{"text":" (Rob Napier).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The script is stored in ","type":"text"},{"code":".swiftpm\/xcode\/xcshareddata\/xcschemes\/<schemename>.xcscheme","type":"codeVoice"},{"text":". The pre-action runs only for Profile, so it does not affect normal builds.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Note:"}],"type":"strong"},{"type":"text","text":" Pre-action scripts do not receive "},{"type":"codeVoice","code":"SRCROOT"},{"type":"text","text":"; if the script fails, Xcode will not show details—check Console.app for logs."}]}]}],"metadata":{"modules":[{"name":"AdaEngine"}],"role":"article","roleHeading":"Article","title":"Known issues and how to debug SPM targets"},"hierarchy":{"paths":[["doc:\/\/AdaEngine\/documentation\/AdaEngine"]]},"references":{"doc://AdaEngine/documentation/AdaEngine":{"url":"\/documentation\/adaengine","type":"topic","identifier":"doc:\/\/AdaEngine\/documentation\/AdaEngine","title":"AdaEngine","abstract":[{"text":"Bringing simple and powerful game engine for your awesome games.","type":"text"}],"kind":"symbol","role":"collection"},"https://cocoaphony.micro.blog/2022/10/29/solving-required-kernel.html":{"type":"link","title":"Solving “Required kernel recording resources…” in Instruments","identifier":"https:\/\/cocoaphony.micro.blog\/2022\/10\/29\/solving-required-kernel.html","titleInlineContent":[{"type":"text","text":"Solving “Required kernel recording resources…” in Instruments"}],"url":"https:\/\/cocoaphony.micro.blog\/2022\/10\/29\/solving-required-kernel.html"}}}