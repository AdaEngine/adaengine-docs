r":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-the-view"},"AT-1-2-view.swift":{"type":"file","identifier":"AT-1-2-view.swift","syntax":"swift","fileName":"ContentView.swift","fileType":"swift","highlights":[],"content":["import AdaEngine","","struct ContentView: View {","    var body: some View {","        Text(\"Sine Wave\")","    }","}"]},"AT-3-3-view.swift":{"type":"file","identifier":"AT-3-3-view.swift","syntax":"swift","fileName":"ContentView.swift","fileType":"swift","highlights":[{"line":13},{"line":14},{"line":15},{"line":16}],"content":["import AdaEngine","","struct ContentView: View {","    @State private var timeOffset: Double = 0","    @State private var animationTask: Task<Void, Never>?","","    var body: some View {","        Text(\"Sine Wave\")","            .textRendered(AnimatedSineWaveRenderer(timeOffset: timeOffset))","            .onAppear {","                startAnimation()","            }","            .onDisappear {","                animationTask?.cancel()","                animationTask = nil","            }","    }","","    private func startAnimation() {","        animationTask?.cancel()","        animationTask = Task { @MainActor in","            while !Task.isCancelled {","                timeOffset += 0.12","                try? await Task.sleep(nanoseconds: 16_000_000)","            }","        }","    }","}"]},"AT-3-1-view.swift":{"syntax":"swift","highlights":[],"fileType":"swift","fileName":"ContentView.swift","type":"file","identifier":"AT-3-1-view.swift","content":["import AdaEngine","","struct ContentView: View {","    @State private var timeOffset: Double = 0","","    var body: some View {","        Text(\"Sine Wave\")","            .textRendered(AnimatedSineWaveRenderer(timeOffset: timeOffset))","    }","}"]},"doc://AdaEngine/tutorials/AdaEngine/GamepadInput#Set-up-the-world":{"type":"section","url":"\/tutorials\/adaengine\/gamepadinput#Set-up-the-world","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/