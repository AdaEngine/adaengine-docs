{"kind":"project","schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText"},"metadata":{"role":"project","title":"Player and Text in Ada","category":"Ada","categoryPathComponent":"AdaEngine"},"sections":[{"estimatedTimeInMinutes":5,"xcodeRequirement":"Xcode 26.2 or later","content":[{"type":"paragraph","inlineContent":[{"text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene.","type":"text"}]}],"kind":"hero","title":"Player and Text in Ada","chapter":"Create your first 2D game project."},{"tasks":[{"title":"Add Player component","stepsSection":[{"caption":[],"media":null,"runtimePreview":null,"code":"PAT-1-1-player-component.swift","type":"step","content":[{"inlineContent":[{"text":"First of all you have to add the player component. For Ada to understand you, just specify the following code.","type":"text"}],"type":"paragraph"}]},{"caption":[{"inlineContent":[{"text":"We will create a separate makePlayer function where we will spawn an entity with various components.","type":"text"}],"type":"paragraph"}],"media":null,"runtimePreview":null,"code":"PAT-1-2-makePlayer.swift","type":"step","content":[{"inlineContent":[{"text":"We must add our player to the scene. To do this we will use ","type":"text"},{"type":"codeVoice","code":"World\/spawn(_:)"},{"text":" to spawn entities. Follow the code!","type":"text"}],"type":"paragraph"}]},{"caption":[],"media":null,"runtimePreview":null,"code":"PAT-1-3-makePlayer.swift","type":"step","content":[{"inlineContent":[{"text":"Next, let’s spawn an entity with the ","type":"text"},{"type":"codeVoice","code":"PlayerComponent"},{"text":", which we discussed earlier, so that we can easily identify this entity as our player.","type":"text"}],"type":"paragraph"}]},{"caption":[],"media":null,"runtimePreview":null,"code":"PAT-1-4-makePlayer.swift","type":"step","content":[{"inlineContent":[{"text":"Ada knows that the player has been added to the scene, but… he can’t do anything and doesn’t have any properties. Let’s fix this! To begin with, we will give the player the opportunity to move and, in general, somehow change his size and position. Let’s use the built-in Transform component and set some initial values.","type":"text"}],"type":"paragraph"}]},{"caption":[],"media":null,"runtimePreview":null,"code":"PAT-1-5-makePlayer.swift","type":"step","content":[{"inlineContent":[{"text":"One more component is missing - what will the player look like? To do this, you can use sprites and the corresponding component in Ada. We pass a ","type":"text"},{"type":"codeVoice","code":"characterAtlas"},{"text":" parameter to get the texture for our player.","type":"text"}],"type":"paragraph"}]},{"caption":[],"media":null,"runtimePreview":null,"code":"PAT-1-6-makeScene.swift","type":"step","content":[{"inlineContent":[{"text":"After all the preparations, let’s create a Plugin that will set up our player. The Plugin pattern is the recommended way to organize game logic in Ada.","type":"text"}],"type":"paragraph"}]}],"contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"inlineContent":[{"text":"Here we will start adding our Components and Entity, so that Ada will correctly render our player and make him alive!","type":"text"}],"type":"paragraph"}]}],"anchor":"Add-Player-component"},{"title":"Add Text component","stepsSection":[{"caption":[],"media":null,"runtimePreview":null,"code":"PAT-2-1-gameState.swift","type":"step","content":[{"inlineContent":[{"text":"Okay, most likely you want to count some points for your player. Let’s start creating the GameState resource. Note that we use ","type":"text"},{"type":"codeVoice","code":"Resource"},{"text":" protocol for global game state.","type":"text"}],"type":"paragraph"}]},{"caption":[{"inlineContent":[{"text":"To customize the text, you can use TextAttributeContainer.","type":"text"}],"type":"paragraph"}],"media":null,"runtimePreview":null,"code":"PAT-2-2-makeScore.swift","type":"step","content":[{"inlineContent":[{"text":"By analogy with the player, we will create a separate function for adding score text to the scene. Here, we spawn an entity with a ","type":"text"},{"type":"codeVoice","code":"TextComponent"},{"text":" - it will help us draw the text. We also add Transform for positioning and insert our GameState as a resource.","type":"text"}],"type":"paragraph"}]}],"contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"inlineContent":[{"text":"Let’s dive deeper into the Ada text component","type":"text"}],"type":"paragraph"}]}],"anchor":"Add-Text-component"}],"kind":"tasks"},{"abstract":[{"type":"text","text":"In this tutorial you will learn about the event listeners system in Ada."},{"type":"text","text":" "},{"text":"How can you catch events and process them","type":"text"}],"action":{"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners","type":"reference","overridingTitle":"Get started","overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"isActive":true},"featuredEyebrow":"Tutorial","kind":"callToAction","title":"Event Listeners in Ada"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/adaengine\/playerandtext"]}],"hierarchy":{"paths":[["doc:\/\/AdaEngine\/tutorials\/AdaEngine","doc:\/\/AdaEngine\/tutorials\/AdaEngine\/$volume","doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project."]],"modules":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project.","projects":[{"sections":[{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject#Create-project-using-Xcode"}],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateProject"},{"sections":[{"kind":"task","reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/CreateFirst2DScene#Intro"},{"ki