{"metadata":{"title":"Getting Started with Ada Script","roleHeading":"Article","role":"article","modules":[{"name":"Ada Script"}]},"abstract":[{"type":"text","text":"Add an "},{"code":".ada","type":"codeVoice"},{"type":"text","text":" file to an AdaEngine executable and run its systems without manually loading each script."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript"},"seeAlsoSections":[{"title":"Essentials","generated":true,"identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptBasics","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLibraries"],"anchor":"Essentials"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/AdaScripting\/documentation\/AdaScripting"]]},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"AdaEngine provides two ways to install Ada Script plugins:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Automatic discovery"}]},{"type":"text","text":" embeds every "},{"type":"codeVoice","code":".ada"},{"type":"text","text":" file in an executable target at"},{"type":"text","text":" "},{"type":"text","text":"build time and generates one plugin backed by one target-level script module."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Manual loading"}],"type":"strong"},{"text":" creates an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin","type":"reference"},{"text":" from source text or a file URL at runtime.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"AdaEditor-created projects use automatic discovery. Use manual loading when scripts live outside the Swift target, come from a downloaded package, or need explicit error handling.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Create a script","anchor":"Create-a-script","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add "},{"code":"Movement.ada","type":"codeVoice"},{"type":"text","text":" anywhere below the executable target’s source directory, for example:"}]},{"code":["Sources\/MyGame\/","├── main.swift","└── Scripts\/","    └── Movement.ada"],"type":"codeListing","syntax":"text"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declare a system and its query with annotations:"}]},{"code":["@system(scheduler: \"update\")","class MovementSystem {","    @query(Transform)","    var transforms;","","    func update(context) {","        for (var entity in transforms) {","            var position = entity.transform.position;","            position[0] += 100 * context.deltaTime;","            entity.transform.position = position;","        }","    }","}"],"type":"codeListing","syntax":"ada"},{"type":"paragraph","inlineContent":[{"text":"AdaEngine discovers ","type":"text"},{"code":"@system","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@query","type":"codeVoice"},{"text":" metadata and calls ","type":"text"},{"code":"update(context)","type":"codeVoice"},{"text":" whenever the selected scheduler runs.","type":"text"}]},{"type":"heading","text":"Enable automatic discovery","anchor":"Enable-automatic-discovery","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Expose "},{"type":"codeVoice","code":"AdaScriptBuildPlugin"},{"type":"text","text":" to your executable target in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}]},{"code":["\/\/ swift-tools-version: 6.2","import PackageDescription","","let package = Package(","    name: \"MyGame\",","    platforms: [","        .macOS(.v15)","    ],","    dependencies: [","        .package(","            url: \"https:\/\/github.com\/AdaEngine\/AdaEngine.git\",","            branch: \"main\"","        )","    ],","    targets: [","        .executableTarget(","            name: \"MyGame\",","            dependencies: [","                .product(name: \"AdaEngine\", package: \"AdaEngine\")","            ],","            plugins: [","                .plugin(name: \"AdaScriptBuildPlugin\", package: \"AdaEngine\")","            ]","        )","    ]",")"],"type":"codeListing","syntax":"swift"},{"style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"Choose a version requirement appropriate for your project instead of a branch dependency when consuming a released AdaEngine version.","type":"text"}]}],"type":"aside"},{"inlineContent":[{"type":"text","text":"The build plugin finds "},{"type":"codeVoice","code":".ada"},{"type":"text","text":" files through SwiftPM, sorts them by target-relative"},{"text":" ","type":"text"},{"text":"path, and generates ","type":"text"},{"code":"AdaScriptPluginsGenerated.swift","type":"codeVoice"},{"text":" in the plugin work","type":"text"},{"text":" ","type":"text"},{"text":"directory. The generated plugin passes one source map to one","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin","isActive":true,"type":"reference"},{"text":". Script source is embedded in the executable; the","type":"text"},{"text":" ","type":"text"},{"text":"original files are not read at runtime.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Install the generated plugin in your app scene:","type":"text"}]},{"type":"codeListing","code":["import AdaEngine","","@main","struct MyGame: App {","    var body: some AppScene {","        WindowGroup {","            GameView()","        }","        .addPlugins(AdaScriptPluginsGenerated())","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Rebuilding the target after adding, removing, renaming, or editing an "},{"type":"codeVoice","code":".ada"},{"type":"text","text":" file refreshes the generated source."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In a portable AdaScript project running in AdaEditor’s macOS game window, edits"},{"type":"text","text":" "},{"type":"text","text":"to "},{"code":".ada","type":"codeVoice"},{"type":"text","text":" files hot reload after a short pause, including unsaved editor buffers."},{"type":"text","text":" "},{"type":"text","text":"The current ECS world remains active. A failed candidate leaves the last valid"},{"type":"text","text":" "},{"type":"text","text":"code running and reports the error in Output. System instances and ordinary"},{"type":"text","text":" "},{"type":"text","text":"script globals restart, and startup systems run once for the new version;"},{"type":"text","text":" "},{"type":"text","text":"exported scriptable-object fields survive. Changes to"},{"type":"text","text":" "},{"type":"text","text":"component, resource, network, or scriptable-object schemas require restarting"},{"type":"text","text":" "},{"type":"text","text":"the game."}]},{"inlineContent":[{"text":"The same generated source contains native backing structs and registration for","type":"text"},{"text":" ","type":"text"},{"text":"scalar ","type":"text"},{"type":"codeVoice","code":"@component"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"@resource"},{"text":" declarations. Because these declarations","type":"text"},{"text":" ","type":"text"},{"text":"change Swift layout, adding or editing their stored fields requires rebuilding","type":"text"},{"text":" ","type":"text"},{"text":"the target rather than source-only reload.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Register-custom-components","type":"heading","text":"Register custom components"},{"inlineContent":[{"type":"text","text":"Ada Script resolves component names while plugins are set up. Register custom Swift components before the generated script plugin:"}],"type":"paragraph"},{"syntax":"swift","code":["import AdaEngine","","@Component","struct Movement: Codable, Sendable {","    var velocity: Vector2","}","","struct GameComponentsPlugin: Plugin {","    @MainActor","    func setup(in app: borrowing AppWorlds) {","        Movement.registerComponent()","    }","}","","@main","struct MyGame: App {","    var body: some AppScene {","        WindowGroup {","            GameView()","        }","        .addPlugins(","            GameComponentsPlugin(),","            AdaScriptPluginsGenerated()","        )","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"code":"@Component","type":"codeVoice"},{"type":"text","text":" macro supplies field reflection for supported property types. A plain "},{"code":"Component","type":"codeVoice"},{"type":"text","text":" can participate in query matching, but its fields are not automatically available through the script bridge."}],"type":"paragraph"},{"level":2,"anchor":"Load-a-script-manually","type":"heading","text":"Load a script manually"},{"inlineContent":[{"type":"text","text":"Create an "},{"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin","type":"reference","isActive":true},{"type":"text","text":" when you need control over the source location or loading failure:"}],"type":"paragraph"},{"syntax":"swift","code":["import AdaEngine","","struct RuntimeScriptsPlugin: Plugin {","    let scriptURL: URL","","    @MainActor","    func setup(in app: borrowing AppWorlds) {","        do {","            let script = try AdaScriptPlugin(contentsOf: scriptURL)","            app.addPlugin(script)","        } catch {","            print(\"Could not load Ada Script: \\(error)\")","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"You can also use ","type":"text"},{"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin\/init(source:name:)","isActive":true,"type":"reference"},{"text":" when one source is","type":"text"},{"text":" ","type":"text"},{"text":"already in memory, or ","type":"text"},{"code":"AdaScriptPlugin\/init(sources:name:)","type":"codeVoice"},{"type":"text","text":" with"},{"type":"text","text":" "},{"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptSource","type":"reference","isActive":true},{"type":"text","text":" values for a multi-file module. Script compilation,"},{"type":"text","text":" "},{"type":"text","text":"import resolution, and annotation validation happen during initialization."},{"type":"text","text":" "},{"type":"text","text":"Native component resolution happens later during plugin setup."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Next steps","anchor":"Next-steps"},{"inlineContent":[{"type":"text","text":"Read "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage"},{"type":"text","text":" for annotation syntax, then "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS"},{"type":"text","text":" for queries, component fields, and native iterator behavior."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/adascripting\/gettingstartedwithadascript"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"references":{"doc://AdaScripting/documentation/AdaScripting/GettingStartedWithAdaScript":{"title":"Getting Started with Ada Script","abstract":[{"text":"Add an ","type":"text"},{"code":".ada","type":"codeVoice"},{"text":" file to an AdaEngine executable and run its systems without manually loading each script.","type":"text"}],"type":"topic","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript","url":"\/documentation\/adascripting\/gettingstartedwithadascript","kind":"article","role":"article"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptAnnotations":{"url":"\/documentation\/adascripting\/adascriptannotations","abstract":[{"type":"text","text":"Choose an annotation by the declaration it describes. Annotation arguments"},{"type":"text","text":" "},{"type":"text","text":"are literals, identifiers, or lists of those values, not runtime expressions."},{"type":"text","text":" "},{"type":"text","text":"The same spelling can have different roles: "},{"type":"codeVoice","code":"@component"},{"type":"text","text":" declares a struct,"},{"type":"text","text":" "},{"type":"text","text":"while "},{"type":"codeVoice","code":"@component(required: true)"},{"type":"text","text":" binds an existing component to a scriptable"},{"type":"text","text":" "},{"type":"text","text":"instance."}],"role":"article","type":"topic","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","title":"Ada Script Annotation Reference","kind":"article"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptLanguage":{"type":"topic","url":"\/documentation\/adascripting\/adascriptlanguage","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage","title":"Ada Script Language","abstract":[{"text":"Use Ada Script syntax with AdaEngine declaration annotations. New to the","type":"text"},{"text":" ","type":"text"},{"text":"language? Start with ","type":"text"},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptBasics","isActive":true},{"text":" for values, functions, types,","type":"text"},{"text":" ","type":"text"},{"text":"properties, control flow, asynchronous work, and annotations.","type":"text"}],"kind":"article","role":"article"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptPlugin/init(source:name:)":{"abstract":[],"title":"init(source:name:)","kind":"symbol","type":"topic","url":"\/documentation\/adascripting\/adascriptplugin\/init(source:name:)","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin\/init(source:name:)","role":"symbol","fragments":[{"text":"convenience","kind":"keyword"},{"text":" ","kind":"text"},{"text":"init","kind":"identifier"},{"kind":"text","text":"("},{"text":"source","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"name","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}]},"doc://AdaScripting/documentation/AdaScripting/AdaScriptSource":{"abstract":[{"type":"text","text":"One source file embedded in an Ada Script module."}],"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptSource","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"AdaScriptSource","kind":"identifier"}],"url":"\/documentation\/adascripting\/adascriptsource","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptSource","kind":"identifier"}],"title":"AdaScriptSource","type":"topic"},"doc://AdaScripting/documentation/AdaScripting":{"url":"\/documentation\/adascripting","title":"Ada Script","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting","kind":"symbol","abstract":[{"text":"Write gameplay systems in Ada Script while keeping entity filtering and access planning in AdaEngine’s native ECS.","type":"text"}],"type":"topic","role":"collection"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptPlugin":{"type":"topic","url":"\/documentation\/adascripting\/adascriptplugin","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin","navigatorTitle":[{"text":"AdaScriptPlugin","kind":"identifier"}],"title":"AdaScriptPlugin","abstract":[{"type":"text","text":"Loads an annotation-driven Ada Script module."}],"kind":"symbol","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptPlugin","kind":"identifier"}]},"doc://AdaScripting/documentation/AdaScripting/AdaScriptECS":{"abstract":[{"type":"text","text":"Declare annotation-driven systems and iterate native AdaECS component columns."}],"title":"Ada Script ECS","type":"topic","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS","kind":"article","url":"\/documentation\/adascripting\/adascriptecs","role":"article"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptBasics":{"title":"Ada Script Basics","abstract":[{"type":"text","text":"Learn the syntax of Ada Script before connecting a script to a scene or ECS"},{"type":"text","text":" "},{"type":"text","text":"world. Ada Script files use the "},{"code":".ada","type":"codeVoice"},{"type":"text","text":" extension. The examples on this page are"},{"type":"text","text":" "},{"type":"text","text":"small pieces you can combine in one file; a game does not need a "},{"code":"main()","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"function. Start with "},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript","isActive":true},{"type":"text","text":" to run a complete system."}],"type":"topic","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptBasics","kind":"article","url":"\/documentation\/adascripting\/adascriptbasics","role":"article"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptLibraries":{"type":"topic","url":"\/documentation\/adascripting\/adascriptlibraries","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLibraries","title":"AdaScript Libraries","abstract":[{"text":"Share reusable AdaScript functions, systems, and scriptable objects through a GitHub repository.","type":"text"},{"text":" ","type":"text"},{"text":"AdaEditor installs the library and its transitive dependencies into the project. Run, Play Mode,","type":"text"},{"text":" ","type":"text"},{"text":"Preview, and ","type":"text"},{"type":"codeVoice","code":"AdaScriptBuildPlugin"},{"text":" load the same installed sources without network access.","type":"text"}],"kind":"article","role":"article"}}}