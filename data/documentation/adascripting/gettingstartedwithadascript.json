{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"AdaEngine provides two ways to install Ada Script plugins:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Automatic discovery"}],"type":"strong"},{"text":" embeds every ","type":"text"},{"code":".ada","type":"codeVoice"},{"text":" file in an executable target at","type":"text"},{"text":" ","type":"text"},{"text":"build time and generates one plugin backed by one target-level script module.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Manual loading"}],"type":"strong"},{"text":" creates an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin","type":"reference"},{"text":" from source text or a file URL at runtime.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"AdaEditor-created projects use automatic discovery. Use manual loading when scripts live outside the Swift target, come from a downloaded package, or need explicit error handling."}],"type":"paragraph"},{"level":2,"text":"Create a script","anchor":"Create-a-script","type":"heading"},{"inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"Movement.ada"},{"type":"text","text":" anywhere below the executable target’s source directory, for example:"}],"type":"paragraph"},{"syntax":"text","code":["Sources\/MyGame\/","├── main.swift","└── Scripts\/","    └── Movement.ada"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Declare a system and its query with annotations:"}],"type":"paragraph"},{"syntax":"ada","code":["@system(scheduler: \"update\")","class MovementSystem {","    @query(Transform)","    var transforms;","","    func update(context) {","        for (var entity in transforms) {","            var position = entity.transform.position;","            position[0] += 100 * context.deltaTime;","            entity.transform.position = position;","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"AdaEngine discovers "},{"type":"codeVoice","code":"@system"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@query"},{"type":"text","text":" metadata and calls "},{"type":"codeVoice","code":"update(context)"},{"type":"text","text":" whenever the selected scheduler runs."}],"type":"paragraph"},{"level":2,"text":"Enable automatic discovery","anchor":"Enable-automatic-discovery","type":"heading"},{"inlineContent":[{"type":"text","text":"Expose "},{"type":"codeVoice","code":"AdaScriptBuildPlugin"},{"type":"text","text":" to your executable target in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ swift-tools-version: 6.2","import PackageDescription","","let package = Package(","    name: \"MyGame\",","    platforms: [","        .macOS(.v15)","    ],","    dependencies: [","        .package(","            url: \"https:\/\/github.com\/AdaEngine\/AdaEngine.git\",","            branch: \"main\"","        )","    ],","    targets: [","        .executableTarget(","            name: \"MyGame\",","            dependencies: [","                .product(name: \"AdaEngine\", package: \"AdaEngine\")","            ],","            plugins: [","                .plugin(name: \"AdaScriptBuildPlugin\", package: \"AdaEngine\")","            ]","        )","    ]",")"],"type":"codeListing"},{"name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"Choose a version requirement appropriate for your project instead of a branch dependency when consuming a released AdaEngine version.","type":"text"}]}],"style":"important","type":"aside"},{"inlineContent":[{"type":"text","text":"The build plugin finds "},{"code":".ada","type":"codeVoice"},{"type":"text","text":" files through SwiftPM, sorts them by target-relative"},{"type":"text","text":" "},{"type":"text","text":"path, and generates "},{"code":"AdaScriptPluginsGenerated.swift","type":"codeVoice"},{"type":"text","text":" in the plugin work"},{"type":"text","text":" "},{"type":"text","text":"directory. The generated plugin passes one source map to one"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin","isActive":true},{"type":"text","text":". Script source is embedded in the executable; the"},{"type":"text","text":" "},{"type":"text","text":"original files are not read at runtime."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Install the generated plugin in your app scene:"}],"type":"paragraph"},{"syntax":"swift","code":["import AdaEngine","","@main","struct MyGame: App {","    var body: some AppScene {","        WindowGroup {","            GameView()","        }","        .addPlugins(AdaScriptPluginsGenerated())","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Rebuilding the target after adding, removing, renaming, or editing an ","type":"text"},{"code":".ada","type":"codeVoice"},{"text":" file refreshes the generated source.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In a portable AdaScript project running in AdaEditor’s macOS game window, edits","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"code":".ada","type":"codeVoice"},{"text":" files hot reload after a short pause, including unsaved editor buffers.","type":"text"},{"text":" ","type":"text"},{"text":"The current ECS world remains active. A failed candidate leaves the last valid","type":"text"},{"text":" ","type":"text"},{"text":"code running and reports the error in Output. System instances and ordinary","type":"text"},{"text":" ","type":"text"},{"text":"script globals restart, and startup systems run once for the new version;","type":"text"},{"text":" ","type":"text"},{"text":"exported scriptable-object fields survive. Changes to","type":"text"},{"text":" ","type":"text"},{"text":"component, resource, network, or scriptable-object schemas require restarting","type":"text"},{"text":" ","type":"text"},{"text":"the game.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The same generated source contains native backing structs and registration for","type":"text"},{"text":" ","type":"text"},{"text":"scalar ","type":"text"},{"code":"@component","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@resource","type":"codeVoice"},{"text":" declarations. Because these declarations","type":"text"},{"text":" ","type":"text"},{"text":"change Swift layout, adding or editing their stored fields requires rebuilding","type":"text"},{"text":" ","type":"text"},{"text":"the target rather than source-only reload.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Register custom components","anchor":"Register-custom-components","type":"heading"},{"inlineContent":[{"text":"Ada Script resolves component names while plugins are set up. Register custom Swift components before the generated script plugin:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import AdaEngine","","@Component","struct Movement: Codable, Sendable {","    var velocity: Vector2","}","","struct GameComponentsPlugin: Plugin {","    @MainActor","    func setup(in app: borrowing AppWorlds) {","        Movement.registerComponent()","    }","}","","@main","struct MyGame: App {","    var body: some AppScene {","        WindowGroup {","            GameView()","        }","        .addPlugins(","            GameComponentsPlugin(),","            AdaScriptPluginsGenerated()","        )","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"@Component","type":"codeVoice"},{"text":" macro supplies field reflection for supported property types. A plain ","type":"text"},{"code":"Component","type":"codeVoice"},{"text":" can participate in query matching, but its fields are not automatically available through the script bridge.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Load a script manually","anchor":"Load-a-script-manually","type":"heading"},{"inlineContent":[{"text":"Create an ","type":"text"},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin","isActive":true},{"text":" when you need control over the source location or loading failure:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import AdaEngine","","struct RuntimeScriptsPlugin: Plugin {","    let scriptURL: URL","","    @MainActor","    func setup(in app: borrowing AppWorlds) {","        do {","            let script = try AdaScriptPlugin(contentsOf: scriptURL)","            app.addPlugin(script)","        } catch {","            print(\"Could not load Ada Script: \\(error)\")","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"You can also use ","type":"text"},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin\/init(source:name:)","isActive":true},{"text":" when one source is","type":"text"},{"text":" ","type":"text"},{"text":"already in memory, or ","type":"text"},{"code":"AdaScriptPlugin\/init(sources:name:)","type":"codeVoice"},{"text":" with","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptSource","isActive":true},{"text":" values for a multi-file module. Script compilation,","type":"text"},{"text":" ","type":"text"},{"text":"import resolution, and annotation validation happen during initialization.","type":"text"},{"text":" ","type":"text"},{"text":"Native component resolution happens later during plugin setup.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Next steps","anchor":"Next-steps","type":"heading"},{"inlineContent":[{"text":"Read ","type":"text"},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage","isActive":true},{"text":" for annotation syntax, then ","type":"text"},{"type":"reference","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS","isActive":true},{"text":" for queries, component fields, and native iterator behavior.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/AdaScripting\/documentation\/AdaScripting"]]},"sections":[],"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptBasics","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations","doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLibraries"],"anchor":"Essentials","generated":true,"title":"Essentials"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adascripting\/gettingstartedwithadascript"]}],"abstract":[{"text":"Add an ","type":"text"},{"code":".ada","type":"codeVoice"},{"text":" file to an AdaEngine executable and run its systems without manually loading each script.","type":"text"}],"metadata":{"roleHeading":"Article","modules":[{"name":"Ada Script"}],"title":"Getting Started with Ada Script","role":"article"},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript"},"references":{"doc://AdaScripting/documentation/AdaScripting/GettingStartedWithAdaScript":{"title":"Getting Started with Ada Script","abstract":[{"type":"text","text":"Add an "},{"code":".ada","type":"codeVoice"},{"type":"text","text":" file to an AdaEngine executable and run its systems without manually loading each script."}],"role":"article","type":"topic","url":"\/documentation\/adascripting\/gettingstartedwithadascript","kind":"article","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptPlugin/init(source:name:)":{"title":"init(source:name:)","abstract":[],"role":"symbol","fragments":[{"kind":"keyword","text":"convenience"},{"text":" ","kind":"text"},{"kind":"identifier","text":"init"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"source"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"name"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"type":"topic","url":"\/documentation\/adascripting\/adascriptplugin\/init(source:name:)","kind":"symbol","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin\/init(source:name:)"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptLanguage":{"title":"Ada Script Language","abstract":[{"type":"text","text":"Use Ada Script syntax with AdaEngine declaration annotations. New to the"},{"type":"text","text":" "},{"type":"text","text":"language? Start with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptBasics"},{"type":"text","text":" for values, functions, types,"},{"type":"text","text":" "},{"type":"text","text":"properties, control flow, asynchronous work, and annotations."}],"role":"article","type":"topic","url":"\/documentation\/adascripting\/adascriptlanguage","kind":"article","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLanguage"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptBasics":{"title":"Ada Script Basics","abstract":[{"type":"text","text":"Learn the syntax of Ada Script before connecting a script to a scene or ECS"},{"type":"text","text":" "},{"type":"text","text":"world. Ada Script files use the "},{"code":".ada","type":"codeVoice"},{"type":"text","text":" extension. The examples on this page are"},{"type":"text","text":" "},{"type":"text","text":"small pieces you can combine in one file; a game does not need a "},{"code":"main()","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"function. Start with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/GettingStartedWithAdaScript"},{"type":"text","text":" to run a complete system."}],"role":"article","type":"topic","url":"\/documentation\/adascripting\/adascriptbasics","kind":"article","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptBasics"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptAnnotations":{"title":"Ada Script Annotation Reference","abstract":[{"type":"text","text":"Choose an annotation by the declaration it describes. Annotation arguments"},{"type":"text","text":" "},{"type":"text","text":"are literals, identifiers, or lists of those values, not runtime expressions."},{"type":"text","text":" "},{"type":"text","text":"The same spelling can have different roles: "},{"code":"@component","type":"codeVoice"},{"type":"text","text":" declares a struct,"},{"type":"text","text":" "},{"type":"text","text":"while "},{"code":"@component(required: true)","type":"codeVoice"},{"type":"text","text":" binds an existing component to a scriptable"},{"type":"text","text":" "},{"type":"text","text":"instance."}],"role":"article","type":"topic","url":"\/documentation\/adascripting\/adascriptannotations","kind":"article","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptAnnotations"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptECS":{"title":"Ada Script ECS","abstract":[{"type":"text","text":"Declare annotation-driven systems and iterate native AdaECS component columns."}],"role":"article","type":"topic","url":"\/documentation\/adascripting\/adascriptecs","kind":"article","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptECS"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptSource":{"title":"AdaScriptSource","abstract":[{"type":"text","text":"One source file embedded in an Ada Script module."}],"role":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptSource","kind":"identifier"}],"navigatorTitle":[{"text":"AdaScriptSource","kind":"identifier"}],"type":"topic","url":"\/documentation\/adascripting\/adascriptsource","kind":"symbol","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptSource"},"doc://AdaScripting/documentation/AdaScripting":{"title":"Ada Script","abstract":[{"type":"text","text":"Write gameplay systems in Ada Script while keeping entity filtering and access planning in AdaEngine’s native ECS."}],"role":"collection","type":"topic","url":"\/documentation\/adascripting","kind":"symbol","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptPlugin":{"title":"AdaScriptPlugin","abstract":[{"type":"text","text":"Loads an annotation-driven Ada Script module."}],"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdaScriptPlugin","kind":"identifier"}],"navigatorTitle":[{"text":"AdaScriptPlugin","kind":"identifier"}],"type":"topic","url":"\/documentation\/adascripting\/adascriptplugin","kind":"symbol","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptPlugin"},"doc://AdaScripting/documentation/AdaScripting/AdaScriptLibraries":{"title":"AdaScript Libraries","abstract":[{"type":"text","text":"Share reusable AdaScript functions, systems, and scriptable objects through a GitHub repository."},{"type":"text","text":" "},{"type":"text","text":"AdaEditor installs the library and its transitive dependencies into the project. Run, Play Mode,"},{"type":"text","text":" "},{"type":"text","text":"Preview, and "},{"code":"AdaScriptBuildPlugin","type":"codeVoice"},{"type":"text","text":" load the same installed sources without network access."}],"role":"article","type":"topic","url":"\/documentation\/adascripting\/adascriptlibraries","kind":"article","identifier":"doc:\/\/AdaScripting\/documentation\/AdaScripting\/AdaScriptLibraries"}}}