d":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Layout-with-stacks","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Add-a-button-and-state","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/UIBasics#Debug-overlays","kind":"task"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-the-view","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Prepare-layout-helpers","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Create-a-custom-TextRenderer","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/AnimatedText#Apply-and-animate","kind":"task"}]},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput","sections":[{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Set-up-the-world","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Create-the-input-system","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Read-buttons","kind":"task"},{"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/GamepadInput#Move-and-rumble","kind":"task"}]}]}],"paths":[["doc:\/\/AdaEngine\/tutorials\/AdaEngine","doc:\/\/AdaEngine\/tutorials\/AdaEngine\/$volume","doc:\/\/AdaEngine\/tutorials\/AdaEngine\/Create-your-first-2D-game-project."]],"reference":"doc:\/\/AdaEngine\/tutorials\/AdaEngine"},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/PlayerAndText"},"kind":"project","metadata":{"category":"Ada","categoryPathComponent":"AdaEngine","title":"Player and Text in Ada","role":"project"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/adaengine\/playerandtext"]}],"sections":[{"kind":"hero","chapter":"Create your first 2D game project.","title":"Player and Text in Ada","estimatedTimeInMinutes":5,"xcodeRequirement":"Xcode 26.2 or later","content":[{"type":"paragraph","inlineContent":[{"text":"In this tutorial, you will learn how to add a player component that you can control and how to add text and various labels to your game scene.","type":"text"}]}]},{"kind":"tasks","tasks":[{"contentSection":[{"mediaPosition":"trailing","content":[{"inlineContent":[{"text":"Here we will start adding our Components and Entity, so that Ada will correctly render our player and make him alive!","type":"text"}],"type":"paragraph"}],"kind":"contentAndMedia"}],"anchor":"Add-Player-component","title":"Add Player component","stepsSection":[{"media":null,"code":"PAT-1-1-player-component.swift","content":[{"inlineContent":[{"text":"First of all you have to add the player component. For Ada to understand you, just specify the following code.","type":"text"}],"type":"paragraph"}],"type":"step","caption":[],"runtimePreview":null},{"media":null,"code":"PAT-1-2-makePlayer.swift","content":[{"inlineContent":[{"text":"We must add our player to the scene. To do this we will use ","type":"text"},{"code":"World\/spawn(_:)","type":"codeVoice"},{"text":" to spawn entities. Follow the code!","type":"text"}],"type":"paragraph"}],"type":"step","caption":[{"inlineContent":[{"type":"text","text":"We will create a separate makePlayer function where we will spawn an entity with various components."}],"type":"paragraph"}],"runtimePreview":null},{"media":null,"code":"PAT-1-3-makePlayer.swift","content":[{"inlineContent":[{"type":"text","text":"Next, let’s spawn an entity with the "},{"code":"PlayerComponent","type":"codeVoice"},{"type":"text","text":", which we discussed earlier, so that we can easily identify this entity as our player."}],"type":"paragraph"}],"type":"step","caption":[],"runtimePreview":null},{"media":null,"code":"PAT-1-4-makePlayer.swift","content":[{"inlineContent":[{"type":"text","text":"Ada knows that the player has been added to the scene, but… he can’t do anything and doesn’t have any properties. Let’s fix this! To begin with, we will give the player the opportunity to move and, in general, somehow change his size and position. Let’s use the built-in Transform component and set some initial values."}],"type":"paragraph"}],"type":"step","caption":[],"runtimePreview":null},{"media":null,"code":"PAT-1-5-makePlayer.swift","content":[{"inlineContent":[{"type":"text","text":"One more component is missing - what will the player look like? To do this, you can use sprites and the corresponding component in Ada. We pass a "},{"code":"characterAtlas","type":"codeVoice"},{"type":"text","text":" parameter to get the texture for our player."}],"type":"paragraph"}],"type":"step","caption":[],"runtimePreview":null},{"media":null,"code":"PAT-1-6-makeScene.swift","content":[{"inlineContent":[{"type":"text","text":"After all the preparations, let’s create a Plugin that will set up our player. The Plugin pattern is the recommended way to organize game logic in Ada."}],"type":"paragraph"}],"type":"step","caption":[],"runtimePreview":null}]},{"contentSection":[{"mediaPosition":"trailing","content":[{"inlineContent":[{"type":"text","text":"Let’s dive deeper into the Ada text component"}],"type":"paragraph"}],"kind":"contentAndMedia"}],"anchor":"Add-Text-component","title":"Add Text component","stepsSection":[{"media":null,"code":"PAT-2-1-gameState.swift","content":[{"inlineContent":[{"type":"text","text":"Okay, most likely you want to count some points for your player. Let’s start creating the GameState resource. Note that we use "},{"code":"Resource","type":"codeVoice"},{"type":"text","text":" protocol for global game state."}],"type":"paragraph"}],"type":"step","caption":[],"runtimePreview":null},{"media":null,"code":"PAT-2-2-makeScore.swift","content":[{"inlineContent":[{"type":"text","text":"By analogy with the player, we will create a separate function for adding score text to the scene. Here, we spawn an entity with a "},{"code":"TextComponent","type":"codeVoice"},{"type":"text","text":" - it will help us draw the text. We also add Transform for positioning and insert our GameState as a resource."}],"type":"paragraph"}],"type":"step","caption":[{"inlineContent":[{"type":"text","text":"To customize the text, you can use TextAttributeContainer."}],"type":"paragraph"}],"runtimePreview":null}]}]},{"kind":"callToAction","title":"Event Listeners in Ada","action":{"type":"reference","overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners","isActive":true,"overridingTitle":"Get started"},"featuredEyebrow":"Tutorial","abstract":[{"type":"text","text":"In this tutorial you will learn about the event listeners system in Ada."},{"type":"text","text":" "},{"type":"text","text":"How can you catch events and process them"}]}],"references":{"doc://AdaEngine/tutorials/AdaEngine/EventListeners":{"type":"topic","url":"\/tutorials\/adaengine\/eventlisteners","kind":"project","title":"Event Listeners in Ada","abstract":[{"text":"In this tutorial you will learn about the event listeners system in Ada.","type":"text"},{"text":" ","type":"text"},{"text":"How can you catch events and process them","type":"text"}],"role":"project","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners","estimatedTime":"5min"},"doc://AdaEngine/tutorials/AdaEngine/EventListeners#Base-of-Event-Subscriber-pattern":{"type":"section","url":"\/tutorials\/adaengine\/eventlisteners#Base-of-Event-Subscriber-pattern","kind":"section","abstract":[{"type":"text","text":"In this tutorial you will learn about the event listeners system in Ada."},{"type":"text","text":" "},{"type":"text","text":"How can you catch events and process them"}],"title":"Base of Event-Subscriber pattern","role":"pseudoSymbol","identifier":"doc:\/\/AdaEngine\/tutorials\/AdaEngine\/EventListeners#Base-of-Event-Subscriber-pattern"},"d